ation": "Hech qanday farzandga ega bo'lmagan terminal tugunlar barg (leaf) tugunlar deyiladi."}, {"question": "AVL daraxtida qidirish operatsiyasining vaqt murakkabligi qancha?", "options": ["O(n^2)", "O(log n)", "O(n)", "O(1)"], "correct_index": 1, "explanation": "AVL daraxti doimo muvozanatda saqlangani uchun qidirish har doim O(log n) vaqt oladi."}, {"question": "Ikkilik qidiruv daraxtida (BST) qidirish murakkabligi eng yomon holatda qanday?", "options": ["O(log n)", "O(n)", "O(n^2)", "O(1)"], "correct_index": 1, "explanation": "Daraxt chiziqli ko'rinishga kelib qolganda (degenerated tree) eng yomon holatdagi qidirish murakkabligi O(n) ga teng."}, {"question": "Grafning darajasi (degree) nimani bildiradi?", "options": ["Grafdagi eng uzun yo'lni", "Ildizdan barggacha bo'lgan masofani", "Tugunga tutashgan qirralar sonini", "Grafdagi umumiy tugunlar sonini"], "correct_index": 2, "explanation": "Yo'naltirilmagan grafda tugunning darajasi unga tutashgan qirralarning umumiy sonidir."}, {"question": "B-daraxtning asosiy maqsadi nima?", "options": ["Tashqi xotira (disk) va katta hajmdagi ma'lumotlar bilan samarali ishlash", "Operativ xotirada tezkor qidirish", "Matnlarni siqish", "Faqat grafik va tasvirlarni saqlash"], "correct_index": 0, "explanation": "B-daraxt tashqi xotiraga murojaatlar sonini kamaytirish va katta hajmdagi ma'lumotlar bilan ishlash uchun mo'ljallangan."}, {"question": "Agar daraxtda n ta tugun boвЂlsa Pryufer kodi uzunligi nechchiga teng bo'ladi?", "options": ["n + 2", "n", "n - 1", "n - 2"], "correct_index": 3, "explanation": "n ta belgilangan tugunli daraxtning Pryufer kodi uzunligi n - 2 ga teng."}, {"question": "Agar daraxtda n ta tugun boвЂlsa, unda nechta qirra boвЂladi?", "options": ["n", "n + 1", "n - 1", "2n"], "correct_index": 2, "explanation": "Har qanday n ta tugunli daraxtda aynan n - 1 ta qirra bo'ladi."}, {"question": "DFS algoritmi rekursiv tarzda bajarilganda qaysi maвЂ™lumot tuzilmasi bilvosita ishlatiladi?", "options": ["Massiv (Array)", "Navbat (Queue)", "Graf (Graph)", "Stek (Stack)"], "correct_index": 3, "explanation": "DFS (Depth-First Search) rekursiya ishlatganda tizim chaqiruvlar steki (Call Stack) dan foydal    anadi."}, {"question": "Graf G = (V, E) da E nimani bildiradi?", "options": ["Yo'llar to'plamini", "Og'irliklar to'plamini", "Qirralar to'plamini", "Tugunlar to'plamini"], "correct_index": 2, "explanation": "Graf ta'rifida V (Vertices) tugunlar to'plami, E (Edges) esa qirralar to'plamini bildiradi."}, {"question": "ToвЂliq grafda tugunlar soniga koвЂra qirralar sonini topish formulasini ko'rsating.", "options": ["n^2", "n * (n + 1) / 2", "2 * n - 1", "n * (n - 1) / 2"], "correct_index": 3, "explanation": "n ta tugunga ega to'liq grafdagi qirralar soni n*(n-1)/2 ga teng."}, {"question": "OgвЂirlikli graf nima?", "options": ["Qirralariga ma'lum bir qiymat (vazn/og'irlik) biriktirilgan graf", "Har bir tugunining darajasi teng bo'lgan graf", "Tugunlari soni 100 dan ortiq bo'lgan graf", "Faqat yo'naltirilgan qirralardan tashkil topgan graf"], "correct_index": 0, "explanation": "Og'irlikli grafda har bir qirra masofa, vaqt yoki xarajat kabi ko'rsatkichni ifodalovchi og'irlikka ega bo'ladi."}, {"question": "Qanday daraxtni biz 'Binar daraxt' deb ataymiz?", "options": ["Har bir darajasi to'liq to'lgan daraxt", "Faqat barg tugunlardan iborat daraxt", "Har bir tuguni aynan 3 ta farzandga ega bo'lgan daraxt", "Har bir tuguni ko'pi bilan 2 ta farzandga ega bo'lgan daraxt"], "correct_index": 3, "explanation": "Binar daraxtda har bir tugun ko'pi bilan ikkita (chap va o'ng) farzandga ega bo'lishi mumkin."}, {"question": "B-daraxtda barcha barg tugunlar (leaf nodes) qayerda joylashgan bo'lishi kerak?", "options": ["Aynan bir xil chuqurlikda (sathda)", "Faqat o'ng tomonda", "Faqat chap tomonda", "Har xil sathlarda"], "correct_index": 0, "explanation": "B-daraxtning muhim xususiyati shundaki, barcha barg tugunlar bir xil chuqurlikda joylashadi."}, {"question": "ToвЂliq grafda 5 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["5", "10", "20", "15"], "correct_index": 1, "explanation": "n*(n-1)/2 formulasi bo'yicha: 5*4/2 = 10."}, {"question": "Ikkilik qidiruv daraxtida (BST) qidirish murakkabligi o'rtacha holatda qanday?", "options": ["O(1)", "O(n log n)", "O(log n)", "O(n)"], "correct_index": 2, "explanation": "Muvozanatlangan BST da o'rtacha qidiruv vaqti balandlikka mutanosib ravishda O(log n) bo'ladi."}, {"question": "Qo'shnilik ro'yxati sifatida berilgan V tugun va E qirrali grafda BFS ning vaqt murakkabligi qanday?", "options": ["O(V + E)", "O(E^2)", "O(V^2)", "O(V * E)"], "correct_index": 0, "explanation": "Qo'shnichilik ro'yxatida BFS har bir tugun va qirranД± bir marta ko'rib chiqadi, shuning uchun murakkablik O(V + E)."}, {"question": "B-daraxtda tugun kalitlar bilan to'lib qolganda qanday amal bajariladi?", "options": ["Qidiruv to'xtatiladi", "Tugun bo'linadi (Split)", "Tugun o'chiriladi", "Daraxt qayta quriladi"], "correct_index": 1, "explanation": "Tugunda kalitlar soni maksimal chegaraga yetganda (2t - 1), u ikkita tugunga bo'linadi (Split)."}, {"question": "Agar daraxtda 8 ta tugun mavjud bo'lsa uning Pryufer kodi uzunligi nechchiga teng boвЂladi?", "options": ["8", "7", "5", "6"], "correct_index": 3, "explanation": "Formula n - 2 bo'lgani uchun: 8 - 2 = 6."}, {"question": "BFS algoritmi qaysi maвЂ™lumot tuzilmasiga asoslanadi?", "options": ["Xesh-jadval (Hash table)", "Stek (Stack)", "Navbat (Queue)", "Daraxt (Tree)"], "correct_index": 2, "explanation": "BFS (Breadth-First Search) kenglik bo'yicha qidirish algoritmi Navbat (Queue) tuzilmasidan foydalanadi."}, {"question": "ToвЂliq grafda 4 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["12", "4", "8", "6"], "correct_index": 3, "explanation": "To'liq grafda qirralar soni n*(n-1)/2 formula bilan topiladi: 4*3/2 = 6."}, {"question": "Agar daraxt left-left (chap-chap) og'ish holatida bo'lsa, uni muvozanatga keltirish uchun qaysi burish ishlatiladi?", "options": ["O'ng-Chap aylantirish", "O'ngga aylantirish (Right Rotation)", "Chap-O'ng aylantirish", "Chapga aylantirish (Left Rotation)"], "correct_index": 1, "explanation": "Left-Left (LL) og'ishda muvozanatni tiklash uchun bitta O'ngga aylantirish (Right Rotation) bajariladi."}]}j†©М  &options": ["Faqat qirralar og'irligini ko'rsatuvchi ro'yxat ko'rinishida", "Tugunlar o'rtasidagi bog'lanishlarni N x N o'lchamli matritsa ko'rinishida", "Tugunlar ro'yxatini massiv ko'rinishida", "Barcha yo'llar uzunligini bir o'lchamli massivda"], "correct_index": 1, "explanation": "Qo'shnichilik matritsasi N x N o'lchamda bo'lib, i va j tugunlar orasida qirra borligini 1 yoki og'irlik bilan ko'rsatadi."}, {"question": "B-daraxtning asosiy maqsadi nima?", "options": ["Operativ xotirada tezkor qidirish", "Faqat grafik va tasvirlarni saqlash", "Tashqi xotira (disk) va katta hajmdagi ma'lumotlar bilan samarali ishlash", "Matnlarni siqish"], "correct_index": 2, "explanation": "B-daraxt tashqi xotiraga murojaatlar sonini kamaytirish va katta hajmdagi ma'lumotlar bilan ishlash uchun mo'ljallangan."}, {"question": "Daraxtda har qanday ikki tugun orasida nechta yoвЂl mavjud?", "options": ["Yo'l mavjud emas", "Cheksiz ko'p yo'l", "Faqat bitta noyob yo'l", "Ikkita yo'l"], "correct_index": 2, "explanation": "Daraxt aciklik bog'langan graf bo'lgani uchun har qanday ikki tugun orasida faqat bitta yo'l mavjud."}, {"question": "Qanday daraxtni biz 'Binar daraxt' deb ataymiz?", "options": ["Har bir tuguni ko'pi bilan 2 ta farzandga ega bo'lgan daraxt", "Faqat barg tugunlardan iborat daraxt", "Har bir tuguni aynan 3 ta farzandga ega bo'lgan daraxt", "Har bir darajasi to'liq to'lgan daraxt"], "correct_index": 0, "explanation": "Binar daraxtda har bir tugun ko'pi bilan ikkita (chap va o'ng) farzandga ega bo'lishi mumkin."}, {"question": "AVL daraxti qanday turdagi daraxt hisoblanadi?", "options": ["Faqat to'liq binar daraxt", "O'z-o'zini muvozanatlovchi binar qidiruv daraxti", "Ixtiyoriy ko'p tarmoqli daraxt", "Muvozanatlanmagan chiziqli daraxt"], "correct_index": 1, "explanation": "AVL daraxti har bir tugunida balandliklar farqi 1 dan oshmaydigan o'z-o'zini muvozanatlovchi BST dir."}, {"question": "B-daraxtda barcha barg tugunlar (leaf nodes) qayerda joylashgan bo'lishi kerak?", "options": ["Aynan bir xil chuqurlikda (sathda)", "Faqat o'ng tomonda", "Faqat chap tomonda", "Har xil sathlarda"], "correct_index": 0, "explanation": "B-daraxtning muhim xususiyati shundaki, barcha barg tugunlar bir xil chuqurlikda joylashadi."}, {"question": "Agar daraxtda n ta tugun boвЂlsa Pryufer kodi uzunligi nechchiga teng bo'ladi?", "options": ["n - 1", "n + 2", "n", "n - 2"], "correct_index": 3, "explanation": "n ta belgilangan tugunli daraxtning Pryufer kodi uzunligi n - 2 ga teng."}, {"question": "ToвЂliq grafda tugunlar soniga koвЂra qirralar sonini topish formulasini ko'rsating.", "options": ["n * (n - 1) / 2", "n * (n + 1) / 2", "2 * n - 1", "n^2"], "correct_index": 0, "explanation": "n ta tugunga ega to'liq grafdagi qirralar soni n*(n-1)/2 ga teng."}, {"question": "AVL daraxtda tugun muvozanatlangan hisoblanishi uchun uning Balance Factor (BF) qiymati qanday bo'lishi kerak?", "options": ["2 yoki -2", "-1, 0, 1", "Har qanday musbat son", "Faqat 0"], "correct_index": 1, "explanation": "AVL daraxtida har bir tugun uchun BF qiymati -1, 0 yoki 1 bo'lishi shart."}, {"question": "BFS algoritmi qaysi maвЂ™lumot tuzilmasiga asoslanadi?", "options": ["Xesh-jadval (Hash table)", "Stek (Stack)", "Daraxt (Tree)", "Navbat (Queue)"], "correct_index": 3, "explanation": "BFS (Breadth-First Search) kenglik bo'yicha qidirish algoritmi Navbat (Queue) tuzilmasidan foydalanadi."}, {"question": "AVL daraxtida qidirish operatsiyasining vaqt murakkabligi qancha?", "options": ["O(1)", "O(n^2)", "O(log n)", "O(n)"], "correct_index": 2, "explanation": "AVL daraxti doimo muvozanatda saqlangani uchun qidirish har doim O(log n) vaqt oladi."}, {"question": "Ikkilik qidiruv daraxtida (BST) qidirish murakkabligi eng yomon holatda qanday?", "options": ["O(n)", "O(log n)", "O(n^2)", "O(1)"], "correct_index": 0, "explanation": "Daraxt chiziqli ko'rinishga kelib qolganda (degenerated tree) eng yomon holatdagi qidirish murakkabligi O(n) ga teng."}, {"question": "Agar daraxtda 8 ta tugun mavjud bo'lsa uning Pryufer kodi uzunligi nechchiga teng boвЂladi?", "options": ["8", "7", "    5", "6"], "correct_index": 3, "explanation": "Formula n - 2 bo'lgani uchun: 8 - 2 = 6."}, {"question": "Daraxtda qaysi tugun 'Ildiz' (root) deb ataladi?", "options": ["Daraxtning eng pastki qismidagi tugun", "Farzandi bo'lmagan tugun", "Eng ko'p farzandga ega tugun", "Ota tuguni bo'lmagan eng yuqori tugun"], "correct_index": 3, "explanation": "Ildiz tugun (root) daraxtning eng yuqori tuguni bo'lib, uning ota tuguni yo'q."}, {"question": "Agar daraxtda n ta tugun boвЂlsa, unda nechta qirra boвЂladi?", "options": ["n", "2n", "n + 1", "n - 1"], "correct_index": 3, "explanation": "Har qanday n ta tugunli daraxtda aynan n - 1 ta qirra bo'ladi."}, {"question": "QoвЂshnilik matritsasi bilan berilgan grafda BFS ning vaqt murakkabligi qanday?", "options": ["O(log V)", "O(V + E)", "O(E)", "O(V^2)"], "correct_index": 3, "explanation": "Matritsadan qo'shnilarni izlash har bir tugun uchun O(V) vaqt oladi, umumiy murakkablik O(V^2) bo'ladi."}, {"question": "B-daraxtda tugun kalitlar bilan to'lib qolganda qanday amal bajariladi?", "options": ["Tugun o'chiriladi", "Tugun bo'linadi (Split)", "Qidiruv to'xtatiladi", "Daraxt qayta quriladi"], "correct_index": 1, "explanation": "Tugunda kalitlar soni maksimal chegaraga yetganda (2t - 1), u ikkita tugunga bo'linadi (Split)."}, {"question": "Graf G = (V, E) da E nimani bildiradi?", "options": ["Og'irliklar to'plamini", "Qirralar to'plamini", "Tugunlar to'plamini", "Yo'llar to'plamini"], "correct_index": 1, "explanation": "Graf ta'rifida V (Vertices) tugunlar to'plami, E (Edges) esa qirralar to'plamini bildiradi."}, {"question": "ToвЂliq grafda 5 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["5", "10", "15", "20"], "correct_index": 1, "explanation": "n*(n-1)/2 formulasi bo'yicha: 5*4/2 = 10."}, {"question": "ToвЂliq grafda 4 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["6", "8", "4", "12"], "correct_index": 0, "explanation": "To'liq grafda qirralar soni n*(n-1)/2 formula bilan topiladi: 4*3/2 = 6."}, {"question": "OgвЂirlikli graf nima?", "options": ["Faqat yo'naltirilgan qirralardan tashkil topgan graf", "Tugunlari soni 100 dan ortiq bo'lgan graf", "Har bir tugunining darajasi teng bo'lgan graf", "Qirralariga ma'lum bir qiymat (vazn/og'irlik) biriktirilgan graf"], "correct_index": 3, "explanation": "Og'irlikli grafda har bir qirra masofa, vaqt yoki xarajat kabi ko'rsatkichni ifodalovchi og'irlikka ega bo'ladi."}, {"question": "DFS algoritmi rekursiv tarzda bajarilganda qaysi maвЂ™lumot tuzilmasi bilvosita ishlatiladi?", "options": ["Stek (Stack)", "Massiv (Array)", "Navbat (Queue)", "Graf (Graph)"], "correct_index": 0, "explanation": "DFS (Depth-First Search) rekursiya ishlatganda tizim chaqiruvlar steki (Call Stack) dan foydalanadi."}, {"question": "AVL daraxtining muvozanatlashganlik sharti (Balance Factor) qanday aniqlanadi?", "options": ["Chap va o'ng ost-daraxtlar balandliklari ayirmasi", "Daraxtdagi barcha tugunlar yig'indisi", "Ildiz va barg orasidagi masofa", "Ota va farzand tugunlar soni nisbati"], "correct_index": 0, "explanation": "Balance Factor = height(Left Subtree) - height(Right Subtree) ko'rinishida hisoblanadi."}, {"question": "Ikkilik qidiruv daraxtida (BST) qidirish murakkabligi o'rtacha holatda qanday?", "options": ["O(log n)", "O(1)", "O(n log n)", "O(n)"], "correct_index": 0, "explanation": "Muvozanatlangan BST da o'rtacha qidiruv vaqti balandlikka mutanosib ravishda O(log n) bo'ladi."}, {"question": "Daraxtda farzandga ega boвЂlmagan tugunlar qanday nomlanadi?", "options": ["Ildiz tugunlar", "Aka-uka tugunlar", "Barg tugunlar (Leaf nodes)", "Ajdod 