5j                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              ЃЛ*Ѓ Qѓ–q_8a6774186b4d4d8a81f07b03cecc3694C{"variant": "C", "quizzes": [{"question": "Agar daraxtda 12 ta tugun mavjud bo'lsa uning Pryufer kodi uzunligi nechchiga teng boвЂladi?", "options": ["11", "13", "12", "10"], "correct_index": 3, "explanation": "Pryufer kodi uzunligi n - 2 formulasi bo'yicha hisoblanadi. 12 ta tugun bo'lsa, 12 - 2 = 10 ga teng."}, {"question": "BogвЂlangan graf deb qanday graflarga aytiladi?", "options": ["Har qanday ikki tugun orasida yo'l mavjud bo'lgan graf", "Tsikllarga ega bo'lmagan graf", "Yo'naltirilgan graf", "Barcha tugunlari bir-biri bilan bog'langan graf"], "correct_index": 0, "explanation": "Bog'langan graf deb, grafdagi har qanday ikki tugun orasida kamida bitta yo'l mavjud bo'lgan grafga aytiladi."}, {"question": "Agar grafdagi F tugun A, B, C va D tugunlar bilan qirralar orqali tutashgan boвЂlsa F tugunning darajasi nechchiga teng?", "options": ["3", "4", "1", "2"], "correct_index": 1, "explanation": "F tugun A, B, C va D tugunlar bilan bog'langanligi sababli, unga tutashgan qirralar soni 4 ta bo'ladi, demak darajasi 4 ga teng."}, {"question": "AVL daraxti va oddiy BST (Binary Search Tree) o'rtasidagi asosiy farq nima?", "options": ["AVL daraxti faqat yo'naltirilgan, BST esa yo'naltirilmagan", "AVL daraxti faqat kichikroq ma'lumotlar uchun ishlatiladi, BST esa kattaroq ma'lumotlar uchun", "Hech qanday farq yo'q", "AVL daraxti o'z-o'zidan muvozanatlashadi, BST esa muvozanatlanmasligi mumkin"], "correct_index"   ЃЛ*Ѓ Qѓ–q_8a6774186b4d4d8a81f07b03cecc3694B{"variant": "B", "quizzes": [{"question": "Daraxt tuzilmasida o'lcham nima?", "options": ["Daraxtning balandligi", "Daraxtning ildizi", "Daraxtdagi qirralar soni", "Daraxtdagi tugunlar soni"], "correct_index": 3, "explanation": "Daraxt tuzilmasida o'lcham (size) daraxtdagi tugunlar sonini bildiradi."}, {"question": "Agar daraxt right-right (o'ng-o'ng) og'ish holatida bo'lsa bunday daraxtni muvozanatga keltirishda uni qaysi tomonga aylantiriladi?", "options": ["Chapga aylantirish", "Avval chapga, keyin o'ngga", "Avval o'ngga, keyin chapga", "O'ngga aylantirish"], "correct_index": 0, "explanation": "Right-Right (RR) og'ish holatida daraxtni chapga (Left Rotation) aylantirish orqali muvozanat tiklanadi."}, {"question": "AVL daraxtining muvozanatlashganlik sharti (Balance Factor) qanday aniqlanadi?", "options": ["Tugunning farzandlari soni", "Tugunning ota-onasi soni", "Chap kichik daraxt balandligi minus o'ng kichik daraxt balandligi", "O'ng kichik daraxt balandligi minus chap kichik daraxt balandligi"], "correct_index": 2, "explanation": "AVL daraxtida Balance Factor (BF) chap kichik daraxt balandligi va o'ng kichik daraxt balandligi o'rtasidagi farq sifatida aniqlanadi."}, {"question": "AVL daraxtiga yangi tugun qo'shilganda muvozanat buzilsa, maksimal necha turdagi aylantirish (rotation) ishlatilishi mumkin?", "options": ["3", "4", "2", "1"], "correct_index": 1, "explanation": "AVL daraxtida muvozanatni tikl    !: 3, "explanation": "Asosiy farq shundaki, AVL daraxti o'z-o'zidan muvozanatlashadi, bu esa qidirish, qo'shish va o'chirish operatsiyalarining O(log n) vaqt murakkabligini kafolatlaydi. Oddiy BST esa muvozanatlanmagan holatda O(n) murakkablikka ega bo'lishi mumkin."}, {"question": "Grafda oвЂtish nima?", "options": ["Grafdan tugunni o'chirish", "Ikki tugun orasidagi eng qisqa yo'lni topish", "Grafga yangi tugun qo'shish", "Grafdagi barcha tugunlarni yoki qirralarni bir marta ko'rib chiqish"], "correct_index": 3, "explanation": "Grafda o'tish (traversal) deb, grafdagi barcha tugunlarni yoki qirralarni bir marta tizimli ravishda ko'rib chiqish jarayoniga aytiladi."}, {"question": "B-daraxtning tartibi t bo'lsa, tugundagi maksimal kalitlar soni qanday formula bilan aniqlanadi?", "options": ["t - 1", "2t", "2t - 1", "t"], "correct_index": 2, "explanation": "B-daraxtning tartibi t bo'lsa, tugundagi maksimal kalitlar soni 2t - 1 formulasi bilan aniqlanadi."}, {"question": "Agar daraxtda ikki tugun qirra orqali bogвЂlangan boвЂlsa, pastdagi tugun qanday nomlanadi?", "options": ["Ildiz (Root)", "Farzand (Child)", "Ota (Parent)", "Aka-uka (Sibling)"], "correct_index": 1, "explanation": "Daraxtda ikki tugun qirra orqali bog'langan bo'lsa, pastdagi tugun farzand (child) deb ataladi."}, {"question": "Agar daraxtda n ta tugun boвЂlsa, unda nechta qirra boвЂladi?", "options": ["n + 1", "2n", "n - 1", "n"], "correct_index": 2, "explanation": "Daraxtda n ta tugun bo'lsa, har doim n - 1 ta qirra bo'ladi."}, {"question": "Ikkilik qidiruv daraxtida (Binary Search Tree) qidirish murakkabligi o'rtacha holatda qanday?", "options": ["O(log n)", "O(1)", "O(n)", "O(n log n)"], "correct_index": 0, "explanation": "Ikkilik qidiruv daraxtida o'rtacha holatda qidirish murakkabligi O(log n) ga teng bo'ladi."}, {"question": "AVL daraxtida eng kichik element qayerda joylashgan bo'ladi?", "options": ["Ildiz tugun", "Eng o'ngdagi barg tugun", "Har qanday joyda bo'lishi mumkin", "Eng chapdagi barg tugun"], "correct_index": 3, "explanation": "AVL daraxti ikkilik qidiruv daraxti bo'lganligi sababli, eng kichik element har doim eng chapdagi barg tugunda joylashgan bo'ladi."}, {"question": "B-daraxtda barcha barg tugunlar (leaf nodes) qayerda joylashgan bo'lishi kerak?", "options": ["Turli sathlarda", "Bir xil sathda", "Faqat ildizga yaqin", "Faqat ildizdan uzoqda"], "correct_index": 1, "explanation": "B-daraxtning muhim xususiyatlaridan biri shundaki, barcha barg tugunlar bir xil sathda joylashgan bo'lishi kerak."}, {"question": "ToвЂliq grafda tugunlar soniga koвЂra qirralar sonini topish formulasi keltirilgan javobni belgilang.", "options": ["n - 1", "n * (n - 1) / 2", "n^2", "n * (n + 1) / 2"], "correct_index": 1, "explanation": "To'liq grafda n ta tugun bo'lsa, qirralar soni n * (n - 1) / 2 formulasi bilan topiladi."}, {"question": "AVL daraxtidan tugunni o'chirish (Deletion) murakkabligi qancha?", "options": ["O(n log n)", "O(1)", "O(log n)", "O(n)"], "correct_index": 2, "explanation": "AVL daraxtidan tugunni o'chirish operatsiyasining vaqt murakkabligi O(log n) ga teng."}, {"question": "QoвЂshnichilik matritsasi (adjacency matrix) qanday tuziladi?", "options": ["Tugunlar soniga teng satr va ustunli matritsa", "Faqat 0 va 1 lardan iborat ro'yxat", "Tugunlarning nomlari ro'yxati", "Qirralar soniga teng satr va ustunli matritsa"], "correct_index": 0, "explanation": "Qo'shnichilik matritsasi N x N o'lchamli bo'lib, bu yerda N tugunlar soni. Agar (i, j) tugunlar orasida qirra bo'lsa, matritsaning (i, j) elementi 1 (yoki og'irlik), aks holda 0 bo'ladi."}, {"question": "Agar daraxtda 10 ta tugun mavjud bo'lsa uning Pryufer kodi uzunligi nechchiga teng boвЂladi?", "options": ["11", "8", "9", "10"], "correct_index": 1, "explanation": "Pryufer kodi uzunligi n - 2 formulasi bo'yicha hisoblanadi. 10 ta tugun bo'lsa, 10 - 2 = 8 ga teng."}, {"question": "BFS va DFS ikkala algoritm uchun ham umumiy bo'lgan xususiyat qaysi?", "options": ["Tsikllarni aniqlash", "Eng qisqa yo'lni topish", "Grafni to'liq tekshirish", "Og'irlikli graflarda ishlash"], "correct_  "index": 2, "explanation": "BFS va DFS algoritmlarining ikkalasi ham grafdagi barcha tugunlarni va qirralarni to'liq tekshirish (traversal) uchun ishlatiladi."}, {"question": "Grafning darajasi (degree) nimani bildiradi?", "options": ["Tugunning og'irligi", "Grafdagi qirralar soni", "Grafdagi tugunlar soni", "Tugunga tutashgan qirralar soni"], "correct_index": 3, "explanation": "Grafning darajasi (degree) tugunga tutashgan qirralar sonini bildiradi."}, {"question": "Agar daraxtda n ta tugun boвЂlsa Pryufer kodi uzunligi nechchiga teng bo'ladi?", "options": ["n - 1", "n - 2", "n + 1", "n"], "correct_index": 1, "explanation": "n ta tugunli daraxtning Pryufer kodi uzunligi n - 2 ga teng bo'ladi."}, {"question": "OgвЂirlikli graf nimalarni ifodalashi mumkin?", "options": ["Masofa, narx, vaqt, o'tkazish qobiliyati", "Faqat narx", "Faqat masofa", "Faqat vaqt"], "correct_index": 0, "explanation": "Og'irlikli grafdagi qirralarning og'irliklari masofa, narx, vaqt, o'tkazish qobiliyati kabi turli xil qiymatlarni ifodalashi mumkin."}, {"question": "Graf G = (V, E) da E nimani bildiradi?", "options": ["Qirralar", "Og'irliklar", "Yo'nalishlar", "Tugunlar"], "correct_index": 0, "explanation": "Graf G = (V, E) da V tugunlar (vertices) to'plamini, E esa qirralar (edges) to'plamini bildiradi."}, {"question": "YoвЂnaltirilgan graf nima?", "options": ["Barcha qirralari og'irlikka ega bo'lgan graf", "Qirralari yo'nalishga ega bo'lgan graf", "Tsikllarga ega bo'lmagan graf", "Har bir tugun boshqa barcha tugunlar bilan bog'langan graf"], "correct_index": 1, "explanation": "Yo'naltirilgan graf (directed graph) deb, qirralari ma'lum bir yo'nalishga ega bo'lgan grafga aytiladi."}, {"question": "Agar daraxt chiziqli (muvozanatlanmagan) bo'lsa qidirish murakkabligi qanday boвЂladi?", "options": ["O(log n)", "O(n)", "O(1)", "O(n log n)"], "correct_index": 1, "explanation": "Agar daraxt chiziqli (muvozanatlanmagan) bo'lsa, u bog'langan ro'yxatga o'xshab qoladi va qidirish murakkabligi O(n) ga teng bo'ladi."}, {"question": "Tugunni bo'lish paytida qaysi kalit yuqoriga (ota tugunga) ko'tariladi?", "options": ["Eng katta kalit", "Tasodifiy kalit", "O'rtadagi kalit", "Eng kichik kalit"], "correct_index": 2, "explanation": "Tugunni bo'lish paytida o'rtadagi kalit yuqoriga, ya'ni ota tugunga ko'tariladi, qolgan kalitlar esa ikkita yangi tugunga taqsimlanadi."}, {"question": "Daraxtda ajdod (ancestor) deb qaysi tugunlarga aytiladi?", "options": ["Berilgan tugunning farzandlari", "Berilgan tugun bilan bir xil sathda joylashgan tugunlar", "Berilgan tugundan ildizga qarab yo'l bo'ylab joylashgan barcha tugunlar", "Berilgan tugunning aka-ukalari"], "correct_index": 2, "explanation": "Ajdod (ancestor) deb, berilgan tugundan ildizga qarab yo'l bo'ylab joylashgan barcha tugunlarga aytiladi."}, {"question": "Agar B daraxtdagi tugunda n ta kalit bo'lsa, shu tugunning farzandlari soni nechta bo'ladi?", "options": ["n - 1", "2n", "n", "n + 1"], "correct_index": 3, "explanation": "B-daraxtda tugundagi kalitlar soni n bo'lsa, uning farzandlari soni n + 1 ga teng bo'ladi."}, {"question": "AVL daraxtini kimlar ixtiro qilgan?", "options": ["Robert Tarjan", "Dijkstra va Prim", "Kruskal va Bellman-Ford", "Adelson-Velsky va Landis"], "correct_index": 3, "explanation": "AVL daraxti 1962 yilda G.M. Adelson-Velsky va E.M. Landis tomonidan ixtiro qilingan."}, {"question": "B-daraxtning asosiy maqsadi nima?", "options": ["Kichik ma'lumotlar to'plamlarini boshqarish", "Graf algoritmlarini optimallashtirish", "Katta hajmdagi ma'lumotlarni diskda samarali saqlash va qidirish", "Faqat xotirada tez qidirish"], "correct_index": 2, "explanation": "B-daraxtlar katta hajmdagi ma'lumotlarni diskda (yoki boshqa ikkilamchi xotira qurilmalarida) samarali saqlash va qidirish uchun mo'ljallangan."}, {"question": "Kichik daraxt yoki qism daraxt (sub tree) tugunlari sifatida qaysi tugunlar olinadi?", "options": ["Faqat berilgan tugunning farzandlari", "Faqat berilgan tugunning ota-onasi", "Faqat berilgan tugunning aka-ukalari", "Berilgan tugun va uning barcha avlodlari"], "correct_index": 3  #, "explanation": "Kichik daraxt (subtree) berilgan tugun va uning barcha avlodlaridan tashkil topgan daraxt qismidir."}, {"question": "AVL daraxtining muvozanatlashganlik sharti (Balance Factor) qanday aniqlanadi?", "options": ["Chap kichik daraxt balandligi minus o'ng kichik daraxt balandligi", "Tugunning ota-onasi soni", "Tugunning farzandlari soni", "O'ng kichik daraxt balandligi minus chap kichik daraxt balandligi"], "correct_index": 0, "explanation": "AVL daraxtida Balance Factor (BF) chap kichik daraxt balandligi va o'ng kichik daraxt balandligi o'rtasidagi farq sifatida aniqlanadi."}, {"question": "Ikkilik qidiruv daraxtida (Binary Search Tree) qidirish murakkabligi eng yomon holatda qanday?", "options": ["O(n)", "O(1)", "O(log n)", "O(n log n)"], "correct_index": 0, "explanation": "Ikkilik qidiruv daraxtida eng yomon holatda (daraxt chiziqli bo'lganda) qidirish murakkabligi O(n) ga teng bo'ladi."}, {"question": "Agar daraxt right-left (o'ng-chap) og'ish holatida bo'lsa bunday daraxtni muvozanatga keltirishda uni qaysi tomonga aylantiriladi?", "options": ["Faqat chapga", "Faqat o'ngga", "Avval o'ng farzandni chapga, keyin ildizni o'ngga", "Avval chap farzandni o'ngga, keyin ildizni chapga"], "correct_index": 2, "explanation": "Right-Left (RL) og'ish holatida avval o'ng farzandni chapga (Left Rotation), keyin ildizni o'ngga (Right Rotation) aylantirish kerak bo'ladi."}, {"question": "ToвЂliq grafda 5 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["15", "5", "10", "20"], "correct_index": 2, "explanation": "To'liq grafdagi qirralar sonini topish formulasi n * (n - 1) / 2. N=5 bo'lsa, 5 * (5 - 1) / 2 = 5 * 4 / 2 = 10 ta qirra bo'ladi."}, {"question": "BFS algoritmi qaysi maвЂ™lumot tuzilmasiga asoslanadi?", "options": ["Navbat (Queue)", "Stek (Stack)", "Ro'yxat (List)", "Daraxt (Tree)"], "correct_index": 0, "explanation": "BFS (Kenglik bo'yicha qidiruv) algoritmi navbat (Queue) ma'lumot tuzilmasiga asoslanadi."}, {"question": "Daraxtda farzandga ega boвЂlmagan tugunlar qanday nomlanadi?", "options": ["Ota tugunlar (Parent nodes)", "Ildiz tugunlar (Root nodes)", "Ichki tugunlar (Internal nodes)", "Barg tugunlar (Leaf nodes)"], "correct_index": 3, "explanation": "Farzandga ega bo'lmagan tugunlar barg tugunlar (leaf nodes) deb ataladi."}, {"question": "QoвЂshnichilik roвЂyxati (adjacency list) nimani bildiradi?", "options": ["Har bir tugun uchun uning qo'shnilarining ro'yxati", "Grafdagi barcha tugunlar ro'yxati", "Grafdagi barcha qirralar ro'yxati", "Grafning og'irliklari ro'yxati"], "correct_index": 0, "explanation": "Qo'shnichilik ro'yxati har bir tugun uchun uning bevosita qo'shni tugunlari ro'yxatini saqlaydi."}, {"question": "Daraxtda tanlangan tugunnning balandligi (height) nimaga teng?", "options": ["Ildizdan ushbu tugungacha bo'lgan yo'lning qirralar soni", "Ushbu tugunning farzandlari soni", "Ushbu tugunning ota-onasi soni", "Ushbu tugundan eng uzoqdagi barg tugungacha bo'lgan eng uzun yo'lning qirralar soni"], "correct_index": 3, "explanation": "Tugunning balandligi (height) ushbu tugundan eng uzoqdagi barg tugungacha bo'lgan eng uzun yo'lning qirralar soniga teng."}, {"question": "Agar grafdagi A tugun B, C va D tugunlar bilan qirralar orqali tutashgan boвЂlsa A tugunning darajasi nechchiga teng?", "options": ["4", "3", "2", "1"], "correct_index": 1, "explanation": "A tugun B, C va D tugunlar bilan bog'langanligi sababli, unga tutashgan qirralar soni 3 ta bo'ladi, demak darajasi 3 ga teng."}, {"question": "MaКјlumotlar yaxlitligi (data integrity) ning necha xil turi bor?", "options": ["2", "3", "4", "5"], "correct_index": 2, "explanation": "Ma'lumotlar yaxlitligining to'rt xil turi mavjud: Entity Integrity, Referential Integrity, Domain Integrity va User-Defined Integrity."}, {"question": "YoвЂnaltirilmagan grafda qirra nimani bildiradi?", "options": ["Ikki tugun orasidagi ikki tomonlama aloqa", "Grafning darajasi", "Tugunning og'irligi", "Bir tugundan ikkinchisiga yo'nalish"], "correct_index": 0, "explanation": "Yo'naltirilmagan grafda qirra ikki tugun orasidagi ikki tomonlama al  $oqani ifodalaydi, ya'ni aloqa har ikki yo'nalishda ham mavjud."}, {"question": "Agar tugunning chap farzandining balandligi 3 va o'ng farzandining balandligi 1 bo'lsa, Balans Faktori (Balance Factor) nechaga teng?", "options": ["0", "-2", "1", "2"], "correct_index": 3, "explanation": "Balance Factor = chap farzand balandligi - o'ng farzand balandligi = 3 - 1 = 2."}, {"question": "Grafda BFS va DFS algoritmlarining xotira murakkabligi nimaga bogвЂliq?", "options": ["Grafning yo'nalishiga", "Qirralar soniga", "Grafning og'irliklariga", "Tugunlar soniga"], "correct_index": 3, "explanation": "BFS va DFS algoritmlarining xotira murakkabligi asosan grafdagi tugunlar soniga (V) bog'liq, chunki ular navbatda yoki stekda saqlanadi (eng yomon holatda O(V))."}, {"question": "AVL daraxtda Balance Factor (BF) qiymati qanday hisoblab topiladi?", "options": ["O'ng kichik daraxt balandligi - Chap kichik daraxt balandligi", "Tugunning ota-onasi soni", "Chap kichik daraxt balandligi - O'ng kichik daraxt balandligi", "Tugunning farzandlari soni"], "correct_index": 2, "explanation": "Balance Factor (BF) chap kichik daraxt balandligidan o'ng kichik daraxt balandligini ayirish orqali hisoblanadi."}, {"question": "Daraxt tuzilmasida o'lcham nima?", "options": ["Daraxtning ildizi", "Daraxtning balandligi", "Daraxtdagi qirralar soni", "Daraxtdagi tugunlar soni"], "correct_index": 3, "explanation": "Daraxt tuzilmasida o'lcham (size) daraxtdagi tugunlar sonini bildiradi."}, {"question": "B daraxtda tugun kalit(qiymat) lar bilan to'lib qolganda (2t-1 ta kalit) qanday amal bajariladi?", "options": ["Tugunni birlashtirish", "Tugunni bo'lish (split)", "Tugunni aylantirish", "Tugunni o'chirish"], "correct_index": 1, "explanation": "B-daraxtda tugun maksimal kalitlar soniga (2t-1) yetganda, u ikkita yangi tugunga bo'linadi (split)."}, {"question": "DFS algoritmi rekursiv tarzda bajarilganda qaysi maвЂ™lumot tuzilmasi bilvosita ishlatiladi?", "options": ["Xesh jadvali (Hash table)", "Navbat (Queue)", "Stek (Stack)", "Ro'yxat (List)"], "correct_index": 2, "explanation": "DFS (Chuqurlik bo'yicha qidiruv) algoritmi rekursiv tarzda bajarilganda, rekursiya chaqiruvlari stek (Stack) ma'lumot tuzilmasida saqlanadi."}, {"question": "Sath yoki chuqurlik (ing. level yoki depth) nima?", "options": ["Ildizdan berilgan tugungacha bo'lgan yo'lning qirralar soni", "Tugunning ota-onasi soni", "Tugunning farzandlari soni", "Tugundan eng uzoqdagi barg tugungacha bo'lgan yo'lning qirralar soni"], "correct_index": 0, "explanation": "Sath yoki chuqurlik (level/depth) ildizdan berilgan tugungacha bo'lgan yo'lning qirralar soniga teng."}, {"question": "AVL daraxtda tugun muvozanatlangan hisoblanishi uchun uning Balance Factor (BF) qiymati qanday bo'lishi kerak?", "options": ["Faqat 0", "Faqat -1 yoki 1", "Har qanday butun son", "-1, 0 yoki 1"], "correct_index": 3, "explanation": "AVL daraxtida tugun muvozanatlangan hisoblanishi uchun uning Balance Factor qiymati -1, 0 yoki 1 bo'lishi kerak."}, {"question": "Agar daraxtda ikki tugun qirra orqali bogвЂlangan boвЂlsa, yuqoridagi tugun qanday nomlanadi?", "options": ["Ildiz (Root)", "Aka-uka (Sibling)", "Ota (Parent)", "Farzand (Child)"], "correct_index": 2, "explanation": "Daraxtda ikki tugun qirra orqali bog'langan bo'lsa, yuqoridagi tugun ota (parent) deb ataladi."}, {"question": "Daraxtda avlod (descendant) deb qaysi tugunlarga aytiladi?", "options": ["Berilgan tugun bilan bir xil sathda joylashgan tugunlar", "Berilgan tugunning aka-ukalari", "Berilgan tugundan barg tugunlarga qarab yo'l bo'ylab joylashgan barcha tugunlar", "Berilgan tugunning ota-onasi"], "correct_index": 2, "explanation": "Avlod (descendant) deb, berilgan tugundan barg tugunlarga qarab yo'l bo'ylab joylashgan barcha tugunlarga aytiladi."}, {"question": "Quyida berilgan grafda BFS yordamida A dan F gacha eng qisqa yo'l uzunligi (qirralar soni) qancha? AвЂ“B, AвЂ“C, BвЂ“D, CвЂ“E, DвЂ“F, EвЂ“F", "options": ["4", "5", "3", "2"], "correct_index": 2, "explanation": "A dan F gacha eng qisqa yo'l: A-B-D-F (3 qirra) yoki A-C-E-F (3 qirra). Ikkala holatda ham u  %zunlik 3 ga teng."}, {"question": "Qo'shnilik ro'yxati (adjacency list) sifatida berilgan V tugun va E qirrali grafda BFS ning vaqt murakkabligi qanday?", "options": ["O(V + E)", "O(E*E)", "O(V)", "O(V*V)"], "correct_index": 0, "explanation": "Qo'shnilik ro'yxati bilan berilgan grafda BFS ning vaqt murakkabligi O(V + E) ga teng, bu yerda V tugunlar soni, E esa qirralar soni."}, {"question": "Agar daraxt right-right (o'ng-o'ng) og'ish holatida bo'lsa bunday daraxtni muvozanatga keltirishda uni qaysi tomonga aylantiriladi?", "options": ["Avval chapga, keyin o'ngga", "O'ngga aylantirish", "Chapga aylantirish", "Avval o'ngga, keyin chapga"], "correct_index": 2, "explanation": "Right-Right (RR) og'ish holatida daraxtni chapga (Left Rotation) aylantirish orqali muvozanat tiklanadi."}, {"question": "B-daraxtning tartibi (minimum degree) t bo'lsa, ildizdan tashqari har bir tugundagi minimal kalitlar soni qancha?", "options": ["t", "2t - 1", "t - 1", "2t"], "correct_index": 2, "explanation": "B-daraxtning tartibi t bo'lsa, ildizdan tashqari har bir tugunda kamida t-1 ta kalit bo'lishi kerak."}, {"question": "Daraxtda qaysi tugun \"Ildiz\" (root) deb ataladi?", "options": ["Eng pastki tugun", "Farzand tugunlari bo'lmagan tugun", "Hech qanday ota tugunga ega bo'lmagan tugun", "Eng ko'p farzandga ega tugun"], "correct_index": 2, "explanation": "Ildiz (root) deb, daraxtning eng yuqorisida joylashgan va hech qanday ota tugunga ega bo'lmagan tugunga aytiladi."}, {"question": "Daraxtda har qanday ikki tugun orasida nechta yoвЂl mavjud?", "options": ["Ikkita", "Cheksiz ko'p", "Faqat bitta", "Yo'l bo'lmasligi ham mumkin"], "correct_index": 2, "explanation": "Daraxtning asosiy xususiyatlaridan biri shundaki, unda har qanday ikki tugun orasida faqat bitta noyob yo'l mavjud."}, {"question": "ToвЂliq graf nima?", "options": ["Og'irlikli graf", "Barcha tugunlar bir-biri bilan bog'langan graf", "Yo'naltirilgan graf", "Faqat bitta tugun boshqalar bilan bog'langan graf"], "correct_index": 1, "explanation": "To'liq graf (complete graph) deb, har bir tugun boshqa har bir tugun bilan qirra orqali bog'langan grafga aytiladi."}, {"question": "Agar daraxt left-left (chap-chap) og'ish holatida bo'lsa bunday daraxtni muvozanatga keltirishda uni qaysi tomonga aylantiriladi?", "options": ["Avval chapga, keyin o'ngga", "Chapga aylantirish", "O'ngga aylantirish", "Avval o'ngga, keyin chapga"], "correct_index": 2, "explanation": "Left-Left (LL) og'ish holatida daraxtni o'ngga (Right Rotation) aylantirish orqali muvozanat tiklanadi."}, {"question": "ToвЂliq grafda 6 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["12", "15", "30", "6"], "correct_index": 1, "explanation": "To'liq grafdagi qirralar sonini topish formulasi n * (n - 1) / 2. N=6 bo'lsa, 6 * (6 - 1) / 2 = 6 * 5 / 2 = 15 ta qirra bo'ladi."}, {"question": "Qanday daraxtni biz \"To'liq binar daraxt\" deb ataymiz?", "options": ["Barcha barg tugunlari bir xil sathda joylashgan daraxt", "Har bir tugun maksimal ikkita farzandga ega bo'lgan daraxt", "Har bir tugun kamida bitta farzandga ega bo'lgan daraxt", "Har bir ichki tugun ikkita farzandga ega bo'lgan va barcha barg tugunlari bir xil sathda joylashgan daraxt"], "correct_index": 3, "explanation": "To'liq binar daraxt (Full Binary Tree) deb, har bir ichki tugun ikkita farzandga ega bo'lgan va barcha barg tugunlari bir xil sathda joylashgan daraxtga aytiladi."}, {"question": "Qanday daraxtni biz Binar daraxt deb ataymiz?", "options": ["Har bir tugun maksimal ikkita farzandga ega bo'lgan daraxt", "Har bir tugun faqat bitta farzandga ega bo'lgan daraxt", "Barcha barg tugunlari bir xil sathda joylashgan daraxt", "Har bir tugun bir nechta farzandga ega bo'lgan daraxt"], "correct_index": 0, "explanation": "Binar daraxt deb, har bir tugun maksimal ikkita farzandga (chap va o'ng) ega bo'lgan daraxtga aytiladi."}, {"question": "AVL daraxtida qidirish operatsiyasining vaqt murakkabligi (Time Complexity) qancha?", "options": ["O(1)", "O(n log n)", "O(log n)", "O(n)"], "correct_index": 2, "explanation": "AVL daraxti muvozanatlanganligi sabab    li, qidirish operatsiyasining vaqt murakkabligi O(log n) ga teng."}, {"question": "Agar daraxtda 8 ta tugun mavjud bo'lsa uning Pryufer kodi uzunligi nechchiga teng boвЂladi?", "options": ["9", "8", "6", "7"], "correct_index": 2, "explanation": "Pryufer kodi uzunligi n - 2 formulasi bo'yicha hisoblanadi. 8 ta tugun bo'lsa, 8 - 2 = 6 ga teng."}, {"question": "Labirintdan chiqish yoвЂlini topish uchun qaysi algoritmdan foydalaniladi?", "options": ["Prim", "Dijkstra", "DFS", "BFS"], "correct_index": 3, "explanation": "Labirintdan chiqish yo'lini topish uchun BFS (eng qisqa yo'lni topish uchun) yoki DFS (shunchaki yo'l topish uchun) algoritmlaridan foydalanish mumkin. BFS eng qisqa yo'lni topishda samarali."}, {"question": "B-daraxtda qidiruv (search) amali qanday vaqt murakkabligiga ega?", "options": ["O(1)", "O(n)", "O(n log n)", "O(log n)"], "correct_index": 3, "explanation": "B-daraxtda qidiruv amali O(log n) vaqt murakkabligiga ega, chunki u muvozanatlangan daraxt tuzilmasidir."}, {"question": "AVL daraxti qanday turdagi daraxt hisoblanadi?", "options": ["Umumiy daraxt", "O'z-o'zidan muvozanatlashadigan ikkilik qidiruv daraxti", "Ko'p farzandli daraxt", "Oddiy ikkilik qidiruv daraxti"], "correct_index": 1, "explanation": "AVL daraxti o'z-o'zidan muvozanatlashadigan ikkilik qidiruv daraxti bo'lib, har bir tugun uchun chap va o'ng kichik daraxtlarning balandlik farqi maksimal 1 ga teng bo'ladi."}, {"question": "Qanday tugunlarni biz aka-uka tugunlar (ing. siblings) deb ataymiz?", "options": ["Bir xil ota tugunga ega bo'lgan tugunlar", "Bir-biriga qo'shni bo'lgan tugunlar", "Bir xil sathda joylashgan tugunlar", "Bir xil balandlikka ega bo'lgan tugunlar"], "correct_index": 0, "explanation": "Aka-uka tugunlar (siblings) deb, bir xil ota tugunga ega bo'lgan tugunlarga aytiladi."}, {"question": "Grafni toвЂliq tekshirish uchun qaysi algoritmlardan foydalanamiz?", "options": ["Floyd-Warshall va Ford-Fulkerson", "Dijkstra va Prim", "Kruskal va Bellman-Ford", "BFS va DFS"], "correct_index": 3, "explanation": "Grafni to'liq tekshirish (traversal) uchun kenglik bo'yicha qidiruv (BFS) va chuqurlik bo'yicha qidiruv (DFS) algoritmlaridan foydalaniladi."}, {"question": "AVL daraxtiga yangi tugun qo'shilganda muvozanat buzilsa, maksimal necha turdagi aylantirish (rotation) ishlatilishi mumkin?", "options": ["4", "1", "2", "3"], "correct_index": 0, "explanation": "AVL daraxtida muvozanatni tiklash uchun to'rt turdagi aylantirish (LL, RR, LR, RL) ishlatilishi mumkin. Har bir muvozanat buzilishi uchun maksimal bitta yoki ikkita aylantirish (single or double rotation) kerak bo'ladi."}, {"question": "OgвЂirlikli graf nima?", "options": ["Faqat yo'naltirilgan qirralarga ega graf", "Tsikllarga ega bo'lmagan graf", "Barcha tugunlari bir-biri bilan bog'langan graf", "Qirralariga qiymatlar berilgan graf"], "correct_index": 3, "explanation": "Og'irlikli graf deb, qirralariga ma'lum bir qiymatlar (og'irliklar) berilgan grafga aytiladi."}, {"question": "ToвЂliq grafda 4 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["6", "8", "12", "4"], "correct_index": 0, "explanation": "To'liq grafdagi qirralar sonini topish formulasi n * (n - 1) / 2. N=4 bo'lsa, 4 * (4 - 1) / 2 = 4 * 3 / 2 = 6 ta qirra bo'ladi."}, {"question": "QoвЂshnilik matritsasi bilan berilgan grafda BFS ning vaqt murakkabligi qanday?", "options": ["O(V + E)", "O(V^2)", "O(E)", "O(V log V)"], "correct_index": 1, "explanation": "Qo'shnilik matritsasi bilan berilgan grafda BFS ning vaqt murakkabligi O(V^2) ga teng, chunki har bir tugun uchun barcha V tugunlarni tekshirish kerak bo'ladi."}, {"question": "Agar daraxt left-right (chap-o'ng) og'ish holatida bo'lsa bunday daraxtni muvozanatga keltirishda uni qaysi tomonga aylantiriladi?", "options": ["Avval chap farzandni o'ngga, keyin ildizni chapga", "Faqat o'ngga", "Faqat chapga", "Avval o'ng farzandni chapga, keyin ildizni o'ngga"], "correct_index": 0, "explanation": "Left-Right (LR) og'ish holatida avval chap farzandni o'ngga (Right Rotation), keyin ildizni chapga (Left Rotation) aylantirish kerak bo'ladi."}]}jџ®  'irralar mavjud boвЂladi?", "options": ["10", "20", "5", "15"], "correct_index": 0, "explanation": "To'liq grafdagi qirralar sonini topish formulasi n * (n - 1) / 2. N=5 bo'lsa, 5 * (5 - 1) / 2 = 5 * 4 / 2 = 10 ta qirra bo'ladi."}, {"question": "Daraxtda tanlangan tugunnning balandligi (height) nimaga teng?", "options": ["Ushbu tugunning ota-onasi soni", "Ushbu tugundan eng uzoqdagi barg tugungacha bo'lgan eng uzun yo'lning qirralar soni", "Ushbu tugunning farzandlari soni", "Ildizdan ushbu tugungacha bo'lgan yo'lning qirralar soni"], "correct_index": 1, "explanation": "Tugunning balandligi (height) ushbu tugundan eng uzoqdagi barg tugungacha bo'lgan eng uzun yo'lning qirralar soniga teng."}, {"question": "Daraxtda har qanday ikki tugun orasida nechta yoвЂl mavjud?", "options": ["Cheksiz ko'p", "Faqat bitta", "Yo'l bo'lmasligi ham mumkin", "Ikkita"], "correct_index": 1, "explanation": "Daraxtning asosiy xususiyatlaridan biri shundaki, unda har qanday ikki tugun orasida faqat bitta noyob yo'l mavjud."}, {"question": "B-daraxtning asosiy maqsadi nima?", "options": ["Katta hajmdagi ma'lumotlarni diskda samarali saqlash va qidirish", "Kichik ma'lumotlar to'plamlarini boshqarish", "Faqat xotirada tez qidirish", "Graf algoritmlarini optimallashtirish"], "correct_index": 0, "explanation": "B-daraxtlar katta hajmdagi ma'lumotlarni diskda (yoki boshqa ikkilamchi xotira qurilmalarida) samarali saqlash va qidirish uchun mo'ljallangan."}, {"question": "Agar grafdagi A tugun B, C va D tugunlar bilan qirralar orqali tutashgan boвЂlsa A tugunning darajasi nechchiga teng?", "options": ["3", "2", "4", "1"], "correct_index": 0, "explanation": "A tugun B, C va D tugunlar bilan bog'langanligi sababli, unga tutashgan qirralar soni 3 ta bo'ladi, demak darajasi 3 ga teng."}, {"question": "AVL daraxtida eng kichik element qayerda joylashgan bo'ladi?", "options": ["Ildiz tugun", "Har qanday joyda bo'lishi mumkin", "Eng o'ngdagi barg tugun", "Eng chapdagi barg tugun"], "correct_index": 3, "explanation": "AVL daraxti ikkilik qidiruv daraxti bo'lganligi sababli, eng kichik element har doim eng chapdagi barg tugunda joylashgan bo'ladi."}, {"question": "Agar daraxt right-right (o'ng-o'ng) og'ish holatida bo'lsa bunday daraxtni muvozanatga keltirishda uni qaysi tomonga aylantiriladi?", "options": ["Avval chapga, keyin o'ngga", "O'ngga aylantirish", "Avval o'ngga, keyin chapga", "Chapga aylantirish"], "correct_index": 3, "explanation": "Right-Right (RR) og'ish holatida daraxtni chapga (Left Rotation) aylantirish orqali muvozanat tiklanadi."}, {"question": "YoвЂnaltirilgan graf nima?", "options": ["Har bir tugun boshqa barcha tugunlar bilan bog'langan graf", "Barcha qirralari og'irlikka ega bo'lgan graf", "Qirralari yo'nalishga ega bo'lgan graf", "Tsikllarga ega bo'lmagan graf"], "correct_index": 2, "explanation": "Yo'naltirilgan graf (directed graph) deb, qirralari ma'lum bir yo'nalishga ega bo'lgan grafga aytiladi."}, {"question": "Agar daraxtda 10 ta tugun mavjud bo'lsa uning Pryufer kodi uzunligi nechchiga teng boвЂladi?", "options": ["11", "9", "8", "10"], "correct_index": 2, "explanation": "Pryufer kodi uzunligi n - 2 formulasi bo'yicha hisoblanadi. 10 ta tugun bo'lsa, 10 - 2 = 8 ga teng."}, {"question": "BFS algoritmi qaysi maвЂ™lumot tuzilmasiga asoslanadi?", "options": ["Navbat (Queue)", "Stek (Stack)", "Ro'yxat (List)", "Daraxt (Tree)"], "correct_index": 0, "explanation": "BFS (Kenglik bo'yicha qidiruv) algoritmi navbat (Queue) ma'lumot tuzilmasiga asoslanadi."}, {"question": "Agar B daraxtdagi tugunda n ta kalit bo'lsa, shu tugunning farzandlari soni nechta bo'ladi?", "options": ["n + 1", "2n", "n - 1", "n"], "correct_index": 0, "explanation": "B-daraxtda tugundagi kalitlar soni n bo'lsa, uning farzandlari soni n + 1 ga teng bo'ladi."}, {"question": "B-daraxtning tartibi (minimum degree) t bo'lsa, ildizdan tashqari har bir tugundagi minimal kalitlar soni qancha?", "options": ["2t", "2t - 1", "t - 1", "t"], "correct_index": 2, "explanation": "B-daraxtning tartibi t bo'lsa, ildizdan tashqari har bir tugunda kamida t-1 ta kalit bo'lishi   (kerak."}, {"question": "AVL daraxtidan tugunni o'chirish (Deletion) murakkabligi qancha?", "options": ["O(n)", "O(1)", "O(log n)", "O(n log n)"], "correct_index": 2, "explanation": "AVL daraxtidan tugunni o'chirish operatsiyasining vaqt murakkabligi O(log n) ga teng."}, {"question": "Qanday tugunlarni biz aka-uka tugunlar (ing. siblings) deb ataymiz?", "options": ["Bir xil balandlikka ega bo'lgan tugunlar", "Bir xil sathda joylashgan tugunlar", "Bir-biriga qo'shni bo'lgan tugunlar", "Bir xil ota tugunga ega bo'lgan tugunlar"], "correct_index": 3, "explanation": "Aka-uka tugunlar (siblings) deb, bir xil ota tugunga ega bo'lgan tugunlarga aytiladi."}, {"question": "B-daraxtning tartibi t bo'lsa, tugundagi maksimal kalitlar soni qanday formula bilan aniqlanadi?", "options": ["t", "t - 1", "2t", "2t - 1"], "correct_index": 3, "explanation": "B-daraxtning tartibi t bo'lsa, tugundagi maksimal kalitlar soni 2t - 1 formulasi bilan aniqlanadi."}, {"question": "Agar daraxtda 8 ta tugun mavjud bo'lsa uning Pryufer kodi uzunligi nechchiga teng boвЂladi?", "options": ["6", "9", "7", "8"], "correct_index": 0, "explanation": "Pryufer kodi uzunligi n - 2 formulasi bo'yicha hisoblanadi. 8 ta tugun bo'lsa, 8 - 2 = 6 ga teng."}, {"question": "AVL daraxti qanday turdagi daraxt hisoblanadi?", "options": ["O'z-o'zidan muvozanatlashadigan ikkilik qidiruv daraxti", "Oddiy ikkilik qidiruv daraxti", "Umumiy daraxt", "Ko'p farzandli daraxt"], "correct_index": 0, "explanation": "AVL daraxti o'z-o'zidan muvozanatlashadigan ikkilik qidiruv daraxti bo'lib, har bir tugun uchun chap va o'ng kichik daraxtlarning balandlik farqi maksimal 1 ga teng bo'ladi."}, {"question": "Grafning darajasi (degree) nimani bildiradi?", "options": ["Tugunga tutashgan qirralar soni", "Grafdagi qirralar soni", "Tugunning og'irligi", "Grafdagi tugunlar soni"], "correct_index": 0, "explanation": "Grafning darajasi (degree) tugunga tutashgan qirralar sonini bildiradi."}, {"question": "ToвЂliq grafda 4 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["8", "4", "6", "12"], "correct_index": 2, "explanation": "To'liq grafdagi qirralar sonini topish formulasi n * (n - 1) / 2. N=4 bo'lsa, 4 * (4 - 1) / 2 = 4 * 3 / 2 = 6 ta qirra bo'ladi."}, {"question": "Tugunni bo'lish paytida qaysi kalit yuqoriga (ota tugunga) ko'tariladi?", "options": ["Tasodifiy kalit", "Eng kichik kalit", "Eng katta kalit", "O'rtadagi kalit"], "correct_index": 3, "explanation": "Tugunni bo'lish paytida o'rtadagi kalit yuqoriga, ya'ni ota tugunga ko'tariladi, qolgan kalitlar esa ikkita yangi tugunga taqsimlanadi."}, {"question": "Daraxtda avlod (descendant) deb qaysi tugunlarga aytiladi?", "options": ["Berilgan tugunning aka-ukalari", "Berilgan tugundan barg tugunlarga qarab yo'l bo'ylab joylashgan barcha tugunlar", "Berilgan tugunning ota-onasi", "Berilgan tugun bilan bir xil sathda joylashgan tugunlar"], "correct_index": 1, "explanation": "Avlod (descendant) deb, berilgan tugundan barg tugunlarga qarab yo'l bo'ylab joylashgan barcha tugunlarga aytiladi."}, {"question": "QoвЂshnichilik roвЂyxati (adjacency list) nimani bildiradi?", "options": ["Har bir tugun uchun uning qo'shnilarining ro'yxati", "Grafdagi barcha qirralar ro'yxati", "Grafning og'irliklari ro'yxati", "Grafdagi barcha tugunlar ro'yxati"], "correct_index": 0, "explanation": "Qo'shnichilik ro'yxati har bir tugun uchun uning bevosita qo'shni tugunlari ro'yxatini saqlaydi."}, {"question": "Agar daraxt right-left (o'ng-chap) og'ish holatida bo'lsa bunday daraxtni muvozanatga keltirishda uni qaysi tomonga aylantiriladi?", "options": ["Avval o'ng farzandni chapga, keyin ildizni o'ngga", "Avval chap farzandni o'ngga, keyin ildizni chapga", "Faqat chapga", "Faqat o'ngga"], "correct_index": 0, "explanation": "Right-Left (RL) og'ish holatida avval o'ng farzandni chapga (Left Rotation), keyin ildizni o'ngga (Right Rotation) aylantirish kerak bo'ladi."}, {"question": "AVL daraxtining muvozanatlashganlik sharti (Balance Factor) qanday aniqlanadi?", "options": ["Chap kichik daraxt balandligi minus o'ng kichik daraxt balandligi", "O'ng ki  )chik daraxt balandligi minus chap kichik daraxt balandligi", "Tugunning ota-onasi soni", "Tugunning farzandlari soni"], "correct_index": 0, "explanation": "AVL daraxtida Balance Factor (BF) chap kichik daraxt balandligi va o'ng kichik daraxt balandligi o'rtasidagi farq sifatida aniqlanadi."}, {"question": "Agar tugunning chap farzandining balandligi 3 va o'ng farzandining balandligi 1 bo'lsa, Balans Faktori (Balance Factor) nechaga teng?", "options": ["1", "0", "2", "-2"], "correct_index": 2, "explanation": "Balance Factor = chap farzand balandligi - o'ng farzand balandligi = 3 - 1 = 2."}, {"question": "Qanday daraxtni biz \"To'liq binar daraxt\" deb ataymiz?", "options": ["Barcha barg tugunlari bir xil sathda joylashgan daraxt", "Har bir tugun kamida bitta farzandga ega bo'lgan daraxt", "Har bir tugun maksimal ikkita farzandga ega bo'lgan daraxt", "Har bir ichki tugun ikkita farzandga ega bo'lgan va barcha barg tugunlari bir xil sathda joylashgan daraxt"], "correct_index": 3, "explanation": "To'liq binar daraxt (Full Binary Tree) deb, har bir ichki tugun ikkita farzandga ega bo'lgan va barcha barg tugunlari bir xil sathda joylashgan daraxtga aytiladi."}, {"question": "Grafni toвЂliq tekshirish uchun qaysi algoritmlardan foydalanamiz?", "options": ["Dijkstra va Prim", "Floyd-Warshall va Ford-Fulkerson", "Kruskal va Bellman-Ford", "BFS va DFS"], "correct_index": 3, "explanation": "Grafni to'liq tekshirish (traversal) uchun kenglik bo'yicha qidiruv (BFS) va chuqurlik bo'yicha qidiruv (DFS) algoritmlaridan foydalaniladi."}, {"question": "OgвЂirlikli graf nima?", "options": ["Qirralariga qiymatlar berilgan graf", "Tsikllarga ega bo'lmagan graf", "Barcha tugunlari bir-biri bilan bog'langan graf", "Faqat yo'naltirilgan qirralarga ega graf"], "correct_index": 0, "explanation": "Og'irlikli graf deb, qirralariga ma'lum bir qiymatlar (og'irliklar) berilgan grafga aytiladi."}, {"question": "AVL daraxtda tugun muvozanatlangan hisoblanishi uchun uning Balance Factor (BF) qiymati qanday bo'lishi kerak?", "options": ["Faqat -1 yoki 1", "Har qanday butun son", "-1, 0 yoki 1", "Faqat 0"], "correct_index": 2, "explanation": "AVL daraxtida tugun muvozanatlangan hisoblanishi uchun uning Balance Factor qiymati -1, 0 yoki 1 bo'lishi kerak."}, {"question": "Agar daraxtda 12 ta tugun mavjud bo'lsa uning Pryufer kodi uzunligi nechchiga teng boвЂladi?", "options": ["10", "13", "12", "11"], "correct_index": 0, "explanation": "Pryufer kodi uzunligi n - 2 formulasi bo'yicha hisoblanadi. 12 ta tugun bo'lsa, 12 - 2 = 10 ga teng."}, {"question": "ToвЂliq grafda 6 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["30", "15", "6", "12"], "correct_index": 1, "explanation": "To'liq grafdagi qirralar sonini topish formulasi n * (n - 1) / 2. N=6 bo'lsa, 6 * (6 - 1) / 2 = 6 * 5 / 2 = 15 ta qirra bo'ladi."}, {"question": "Qo'shnilik ro'yxati (adjacency list) sifatida berilgan V tugun va E qirrali grafda BFS ning vaqt murakkabligi qanday?", "options": ["O(V)", "O(V*V)", "O(V + E)", "O(E*E)"], "correct_index": 2, "explanation": "Qo'shnilik ro'yxati bilan berilgan grafda BFS ning vaqt murakkabligi O(V + E) ga teng, bu yerda V tugunlar soni, E esa qirralar soni."}, {"question": "Daraxt tuzilmasida o'lcham nima?", "options": ["Daraxtning ildizi", "Daraxtdagi qirralar soni", "Daraxtdagi tugunlar soni", "Daraxtning balandligi"], "correct_index": 2, "explanation": "Daraxt tuzilmasida o'lcham (size) daraxtdagi tugunlar sonini bildiradi."}, {"question": "Agar daraxt left-left (chap-chap) og'ish holatida bo'lsa bunday daraxtni muvozanatga keltirishda uni qaysi tomonga aylantiriladi?", "options": ["Avval chapga, keyin o'ngga", "Chapga aylantirish", "O'ngga aylantirish", "Avval o'ngga, keyin chapga"], "correct_index": 2, "explanation": "Left-Left (LL) og'ish holatida daraxtni o'ngga (Right Rotation) aylantirish orqali muvozanat tiklanadi."}, {"question": "Daraxtda ajdod (ancestor) deb qaysi tugunlarga aytiladi?", "options": ["Berilgan tugunning farzandlari", "Berilgan tugun bilan bir xil sathda joylashgan tugunlar", "Berilgan tugunning aka-ukalari",  * "Berilgan tugundan ildizga qarab yo'l bo'ylab joylashgan barcha tugunlar"], "correct_index": 3, "explanation": "Ajdod (ancestor) deb, berilgan tugundan ildizga qarab yo'l bo'ylab joylashgan barcha tugunlarga aytiladi."}, {"question": "QoвЂshnilik matritsasi bilan berilgan grafda BFS ning vaqt murakkabligi qanday?", "options": ["O(E)", "O(V log V)", "O(V + E)", "O(V^2)"], "correct_index": 3, "explanation": "Qo'shnilik matritsasi bilan berilgan grafda BFS ning vaqt murakkabligi O(V^2) ga teng, chunki har bir tugun uchun barcha V tugunlarni tekshirish kerak bo'ladi."}, {"question": "AVL daraxtiga yangi tugun qo'shilganda muvozanat buzilsa, maksimal necha turdagi aylantirish (rotation) ishlatilishi mumkin?", "options": ["4", "1", "3", "2"], "correct_index": 0, "explanation": "AVL daraxtida muvozanatni tiklash uchun to'rt turdagi aylantirish (LL, RR, LR, RL) ishlatilishi mumkin. Har bir muvozanat buzilishi uchun maksimal bitta yoki ikkita aylantirish (single or double rotation) kerak bo'ladi."}, {"question": "OgвЂirlikli graf nimalarni ifodalashi mumkin?", "options": ["Faqat masofa", "Masofa, narx, vaqt, o'tkazish qobiliyati", "Faqat vaqt", "Faqat narx"], "correct_index": 1, "explanation": "Og'irlikli grafdagi qirralarning og'irliklari masofa, narx, vaqt, o'tkazish qobiliyati kabi turli xil qiymatlarni ifodalashi mumkin."}, {"question": "DFS algoritmi rekursiv tarzda bajarilganda qaysi maвЂ™lumot tuzilmasi bilvosita ishlatiladi?", "options": ["Stek (Stack)", "Navbat (Queue)", "Xesh jadvali (Hash table)", "Ro'yxat (List)"], "correct_index": 0, "explanation": "DFS (Chuqurlik bo'yicha qidiruv) algoritmi rekursiv tarzda bajarilganda, rekursiya chaqiruvlari stek (Stack) ma'lumot tuzilmasida saqlanadi."}, {"question": "AVL daraxti va oddiy BST (Binary Search Tree) o'rtasidagi asosiy farq nima?", "options": ["Hech qanday farq yo'q", "AVL daraxti faqat kichikroq ma'lumotlar uchun ishlatiladi, BST esa kattaroq ma'lumotlar uchun", "AVL daraxti faqat yo'naltirilgan, BST esa yo'naltirilmagan", "AVL daraxti o'z-o'zidan muvozanatlashadi, BST esa muvozanatlanmasligi mumkin"], "correct_index": 3, "explanation": "Asosiy farq shundaki, AVL daraxti o'z-o'zidan muvozanatlashadi, bu esa qidirish, qo'shish va o'chirish operatsiyalarining O(log n) vaqt murakkabligini kafolatlaydi. Oddiy BST esa muvozanatlanmagan holatda O(n) murakkablikka ega bo'lishi mumkin."}, {"question": "B-daraxtda barcha barg tugunlar (leaf nodes) qayerda joylashgan bo'lishi kerak?", "options": ["Faqat ildizdan uzoqda", "Turli sathlarda", "Bir xil sathda", "Faqat ildizga yaqin"], "correct_index": 2, "explanation": "B-daraxtning muhim xususiyatlaridan biri shundaki, barcha barg tugunlar bir xil sathda joylashgan bo'lishi kerak."}, {"question": "Quyida berilgan grafda BFS yordamida A dan F gacha eng qisqa yo'l uzunligi (qirralar soni) qancha? AвЂ“B, AвЂ“C, BвЂ“D, CвЂ“E, DвЂ“F, EвЂ“F", "options": ["3", "4", "5", "2"], "correct_index": 0, "explanation": "A dan F gacha eng qisqa yo'l: A-B-D-F (3 qirra) yoki A-C-E-F (3 qirra). Ikkala holatda ham uzunlik 3 ga teng."}, {"question": "Agar daraxt chiziqli (muvozanatlanmagan) bo'lsa qidirish murakkabligi qanday boвЂladi?", "options": ["O(log n)", "O(n log n)", "O(n)", "O(1)"], "correct_index": 2, "explanation": "Agar daraxt chiziqli (muvozanatlanmagan) bo'lsa, u bog'langan ro'yxatga o'xshab qoladi va qidirish murakkabligi O(n) ga teng bo'ladi."}, {"question": "Daraxtda farzandga ega boвЂlmagan tugunlar qanday nomlanadi?", "options": ["Ota tugunlar (Parent nodes)", "Barg tugunlar (Leaf nodes)", "Ichki tugunlar (Internal nodes)", "Ildiz tugunlar (Root nodes)"], "correct_index": 1, "explanation": "Farzandga ega bo'lmagan tugunlar barg tugunlar (leaf nodes) deb ataladi."}, {"question": "Ikkilik qidiruv daraxtida (Binary Search Tree) qidirish murakkabligi o'rtacha holatda qanday?", "options": ["O(1)", "O(n)", "O(log n)", "O(n log n)"], "correct_index": 2, "explanation": "Ikkilik qidiruv daraxtida o'rtacha holatda qidirish murakkabligi O(log n) ga teng bo'ladi."}, {"question": "Grafda BFS va DFS algoritmlarining xotira murakkabligi n  +imaga bogвЂliq?", "options": ["Tugunlar soniga", "Qirralar soniga", "Grafning og'irliklariga", "Grafning yo'nalishiga"], "correct_index": 0, "explanation": "BFS va DFS algoritmlarining xotira murakkabligi asosan grafdagi tugunlar soniga (V) bog'liq, chunki ular navbatda yoki stekda saqlanadi (eng yomon holatda O(V))."}, {"question": "Sath yoki chuqurlik (ing. level yoki depth) nima?", "options": ["Tugunning ota-onasi soni", "Ildizdan berilgan tugungacha bo'lgan yo'lning qirralar soni", "Tugunning farzandlari soni", "Tugundan eng uzoqdagi barg tugungacha bo'lgan yo'lning qirralar soni"], "correct_index": 1, "explanation": "Sath yoki chuqurlik (level/depth) ildizdan berilgan tugungacha bo'lgan yo'lning qirralar soniga teng."}, {"question": "Agar grafdagi F tugun A, B, C va D tugunlar bilan qirralar orqali tutashgan boвЂlsa F tugunning darajasi nechchiga teng?", "options": ["2", "3", "1", "4"], "correct_index": 3, "explanation": "F tugun A, B, C va D tugunlar bilan bog'langanligi sababli, unga tutashgan qirralar soni 4 ta bo'ladi, demak darajasi 4 ga teng."}, {"question": "AVL daraxtini kimlar ixtiro qilgan?", "options": ["Kruskal va Bellman-Ford", "Robert Tarjan", "Dijkstra va Prim", "Adelson-Velsky va Landis"], "correct_index": 3, "explanation": "AVL daraxti 1962 yilda G.M. Adelson-Velsky va E.M. Landis tomonidan ixtiro qilingan."}, {"question": "Qanday daraxtni biz Binar daraxt deb ataymiz?", "options": ["Har bir tugun bir nechta farzandga ega bo'lgan daraxt", "Har bir tugun faqat bitta farzandga ega bo'lgan daraxt", "Barcha barg tugunlari bir xil sathda joylashgan daraxt", "Har bir tugun maksimal ikkita farzandga ega bo'lgan daraxt"], "correct_index": 3, "explanation": "Binar daraxt deb, har bir tugun maksimal ikkita farzandga (chap va o'ng) ega bo'lgan daraxtga aytiladi."}, {"question": "Ikkilik qidiruv daraxtida (Binary Search Tree) qidirish murakkabligi eng yomon holatda qanday?", "options": ["O(n log n)", "O(1)", "O(n)", "O(log n)"], "correct_index": 2, "explanation": "Ikkilik qidiruv daraxtida eng yomon holatda (daraxt chiziqli bo'lganda) qidirish murakkabligi O(n) ga teng bo'ladi."}, {"question": "BFS va DFS ikkala algoritm uchun ham umumiy bo'lgan xususiyat qaysi?", "options": ["Grafni to'liq tekshirish", "Og'irlikli graflarda ishlash", "Eng qisqa yo'lni topish", "Tsikllarni aniqlash"], "correct_index": 0, "explanation": "BFS va DFS algoritmlarining ikkalasi ham grafdagi barcha tugunlarni va qirralarni to'liq tekshirish (traversal) uchun ishlatiladi."}, {"question": "Daraxtda qaysi tugun \"Ildiz\" (root) deb ataladi?", "options": ["Eng ko'p farzandga ega tugun", "Eng pastki tugun", "Farzand tugunlari bo'lmagan tugun", "Hech qanday ota tugunga ega bo'lmagan tugun"], "correct_index": 3, "explanation": "Ildiz (root) deb, daraxtning eng yuqorisida joylashgan va hech qanday ota tugunga ega bo'lmagan tugunga aytiladi."}, {"question": "Agar daraxtda n ta tugun boвЂlsa, unda nechta qirra boвЂladi?", "options": ["n + 1", "2n", "n - 1", "n"], "correct_index": 2, "explanation": "Daraxtda n ta tugun bo'lsa, har doim n - 1 ta qirra bo'ladi."}, {"question": "YoвЂnaltirilmagan grafda qirra nimani bildiradi?", "options": ["Tugunning og'irligi", "Ikki tugun orasidagi ikki tomonlama aloqa", "Grafning darajasi", "Bir tugundan ikkinchisiga yo'nalish"], "correct_index": 1, "explanation": "Yo'naltirilmagan grafda qirra ikki tugun orasidagi ikki tomonlama aloqani ifodalaydi, ya'ni aloqa har ikki yo'nalishda ham mavjud."}, {"question": "Grafda oвЂtish nima?", "options": ["Ikki tugun orasidagi eng qisqa yo'lni topish", "Grafdagi barcha tugunlarni yoki qirralarni bir marta ko'rib chiqish", "Grafga yangi tugun qo'shish", "Grafdan tugunni o'chirish"], "correct_index": 1, "explanation": "Grafda o'tish (traversal) deb, grafdagi barcha tugunlarni yoki qirralarni bir marta tizimli ravishda ko'rib chiqish jarayoniga aytiladi."}, {"question": "Agar daraxtda ikki tugun qirra orqali bogвЂlangan boвЂlsa, pastdagi tugun qanday nomlanadi?", "options": ["Farzand (Child)", "Ota (Parent)", "Aka-uka (Sibling)", "Ildiz (Root)"], "correct_index"    : 0, "explanation": "Daraxtda ikki tugun qirra orqali bog'langan bo'lsa, pastdagi tugun farzand (child) deb ataladi."}, {"question": "Kichik daraxt yoki qism daraxt (sub tree) tugunlari sifatida qaysi tugunlar olinadi?", "options": ["Faqat berilgan tugunning aka-ukalari", "Faqat berilgan tugunning ota-onasi", "Berilgan tugun va uning barcha avlodlari", "Faqat berilgan tugunning farzandlari"], "correct_index": 2, "explanation": "Kichik daraxt (subtree) berilgan tugun va uning barcha avlodlaridan tashkil topgan daraxt qismidir."}, {"question": "Agar daraxt left-right (chap-o'ng) og'ish holatida bo'lsa bunday daraxtni muvozanatga keltirishda uni qaysi tomonga aylantiriladi?", "options": ["Avval o'ng farzandni chapga, keyin ildizni o'ngga", "Faqat o'ngga", "Avval chap farzandni o'ngga, keyin ildizni chapga", "Faqat chapga"], "correct_index": 2, "explanation": "Left-Right (LR) og'ish holatida avval chap farzandni o'ngga (Right Rotation), keyin ildizni chapga (Left Rotation) aylantirish kerak bo'ladi."}, {"question": "BogвЂlangan graf deb qanday graflarga aytiladi?", "options": ["Barcha tugunlari bir-biri bilan bog'langan graf", "Yo'naltirilgan graf", "Har qanday ikki tugun orasida yo'l mavjud bo'lgan graf", "Tsikllarga ega bo'lmagan graf"], "correct_index": 2, "explanation": "Bog'langan graf deb, grafdagi har qanday ikki tugun orasida kamida bitta yo'l mavjud bo'lgan grafga aytiladi."}, {"question": "Agar daraxtda ikki tugun qirra orqali bogвЂlangan boвЂlsa, yuqoridagi tugun qanday nomlanadi?", "options": ["Aka-uka (Sibling)", "Ota (Parent)", "Ildiz (Root)", "Farzand (Child)"], "correct_index": 1, "explanation": "Daraxtda ikki tugun qirra orqali bog'langan bo'lsa, yuqoridagi tugun ota (parent) deb ataladi."}, {"question": "ToвЂliq graf nima?", "options": ["Barcha tugunlar bir-biri bilan bog'langan graf", "Yo'naltirilgan graf", "Og'irlikli graf", "Faqat bitta tugun boshqalar bilan bog'langan graf"], "correct_index": 0, "explanation": "To'liq graf (complete graph) deb, har bir tugun boshqa har bir tugun bilan qirra orqali bog'langan grafga aytiladi."}, {"question": "B daraxtda tugun kalit(qiymat) lar bilan to'lib qolganda (2t-1 ta kalit) qanday amal bajariladi?", "options": ["Tugunni o'chirish", "Tugunni bo'lish (split)", "Tugunni aylantirish", "Tugunni birlashtirish"], "correct_index": 1, "explanation": "B-daraxtda tugun maksimal kalitlar soniga (2t-1) yetganda, u ikkita yangi tugunga bo'linadi (split)."}, {"question": "Graf G = (V, E) da E nimani bildiradi?", "options": ["Qirralar", "Og'irliklar", "Tugunlar", "Yo'nalishlar"], "correct_index": 0, "explanation": "Graf G = (V, E) da V tugunlar (vertices) to'plamini, E esa qirralar (edges) to'plamini bildiradi."}, {"question": "QoвЂshnichilik matritsasi (adjacency matrix) qanday tuziladi?", "options": ["Tugunlarning nomlari ro'yxati", "Faqat 0 va 1 lardan iborat ro'yxat", "Tugunlar soniga teng satr va ustunli matritsa", "Qirralar soniga teng satr va ustunli matritsa"], "correct_index": 2, "explanation": "Qo'shnichilik matritsasi N x N o'lchamli bo'lib, bu yerda N tugunlar soni. Agar (i, j) tugunlar orasida qirra bo'lsa, matritsaning (i, j) elementi 1 (yoki og'irlik), aks holda 0 bo'ladi."}, {"question": "B-daraxtda qidiruv (search) amali qanday vaqt murakkabligiga ega?", "options": ["O(1)", "O(log n)", "O(n)", "O(n log n)"], "correct_index": 1, "explanation": "B-daraxtda qidiruv amali O(log n) vaqt murakkabligiga ega, chunki u muvozanatlangan daraxt tuzilmasidir."}, {"question": "AVL daraxtida qidirish operatsiyasining vaqt murakkabligi (Time Complexity) qancha?", "options": ["O(log n)", "O(n log n)", "O(n)", "O(1)"], "correct_index": 0, "explanation": "AVL daraxti muvozanatlanganligi sababli, qidirish operatsiyasining vaqt murakkabligi O(log n) ga teng."}, {"question": "ToвЂliq grafda tugunlar soniga koвЂra qirralar sonini topish formulasi keltirilgan javobni belgilang.", "options": ["n * (n - 1) / 2", "n * (n + 1) / 2", "n^2", "n - 1"], "correct_index": 0, "explanation": "To'liq grafda n ta tugun bo'lsa, qirralar soni n * (n - 1) / 2 formulasi bilan topiladi."}]}jџ®
