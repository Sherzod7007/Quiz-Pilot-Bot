ect_index": 3, "explanation": "Sunnat va Hadislar Islom shariatining ikkinchi asosiy manbas   в   йect_index": 0, "explanation": "Yahudiylik tarixdan Muso (a.s.) va Ibrohim (a.s.) nomlari bilan chambarchas bog'liq."}, {"question": "Qaysi biri qadimgi milliy din hisoblanadi?", "options": ["Xristianlik", "Shintoizm", "Islom", "Protestantizm"], "correct_index": 1, "explanation": "Shintoizm Yaponiyaning qadimgi va an'anaviy milliy dini hisoblanadi."}, {"question": "Islom nechta asosiy ruknga ega?", "options": ["5 ta", "3 ta", "10 ta", "7 ta"], "correct_index": 0, "explanation": "Islom dini 5 ta asosiy rukndan iborat: Iymon, Namoz, Ro'za, Zakot, Haj."}, {"question": "Dinshunoslikning vazifalaridan biri qaysi?", "options": ["Faqat diniy bayramlarni tashkillashtirish", "Moddiy ishlab chiqarishni oshirish", "Diniy hodisalarni ilmiy va tahliliy o'rganish", "Aholini muayyan dinga o'tkazish"], "correct_index": 2, "explanation": "Diniy hodisalarni ob'ektiv hamda xolis yondashuv asosida tahlil qilish dinshunoslikning asosiy vazifalaridan biridir."}, {"question": "Buddizmning asosiy yoвЂnalishlaridan biri qaysi?", "options": ["Katolik va Pravoslav", "Xinayana va Maxayana", "Sunniylik va Shia", "Iudaizm"], "correct_index": 1, "explanation": "Xinayana (Xeravada) va Maxayana Buddizmning eng yirik yo'nalishlaridir."}, {"question": "Haj ibodati qayerda bajariladi?", "options": ["Qohira shahrida", "Makka shahrida", "Madina shahrida", "Quddus shahrida"], "correct_index": 1, "explanation": "Haj ibodati Makkai Mukarramadagi Ka'ba va uning atrofidagi muqaddas joylarda bajariladi."}, {"question": "Milliy dinlarning asosiy xususiyati?", "options": ["Butun dunyo bo'ylab keng yoyilishi", "Ibodat tili yo'qligi", "Kitoblari yo'qligi", "Faqat ma'lum bir etnik guruh yoki xalq orasida tarqalganligi"], "correct_index": 3, "explanation": "Milliy dinlar asosan bitta etnos yoki xalq doirasida saqlanib qoladi."}, {"question": "Milliy dinlarning paydo boвЂlishiga nima sabab boвЂladi?", "options": ["Siyosiy partiyalar tuzilishi", "Xalqning etnik va madaniy rivojlanish ehtiyojlari", "Xalqaro shartnomalar", "Zamonaviy texnologiyalar"], "correct_index": 1, "explanation": "Milliy dinlar muayyan jamiyat va etnosning shakllanish, urf-odat va madaniy ehtiyojlari natijasida paydo bo'ladi."}, {"question": "Hijrat voqeasi qayerdan qayerga boвЂlgan?", "options": ["Makkadan Quddusga", "Madinadan Makkaga", "Makkadan Madinaga", "Madinadan Shomga"], "correct_index": 2, "explanation": "Hijrat 622-yilda musulmonlarning Makkadan Madinaga ko'chib o'tish voqeasidir."}, {"question": "Hinduizm qaysi mamlakatda shakllangan?", "options": ["Eron", "Yaponiya", "Xitoy", "Hindiston"], "correct_index": 3, "explanation": "Hinduizm dini Hindiston yarimorolida shakllangan va rivojlangan."}, {"question": "Qiyos nimaga asoslanadi?", "options": ["Qur'on va Sunnatdagi oxshash hukmlarni yangi masalaga solishtirish va tatbiq etishga", "Insonning shaxsiy xohishiga", "Tush ko'rishga", "Boshqa dinlar tajribasiga"], "correct_index": 0, "explanation": "Qiyos вЂ“ manbalarda hukmi bo'lmagan masalani sababi bir xil bo'lgan hukmli masalaga solishtirishdir."}, {"question": "Milliy dinlarda marosim va urf-odatlar qanday ahamiyatga ega?", "options": ["Faqat sayyohlar uchun mo'ljallangan", "Hech qanday ahamiyatga ega emas", "Ikkinchi darajali", "Juda yuqori, etnik madaniyat bilan uzviy bog'liq"], "correct_index": 3, "explanation": "Milliy dinlarda marosimlar va urf-odatlar milliylik hamda urf-odatlarni saqlashda muhim o'rin tutadi."}, {"question": "Dinshunoslikning yana bir vazifasi nima?", "options": ["Sog'liqni saqlash tizimini nazorat qilish", "Bag'rikenglik va diniy bag'rikenglik madaniyatini rivojlantirish", "Tadbirkorlikni rivojlantirish", "Siyosiy qarorlarni qabul qilish"], "correct_index": 1, "explanation": "Dinlararo bag'rikenglik va tinch-totuvlikni ta'minlashga ko'maklashish uning muhim vazifasidir."}, {"question": "Hadislarni toвЂplagan mashhur kitoblardan biri?", "options": ["Katta Fiqh", "Al-Jome' as-Sahih (Imom Buxoriy)", "Avesto", "Tavrot"], "correct_index": 1, "explanation": "Imom al-Buxoriyning \"Al-Jome' as-Sahih\" kitobi eng ishonchli hadislar to'plamidir."}, {"question": "Islom   кda kuniga necha mahal namoz oвЂqiladi?", "options": ["5 mahal", "7 mahal", "1 mahal", "3 mahal"], "correct_index": 0, "explanation": "Islomda har bir balog'atga etgan musulmonga kuniga 5 mahal namoz farz qilingan."}, {"question": "Xristianlikning eng koвЂp tarqalgan yoвЂnalishi qaysi?", "options": ["Protestantizm", "Katolik", "Pravoslavie", "Monofizitlik"], "correct_index": 1, "explanation": "Katolitsizm xristianlikning eng ko'p ketma-ket ergashuvchilariga ega bo'lgan yo'nalishidir."}, {"question": "Xristianlikning asoschisi kim?", "options": ["Muso (a.s.)", "Siddxartxa Gautama", "Iso Masih (Iisus Xristos)", "Muhammad (s.a.v.)"], "correct_index": 2, "explanation": "Xristianlik ta'limotining asoschisi va markaziy shaxsiyat Iso Masihdir."}, {"question": "Hinduizmning muqaddas matnlari qaysi?", "options": ["Tavrot", "Avesto", "Vedalar va Upanishadlar", "Injil"], "correct_index": 2, "explanation": "Vedalar, Upanishadlar hamda Mahabharata kabi matnlar Hinduizmning muqaddas kitoblaridir."}, {"question": "Islom fiqhida manbalar nechta asosiy toifaga boвЂlinadi?", "options": ["Yuzta", "Faqat bitta", "O'nta", "Asosiy va qo'shimcha (manbalar)"], "correct_index": 3, "explanation": "Islom fiqhi manbalari asosiy (Qur'on, Sunnat, Ijmo', Qiyos) va qo'shimcha manbalarga bo'linadi."}, {"question": "Hadislar nima?", "options": ["Muhammad (s.a.v.)ning so'zlari va amallari haqidagi rivoyatlar", "Faqat duolar to'plami", "Qadimiy shaqar qonunlari", "Sahobalarning o'z fikrlari"], "correct_index": 0, "explanation": "Hadis вЂ“ Payg'ambarimiz (s.a.v.) so'zlari, amallari va sifatlari haqida yetib kelgan xabardir."}, {"question": "Zakot kimlarga beriladi?", "options": ["Faqat davlat arboblariga", "Boy insonlarga", "Ehtiyojmand va kambag'allarga", "Barcha qarindoshlarga"], "correct_index": 2, "explanation": "Zakot jamiyatdagi muhtoj, kambag'al va belgilangan toifa insonlarga beriladi."}, {"question": "Xristianlik qaysi asrda vujudga kelgan?", "options": ["Miloddan avvalgi V asrda", "Milodiy VII asrda", "Milodiy I asrda", "Milodiy XV asrda"], "correct_index": 2, "explanation": "Xristianlik milodiy I asrda Rim imperiyasining sharqiy qismida paydo bo'lgan."}, {"question": "Zardushtiylikning asoschisi kim?", "options": ["Zardusht (Zoroastr)", "Konfutsiy", "Muso (a.s.)", "Budda"], "correct_index": 0, "explanation": "Zardushtiylik ta'limotining asoschisi va targ'ibotchisi Zardushtdir."}, {"question": "QurвЂ™onda nechta sura bor?", "options": ["100 ta", "150 ta", "114 ta", "66 ta"], "correct_index": 2, "explanation": "Qur'oni Karim 114 ta suradan tashkil topgan."}, {"question": "Milliy dinlar qanday dinlar turiga kiradi?", "options": ["Zamonaviy oqimlar", "Muayyan bir xalq yoki elatga mansub dinlar", "Ateistik ta'limotlar", "Jahon dinlari"], "correct_index": 1, "explanation": "Milliy dinlar muayyan bir xalq yoki millat madaniyati va tarixi bilan chegaralangan dinlardir."}, {"question": "Yahudiylikning asosiy muqaddas kitobi?", "options": ["Qur'on", "Tripitaka", "Tavrot (Tora)", "Zend-Avesto"], "correct_index": 2, "explanation": "Tavrot (Tora) yahudiylikning eng asosiy va muqaddas manbasi hisoblanadi."}, {"question": "Islomda taqiqlangan ichimlik?", "options": ["Sharbatlar", "Choy", "Meyoriy spirtli ichimliklar hamda mast qiluvchi barcha ichimliklar (Xamr)", "Sut"], "correct_index": 2, "explanation": "Islomda mast qiluvchi har qanday ichimlik (xamr) harom va taqiqlangan."}, {"question": "Islom dinida eng muqaddas joy?", "options": ["Ka'ba (Makkai Mukarrama)", "Al-Aqsa masjidi", "Masjid an-Nabaviy", "Umaviy masjidi"], "correct_index": 0, "explanation": "Ka'batulloh Makkadagi eng muqaddas va musulmonlar qiblasi bo'lgan joydir."}, {"question": "QurвЂ™ondan keyingi ikkinchi asosiy manba qaysi?", "options": ["Sunnat (Hadislar)", "Qiyos", "Tafsir", "Ijmo'"], "correct_index": 0, "explanation": "Sunnat va Hadislar Islom shariatining ikkinchi asosiy manbasi sanaladi."}, {"question": "Xristianlik qaysi hududda paydo boвЂlgan?", "options": ["Hindistonda", "Yaqin Sharqda (Falasthin)", "G'arbiy Yevropada", "Markaziy Osiyoda"], "correct_index": 1, "explanation":   л "Xristianlik Yaqin Sharqda, ya'ni Falastin hududida vujudga kelgan."}, {"question": "Iso Masihning tirilish bayrami qanday ataladi?", "options": ["Rojdestvo", "Troitza", "Pasha", "Kresteniye"], "correct_index": 2, "explanation": "Iso Masihning qayta tirilishi sharafiga nishonlanadigan bayram Pasha deb ataladi."}, {"question": "Xristianlikning eng muhim bayramlaridan biri?", "options": ["Pasha (Tirilish bayrami)", "Xanuka", "Qurbon hayiti", "Navro'z"], "correct_index": 0, "explanation": "Pasha (Easter) Xristianlikdagi eng asosiy bayramlardan biri hisoblanadi."}, {"question": "Dinshunoslik nimani oвЂrganadi?", "options": ["Faqatgina tabiat qonunlarini", "Geografik joylashuvlarni", "Siyosiy tuzumlarni", "Dillarning paydo bo'lishi, tarixi va ta'limotlarini"], "correct_index": 3, "explanation": "Dinshunoslik dinlarning kelib chiqishi, tarixi, e'tiqodiy va axloqiy tizimlarini ilmiy jihatdan o'rganadi."}, {"question": "Buddizmning muqaddas kitoblari qaysi nom bilan yuritiladi?", "options": ["Veda", "Avesto", "Bibliya", "Tripitaka (Uch savat)"], "correct_index": 3, "explanation": "Buddizmning muqaddas matnlari to'plami Tripitaka deb ataladi."}, {"question": "Buddizmda qayta tugвЂilish eвЂ™tiqodi qanday ataladi?", "options": ["Nirvana", "Samsara", "Dxarma", "Sutrabitaka"], "correct_index": 1, "explanation": "Qayta tug'ilish zanjiri buddizmda ham Samsara deyiladi."}, {"question": "Muhammad (s.a.v.) qayerda tugвЂilganlar?", "options": ["Madina shahrida", "Makka shahrida", "Quddus shahrida", "Toif shahrida"], "correct_index": 1, "explanation": "Muhammad (s.a.v.) milodiy 570-yilda Makka shahrida tug'ilganlar."}, {"question": "Shinto dini qaysi davlatning milliy dini?", "options": ["Misr", "Hindiston", "Yaponiya", "Xitoy"], "correct_index": 2, "explanation": "Shintoizm Yaponiya xalqining an'anaviy va milliy dini hisoblanadi."}, {"question": "Buddizmning asoschisi kim?", "options": ["Konfutsiy", "Zardusht", "Lao-Tzi", "Siddxartxa Gautama (Budda)"], "correct_index": 3, "explanation": "Buddizm ta'limotiga miloddan avvalgi VI-V asrlarda Siddxartxa Gautama asos solgan."}, {"question": "QurвЂ™on qaysi tilda nozil qilingan?", "options": ["Ibroniy tilda", "Oromiy tilda", "Fors tilda", "Arab tilda"], "correct_index": 3, "explanation": "Qur'oni Karim arab tilida nozil qilingan."}, {"question": "Buddizm qaysi mamlakatda vujudga kelgan?", "options": ["Yaponiya", "Hindiston", "Tailand", "Xitoy"], "correct_index": 1, "explanation": "Buddizm miloddan avvalgi VI asrda Qadimgi Hindistonda paydo bo'lgan."}, {"question": "Musulmonlarning ibodat joyi?", "options": ["Pagoda", "Cherkov", "Sinagoga", "Masjid"], "correct_index": 3, "explanation": "Musulmonlar jamoat bo'lib ibodat qiladigan muqaddas joy Masjid deyiladi."}, {"question": "RoвЂza qaysi oyda tutiladi?", "options": ["Sha'bon oyida", "Muharram oyida", "Ramazon oyida", "Rujab oyida"], "correct_index": 2, "explanation": "Farz bo'lgan ro'za Islom taqvimining Ramazon oyida tutiladi."}, {"question": "Xristianlikning markaziy gвЂoyasi?", "options": ["Dunyo azob-uqubatdan iboratligi", "Iso Masih orqali insoniyatni qutqarish va ilohiy sevgiga tayanish", "Olovga sig'inish", "Etnik ustunlik"], "correct_index": 1, "explanation": "Xristianlik Iso Masihning qurbonligi orqali insoniyatning najot topishi g'oyasiga asoslanadi."}, {"question": "Islom dinining asosiy manbasi qaysi?", "options": ["Hadislar", "Ijmo'", "Qur'oni Karim", "Qiyos"], "correct_index": 2, "explanation": "Islom dinining birinchi va eng asosiy manbasi Qur'oni Karimdir."}, {"question": "Dinshunoslikning yana bir predmeti qaysi?", "options": ["Faqat davlat chegaralari", "Diniy e'tiqod va marosimlar tizimi", "Astronomik hodisalar", "Iqtisodiy krizislar"], "correct_index": 1, "explanation": "Diniy e'tiqodlar, marosimlar hamda diniy tashkilotlar faoliyati uning predmetiga kiradi."}, {"question": "Qaysi milliy din qadimgi Eron xalqi bilan bogвЂliq?", "options": ["Dovosizm", "Sikhizm", "Zardushtiylik", "Konfutsichilik"], "correct_index": 2, "explanation": "Zardushtiylik qadimgi Eron va O'rta Osiyo xalqlari madaniyati va e'tiqodi bilan bog'l   мiq."}, {"question": "Shahodat kalimasining mazmuni nima?", "options": ["Tinchlikka da'vat qilish", "Barcha dinlar teng ekanligini ta'kidlash", "Allohdan o'zga iloh yo'qligi va Muhammad (s.a.v.) Unining elchisi ekanligiga guvohlik berish", "Ibodat vaqtlari haqida xabar berish"], "correct_index": 2, "explanation": "Shahodat kalimasi Islom e'tiqodining kaliti va tavhid va payg'ambarlikni e'tirof etishdir."}, {"question": "Milliy dinlar asosan qayerda tarqalgan boвЂladi?", "options": ["Faqat Yevropada", "Barcha qitalarda teng", "Faqat shahar markazlarida", "Muayyan xalq yashaydigan mintaqada"], "correct_index": 3, "explanation": "Milliy dinlar tegishli etnik guruh va xalq yashaydigan hudud doirasida tarqaladi."}, {"question": "Zardushtiylikning muqaddas kitobi qaysi?", "options": ["Tavrot", "Injil", "Avesto", "Veda"], "correct_index": 2, "explanation": "Avesto zardushtiylik dinining asosiy va muqaddas manbasidir."}, {"question": "Milliy dinlar qaysi din turidan farq qiladi?", "options": ["Iptidoiy e'tiqodlardan", "Qabila dinlaridan", "Jahon dinlaridan", "An'anaviy e'tiqodlardan"], "correct_index": 2, "explanation": "Milliy dinlar baynalminal bo'lmagani bilan barcha xalqlarni qamrab oladigan Jahon dinlaridan farq qiladi."}, {"question": "QurвЂ™on kimga nozil qilingan?", "options": ["Muso (a.s.)ga", "Ibrohim (a.s.)ga", "Iso (a.s.)ga", "Muhammad (s.a.v.)ga"], "correct_index": 3, "explanation": "Qur'oni Karim So'nggi payg'ambar Muhammad (s.a.v.)ga nozil qilingan."}, {"question": "Buddistlarning ibodat joyi qanday ataladi?", "options": ["Pagoda (Ibodathona/Shtupa)", "Sinagoga", "Masjid", "Cherkov"], "correct_index": 0, "explanation": "Buddistlarning diniy majmualari ibodathona, pagoda yoki shtupa deb ataladi."}, {"question": "Buddizmning asosiy amaliyotlaridan biri?", "options": ["Qurbonlik qilish", "Meditatsiya", "Ro'za tutish", "Olovga sig'inish"], "correct_index": 1, "explanation": "Meditatsiya ongni tozalash va ruhiy yuksalish uchun buddizmda asosiy amaliyotdir."}, {"question": "Dinshunoslikning asosiy metodlaridan biri?", "options": ["Fizik tajriba", "Tarixiy-qiyosiy metod", "Kimyoviy analiz", "Matematik modellashtirish"], "correct_index": 1, "explanation": "Tarixiy-qiyosiy metod dinlar rivojlanishi va o'xshashliklarini tahlil qilishda keng qo'llaniladi."}, {"question": "Dinshunoslik qaysi soha bilan chambarchas bogвЂliq?", "options": ["Matematika va kibernetika", "Astronomiya va geografiya", "Fizika va kimyo", "Tarix, falsafa va sotsiologiya"], "correct_index": 3, "explanation": "Dinshunoslik gumanitar va ijtimoiy fanlar, jumladan tarix, falsafa va sotsiologiya bilan yaqin bog'liq."}, {"question": "Dinshunoslikning asosiy maqsadi nimadan iborat?", "options": ["Diniy e'tiqodlarni yo'q qilish", "Muayyan bir dinni targ'ib qilish", "Dinlar haqida ob'ektiv ilmiy bilim berish va bag'rikenglikni shakllantirish", "Faqat qadimgi afsonalarni to'plash"], "correct_index": 2, "explanation": "Asosiy maqsad dinlar to'g'risida ob'ektiv, ilmiy asoslangan bilimlarni shakllantirish va konfessiyalararo bag'rikenglikni ta'minlashdir."}, {"question": "Yahudiylarning asosiy ibodat joyi?", "options": ["Shtupa", "Masiqit", "Ibodathona (Xram)", "Sinagoga"], "correct_index": 3, "explanation": "Yahudiylarning jamoat ibodatini bajaradigan joyi Sinagoga deyiladi."}, {"question": "Xristianlikda \"Muqaddas uchlik\" nimani anglatadi?", "options": ["Uchta farishta", "Tavrot, Injil, Zabur", "Ota-Xudo, O'g'il-Xudo va Muqaddas Ruh", "Muso, Iso, Muhammad"], "correct_index": 2, "explanation": "Muqaddas uchlik (Troitza) Ota, O'g'il va Muqaddas Ruh birligini anglatadi."}, {"question": "Xristianlikning muqaddas kitobi qaysi?", "options": ["Avesto", "Qur'on", "Tavrot", "Injil (Bibliya)"], "correct_index": 3, "explanation": "Xristianlikning muqaddas kitobi Injil (Bibliya) hisoblanadi."}, {"question": "Qaysi din milliy dinlarga misol boвЂla oladi?", "options": ["Buddizm", "Iudaizm (Yahudiylik)", "Islom", "Xristianlik"], "correct_index": 1, "explanation": "Iudaizm muayyan bir millat (yahudiy xalqi) bilan bog'liq bo'lgan milliy dindir."}, {"question": "Hinduizmda     qayta tugвЂilish eвЂ™tiqodi qanday ataladi?", "options": ["Karma", "Kamma", "Samsara (Reinkarnatsiya)", "Nirvana"], "correct_index": 2, "explanation": "Ruhlarning qayta tug'ilish va aylanish zanjiri Samsara deb ataladi."}, {"question": "Zardushtiylikda yaxshilik kuchlari qiroli kim?", "options": ["Mihr", "Anaxita", "Ahriman", "Ahuramazda"], "correct_index": 3, "explanation": "Ahuramazda zardushtiylikda ezgulik va yorug'lik tangrisi hisoblanadi."}, {"question": "Sunnat nimani anglatadi?", "options": ["Faqat Qur'on suralari", "Tarixiy voqealar to'plami", "Muhammad (s.a.v.)ning yo'li, fe'l-atvori va ko'rsatmalari", "Olimlarning shaxsiy fikri"], "correct_index": 2, "explanation": "Sunnat вЂ“ Payg'ambarimiz (s.a.v.)ning aytgan gip gaplari, qilgan amallari va maqullashlaridir."}, {"question": "Islomdagi вЂњhalolвЂќ soвЂzi nimani anglatadi?", "options": ["Shubhali", "Majburiy", "Taqiqlangan, harom", "Ruxsat berilgan, shariatga uyg'un"], "correct_index": 3, "explanation": "Halol вЂ“ Islom shariatida ruxsat berilgan va pok bo'lgan narsa hamda amallardir."}, {"question": "Islomning birinchi farz amali?", "options": ["Zakot berish", "Iymon keltirish (Shahodat)", "Ro'za tutish", "Namoz o'qish"], "correct_index": 1, "explanation": "Islomdagi birinchi va eng muhim farz amal Allohga va Unining elchisiga iymon keltirishdir."}, {"question": "IjmoвЂ™ nima?", "options": ["Bir kishining shaxsiy qarori", "Davlat rahbari buyrug'i", "Qur'on o'qish qoidasi", "Islom olimlarining biror diniy masala bo'yicha bir ovozdan kelishuvi"], "correct_index": 3, "explanation": "Ijmo' вЂ“ bir davrdagi Islom mujtahid olimlarining diniy hukm borasidagi ittifoqidir."}, {"question": "Dinshunoslikning predmeti nima?", "options": ["Iqtisodiy jarayonlar", "O'simliklar dunyosi", "Dinning mohiyati, rivojlanishi va ijtimoiy funksiyalari", "Faqat ibodathonalarning me'morchiligi"], "correct_index": 2, "explanation": "Dinshunoslikning predmeti din va uning jamiyatdagi namoyon bo'lish qonuniyatlaridir."}, {"question": "Buddizmda \"ToвЂrt olijanob haqiqat\" nimani bildiradi?", "options": ["Ijtimoiy tabaqalar haqidagi qonun", "Azob-uqubat va undan qutulish yo'li haqidagi ta'limot", "Dunyoning yaratilishi haqidagi afsona", "To'rt xil ibodat usuli"], "correct_index": 1, "explanation": "To'rt olijanob haqiqat hayotning azob ekani va undan halos bo'lish yo'lini ko'rsatuvchi tayanch ta'limotdir."}, {"question": "Islom dini asoschisi kim?", "options": ["Muso (a.s.)", "Muhammad (s.a.v.)", "Iso (a.s.)", "Ibrohim (a.s.)"], "correct_index": 1, "explanation": "Islom dini Payg'ambari va uni yetkazuvchi asosiy shaxs Muhammad (s.a.v.) hisoblanadilar."}, {"question": "Buddizmda axloqiy qonun yoki taвЂ™limot qanday ataladi?", "options": ["Sutra", "Karma", "Sangxa", "Dxarma"], "correct_index": 3, "explanation": "Dxarma buddizmda borliq qonuniyati, burch va ta'limot ma'nolarini bildiradi."}, {"question": "Dinshunoslikning jamiyatdagi roli nimada?", "options": ["Texnik innovatsiyalarni yaratish", "Ijtimoiy nizolarni keltirib chiqarish", "Insonlarni faqat bitta e'tiqodga majburlash", "Jamiyatda diniy ma'rifat va bag'rikenglikni oshirish"], "correct_index": 3, "explanation": "Dinshunoslik jamiyatda to'g'ri diniy ma'rifatni tarqatish va dinlararo totuvlikni ta'minlashda muhim rol o'ynaydi."}, {"question": "Musulmonlarning haftalik jamoat namozi kuni qaysi?", "options": ["Shanba", "Dushanba", "Juma", "Yakshanba"], "correct_index": 2, "explanation": "Juma kuni musulmonlar uchun haftalik jamoat namozi va bayram kuni hisoblanad