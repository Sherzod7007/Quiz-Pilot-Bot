   ђ ђ                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      ”mQ Q©q_a6cb6cc574c54dbfb063a8587e56f640A{"variant": "A", "quizzes": [{"question": "Rekursiv algoritm toвЂgвЂri ishlashi uchun qaysi shart zarur?", "options": ["Bazaviy holatning mavjudligi va har bir chaqiruvda bazaviy holatga yaqinlashish", "Global o'zgaruvchilardan foydalanish", "Faqat bitta parametrga ega bo'lish", "Cheksiz chaqiruvlar soniga ega bo'lish"], "correct_index": 0, "explanation": "Rekursiv algoritm to'g'ri ishlashi uchun har doim rekursiyani to'xtatuvchi bazaviy holatga ega bo'lishi va har bir rekursiv chaqiruvda ushbu bazaviy holatga qarab harakatlanishi kerak."}, {"question": "Tail recursionda rekursiv chaqiruv odatda qayerda joylashadi?", "options": ["Shartli operator ichida, lekin oxirgi amal emas", "Funksiyaning o'rtasida, boshqa amallardan oldin", "Funksiyaning oxirgi amali sifatida, undan keyin boshqa hisob-kitoblar bo'lmaydi", "Funksiyaning boshida"], "correct_index": 2, "explanation": "Tail recursionda rekursiv chaqiruv funksiyaning eng oxirgi amali sifatida joylashadi, ya'ni rekursiv chaqiruvdan keyin funksiyada boshqa hech qanday hisob-kitob yoki amal bajarilmaydi. Bu ba'zi kompilyatorlarga stekdan foydalanishni optimallashtirish imkonini beradi."}, {"question": "Rekursiv yechimning iterativ yechimga nisbatan ehtimoliy kamchiligi qaysi?", "options": ["O'qishning qiyinligi", "Kodning murakkabligi", "Tezroq ishlash", "Xotira sarfi (chaqiruvlar stekidan foydalanish) va stek to'lib ketish xavfi"], "correct_index": 3, "explanation": "Rekursiv yechimlar ko'pincha chaqiruvlar stekidan sezilarli darajada foydalanadi, bu esa katta rekursiya chuqurligida xotira sarfini oshirishi va 'Stack Overflow' xatosiga olib kelishi mumkin."}, {"question": "Rekursiyada chaqiruvlar stekida asosan nimalar saqlanadi?", "options": ["Har bir funksiya chaqiruvining konteksti (parametrlar, lokal o'zgaruvchilar, qaytish manzili)", "Rekursiv chaqiruvlarning yakuniy natijalari", "Global o'zgaruvchilarning qiymatlari", "Fayl tizimi ma'lumotlari"], "correct_index": 0, "explanation": "Chaqiruvlar stekida har bir funksiya chaqiruvining alohida konteksti, ya'ni uning parametrlari, lokal o'zgaruvchilari va funksiya tugagandan so'ng qaytish kerak bo'lgan manzil saqlanadi."}, {"question": "Rekursiv funksiyada bazaviy holatning asosiy vazifasi nimadan iborat?", "options": ["Xatolarni aniqlash va tuzatish", "Yangi rekursiv chaqiruvlarni boshlash", "Rekursiyani tugatish va cheksiz tsiklni oldini olish", "Ma'lumotlarni vaqtincha saqlash"], "correct_index": 2, "explanation": "Bazaviy holat rekursiv funksiyaning tugash nuqtasini belgilaydi, bu esa cheksiz rekursiyaning oldini oladi va funksiyaga natijani qaytarish imkonini beradi."}]}jљ—c
