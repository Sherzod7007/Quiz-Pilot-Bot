5	                                                                                                                                                                                                                                                             ’(Ѓ	 Q¤q_3f880dccb51846609ffd890826f594b6A{"variant": "A", "quizzes": [{"question": "Tugun (node) nima?", "options": ["To'lqinning amplitudasi.", "To'lqinning tarqalish yo'nalishi.", "Turg'un to'lqinda doimiy ravishda nol siljishga ega bo'lgan nuqta.", "Turg'un to'lqinda doimiy ravishda maksimal siljishga ega bo'lgan nuqta."], "correct_index": 2, "explanation": "Tugunlar turg'un to'lqinda doimiy ravishda nol siljishga ega bo'lgan nuqtalardir. Bu nuqtalarda to'lqinlar bir-birini butunlay bekor qiladi."}, {"question": "Turg'un to'lqin qanday hosil bo'ladi?", "options": ["To'lqinning bir yo'nalishda tarqalishi natijasida.", "Bir xil chastotali va amplitudali, qarama-qarshi yo'nalishda tarqalayotgan ikki to'lqinning superpozitsiyasi natijasida.", "Turli chastotali to'lqinlarning qo'shilishi natijasida.", "Faqat bitta to'lqinning tarqalishi natijasida."], "correct_index": 1, "explanation": "Turg'un to'lqinlar bir xil chastotali va amplitudali, ammo qarama-qarshi yo'nalishda tarqalayotgan ikki to'lqinning superpozitsiyasi (bir-biriga qo'shilishi) natijasida hosil bo'ladi."}, {"question": "Kuchayish (maksimum) sharti qaysi?", "options": ["Faza farqi 3ПЂ/2 ga teng.", "Yo'l farqi to'lqin uzunligining butun karralisiga teng.", "Faza farqi ПЂ ga teng.", "Yo'l farqi to'lqin uzunligining yarim butun karralisiga teng."], "correct_index": 1, "explanation": "Kuchayish sharti ikki to'lqinning yo'l farqi to'lqin uzunligining butun karralisiga (nО») teng bo'lganda yuzaga keladi."}, {"question": "Do'nglik (antinode) nima?", "options": ["To'lqinning chastotasi.", "Turg'un to'lqinda doimiy ravishda maksimal siljishga ega bo'lgan nuqta.", "To'lqinning uzunligi.", "Turg'un to'lqinda doimiy ravishda nol siljishga ega bo'lgan nuqta."], "correct_index": 1, "explanation": "Do'ngliklar (antinodlar) turg'un to'lqinda doimiy ravishda maksimal siljishga ega bo'lgan nuqtalardir. Bu nuqtalarda to'lqinlar bir-birini kuchaytiradi."}, {"question": "Susayish (minimum) sharti qaysi?", "options": ["Yo'l farqi to'lqin uzunligining yarim butun karralisiga teng.", "Faza farqi 2ПЂ ga teng.", "Yo'l farqi to'lqin uzunligining butun karralisiga teng.", "Faza farqi 0 ga teng."], "correct_index": 0, "explanation": "Susayish sharti ikki to'lqinning yo'l farqi to'lqin uzunligining yarim butun karralisiga ((n+1/2)О») teng bo'lganda yuzaga keladi."}]}jўЕCЃЛ*Ѓ Qѓ–q_8a6774186b4d4d8a81f07b03cecc3694D{"variant": "D", "quizzes": [{"question": "MaКјlumotlar yaxlitligi (data integrity) ning necha xil turi bor?", "options": ["3", "4", "5", "2"], "correct_index": 1, "explanation": "Ma'lumotlar yaxlitligining to'rt xil turi mavjud: Entity Integrity, Referential Integrity, Domain Integrity va User-Defined Integrity."}, {"question": "Agar daraxtda n ta tugun boвЂlsa Pryufer kodi uzunligi nechchiga teng bo'ladi?", "options": ["n - 1", "n - 2", "n + 1", "n"], "correct_index": 1, "explanation": "n ta tugunli daraxtning Pryufer kodi uzunligi n - 2 ga teng bo'ladi."}, {"question": "AVL daraxtda Balance Factor (BF) qiymati qanday hisoblab topiladi?", "options": ["Tugunning ota-onasi soni", "Tugunning farzandlari soni", "Chap kichik daraxt balandligi - O'ng kichik daraxt balandligi", "O'ng kichik daraxt balandligi - Chap kichik daraxt balandligi"], "correct_index": 2, "explanation": "Balance Factor (BF) chap kichik daraxt balandligidan o'ng kichik daraxt balandligini ayirish orqali hisoblanadi."}, {"question": "Labirintdan chiqish yoвЂlini topish uchun qaysi algoritmdan foydalaniladi?", "options": ["BFS", "Dijkstra", "DFS", "Prim"], "correct_index": 0, "explanation": "Labirintdan chiqish yo'lini topish uchun BFS (eng qisqa yo'lni topish uchun) yoki DFS (shunchaki yo'l topish uchun) algoritmlaridan foydalanish mumkin. BFS eng qisqa yo'lni topishda samarali."}, {"question": "ToвЂliq grafda 5 ta tugun boвЂlsa nechta q  &  .     "Namoz",
