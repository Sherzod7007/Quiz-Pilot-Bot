'ta_c12384c773	'ta_d13f6f1b35'ta_450e5f529b'ta_5846b73691'ta_8b705862f5'ta_57b66c1fe0'ta_6745a86010'ta_878ac13e62'	ta_6518a066d4   Иtkazuvchanlikni hosil qiladi."}, {"question": "Taqiqlangan sohasi mavjud boвЂlmagan yoki valentlik sohasi bilan oвЂtkazuvchanlik sohasi ustma-ust tushgan moddalar qaysi?", "options": ["Metallar", "Dielektriklar", "Yarimo'tkazgichlar", "Supero'tkazgichlar"], "correct_index": 0, "explanation": "Metallarda valentlik sohasi va o'tkazuvchanlik sohasi ustma-ust tushadi, bu esa elektronlarning erkin harakatlanishini va yuqori elektr o'tkazuvchanligini ta'minlaydi."}, {"question": "Kremniyga (IV-gruppa) Beshinchi gruppa elementi (masalan, Fosfor) qoвЂshilganda qanday turdagi yarim oвЂtkazgich hosil boвЂladi?", "options": ["n-tipli", "Izolyator", "Xususiy", "p-tipli"], "correct_index": 0, "explanation": "Beshinchi gruppa elementi (masalan, Fosfor) kremniyga qo'shilganda, u bitta ortiqcha elektron beradi, bu esa n-tipli yarimo'tkazgich hosil bo'lishiga olib keladi."}, {"question": "Yarim oвЂ™tkazgichlarda harorat (T) ortishi bilan zaryad tashuvchilar konsentratsiyasi qanday oвЂ™zgaradi?", "options": ["Ortadi", "Kamayadi", "Avval kamayib, keyin ortadi", "O'zgarmaydi"], "correct_index": 0, "explanation": "Harorat ortishi bilan ko'proq elektronlar termal energiya olib, valentlik sohasidan o'tkazuvchanlik sohasiga o'tadi, bu esa elektronlar va kovaklar konsentratsiyasini oshiradi."}, {"question": "Absolyut nol haroratda (T=0K) xususiy yarim oвЂ™tkazgich oвЂ™zini qanday tutadi?", "options": ["Yarimo'tkazgich kabi (normal)", "Izolyator kabi", "Metall kabi", "Supero'tkazgich kabi"], "correct_index": 1, "explanation": "Absolyut nol haroratda xususiy yarimo'tkazgichlarda valentlik sohasi to'liq to'lgan, o'tkazuvchanlik sohasi esa bo'sh bo'ladi, shuning uchun ular elektr tokini o'tkazmaydi va izolyator kabi harakat qiladi."}, {"question": "Taqiqlangan soha kengligi (Eg) ortishi bilan zaryad tashuvchilar konsentratsiyasi qanday oвЂ™zgaradi?", "options": ["O'zgarmaydi", "Ortadi", "Avval ortib, keyin kamayadi", "Kamayadi"], "correct_index": 3, "explanation": "Taqiqlangan soha kengligi ortishi bilan elektronlarning valentlik sohasidan o'tkazuvchanlik sohasiga o'tishi uchun ko'proq energiya talab qilinadi, bu esa zaryad tashuvchilar konsentratsiyasini kamaytiradi."}, {"question": "Alfa (О±) yemirilishda yadroning massa soni (A) va zaryadi (Z) qanday oвЂzgaradi?", "options": ["A o'zgarmaydi, Z 1 ga ortadi", "A 4 ga, Z 2 ga kamayadi", "A 4 ga, Z 2 ga ortadi", "A o'zgarmaydi, Z 1 ga kamayadi"], "correct_index": 1, "explanation": "Alfa yemirilishda geliy yadrosi (ikki proton va ikki neytron) uchib chiqadi, shuning uchun massa soni 4 ga, zaryad soni esa 2 ga kamayadi."}, {"question": "Yadrodagi protonlar va neytronlar umumiy nom bilan nima deyiladi?", "options": ["Nuklonlar", "Leptonlar", "Elektronlar", "Kvarklar"], "correct_index": 0, "explanation": "Protonlar va neytronlar yadroda joylashganligi sababli umumiy nom bilan nuklonlar deb ataladi."}, {"question": "Xususiy yarim oвЂ™tkazgichlarda elektronlar (n) va kovaklar (p) konsentratsiyasi oвЂ™rtasidagi munosabat qanday?", "options": ["n = p", "n в‰  p", "n < p", "n > p"], "correct_index": 0, "explanation": "Xususiy yarimo'tkazgichlarda har bir valentlik sohasidan o'tkazuvchanlik sohasiga o'tgan elektron uchun valentlik sohasida bitta kovak hosil bo'ladi, shuning uchun ularning konsentratsiyasi teng bo'ladi."}, {"question": "OвЂzaro taвЂ™sir turlari ichida eng kichik taвЂ™sir doimiysiga (~10вЃ»ВівЃ№) egasi qaysi?", "options": ["Elektromagnit o'zaro ta'sir", "Zaif o'zaro ta'sir", "Gravitatsion o'zaro ta'sir", "Kuchli o'zaro ta'sir"], "correct_index": 2, "explanation": "To'rtta fundamental o'zaro ta'sir orasida gravitatsion o'zaro ta'sir eng zaifidir."}, {"question": "Metall va yarim oвЂtkazgich kontaktida tokni bir yoвЂnalishda oвЂtkazuvchi qatlam nima deyiladi?", "options": ["Omik kontakt", "Shottki to'sig'i", "p-n o'tish", "Dielektrik qatlam"], "correct_index": 1, "explanation": "Metall va yarimo'tkazgich kontaktida Shottki to'sig'i hosil bo'lishi mumkin, bu tokni bir yo'nalishda o'tkazish xususiyatiga ega."}, {"question": "Kristallarda elektronlarning alohida atomlarga tegishli boвЂ   Йlmay, butun kristall boвЂylab harakatlanishi nima deyiladi?", "options": ["Rekombinatsiya", "Lokalizatsiya", "Ionizatsiya", "Delokalizatsiya"], "correct_index": 3, "explanation": "Metallar va ba'zi yarimo'tkazgichlarda elektronlar alohida atomlarga bog'lanmagan holda butun kristall bo'ylab erkin harakatlana oladi."}, {"question": "Kristall panjarada zarrachalarning muvozanat holati atrofida tartibli joylashishi nima deb ataladi?", "options": ["Molekulyar bog'lanish", "Atom bog'lanishi", "Amorf tuzilish", "Kristall panjara"], "correct_index": 3, "explanation": "Bu kristallarning asosiy xususiyati bo'lib, atomlar, ionlar yoki molekulalar fazoda tartibli, davriy takrorlanuvchi tuzilish hosil qiladi."}, {"question": "Ikki xil metall kontaktga keltirilganda, ular orasida potensiallar farqi hosil boвЂlishi qanday nomlanadi?", "options": ["Xoll effekti", "Fotoelektr effekt", "Termoelektr effekt", "Kontakt potensiallar farqi"], "correct_index": 3, "explanation": "Ikki xil metall kontaktga keltirilganda, ularning chiqish ishlari farqi tufayli elektronlar bir metalldan ikkinchisiga o'tadi va natijada potensiallar farqi hosil bo'ladi."}, {"question": "Massalar soni (A) bir xil boвЂlib, zaryadi (Z) har xil boвЂlgan yadrolar nima deyiladi?", "options": ["Izobaralar", "Izotonlar", "Izomerlar", "Izotoplar"], "correct_index": 0, "explanation": "Izobaralar - bu bir xil massa soniga (A), ammo har xil zaryad soniga (Z) ega bo'lgan yadrolar."}, {"question": "Elektronni metalldan vakuumga chiqarish uchun sarflanadigan minimal energiya nima deyiladi?", "options": ["Bog'lanish energiyasi", "Ionizatsiya energiyasi", "Kinetik energiya", "Chiqish ishi"], "correct_index": 3, "explanation": "Chiqish ishi - bu elektronni metalldan chiqarib, uni vakuumga olib chiqish uchun zarur bo'lgan minimal energiya."}, {"question": "p-n oвЂtishda muvozanat holatida nima sodir boвЂladi?", "options": ["Diffuziya va dreyf toklari tenglashadi", "Faqat elektronlar harakatlanadi", "Hech qanday zaryad tashuvchi harakatlanmaydi", "Faqat kovaklar harakatlanadi"], "correct_index": 0, "explanation": "Muvozanat holatida diffuziya (konsentratsiya farqi tufayli) va dreyf (ichki elektr maydoni tufayli) toklari bir-birini kompensatsiya qiladi, natijada sof tok nolga teng bo'ladi."}, {"question": "Valentlik sohasi bilan oвЂtkazuvchanlik sohasi orasidagi elektronlar boвЂlishi mumkin boвЂlmagan oraliq nima deyiladi?", "options": ["O'tkazuvchanlik sohasi", "Fermi sathi", "Valentlik sohasi", "Taqiqlangan soha"], "correct_index": 3, "explanation": "Taqiqlangan soha - bu valentlik sohasi va o'tkazuvchanlik sohasi orasidagi energetik bo'shliq bo'lib, unda elektronlar doimiy ravishda joylasha olmaydi."}, {"question": "Betta (ОІ) yemirilishda yadrodan qanday zarracha uchib chiqadi?", "options": ["Alfa zarracha", "Proton", "Neytron", "Elektron yoki pozitron"], "correct_index": 3, "explanation": "Beta yemirilishda yadro ichidagi neytron protonga aylanib elektron (beta-minus) chiqarishi yoki proton neytronga aylanib pozitron (beta-plyus) chiqarishi mumkin."}, {"question": "n-tipli yarim oвЂtkazgichlarda Fermi sathi (Вµ) taqiqlangan sohaning qaysi qismida joylashgan boвЂladi?", "options": ["Valentlik sohasiga yaqin", "Taqiqlangan sohadan tashqarida", "O'tkazuvchanlik sohasiga yaqin", "Taqiqlangan sohaning o'rtasida"], "correct_index": 2, "explanation": "n-tipli yarimo'tkazgichlarda donor kirishmalar qo'shimcha elektronlar beradi, bu esa Fermi sathini o'tkazuvchanlik sohasiga yaqinroq siljitadi."}, {"question": "Zaryadlar soni (Z) bir xil, neytronlar soni (N) har xil boвЂlgan yadrolar nima deyiladi?", "options": ["Izobaralar", "Izotonlar", "Izotoplar", "Izomerlar"], "correct_index": 2, "explanation": "Izotoplar - bu bir xil protonlar soniga (bir xil element), ammo har xil neytronlar soniga ega bo'lgan atom yadrolari."}, {"question": "Elektronlar boвЂlmagan yoki qisman toвЂlgan, elektr oвЂtkazuvchanlikni taвЂ™minlovchi soha qaysi?", "options": ["Valentlik sohasi", "Asosiy soha", "O'tkazuvchanlik sohasi", "Taqiqlangan soha"], "correct_index": 2, "explanation": "O'tkazuvchanli   Кk sohasi - bu elektronlar bo'lmagan yoki qisman to'lgan energetik soha bo'lib, undagi elektronlar elektr tokini o'tkazishga qodir."}, {"question": "Yarim oвЂtkazgichlarda harorat koвЂtarilishi bilan ularning elektr oвЂtkazuvchanligi qanday oвЂzgaradi?", "options": ["O'zgarmaydi", "Kamayadi", "Avval kamayib, keyin ortadi", "Ortadi"], "correct_index": 3, "explanation": "Harorat ortishi bilan yarimo'tkazgichlarda ko'proq elektronlar valentlik sohasidan o'tkazuvchanlik sohasiga o'tadi, bu esa zaryad tashuvchilar konsentratsiyasini oshirib, elektr o'tkazuvchanligini oshiradi."}, {"question": "p-tipli yarim oвЂtkazgichda asosiy zaryad tashuvchilar qaysilar?", "options": ["Elektronlar", "Ikkala ham teng", "Kovaklar", "Neytronlar"], "correct_index": 2, "explanation": "p-tipli yarimo'tkazgichlarda akseptor kirishmalar tufayli kovaklar konsentratsiyasi elektronlar konsentratsiyasidan ancha yuqori bo'ladi."}, {"question": "p-tipli yarim oвЂtkazgichda Fermi sathi (Вµ) qayerda joylashgan boвЂladi?", "options": ["Taqiqlangan sohaning o'rtasida", "Taqiqlangan sohadan tashqarida", "O'tkazuvchanlik sohasiga yaqin", "Valentlik sohasiga yaqin"], "correct_index": 3, "explanation": "p-tipli yarimo'tkazgichlarda akseptor kirishmalar kovaklar hosil qiladi, bu esa Fermi sathini valentlik sohasiga yaqinroq siljitadi."}, {"question": "Yadro kuchlarining asosiy xususiyati nima?", "options": ["Faqat protonlar orasida ta'sir qiladi", "Faqat neytronlar orasida ta'sir qiladi", "Qisqa masofali va zaryadga bog'liq emasligi", "Uzoq masofali va zaryadga bog'liq"], "correct_index": 2, "explanation": "Yadro kuchlari juda qisqa masofalarda ta'sir qiladi va protonlar, neytronlar yoki proton-neytron orasidagi ta'sir kuchlari deyarli bir xil, ya'ni zaryadga bog'liq emas."}, {"question": "Yarim oвЂtkazgichli diodning asosiy xossasi nima?", "options": ["Kuchlanishni kuchaytirish", "Tokni bir yo'nalishda o'tkazish", "Tokni umuman o'tkazmaslik", "Tokni ikki yo'nalishda o'tkazish"], "correct_index": 1, "explanation": "Yarimo'tkazgichli diodning asosiy xossasi uning bir tomonlama o'tkazuvchanligidir, ya'ni tokni faqat bir yo'nalishda o'tkazadi."}, {"question": "Qattiq jism hosil boвЂlishida zarrachalar orasidagi qaysi kuchlar ularning bir-biriga qoвЂshilishiga qarshilik qiladi?", "options": ["Tortishish kuchlari", "Itarish kuchlari", "Magnit kuchlar", "Yadro kuchlari"], "correct_index": 1, "explanation": "Atomlar bir-biriga juda yaqinlashganda, ularning elektron qobiqlari o'zaro itarishni boshlaydi, bu esa ularning ma'lum bir masofada muvozanatda bo'lishini ta'minlaydi."}, {"question": "Qattiq jismlarda elektronlarning energetik sohalarga boвЂlinishiga sabab boвЂladigan asosiy prinsip qaysi?", "options": ["Pauli prinsipi", "Geyzenbergning noaniqlik prinsipi", "Dirak prinsipi", "Plank kvant prinsipi"], "correct_index": 0, "explanation": "Pauli prinsipi shuni aytadiki, bitta kvant holatida ikkita bir xil fermion (elektron) bo'lishi mumkin emas. Bu atomlar bir-biriga yaqinlashganda energetik sathlarning sohalarga bo'linishiga olib keladi."}, {"question": "Xususiy yarim oвЂ™tkazgichlarda Fermi sathi (Вµ) qayerda joylashgan boвЂ™ladi?", "options": ["Valentlik sohasida", "Taqiqlangan sohadan tashqarida", "Taqiqlangan sohaning o'rtasida", "O'tkazuvchanlik sohasida"], "correct_index": 2, "explanation": "Xususiy yarimo'tkazgichlarda Fermi sathi taqiqlangan sohaning aniq o'rtasida joylashgan bo'ladi, bu elektronlar va kovaklarning teng ehtimollik bilan paydo bo'lishini ko'rsatadi."}, {"question": "Yarim oвЂtkazgich panjarasidan bitta elektronni oвЂziga olib, musbat zaryadlangan kovak hosil qiladigan kirishmalar nima deyiladi?", "options": ["Akseptor", "Donor", "Neytral", "Katalizator"], "correct_index": 0, "explanation": "Akseptor kirishmalar yarimo'tkazgichdan elektron qabul qilib, kovaklar hosil qiladi, bu esa p-tipli o'tkazuvchanlikni ta'minlaydi."}, {"question": "n-tipli yarim oвЂtkazgichda 'ozchilik' zaryad tashuvchilar qaysilar?", "options": ["Kovaklar", "Elektronlar", "Neytronlar", "Ikkala ham teng"], "correct_index": 0, "explanation": "n-tipli yarimo    'tkazgichlarda elektronlar asosiy zaryad tashuvchilar bo'lsa, kovaklar ozchilik zaryad tashuvchilar hisoblanadi."}, {"question": "Taqiqlangan sohasining kengligi (О”E) juda katta (bir necha eV) boвЂlgan moddalar nima deb ataladi?", "options": ["Supero'tkazgichlar", "Yarimo'tkazgichlar", "Metallar", "Dielektriklar (izolyatorlar)"], "correct_index": 3, "explanation": "Dielektriklar (izolyatorlar) juda katta taqiqlangan sohaga ega bo'lib, bu ularning elektr tokini o'tkazmasligini anglatadi."}, {"question": "Pauli prinsipiga koвЂ™ra, bitta energetik sathda koвЂ™pi bilan nechta elektron boвЂ™lishi mumkin?", "options": ["Uchta", "Bitta", "Ikkita", "To'rtta"], "correct_index": 2, "explanation": "Pauli prinsipi shuni aytadiki, bitta kvant holatida ikkita bir xil fermion (elektron) bo'lishi mumkin emas. Biroq, bitta energetik sathda (orbitalda) qarama-qarshi spinli ikkita elektron joylashishi mumkin."}, {"question": "Valent sohadagi elektron oвЂ™tkazuvchanlik sohasiga oвЂ™tganda, u yerda qolgan boвЂ™sh oвЂ™rin nima deyiladi?", "options": ["Neytron", "Proton", "Elektron", "Kovak"], "correct_index": 3, "explanation": "Elektron valentlik sohasidan o'tkazuvchanlik sohasiga o'tganda, u o'zidan keyin musbat zaryadlangan 'kovak' qoldiradi, bu ham zaryad tashuvchi vazifasini bajaradi."}, {"question": "Kirishmali yarim oвЂtkazgichlarda juda past temperaturalarda qaysi turdagi oвЂtkazuvchanlik ustunlik qiladi?", "options": ["Supero'tkazuvchanlik", "Metall o'tkazuvchanlik", "Kirishmali o'tkazuvchanlik", "Xususiy o'tkazuvchanlik"], "correct_index": 2, "explanation": "Past haroratlarda kirishma atomlaridan elektronlar (yoki kovaklar) ajralib chiqishi ustunlik qiladi, chunki bu jarayon uchun kamroq energiya talab qilinadi."}, {"question": "Chiqish ishi turlicha boвЂlgan ikki metall tekkizilganda, elektronlar qaysi metalldan qaysinisiga oвЂtadi?", "options": ["Elektronlar o'tmaydi", "Chiqish ishi katta bo'lgan metalldan chiqish ishi kichik bo'lgan metallga", "Chiqish ishi kichik bo'lgan metalldan chiqish ishi katta bo'lgan metallga", "Har ikki yo'nalishda ham teng o'tadi"], "correct_index": 2, "explanation": "Elektronlar energiya jihatdan qulayroq holatga o'tishga intiladi, ya'ni chiqish ishi kichik bo'lgan metalldan (elektronlar erkinroq) chiqish ishi katta bo'lgan metallga o'tadi."}, {"question": "Massa defekti deb nimaga aytiladi?", "options": ["Yadroning massasi uni tashkil etuvchi nuklonlar massalari yig'indisidan kichik bo'lishi", "Elektronning massasi proton massasidan kichik bo'lishi", "Neytronning massasi proton massasidan katta bo'lishi", "Atomning massasi yadro massasidan kichik bo'lishi"], "correct_index": 0, "explanation": "Massa defekti - bu yadroning haqiqiy massasi uni tashkil etuvchi alohida nuklonlarning massalari yig'indisidan kichik bo'lishi. Bu massa farqi yadro bog'lanish energiyasiga aylanadi."}, {"question": "Harorat juda yuqori boвЂlganda kirishmali yarim oвЂtkazgich oвЂzini qanday tutadi?", "options": ["Metall kabi", "Supero'tkazgich kabi", "Izolyator kabi", "Xususiy yarimo'tkazgich kabi"], "correct_index": 3, "explanation": "Yuqori haroratlarda termal generatsiya kuchayadi va kirishma atomlaridan keladigan zaryad tashuvchilar soni xususiy zaryad tashuvchilar soniga nisbatan ahamiyatsiz bo'lib qoladi, shuning uchun u xususiy yarimo'tkazgich kabi harakat qiladi."}, {"question": "p va n turdagi yarim oвЂtkazgichlar kontaktida hosil boвЂlgan oвЂtish sohasi nima deb ataladi?", "options": ["Izolyator qatlami", "p-n o'tish", "Metall-yarimo'tkazgich o'tish", "Omik kontakt"], "correct_index": 1, "explanation": "p-n o'tish - bu p-tipli va n-tipli yarimo'tkazgichlar bir-biriga tegib turgan joyda hosil bo'ladigan soha bo'lib, diodlarning asosini tashkil qiladi."}, {"question": "n-sohadan p-sohaga elektronlar diffuziyasi natijasida n-soha qanday zaryadlanadi?", "options": ["Musbat", "Avval manfiy, keyin musbat", "Manfiy", "Neytral"], "correct_index": 0, "explanation": "n-sohadan p-sohaga elektronlar o'tganda, n-sohada elektronlar yetishmovchiligi yuzaga keladi va u musbat zaryadlanadi (donor ionlari qoladi)."}]}j†ћЗ   М": 1, "explanation": "Grafik usul tekislikda tasvirlash oson bo'lganligi sababli ko'pincha 2 ta o'zgaruvchili masalalarda qo'llaniladi."}, {"question": "OвЂzgaruvchilari orasida П†(x, y) = 0 bogвЂlanish tenglamasi berilgan ekstremum nima deyiladi?", "options": ["Shartli ekstremum", "Lokal ekstremum", "Oshkor ekstremum", "Mutlaq ekstremum"], "correct_index": 0, "explanation": "Qo'shimcha cheklov (bog'lanish tenglamasi) berilgan hollarda topiladigan ekstremum shartli ekstremum deyiladi."}, {"question": "Agar masalada xarajatlarni kamaytirish soвЂralsa, maqsad funksiyasi nimaga intiladi?", "options": ["Birga", "Maksimumga (max)", "O'zgarmasga", "Minimumga (min)"], "correct_index": 3, "explanation": "Xarajatlarni minimallashtirish uchun maqsad funksiyasi min ga intiladi."}, {"question": "Axborot xavfsizligida barmoq izi matematik modelini nima orqali qurish mumkin?", "options": ["Ikki karrali integrallar va sirt tenglamalari orqali", "Faqat oddiy qo'shish usuli bilan", "Tasodifiy sonlar generatori orqali", "Chiziqli tenglamalar sistemasi bilan"], "correct_index": 0, "explanation": "Barmoq izi tasviridagi zichlik va sirt relyefini ikki karrali integrallar va sirt tenglamalari yordamida modellashtirish mumkin."}, {"question": "Ekstremumga tekshirishda в€† = AC - B^2 < 0 boвЂlsa, xulosa qanday boвЂladi?", "options": ["Ekstremum mavjud emas", "Ekstremum mavjud", "Maksimum mavjud", "Minimum mavjud"], "correct_index": 0, "explanation": "Ikki o'zgaruvchili funksiyada в€† = AC - B^2 < 0 bo'lganda ushbu nuqtada ekstremum mavjud emas."}, {"question": "в€‚^2 z / в€‚x^2 koвЂrinishidagi hosila nima deyiladi?", "options": ["Aralash hosila", "To'liq differensial", "y bo'yicha birinchi tartibli hosila", "x bo'yicha ikkinchi tartibli xususiy hosila"], "correct_index": 3, "explanation": "Ushbu belgilash x o'zgaruvchisi bo'yicha olingan ikkinchi tartibli xususiy hosiladir."}, {"question": "Chiziqli dasturlash masalasining asosiy maqsadi nima?", "options": ["Grafiklarni chizish", "Tenglamalar sonini ko'paytirish", "Cheklangan resurslar sharoitida optimal yechimni topish", "Nomalumlarni yo'qotish"], "correct_index": 2, "explanation": "Asosiy maqsad вЂ” berilgan cheklovlar doirasida eng maqbul (optimal) yechimga erishish."}, {"question": "z = y^2 + 7 funksiya uchun z_x' ni toping:", "options": ["2y", "0", "7", "2y + 7"], "correct_index": 1, "explanation": "Funksiyada x o'zgaruvchisi qatnashmagani uchun x bo'yicha xususiy hosilasi 0 ga teng."}, {"question": "Agar ikki karrali integralda integral ostidagi funksiya 1 ga teng boвЂlsa, u nimani hisoblaydi?", "options": ["Perimetrni", "Sohaning hajmini", "Og'irlik markazini", "Integrallash sohasi D ning yuzasini"], "correct_index": 3, "explanation": "в€¬_D 1 dx dy integral D sohaning yuzasiga teng bo'ladi."}, {"question": "OвЂyin industriyasida 3D modellarning yoritilishini hisoblashda nima qoвЂllaniladi?", "options": ["Algebraik tenglamalar", "Noma'lum ko'paytuvchilar", "Faqat chiziqli integrallar", "Sirt integrallari va ikki karrali integrallar"], "correct_index": 3, "explanation": "3D modellarda nur va soyaning tarqalishini hisoblashda sirt va ikki karrali integrallar ishlatiladi."}, {"question": "Shartli ekstremumni topishda qaysi funksiya yordamida hisoblashlar olib boriladi?", "options": ["Nyuton funksiyasi", "Gauss funksiyasi", "Lagranj funksiyasi", "Eyler funksiyasi"], "correct_index": 2, "explanation": "Shartli ekstremumni topishda Lagranj ko'paytuvchilar usuli va Lagranj funksiyasi qo'llaniladi."}, {"question": "Ikki karrali integral qanday soha ustida hisoblanadi?", "options": ["Tekislikdagi cheklangan D soha ustida", "Cheksiz to'g'ri chiziq ustida", "Faqat fazodagi shar ustida", "Faqat bir o'lchovli kesma ustida"], "correct_index": 0, "explanation": "Ikki karrali integral 2D tekislikdagi cheklangan va yopiq D sohada hisoblanadi."}, {"question": "Matematik modeldagi вЂњCheklovlarвЂќ nima?", "options": ["Resurslar va shartlarning cheklanganligini ko'rsatuvchi tenglama va tengsizliklar", "Nomanfiy sonlar to'plami", "Maqsad funksiyasining hosilasi", "Barcha mumkin bo'lgan yechimlar   Н"], "correct_index": 0, "explanation": "Cheklovlar mavjud resurslar miqdorini va masala shartlarini bildiradi."}, {"question": "Funksiyaning maksimum va minimum nuqtalari umumiy qanday nomlanadi?", "options": ["Ekstremum nuqtalari", "Nol nuqtalari", "Kritik nuqtalar", "Statsionar nuqtalar"], "correct_index": 0, "explanation": "Maksimum va minimum nuqtalari birgalikda ekstremum nuqtalari deb ataladi."}, {"question": "Funksiyada faqat x oвЂzgarganda olingan в€†_x z = f(x + в€†x, y) - f(x, y) ayirma nima deyiladi?", "options": ["Xususiy hosila", "To'liq differensial", "Xususiy orttirma", "To'liq orttirma"], "correct_index": 2, "explanation": "Faqat bitta o'zgaruvchi x o'zgargandagi orttirma x bo'yicha xususiy orttirma deyiladi."}, {"question": "ToвЂliq differensial qaysi harf bilan belgilanadi?", "options": ["dz", "z_x'", "в€†z", "d^2z"], "correct_index": 0, "explanation": "To'liq differensial dz belgisi bilan ifodalanadi."}, {"question": "Funksiyaning yopiq sohadagi eng katta va eng kichik qiymatlari qayerda qidiriladi?", "options": ["Faqat soha chegarasida", "Faqat koordinata boshida", "Soha ichidagi kritik nuqtalarda va soha chegarasida", "Faqat soha markazida"], "correct_index": 2, "explanation": "Yopiq sohada eng katta va eng kichik qiymatlar soha ichki kritik nuqtalarida hamda soha chegarasida qidiriladi."}, {"question": "Fermerning 10 ga yeri bor. BugвЂdoy x1 va sholi x2 uchun yer cheklovi qanday yoziladi?", "options": ["x1 + x2 в‰Ґ 10", "x1 * x2 в‰¤ 10", "x1 + x2 в‰¤ 10", "x1 - x2 = 10"], "correct_index": 2, "explanation": "Ekin maydonlari yig'indisi umumiy yer maydoni 10 ga dan oshmasligi kerak: x1 + x2 в‰¤ 10."}, {"question": "Plastinkaning ogвЂirlik markazi koordinatalari nima orqali aniqlanadi?", "options": ["Faqat soha yuzi orqali", "Perimetrlar nisbati orqali", "Koordinata boshidan masofa orqali", "Statik momentlarning massaga nisbati va ikki karrali integrallar orqali"], "correct_index": 3, "explanation": "Og'irlik markazi x_c = My/m va y_c = Mx/m ko'rinishida statik momentlar va massaning ikki karrali integrallari orqali topiladi."}, {"question": "Tikuvchilik korxonasi: 12 metr matodan koвЂylak (x1) uchun 3 metr, shim (x2) uchun 2 metr sarflansa, mato cheklovi qaysi javobda toвЂgвЂri?", "options": ["3x1 + 2x2 в‰¤ 12", "3x1 + 2x2 в‰Ґ 12", "2x1 + 3x2 в‰¤ 12", "x1 + x2 в‰¤ 12"], "correct_index": 0, "explanation": "Ko'ylakka 3x1, shimga 2x2 metr mato ketadi, jami sarf 12 metrdan oshmasligi kerak: 3x1 + 2x2 в‰¤ 12."}, {"question": "z = 10x funksiyaning x boвЂyicha xususiy hosilasi z_x' nimaga teng?", "options": ["1", "10", "0", "10x"], "correct_index": 1, "explanation": "x bo'yicha hosila olinganda (10x)' = 10 bo'ladi."}, {"question": "Bir jinsli plastinkaning massasini topish uchun nima maвЂ™lum boвЂlishi kerak?", "options": ["Faqat uning perimetri", "Havo bosimi", "Plastinkaning sirtiy zichligi va egallagan sohasi", "Faqat uning balandligi"], "correct_index": 2, "explanation": "Massa m = в€¬_D ПЃ(x,y) dx dy formulasi orqali topilishi uchun sirtiy zichlik va D soha ma'lum bo'lishi lozim."}, {"question": "Chiziqli dasturlash masalasining matematik modelida x1, x2 в‰Ґ 0 sharti nima deyiladi?", "options": ["Chiziqlilik sharti", "O'zgaruvchilarning nomanfiylik sharti", "Maqsad sharti", "Cheklov sharti"], "correct_index": 1, "explanation": "O'zgaruvchilarning noldan kichik bo'lmaslik talabi nomanfiylik sharti deyiladi."}, {"question": "f(x,y) funksiya ikki karrali integrallanuvchi boвЂlishining yetarli sharti:", "options": ["D yopiq va cheklangan sohada uzluksiz bo'lishi", "Chiziqli bo'lishi", "D sohada faqat musbat bo'lishi", "Faqat noldan katta hosilaga ega bo'lishi"], "correct_index": 0, "explanation": "Yopiq va cheklangan D sohada uzluksiz bo'lgan funksiya shu sohada integrallanuvchi bo'ladi."}, {"question": "Agar A = 2, B = 0, C = 2 boвЂlsa, в€† = AC - B^2 qiymatini hisoblang:", "options": ["0", "2", "4", "-4"], "correct_index": 2, "explanation": "в€† = 2 * 2 - 0^2 = 4."}, {"question": "z funksiyaning x boвЂyicha xususiy hosilasi qanday belgilanadi?", "options": ["dz", "z_x' yoki в€‚z/в€‚x", "z_y   О' yoki в€‚z/в€‚y", "в€†z"], "correct_index": 1, "explanation": "x bo'yicha xususiy hosila z_x' yoki в€‚z/в€‚x ko'rinishida belgilanadi."}, {"question": "Chiziqli dasturlash nima?", "options": ["Chiziqli bog'lanishli optimallashtirish masalalarini yechish usullari bo'limi", "Geometrik shakllarni chizish usuli", "Faqat chiziqli tenglamalar sistemasi", "Kompyuterda dastur yozish tili"], "correct_index": 0, "explanation": "Chiziqli dasturlash вЂ” chiziqli maqsad funksiyasi va chiziqli cheklovlarga ega masalalarni yechuvchi matematika bo'limi."}, {"question": "F(x, y) = 0 koвЂrinishida berilgan funksiya nima deyiladi?", "options": ["Oshkor funksiya", "Oshkormas funksiya", "Chiziqli funksiya", "Murakkab funksiya"], "correct_index": 1, "explanation": "O'zgaruvchilari tenglamaning bir tomonida yig'ilgan F(x, y) = 0 ko'rinishidagi funksiya oshkormas funksiya deyiladi."}, {"question": "Ikki karrali integralda oвЂzgarmas sonni integral belgisidan tashqariga chiqarish mumkinmi?", "options": ["Yo'q, mumkin emas", "Faqat musbat bo'lsa mumkin", "Ha, mumkin", "Faqat nolga teng bo'lganda mumkin"], "correct_index": 2, "explanation": "Integral xossasiga ko'ra, o'zgarmas ko'paytuvchini integral belgisidan tashqariga chiqarish mumkin."}, {"question": "Hayotda вЂњOptimallashtirishвЂќ nima uchun kerak?", "options": ["Matematik modellarni yo'qotish uchun", "Hisoblashlarni murakkablashtirish uchun", "Mavjud resurslardan eng samarali va foydali tarzda foydalanish uchun", "Faqat xarajatlarni oshirish uchun"], "correct_index": 2, "explanation": "Optimallashtirish cheklangan resurslardan maksimal foyda yoki minimal xarajat olish uchun xizmat qiladi."}, {"question": "Nomanfiylik sharti (x в‰Ґ 0) nimani bildiradi?", "options": ["Resurslar cheksizligini", "Nolga bo'lish mumkinligini", "Faqat manfiy qiymatlarni hisobga olishni", "Ishlab chiqariladigan mahsulot yoki resurs miqdori manfiy bo'lishi mumkin emasligini"], "correct_index": 3, "explanation": "Amaliy masalalarda mahsulot va resurs miqdori manfiy bo'la olmaydi."}, {"question": "Ikki oвЂzgaruvchili z = f(x, y) funksiyaning M0(x0, y0) nuqtadagi qiymati uning atrofidagi boshqa nuqtalardagi qiymatlaridan katta boвЂlsa, bu nuqta nima deyiladi?", "options": ["Nol nuqtasi", "Minimum nuqtasi", "Maksimum nuqtasi", "Egar nuqtasi"], "correct_index": 2, "explanation": "Atrofidagi barcha nuqtalardagi qiymatlardan katta qiymat qabul qiluvchi nuqta maksimum nuqtasi hisoblanadi."}, {"question": "вЂњMaqsad funksiyasiвЂќ deganda nimani tushunasiz?", "options": ["Maksimallashtirilishi yoki minimallashtirilishi kerak bo'lgan matematik ifoda", "Faqat nolga teng bo'lgan ifoda", "Cheklovlar tenglamasi", "O'zgaruvchilarning nomanfiylik sharti"], "correct_index": 0, "explanation": "Maqsad funksiyasi optimallashtirish masalasida erishilmoqchi bo'lgan asosiy mezonni ifodalaydi."}, {"question": "Ikki karrali integralning geometrik maвЂ™nosi nimani bildiradi?", "options": ["Nuqtaning tezligini", "Yassi shaklning perimetrini", "Egri chiziq uzunligini", "Silindrik jismning hajmini"], "correct_index": 3, "explanation": "Musbat f(x,y) funksiyaning ikki karrali integrali mos silindrik jism hajmini ifodalaydi."}, {"question": "Modellashtirishning birinchi bosqichi nima?", "options": ["Matematik tenglamani yechish", "Dastur kodini yozish", "Natijalarni tahlil qilish", "Masalaning qo'yilishi va maqsadni aniqlash"], "correct_index": 3, "explanation": "Modellashtirish masalaning qo'yilishi va maqsadlarni belgilashdan boshlanadi."}, {"question": "z = 5x + 8y funksiya uchun z_x' ni toping:", "options": ["8", "5x", "5", "13"], "correct_index": 2, "explanation": "x bo'yicha xususiy hosila olinganda y o'zgarmas deb qaraladi: (5x)' = 5 va (8y)' = 0, natija 5."}, {"question": "Maqsad funksiyasi вЂњmaxвЂќ boвЂlsa, nima izlanadi?", "options": ["Maksimal (eng katta) qiymat", "O'rtacha qiymat", "Minimal (eng kichik) qiymat", "Nol qiymat"], "correct_index": 0, "explanation": "'max' belgisi maksimum (eng katta foyda yoki natija) izlanayotganini bildiradi."}, {"question": "z = x + y funksiyaning x boвЂyicha ikkinchi tartibli hosilasi z_xx    '' nimaga teng?", "options": ["2", "1", "x", "0"], "correct_index": 3, "explanation": "Birinchi hosila z_x' = 1, ikkinchi hosila z_xx'' = (1)' = 0."}, {"question": "Model tuzishda вЂњSoddalikвЂќ tamoyili nima uchun kerak?", "options": ["Aniqlikni butunlay yo'qotish uchun", "Maqsad funksiyasini yo'qotish uchun", "Modelni tushunish va hisoblashni osonlashtirish uchun", "Xatoliklarni ko'paytirish uchun"], "correct_index": 2, "explanation": "Soddalik tamoyili modelni keraksiz murakkabliklardan xoli qilib, asosiy jarayonlarni aks ettirishga yordam beradi."}, {"question": "Chiziqli dasturlash masalasida cheklangan resurslar (masalan: un, vaqt, pul) qanday ifodalanadi?", "options": ["O'zgarmas koordinatalar bilan", "Faqat maqsad funksiyasi bilan", "Nomanfiylik sharti bilan", "Tengsizliklar yoki tenglamalar ko'rinishidagi cheklovlar bilan"], "correct_index": 3, "explanation": "Resurslar miqdori modelda matematik tengsizliklar yoki tenglamalar ko'rinishida beriladi."}, {"question": "Muzqaymoq 20 soвЂm, pulingiz 100 soвЂm. Muzqaymoq soni x bo'lsa, toвЂgвЂri tengsizlikni toping:", "options": ["20x в‰¤ 100", "x в‰¤ 20", "20x в‰Ґ 100", "20x = 100"], "correct_index": 0, "explanation": "Xarajat (20x) mavjud puldan (100) oshib ketmasligi kerak, ya'ni 20x в‰¤ 100."}, {"question": "Agar masalada foydani koвЂpaytirish soвЂralsa, maqsad funksiyasi nimaga intiladi?", "options": ["Minimumga (min)", "Nolga", "Cheksizlikka", "Maksimumga (max)"], "correct_index": 3, "explanation": "Foyda maksimal darajaga yetkazilishi kerak, shuning uchun maqsad funksiyasi max ga intiladi."}, {"question": "Talabaning vaqti: 5 soat boвЂsh vaqt bor. Kitob oвЂqish (x1) va video koвЂ™rish (x2) uchun jami vaqt cheklovi qanday yoziladi?", "options": ["x1 + x2 в‰Ґ 5", "x1 - x2 в‰¤ 5", "x1 * x2 = 5", "x1 + x2 в‰¤ 5"], "correct_index": 3, "explanation": "Sarflangan vaqt yig'indisi mavjud 5 soatdan oshib ketmasligi kerak: x1 + x2 в‰¤ 5."}, {"question": "z = x^2 + y^2 funksiyaning statsionar nuqtasini toping:", "options": ["(1, 1)", "(1, 0)", "(0, 1)", "(0, 0)"], "correct_index": 3, "explanation": "z_x' = 2x = 0 va z_y' = 2y = 0 tenglamalardan x=0, y=0 kelib chiqadi. Statsionar nuqta (0,0)."}, {"question": "Bitta mahsulotdan 5000 soвЂm foyda qolsa, x ta mahsulotdan qancha foyda qoladi?", "options": ["x - 5000", "5000 + x", "5000 / x", "5000x"], "correct_index": 3, "explanation": "x ta mahsulotdan olinadigan umumiy foyda 5000 * x so'm bo'ladi."}, {"question": "Vitaminlar: Kuniga kamida 10 birlik vitamin olish kerak. Olma (x1) 2 birlik, banan (x2) 5 birlik vitamin bersa, вЂњkamidaвЂќ sharti qaysi belgi bilan yoziladi?", "options": ["2x1 + 5x2 в‰Ґ 10", "x1 + x2 < 10", "2x1 + 5x2 в‰¤ 10", "2x1 + 5x2 = 10"], "correct_index": 0, "explanation": "'Kamida' so'zi katta yoki teng (в‰Ґ) belgisini bildiradi: 2x1 + 5x2 в‰Ґ 10."}, {"question": "Р¤(x, y, О») = x + y + О»(x^2 + y^2 - 1) Lagranj funksiyasidan x boвЂyicha hosila oling:", "options": ["1 + 2О»x", "1 + 2О»y", "1 + О»", "2О»x"], "correct_index": 0, "explanation": "x bo'yicha xususiy hosila: (x)' + (y)' + О»(x^2)' + О»(y^2)' - О»(1)' = 1 + 2О»x."}, {"question": "ToвЂliq differensialni hisoblash formulasini koвЂrsating:", "options": ["dz = z_x' + z_y'", "dz = z_x' dx + z_y' dy", "dz = z_x' dx - z_y' dy", "dz = dx + dy"], "correct_index": 1, "explanation": "Ikki o'zgaruvchili funksiyaning to'liq differensiali dz = z_x' dx + z_y' dy formula bilan hisoblanadi."}, {"question": "Ikki karrali integralda D sohaning diametr tushunchasi qanday aniqlanadi?", "options": ["Soha chegarasining uzunligi", "Soha yuzining kvadrati", "Soha markazidan masofa", "Sohadagi ixtiyoriy ikki nuqta orasidagi eng katta masofa"], "correct_index": 3, "explanation": "Sohaning diametri shu sohada yotuvchi barcha juft nuqtalar orasidagi masofalarning eng kattasiga teng."}]}j†џ                                                                                                                                                                                                                                                                                    
   2 2                                                                                                                                                                                                                                                                                                        Ѓќ6 Q‚єq_80c6ca04bd1648dfbb7002ea7001bfcfA{"variant": "A", "quizzes": [{"question": "Kristall panjaraning ichki maydoni taвЂ™sirini hisobga olgan holda kiritilgan massa nima deyiladi?", "options": ["Nisbiy massa", "Haqiqiy massa", "Dam olish massasi", "Effektiv massa"], "correct_index": 3, "explanation": "Effektiv massa - bu elektronning kristall panjara ichidagi harakatini tavsiflash uchun ishlatiladigan tushuncha bo'lib, panjara potentsialining elektron harakatiga ta'sirini hisobga oladi."}, {"question": "ToвЂliq elektronlar bilan toвЂlgan eng yuqori energetik soha qanday ataladi?", "options": ["Valentlik sohasi", "Fermi sohasi", "O'tkazuvchanlik sohasi", "Taqiqlangan soha"], "correct_index": 0, "explanation": "Valentlik sohasi - bu elektronlar bilan to'liq to'lgan va atomlarning valent elektronlarini o'z ichiga olgan eng yuqori energetik soha."}, {"question": "Kontakt potensiallar farqi tashqi zanjirdagi tokka qanday taвЂ™sir qiladi?", "options": ["Tokni kuchaytiradi", "Tokka ta'sir qilmaydi", "Tok o'tishiga qarshilik ko'rsatadi", "Tok o'tishiga yordam beradi"], "correct_index": 2, "explanation": "Kontakt potensiallar farqi (yoki ichki elektr maydoni) zaryad tashuvchilarning o'tishiga to'sqinlik qiladi, ya'ni tok o'tishiga qarshilik ko'rsatadi."}, {"question": "Mikrozarrachalarning energetik sathlar boвЂ™ylab taqsimlanish ehtimolligi qaysi statistika bilan aniqlanadi?", "options": ["Bose-Eynshteyn statistikasi", "Maksvell statistikasi", "Bolsman statistikasi", "Fermi-Dirak statistikasi"], "correct_index": 3, "explanation": "Elektronlar kabi fermionlar Pauli prinsipiga amal qilganligi sababli Fermi-Dirak statistikasiga bo'ysunadi."}, {"question": "Neytron er