   - Я-                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 ‘/d Qўq_a213c3bd05944ffab8d1a21ef3dcd3e7A{"variant": "A", "quizzes": [{"question": "Dinshunoslikda ilmiy yondashuv qanday boвЂladi?", "options": ["ObвЂ™ektivlik, xolislik va faktlarga asoslangan holda", "SubвЂ™ektiv va shaxsiy eвЂ™tiqodlarga tayanib", "Diniy rahbariyatning koвЂrsatmalariga binoan", "Faqat diniy manbalarga asoslanib"], "correct_index": 0, "explanation": "Dinshunoslikda ilmiy yondashuv obвЂ™ektivlik, xolislik, tanqidiy fikrlash va empirik faktlarga asoslanishni talab qiladi, shaxsiy eвЂ™tiqodlar yoki diniy dogmalarga tayanmaydi."}, {"question": "Dinshunoslikning vazifalaridan biri qaysi?", "options": ["Diniy taвЂ™limotlarni yaratish", "Diniy urf-odatlarni joriy etish", "Diniy tashkilotlarni boshqarish", "Dinning jamiyat hayotidagi oвЂrni va ahamiyatini tahlil qilish"], "correct_index": 3, "explanation": "Dinshunoslik dinning jamiyat, madaniyat, siyosat va shaxs hayotidagi oвЂrnini ilmiy asosda tahlil qiladi va baholaydi."}, {"question": "Dinshunoslikning predmeti nima?", "options": ["Faqat ilohiyot masalalari", "Iqtisodiy munosabatlar", "Din hodisasi, uning shakllari, funksiyalari va jamiyatdagi oвЂrni", "Siyosiy tizimlar"], "correct_index": 2, "explanation": "Dinshunoslikning predmeti dinning oвЂzi, yaвЂ™ni diniy hodisalar, eвЂ™tiqodlar, amaliyotlar, institutlar va ularning jamiyatdagi oвЂrni hisoblanadi."}, {"question": "Dinshunoslik nimani oвЂrganadi?", "options": ["Faqat biror bir dinning aqidalarini", "Dinni, uning kelib chiqishi, rivojlanishi, jamiyatdagi oвЂrni va taвЂ™sirini", "Tarixiy voqealarni", "Falsafiy masalalarni"], "correct_index": 1, "explanation": "Dinshunoslik dinni kompleks tarzda, uning barcha jihatlari, kelib chiqishi, evolyutsiyasi va jamiyatga taвЂ™sirini ilmiy nuqtai nazardan oвЂrganadi."}, {"question": "Dinshunoslikning asosiy maqsadi nimadan iborat?", "options": ["Biror bir dinni targвЂib qilish", "Diniy marosimlarni tashkil etish", "Dinni ilmiy, obвЂ™ektiv va har tomonlama oвЂrganish", "Diniy eвЂ™tiqodlarni shakllantirish"], "correct_index": 2, "explanation": "Dinshunoslikning asosiy maqsadi dinni ilmiy metodlar yordamida, xolis va obвЂ™ektiv tarzda tushunish va tahlil qilishdir, diniy targвЂibot bilan shugвЂullanmaydi."}]}j›>Ёc QП]q_d821bf93783249e48fe257a7f45005f4D{"variant": "D", "quizzes": [{"question": "Estetik ong va uning koК»rinishlari qanday?", "options": ["Estetik ong вЂ“ bu faqat san'at asarlarini yaratish jarayoni boК»lib, uning koК»rinishlari faqat rassomchilik va haykaltaroshlikda uchraydi.", "Estetik ong вЂ“ bu insonning kundalik hayotdagi oddiy fikrlari boК»lib, uning koК»rinishlari faqat moddiy boylikka intilishda aks etadi.", "Estetik ong вЂ“ bu insonning borliqni goК»zallik qonuniyatlari asosida idrok etishi va baholashi boК»lib, uning koК»rinishlari estetik his-tuygК»ular, did, ideal va nazariyalarda namoyon boК»ladi.", "Estetik ong вЂ“ bu ilmiy bilimlarni oК»zlashtirish jarayoni boК»lib, uning koК»rinishlari faqat matematik formulalarda ifodalanadi."], "correct_index": 2, "explanation": "Estetik ong insonning borliqni goК»zallik, uygК»unlik va mukammallik nuqtai nazaridan idrok etishi, baholashi va oК»zgartirishga intilishi. Uning asosiy koК»rinishlari estetik his-tuygК»ular, did, ideal, ehtiyoj, baho va nazariyalardir."}, {"question"  L  Oatda qanday koвЂrinishda yoziladi?", "options": ["f(x, y, z)", "z = f(x, y)", "f(x)", "y = f(x)"], "correct_index": 1, "explanation": "Ikki o'zgaruvchili funksiya odatda z = f(x, y) ko'rinishida yoziladi, bu yerda x va y mustaqil o'zgaruvchilar, z esa bog'liq o'zgaruvchi."}, {"question": "ToвЂla differensial formulasini koвЂrsating.", "options": ["dz = (в€‚z/в€‚x)dx", "dz = (в€‚z/в€‚y)dy", "dz = dx + dy", "dz = (в€‚z/в€‚x)dx + (в€‚z/в€‚y)dy"], "correct_index": 3, "explanation": "Ikki o'zgaruvchili funksiyaning to'la differensiali dz = (в€‚z/в€‚x)dx + (в€‚z/в€‚y)dy formula bilan beriladi."}, {"question": "Agar Teylor qatorida x0 = 0 deb olinsa, funksiyaning x ning darajalari boвЂyicha qaysi qatorni hosil qilamiz?", "options": ["Sonli qatorni", "Makloren qatorini", "Teylor qatorini", "Fur'ye qatorini"], "correct_index": 1, "explanation": "Teylor qatorida x0 = 0 deb olinsa, Makloren qatori hosil bo'ladi."}, {"question": "Qachon integral II -tur xosmas integral deyiladi?", "options": ["Agar integral ostidagi funksiya integrallash oralig'ida uzilishga ega bo'lsa", "Agar integrallash chegaralari cheksiz bo'lsa", "Agar integralni hisoblash qiyin bo'lsa", "Agar integralning qiymati chekli bo'lsa"], "correct_index": 0, "explanation": "II-tur xosmas integral, agar integral ostidagi funksiya integrallash oralig'ida uzilishga ega bo'lsa, deyiladi."}, {"question": "Quyidagilardan qaysi biri Dalamber alomati formulasi?", "options": ["lim(nв†’в€ћ) (an+1 / an)", "в€«1^в€ћ f(x)dx", "lim(nв†’в€ћ) an", "lim(nв†’в€ћ) (an)^(1/n)"], "correct_index": 0, "explanation": "Dalamber alomati lim(nв†’в€ћ) (an+1 / an) = L ni hisoblashga asoslangan. Agar L<1 bo'lsa, qator yaqinlashuvchi, L>1 bo'lsa, uzoqlashuvchi."}, {"question": "Agar ОЈ an va ОЈ bn yaqinlashuvchi boвЂlsa, ОЈ (an + bn) qanday?", "options": ["Shartli yaqinlashuvchi", "Uzoqlashuvchi", "Yaqinlashuvchi", "Absolyut yaqinlashuvchi"], "correct_index": 2, "explanation": "Agar ikkita qator yaqinlashuvchi bo'lsa, ularning yig'indisi ham yaqinlashuvchi bo'ladi."}, {"question": "Aniq integralning amaliy qoвЂllanilishiga qaysi misol toвЂgвЂri?", "options": ["Funksiyaning limitini topish", "Funksiyaning boshlang'ichini topish", "Egri chiziq ostidagi yuzani hisoblash", "Funksiyaning hosilasini topish"], "correct_index": 2, "explanation": "Aniq integralning asosiy amaliy qo'llanilishlaridan biri egri chiziq bilan chegaralangan yuzalarni hisoblashdir."}, {"question": "в€«-в€ћ^+в€ћ f(x) dx integral qachon yaqinlashuvchi boвЂladi?", "options": ["Agar f(x) toq funksiya bo'lsa", "Agar f(x) juft funksiya bo'lsa", "Agar в€«-в€ћ^c f(x) dx va в€«c^+в€ћ f(x) dx ikkalasi ham yaqinlashuvchi bo'lsa", "Har doim"], "correct_index": 2, "explanation": "в€«-в€ћ^+в€ћ f(x) dx integral, agar в€«-в€ћ^c f(x) dx va в€«c^+в€ћ f(x) dx (bu yerda c ixtiyoriy son) ikkalasi ham yaqinlashuvchi bo'lsa, yaqinlashuvchi deyiladi."}, {"question": "Agar f(x, y) = 2x + y boвЂlsa, f(1,3) ni toping.", "options": ["5", "4", "7", "6"], "correct_index": 0, "explanation": "f(1,3) = 2*1 + 3 = 2 + 3 = 5."}, {"question": "Quyidagilardan qaysi biri Koshining ildiz alomati formulasi?", "options": ["lim(nв†’в€ћ) (an+1 / an)", "lim(nв†’в€ћ) an", "lim(nв†’в€ћ) (an)^(1/n)", "в€«1^в€ћ f(x)dx"], "correct_index": 2, "explanation": "Koshining ildiz alomati lim(nв†’в€ћ) (an)^(1/n) = L ni hisoblashga asoslangan. Agar L<1 bo'lsa, qator yaqinlashuvchi, L>1 bo'lsa, uzoqlashuvchi."}, {"question": "BoвЂlaklab integrallash formulasi qaysi?", "options": ["в€«udv = uv - в€«vdu", "в€«f(g(x))g'(x)dx = в€«f(u)du", "в€«a^b f(x)dx = F(b) - F(a)", "в€«f(x)dx = F(x) + C"], "correct_index": 0, "explanation": "Bo'laklab integrallash formulasi в€«udv = uv - в€«vdu ko'rinishida bo'lib, u ikki funksiya ko'paytmasining integralini hisoblashda ishlatiladi."}, {"question": "Chegarasi cheksiz boвЂlgan integral qanday aniqlanadi?", "options": ["Limit orqali", "Boshlang'ich funksi