mafkuraviy maqsadlarga erishishdir."},{"question":"Ekstremizmga qarshi kurashning muhim yoвЂnalishlaridan biri?","options":["Aholining huquqiy va diniy savodxonligini oshirish","Zo'ravonlikni qo'llash","Chegara nazoratini kuchaytirish","Iqtisodiy sanksiyalar kiritish"],"correct_index":0,"explanation":"Aholining, ayniqsa yoshlarning huquqiy va diniy savodxonligini oshirish ekstremistik g'oyalarga qarshi immunitetni shakllantiradi."},{"question":"Terrorizmga qarshi kurashning asosiy vositalaridan biri?","options":["Huquqni muhofaza qilish organlarining faoliyati","Diplomatik muzokaralar","Madaniy tadbirlar","Sport musobaqalari"],"correct_index":0,"explanation":"Huquqni muhofaza qilish organlarining faoliyati terrorchilik harakatlarining oldini olish va ul  Гarni bartaraf etishda muhim rol o'ynaydi."},{"question":"Yoshlarni ekstremizm taвЂ™siridan asrash uchun nima zarur?","options":["To'g'ri tarbiya, bilim berish va ularning dunyoqarashini kengaytirish","Ularni jamiyatdan ajratish","Ularga barcha ma'lumotni taqiqlash","Faqat diniy ta'lim berish"],"correct_index":0,"explanation":"Yoshlarga to'g'ri tarbiya berish, ularning bilimini oshirish va tanqidiy fikrlash qobiliyatini rivojlantirish ekstremistik g'oyalarga qarshi himoya vazifasini o'taydi."},{"question":"Terrorchilik faoliyatiga nimalar kiradi?","options":["Portlashlar, odam o'g'irlash, garovga olish, qotilliklar","Tinch namoyishlar","Siyosiy munozaralar","Madaniy festivallar"],"correct_index":0,"explanation":"Terrorchilik faoliyati aholi orasida vahima uyg'otishga qaratilgan zo'ravonlik harakatlarini o'z ichiga oladi."},{"question":"Ekstremizmning oldini olishning eng samarali yoвЂli?","options":["Mafkuraviy immunitetni shakllantirish","Harbiy kuch ishlatish","Iqtisodiy blokada","Siyosiy izolyatsiya"],"correct_index":0,"explanation":"Aholida, ayniqsa yoshlarda, to'g'ri mafkuraviy qarashlarni shakllantirish ekstremistik g'oyalarga qarshi eng samarali himoyadir."},{"question":"Terrorizmga qarshi kurashda xalqaro hamkorlikning roli?","options":["Global tahdidga qarshi birgalikda kurashish","Faqat bir davlatning harakatlanishi","Harbiy ittifoqlar tuzish","Iqtisodiy raqobatni kuchaytirish"],"correct_index":0,"explanation":"Terrorizm global tahdid bo'lganligi sababli, unga qarshi kurashda xalqaro hamkorlik va birgalikdagi sa'y-harakatlar juda muhimdir."},{"question":"Radikal gвЂoyalarga qarshi samarali chora?","options":["Ma'rifat va targ'ibot ishlarini kuchaytirish","Chet elga chiqishni taqiqlash","Internetni cheklash","Diniy ta'limni to'xtatish"],"correct_index":0,"explanation":"Ma'rifat va targ'ibot ishlari orqali radikal g'oyalarning xavfini tushuntirish va ularga qarshi to'g'ri qarashlarni shakllantirish samarali choradir."},{"question":"OвЂzbekiston ekstremizm va terrorizmga qarshi kurashda nimaga eвЂ™tibor beradi?","options":["Aholining ma'naviy-ma'rifiy darajasini oshirishga","Faqat harbiy kuchga","Faqat iqtisodiy choralariga","Faqat siyosiy bosimga"],"correct_index":0,"explanation":"O'zbekiston ekstremizm va terrorizmga qarshi kurashda aholining ma'naviy-ma'rifiy darajasini oshirish, yoshlarni to'g'ri tarbiyalashga alohida e'tibor qaratadi."},{"question":"Dinshunoslik fanining asosiy predmeti nima?","options":["Dinning ijtimoiy-tarixiy hodisa sifatidagi mohiyati va qonuniyatlari","Faqat diniy marosimlar","Faqat diniy binolar","Faqat diniy musiqa"],"correct_index":0,"explanation":"Dinshunoslik dinning ijtimoiy-tarixiy hodisa sifatidagi mohiyatini, uning paydo bo'lishi, rivojlanishi va jamiyatdagi o'rnini o'rganadi."},{"question":"Dinshunoslik qaysi fanlar bilan uzviy bogвЂliq?","options":["Falsafa, sotsiologiya, tarix, psixologiya","Faqat fizika va kimyo","Faqat matematika va informatika","Faqat biologiya va tibbiyot"],"correct_index":0,"explanation":"Dinshunoslik dinning turli jihatlarini o'rganishda falsafa, sotsiologiya, tarix va psixologiya kabi ko'plab gumanitar fanlar bilan aloqada bo'ladi."},{"question":"Dinshunoslik fani nimani oвЂrganadi?","options":["Dinlarni, ularning kelib chiqishi, rivojlanishi va jamiyatdagi oвЂrnini","Faqat qadimgi dinlarni","Faqat zamonaviy dinlarni","Dinlarning faqat iqtisodiy jihatlarini"],"correct_index":0,"explanation":"Dinshunoslik dinlarni kompleks tarzda, ularning tarixiy, ijtimoiy, madaniy va falsafiy jihatlarini o'rganadigan fandir."},{"question":"Dinshunoslik fanining asosiy vazifasi nima?","options":["Dinlarning mohiyatini ilmiy asosda tushuntirish va tahlil qilish","Muayyan bir dinni targ'ib qilish","Diniy marosimlarni o'tkazish","Diniy tashkilotlarni boshqarish"],"correct_index":0,"explanation":"Dinshunoslikning asosiy maqsadi dinlarni ilmiy, ob'ektiv nuqtai nazardan o'rganish va tahlil qilishdir."},{"question":"Dinshunoslik fanida qaysi yondashuv muhim?","options":["Ob'ektivlik va neytrallik","Sub'ektivlik va shaxsiy e'tiqodlarga tayanib","Faqat diniy matnlarni  Д sharhlash","Diniy rahbarlarning fikrlariga asoslanish"],"correct_index":0,"explanation":"Ilmiy yondashuv dinlarni har qanday shaxsiy e'tiqod yoki tarafkashlikdan xoli, ob'ektiv tarzda o'rganishni talab qiladi."},{"question":"Dinshunoslik fani qachon shakllangan?","options":["XIX asrning ikkinchi yarmi","Qadimgi davrlarda","O'rta asrlarda","XX asrning boshlarida"],"correct_index":0,"explanation":"Dinshunoslik fan sifatida XIX asrning ikkinchi yarmida, dinlarni ilmiy o'rganishga bo'lgan ehtiyoj natijasida shakllangan."},{"question":"Dinshunoslik fanining metodlari qaysilar?","options":["Qiyosiy-tarixiy, sotsiologik, psixologik, fenomenologik","Faqat eksperimental metod","Faqat matematik modellashtirish","Faqat laboratoriya tadqiqotlari"],"correct_index":0,"explanation":"Dinshunoslik dinlarni o'rganishda turli metodlardan, jumladan qiyosiy-tarixiy, sotsiologik, psixologik va fenomenologik metodlardan foydalanadi."},{"question":"Dinshunoslik nimani maqsad qiladi?","options":["Dinlarning ijtimoiy, madaniy va tarixiy rolini tushunish","Muayyan bir dinni targ'ib qilish","Diniy nizolarni keltirib chiqarish","Diniy ta'limotlarni majburiy qilish"],"correct_index":0,"explanation":"Dinshunoslik dinlarning jamiyatdagi o'rnini, ularning madaniyat va tarixga ta'sirini ilmiy asosda tushunishni maqsad qiladi."},{"question":"Dinshunoslik fanining ahamiyati nimada?","options":["Diniy bag'rikenglikni shakllantirish va dinlararo muloqotni rivojlantirish","Muayyan bir dinning ustunligini ta'minlash","Diniy nizolarni keltirib chiqarish","Diniy ta'limotlarni majburiy qilish"],"correct_index":0,"explanation":"Dinshunoslik dinlar haqida ob'ektiv bilim berish orqali bag'rikenglikni oshirishga va dinlararo tushunishni rivojlantirishga yordam beradi."},{"question":"Dinshunoslik fani qaysi sohada zarur?","options":["Ta'lim, ilm-fan, davlat boshqaruvi, madaniyat","Faqat harbiy sohada","Faqat sport sohasida","Faqat qishloq xo'jaligida"],"correct_index":0,"explanation":"Dinshunoslik fanining bilimlari ta'lim, ilm-fan, davlat boshqaruvi va madaniyat sohalarida din bilan bog'liq masalalarni tushunish va hal qilishda zarur."},{"question":"Milliy dinlar deganda nima tushuniladi?","options":["Muayyan bir xalq yoki etnik guruh bilan bog'liq dinlar","Butun dunyo bo'ylab tarqalgan dinlar","Faqat qadimgi dinlar","Faqat zamonaviy dinlar"],"correct_index":0,"explanation":"Milliy dinlar ma'lum bir xalq, millat yoki etnik guruhning madaniyati va an'analari bilan chambarchas bog'liq bo'ladi."},{"question":"Milliy dinlarga qaysi dinlar kiradi?","options":["Yahudiylik, Hinduizm, Shintoizm, Zardushtiylik","Xristianlik, Islom, Buddizm","Ateizm, Agnostitsizm","Faqat qadimgi Misr dinlari"],"correct_index":0,"explanation":"Yahudiylik, Hinduizm, Shintoizm va Zardushtiylik kabi dinlar ma'lum bir xalq yoki mintaqa bilan bog'liq bo'lgan milliy dinlarga misoldir."},{"question":"Yahudiylik qaysi xalqning milliy dini?","options":["Yahudiy xalqining","Arab xalqining","Hind xalqining","Yapon xalqining"],"correct_index":0,"explanation":"Yahudiylik asosan yahudiy xalqi bilan bog'liq bo'lib, ularning madaniyati va tarixining ajralmas qismidir.