000 so'mrejectedjuЬз   7 "qismiy_satr"], "correct_index": 0, "explanation": "strstr funksiyasi 'satr' kichik satrini 'qismiy_satr' satrida topadi va nullptr bo'lmagan ko'rsatkich qaytaradi. Shuning uchun ifoda true (1) qiymatini beradi."}, {"question": "Kod natijasini toping: string s=\"aaab\"; cout<<s.find(\"b\");", "options": ["3", "0", "1", "2"], "correct_index": 0, "explanation": "find funksiyasi 'b' belgisining 'aaab' satridagi birinchi uchragan indeksini qaytaradi. 'b' 3-indeksdan boshlanadi."}, {"question": "Kod natijasi qanday? int x=7; string s=to_string(x)+\" ta\"; cout<<s;", "options": ["7", "x ta", "ta 7", "7 ta"], "correct_index": 3, "explanation": "to_string funksiyasi 7 butun sonini '7' satriga aylantiradi. Keyin unga ' ta' satri qo'shiladi. Natija '7 ta' bo'ladi."}, {"question": "Quyidagi kodda qaysi satr hosil boвЂladi? string s=\"abcd\"; s.replace(1,2,\"XY\"); cout<<s;", "options": ["XYcd", "aXYd", "abcd", "abXY"], "correct_index": 1, "explanation": "replace funksiyasi 'abcd' satrining 1-indeksdan boshlab 2 ta belgisini ('bc') 'XY' satri bilan almashtiradi. Natija 'aXYd' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"algoritm\"; cout<<s.substr(4,3);", "options": ["gor", "algo", "rit", "itm"], "correct_index": 2, "explanation": "substr funksiyasi 4-indeksdan boshlab (0-indeksli 'a') 3 ta belgini oladi. Bu 'rit' satrini beradi."}, {"question": "Kod ekranga nima chiqaradi? char s[]=\"kompyuter\"; cout<<strchr(s,'p');", "options": ["kompyuter", "p", "kom", "pyuter"], "correct_index": 3, "explanation": "strchr funksiyasi 'p' belgisining 'kompyuter' satridagi birinchi uchragan joyidan boshlab qolgan qismini qaytaradi, ya'ni 'pyuter'."}, {"question": "Kod natijasini toping: string s=\"abcabcabc\"; cout<<s.find(\"abc\");", "options": ["1", "3", "0", "6"], "correct_index": 2, "explanation": "find funksiyasi 'abc' kichik satrining 'abcabcabc' satridagi birinchi uchragan indeksini qaytaradi. 'abc' 0-indeksdan boshlanadi."}, {"question": "Quyidagi kodda qaysi satr hosil boвЂladi? string s=\"kitob\"; s.replace(0,1,\"K\"); cout<<s;", "options": ["kitob", "Kkitob", "itob", "Kitob"], "correct_index": 3, "explanation": "replace funksiyasi 'kitob' satrining 0-indeksdan boshlab 1 ta belgisini ('k') 'K' satri bilan almashtiradi. Natija 'Kitob' bo'ladi."}, {"question": "Quyidagi kodda qaysi satr hosil boвЂladi? string s=\"salom\"; s.replace(1,3,\"AB\"); cout<<s;", "options": ["sABlom", "sABm", "salom", "ABsalom"], "correct_index": 1, "explanation": "replace funksiyasi 'salom' satrining 1-indeksdan boshlab 3 ta belgisini ('alo') 'AB' satri bilan almashtiradi. Natija 'sABm' bo'ladi."}, {"question": "Quyidagi kodda ekranga nima chiqadi: string s = \"salom\"; s.insert(0,\"Assalomu \"); cout << s;", "options": ["Assalomu", "salomAssalomu ", "salom", "Assalomu salom"], "correct_index": 3, "explanation": "insert funksiyasi 'Assalomu ' satrini 'salom' satrining 0-indeksiga (boshiga) kiritadi. Natija 'Assalomu salom' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"email@test.uz\"; cout<<s.find(\"@\");", "options": ["0", "4", "6", "5"], "correct_index": 3, "explanation": "find funksiyasi '@' belgisining 'email@test.uz' satridagi birinchi uchragan indeksini qaytaradi. '@' 5-indeksdan boshlanadi."}, {"question": "Kod natijasini toping: string s=\"kompyuter\"; s.erase(3,2); cout<<s;", "options": ["komuter", "komp", "koter", "kompyuter"], "correct_index": 0, "explanation": "erase funksiyasi 'kompyuter' satridan 3-indeksdan boshlab (0-indeksli 'k') 2 ta belgini ('py') o'chiradi. Natija 'komuter' bo'ladi."}, {"question": "Kod natijasini toping: char s[]=\"125\"; int x=atoi(s); cout<<x+6;", "options": ["6", "125", "131", "119"], "correct_index": 2, "explanation": "atoi funksiyasi '125' satrini butun songa (125) aylantiradi. Keyin 125 ga 6 qo'shiladi, natija 131."}, {"question": "Kod natijasini toping: string s=\"90\"; int x=stoi(s); cout<<x+1;", "options": ["90", "1", "89", "91"], "correct_index": 3, "explanation": "stoi funksiyasi '90' satrini butun songa (90) aylantiradi. Keyin 90 ga 1 qo'shiladi, natija 91."}, {"question": "Kod n   :atijasini toping: string s=\"AI\"; s.append(\" yordamchi\"); cout<<s;", "options": ["AI yordamchi", "AI", "AIyordamchi", "yordamchiAI"], "correct_index": 0, "explanation": "append funksiyasi ' yordamchi' satrini 'AI' satrining oxiriga qo'shadi. Natija 'AI yordamchi' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"12345\"; reverse(s.begin(), s.end()); cout<<s;", "options": ["15243", "54321", "51423", "12345"], "correct_index": 1, "explanation": "reverse funksiyasi '12345' satrini teskari tartibda joylashtiradi. Natija '54321' bo'ladi."}, {"question": "Kod natijasini toping: char s[]=\"2026\"; int x=atoi(s); cout<<x+6;", "options": ["2032", "2026", "6", "2020"], "correct_index": 0, "explanation": "atoi funksiyasi '2026' satrini butun songa (2026) aylantiradi. Keyin 2026 ga 6 qo'shiladi, natija 2032."}, {"question": "Kod natijasini toping: string s=\"C++\"; s.append(\"17\"); cout<<s;", "options": ["17C++", "C++", "C++17", "C+17+"], "correct_index": 2, "explanation": "append funksiyasi '17' satrini 'C++' satrining oxiriga qo'shadi. Natija 'C++17' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"test\"; s.append(\".txt\"); cout<<s;", "options": ["test.txt", ".txttest", "test", "test txt"], "correct_index": 0, "explanation": "append funksiyasi '.txt' satrini 'test' satrining oxiriga qo'shadi. Natija 'test.txt' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"salom\"; reverse(s.begin(), s.end()); cout<<s;", "options": ["salom", "masol", "solam", "molas"], "correct_index": 3, "explanation": "reverse funksiyasi 'salom' satrini teskari tartibda joylashtiradi. Natija 'molas' bo'ladi."}, {"question": "Kod ekranga nima chiqaradi? char s[]=\"informatika\"; cout<<strchr(s,'m');", "options": ["m", "informatika", "matika", ""], "correct_index": 3, "explanation": "strchr funksiyasi 'm' belgisini 'informatika' satrida topa olmaydi va nullptr qaytaradi. cout nullptr ni bo'sh satr sifatida chiqaradi."}, {"question": "Quyidagi kodda strcmp natijasi qanday baholanadi: cout << (strcmp(\"abc\",\"abc\") == 0);", "options": ["1", "abc", "true", "0"], "correct_index": 0, "explanation": "strcmp funksiyasi 'abc' va 'abc' satrlarini solishtiradi. Ular bir xil bo'lgani uchun 0 qaytaradi. 0 == 0 ifodasi true (1) qiymatini beradi."}, {"question": "Quyidagi kodda ekranga nima chiqadi: string s = \"C++\"; s.insert(3,\"17\"); cout << s;", "options": ["17C++", "C++17", "C17++", "C++"], "correct_index": 1, "explanation": "insert funksiyasi '17' satrini 'C++' satrining 3-indeksiga (oxiriga) kiritadi. Natija 'C++17' bo'ladi."}, {"question": "Kod natijasini toping: char s[]=\"algoritmlar\"; cout<<(strstr(s,\"ritm\")!=nullptr);", "options": ["0", "algoritmlar", "1", "ritm"], "correct_index": 2, "explanation": "strstr funksiyasi 'ritm' kichik satrini 'algoritmlar' satrida topadi va nullptr bo'lmagan ko'rsatkich qaytaradi. Shuning uchun ifoda true (1) qiymatini beradi."}, {"question": "Quyidagi kodda qaysi satr hosil boвЂladi? string s=\"dastur\"; s.replace(3,3,\"ta\" ); cout<<s;", "options": ["dasturta", "dasta", "dastur", "dastta"], "correct_index": 1, "explanation": "replace funksiyasi 'dastur' satrining 3-indeksdan boshlab 3 ta belgisini ('tur') 'ta' satri bilan almashtiradi. Natija 'dasta' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"aaabbb\"; s.erase(2,2); cout<<s;", "options": ["aaab", "aaabbb", "abbb", "aabb"], "correct_index": 3, "explanation": "erase funksiyasi 'aaabbb' satridan 2-indeksdan boshlab (0-indeksli birinchi 'a') 2 ta belgini ('ab') o'chiradi. Natija 'aabb' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"45\"; int x=stoi(s); cout<<x+1;", "options": ["46", "1", "45", "44"], "correct_index": 0, "explanation": "stoi funksiyasi '45' satrini butun songa (45) aylantiradi. Keyin 45 ga 1 qo'shiladi, natija 46."}, {"question": "Kod natijasini toping: string s=\"data_analysis\"; cout<<s.find(\"ana\");", "options": ["9", "0", "1", "5"], "correct_index": 3, "explanation": "find funksiyasi 'ana' kichik satrining 'data_analysis' satridagi birinchi uchragan indeksini qaytaradi. 'ana' 5-indeksda
