"], "correct_index": 0, "explanation": "z'x = 1, z''xx = 0."}, {"question": "Hayotda вЂњOptimallashtirishвЂќ nima uchun kerak?", "options": ["Resurslardan samarali foydalanish va eng yaxshi natijaga erishish uchun", "Muammolarni murakkablashtirish uchun", "Faqat nazariy masalalarni hal qilish uchun", "Hech qanday amaliy ahamiyatga ega emas"], "correct_index": 0, "explanation": "Optimallashtirish resurslardan samarali foydalanib, eng yaxshi natijaga erishish uchun muhimdir."}, {"question": "вЂњMaqsad funksiyasiвЂќ deganda nimani tushunasiz?", "options": ["Optimallashtirilishi kerak bo'lgan funksiya (masalan, foyda, xarajat)", "Cheklovlarni ifodalovchi funksiya", "Yordamchi funksiya", "Noma'lum o'zgaruvchilar"], "correct_index": 0, "explanation": "Maqsad funksiyasi - bu optimallashtirish masalasida maksimal yoki minimal qiymati topilishi kerak bo'lgan funksiya."}, {"question": "Matematik modeldagi вЂњCheklovlarвЂќ nima?", "options": ["Resurslar, vaqt, byudjet kabi cheklanganliklarni ifodalovchi tengsizliklar yoki tengliklar", "Optimallashtirilishi kerak bo'lgan funksiya", "Noma'lum o'zgaruvchilar", "Modelning yechimi"], "correct_index": 0, "explanation": "Cheklovlar - bu modeldagi resurslar, vaqt, byudjet kabi cheklanganliklarni ifodalovchi shartlar."}, {"question": "Model tuzishda вЂњSoddalikвЂќ tamoyili nima uchun kerak?", "options": ["Modelni tushunish va yechishni osonlashtirish uchun", "Modelni murakkablashtirish uchun", "Modelning aniqligini oshirish uchun", "Modelni haqiqatga yaqinlashtirish uchun"], "correct_index": 0, "explanation": "Soddalik tamoyili modelni tushunish, tahlil qilish va yechishni osonlashtiradi."}, {"question": "Nomanfiylik sharti (x в‰Ґ 0) nimani bildiradi?", "options": ["O'zgaruvchilarning manfiy bo'lmasligini", "O'zgaruvchilarning musbat bo'lishini", "O'zgaruvchilarning nolga teng bo'lishini", "O'zgaruvchilarning cheksiz bo'lishini"], "correct_index": 0, "explanation": "Nomanfiylik sharti o'zgaruvchilarning nolga teng yoki undan katta bo'l