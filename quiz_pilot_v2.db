tion": "Kibermakonda ekstremistik gвЂoyalar qanday niqoblanadi?", "options": ["Diniy shiorlar, adolat chaqiriqlari, ijtimoiy muammolarni hal qilish niqobi ostida", "Ilmiy maqolalar sifatida", "Madaniy tadbirlar sifatida", "Sport yangiliklari sifatida"], "correct_index": 0, "explanation": "Kibermakonda ekstremistik gвЂoyalar koвЂpincha diniy shiorlar, adolat chaqiriqlari, ijtimoiy muammolarni hal qilish vaвЂ™dalari niqobi ostida tarqatiladi."}, {"question": "Internetda diniy bilimni qayerdan olish maвЂ™qul?", "options": ["Rasmiy diniy tashkilotlarning veb-saytlari, ishonchli ulamolarning sahifalari", "NomaвЂ™lum bloglar, radikal guruhlarning sahifalari", "Ijtimoiy tarmoqlardagi tasodifiy postlar", "Har qanday manbadan"], "correct_index": 0, "explanation": "Internetda diniy bilimlarni rasmiy diniy tashkilotlarning veb-saytlari, tan olingan va ishonchli ulamolarning sahifalari, ilmiy-maвЂ™rifiy portallardan olish maвЂ™qul."}, {"question": "Kibermakonda din omili nimani talab qiladi?", "options": ["Diniy savodxonlikni oshirish, axborot xavfsizligini taвЂ™minlash", "Diniy taвЂ™limotlarni taqiqlash", "Internetni cheklash", "Diniy nizolarni qoвЂzgвЂash"], "correct_index": 0, "explanation": "Kibermakonda din omili diniy savodxonlikni oshirishni, axborot xavfsizligini taвЂ™minlashni va zararli kontentga qarshi kurashishni talab qiladi."}, {"question": "Raqamli makonda diniy xavfsizlik nimani anglatadi?", "options": ["Internetda diniy ekstremizm va terrorizmga qarshi kurashish", "Diniy taвЂ™limotlarni butunlay taqiqlash", "Faqat diniy tashkilotlarni nazorat qilish", "Faqat shaxsiy maвЂ™lumotlarni himoya qilish"], "correct_index": 0, "explanation": "Raqamli makonda diniy xavfsizlik internetda diniy ekstremizm, terrorizm va boshqa zararli diniy gвЂoyalarning tarqalishiga qarshi kurashish, fuqarolarni ularning taвЂ™siridan himoya qilishni anglatadi."}, {"question": "Diniy qadriyatlar nima?", "options": ["Din taвЂ™limotlarida aks etgan, inson va jamiyat uchun muhim boвЂlgan axloqiy meвЂ™yorlar va ideallar", "Faqat moddiy boyliklar", "Faqat siyosiy gвЂoyalar", "Faqat ilmiy kashfiyotlar"], "correct_index": 0, "explanation": "Diniy qadriyatlar din taвЂ™limotlarida aks etgan, insonning maвЂ™naviy-axloqiy kamolotiga xizmat qiladigan, jamiyat uchun muhim boвЂlgan meвЂ™yorlar, ideallar va tamoyillardir."}, {"question": "Diniy qadriyatlar nimani mustahkamlaydi?", "options": ["Oilaviy qadriyatlar, ijtimoiy adolat, bagвЂrikenglik", "Iqtisodiy tengsizlik", "Siyosiy nizolar", "Ilmiy shubhalar"], "correct_index": 0, "explanation": "Diniy qadriyatlar oilaviy qadriyatlarni, ijtimoiy adolatni, bagвЂrikenglikni, oвЂzaro hurmatni va insonparvarlikni mustahkamlaydi."}, {"question": "Inson hayotida diniy qadriyatlarning oвЂrni nimada?", "options": ["MaвЂ™naviy yoвЂnalish, axloqiy asos, ichki tinchlik", "Faqat moddiy farovonlik", "Faqat siyosiy hokimiyat", "Faqat ilmiy taraqqiyot"], "correct_index": 0, "explanation": "Diniy qadriyatlar inson hayotiga maвЂ™naviy yoвЂnalish beradi, axloqiy asos boвЂlib xizmat qiladi, ichki tinchlik va ruhiy xotirjamlikni taвЂ™minlaydi."}, {"question": "Diniy qadriyatlar qayerdan shakllanadi?", "options": ["Muqaddas kitoblar, paygвЂambarlar taвЂ™limotlari, diniy anвЂ™analar", "Faqat hukumat qarorlari", "Faqat ilmiy tadqiqotlar", "Faqat shaxsiy xohishlar"], "correct_index": 0, "explanation": "Diniy qadriyatlar muqaddas kitoblar, paygвЂambarlar taвЂ™limotlari, diniy anвЂ™analar va ulamolarning sharhlari asosida shakllanadi."}, {"question": "Diniy qadriyatlar yoshlar   Йtarbiyasida nimani taвЂ™minlaydi?", "options": ["Axloqiy kamolot, vatanparvarlik, insonparvarlik", "Faqat moddiy manfaat", "Faqat siyosiy ambitsiyalar", "Faqat ilmiy bilimlarni"], "correct_index": 0, "explanation": "Diniy qadriyatlar yoshlar tarbiyasida axloqiy kamolotni, vatanparvarlikni, insonparvarlikni, oвЂzaro hurmat va bagвЂrikenglikni taвЂ™minlaydi."}, {"question": "BagвЂrikenglik qaysi qadriyat bilan bogвЂliq?", "options": ["Diniy qadriyatlar", "Iqtisodiy qadriyatlar", "Siyosiy qadriyatlar", "Ilmiy qadriyatlar"], "correct_index": 0, "explanation": "BagвЂrikenglik (tolerantlik) koвЂplab dinlarning asosiy qadriyatlaridan biri boвЂlib, boshqa dinlarga, eвЂ™tiqodlarga va madaniyatlarga hurmat bilan qarashni anglatadi."}, {"question": "Diniy qadriyatlar jamiyatda nimani kuchaytiradi?", "options": ["Ijtimoiy birdamlik, oвЂzaro yordam, tinchlik", "Ijtimoiy boвЂlinish", "ZoвЂravonlik", "Tengsizlik"], "correct_index": 0, "explanation": "Diniy qadriyatlar jamiyatda ijtimoiy birdamlikni, oвЂzaro yordamni, tinchlikni va hamjihatlikni kuchaytiradi."}, {"question": "Diniy qadriyatlar qachon buziladi?", "options": ["Ekstremizm, fanatizm, notoвЂgвЂri talqinlar paydo boвЂlganda", "Ilmiy taraqqiyot yuz berganda", "Iqtisodiy oвЂsish boвЂlganda", "Madaniy almashinuvda"], "correct_index": 0, "explanation": "Diniy qadriyatlar ekstremizm, fanatizm, diniy taвЂ™limotlarning notoвЂgвЂri talqinlari va murosasizlik paydo boвЂlganda buziladi."}, {"question": "Diniy qadriyatlar qaysi sohada muhim?", "options": ["MaвЂ™naviyat, axloq, tarbiya", "Faqat iqtisodiyot", "Faqat siyosat", "Faqat texnologiya"], "correct_index": 0, "explanation": "Diniy qadriyatlar maвЂ™naviyat, axloq, tarbiya, oila va ijtimoiy munosabatlar sohasida muhim ahamiyatga ega."}, {"question": "Diniy qadriyatlar nimani targвЂib qiladi?", "options": ["Ezgulik, adolat, rahm-shafqat, halollik", "Yomonlik, adolatsizlik, shafqatsizlik, yolgвЂonchilik", "Faqat moddiy boylik", "Faqat siyosiy hokimiyat"], "correct_index": 0, "explanation": "Diniy qadriyatlar ezgulik, adolat, rahm-shafqat, halollik, poklik va insonparvarlik kabi fazilatlarni targвЂib qiladi."}, {"question": "Diniy qadriyatlar milliy qadriyatlar bilan qanday bogвЂliq?", "options": ["Bir-birini toвЂldiradi va mustahkamlaydi", "Bir-biriga zid", "Bir-biridan butunlay mustaqil", "Hech qanday bogвЂliqligi yoвЂq"], "correct_index": 0, "explanation": "Diniy qadriyatlar milliy qadriyatlar bilan chambarchas bogвЂliq boвЂlib, bir-birini toвЂldiradi, mustahkamlaydi va xalqning maвЂ™naviy asosini tashkil etadi."}, {"question": "Diniy qadriyatlar globallashuv sharoitida nimani talab qiladi?", "options": ["Ularni saqlash, himoya qilish va toвЂgвЂri targвЂib qilish", "Ularni butunlay rad etish", "Ularni oвЂzgartirish", "Ularni cheklash"], "correct_index": 0, "explanation": "Globallashuv sharoitida diniy qadriyatlarni saqlash, himoya qilish, ularni notoвЂgвЂri talqinlardan asrash va toвЂgвЂri targвЂib qilish muhim ahamiyat kasb etadi."}, {"question": "Diniy sekta nima?", "options": ["Asosiy dindan ajralib chiqqan, oвЂziga xos taвЂ™limot va amaliyotlarga ega kichik diniy guruh", "Katta diniy tashkilot", "Diniy taвЂ™lim muassasasi", "Diniy bayram"], "correct_index": 0, "explanation": "Diniy sekta (oqim) asosiy, anвЂ™anaviy dindan ajralib chiqqan, oвЂziga xos, koвЂpincha radikal taвЂ™limot va amaliyotlarga ega kichik diniy guruhdir."}, {"question": "Sektalarning asosiy belgisi nima?", "options": ["Asosiy dindan farqli taвЂ™limot, yopiq jamoa, liderga mutlaq itoat", "Keng tarqalganlik", "Ochiqlik", "Demokratik boshqaruv"], "correct_index": 0, "explanation": "Sektalarning asosiy belgilari asosiy dindan farqli taвЂ™limotlar, yopiq va izolyatsiya qilingan jamoa, liderga mutlaq itoat va koвЂpincha radikal gвЂoyalardir."}, {"question": "Diniy oqimlar qanday paydo boвЂladi?", "options": ["Diniy taвЂ™limotlarni notoвЂgвЂri talqin qilish, ijtimoiy norozilik, liderning shaxsiy ambitsiyalari", "Ilmiy kashfiyotlar", "Iqtisodiy rivojlanish", "Siyosiy barqarorlik"], "correct_index": 0, "explanation": "D    iniy oqimlar (sektalar) diniy taвЂ™limotlarni notoвЂgвЂri talqin qilish, ijtimoiy-iqtisodiy muammolar, norozilik kayfiyatlari va karizmatik liderlarning shaxsiy ambitsiyalari natijasida paydo boвЂladi."}, {"question": "Sektalar koвЂpincha kimlarni nishonga oladi?", "options": ["Diniy savodsiz, ijtimoiy zaif, hayotda oвЂz oвЂrnini topmagan shaxslarni", "Diniy bilimi yuqori boвЂlganlarni", "Ijtimoiy faol shaxslarni", "Ilmiy doiralarni"], "correct_index": 0, "explanation": "Sektalar koвЂpincha diniy savodsiz, ijtimoiy zaif, hayotda oвЂz oвЂrnini topmagan, ruhiy tushkunlikdagi shaxslarni oвЂz saflariga tortishga harakat qiladi."}, {"question": "Diniy sektalarning xavfi nimada?", "options": ["Shaxsning ruhiy va jismoniy salomatligiga zarar yetkazish, oilalarni buzish, jamiyatga tahdid solish", "Iqtisodiy rivojlanishga hissa qoвЂshish", "Madaniy almashinuvni rivojlantirish", "Ilmiy taraqqiyotni tezlashtirish"], "correct_index": 0, "explanation": "Diniy sektalar shaxsning ruhiy va jismoniy salomatligiga zarar yetkazishi, oilalarni buzishi, jamiyatda nizolar keltirib chiqarishi va hatto terrorchilikka olib kelishi mumkin."}, {"question": "Sektalar qanday usullardan foydalanadi?", "options": ["Psixologik bosim, manipulyatsiya, yolgвЂon vaвЂ™dalar", "Ochiq muloqot", "Ilmiy dalillar", "Demokratik usullar"], "correct_index": 0, "explanation": "Sektalar oвЂz aвЂ™zolarini jalb qilish va ushlab turish uchun psixologik bosim, manipulyatsiya, yolgвЂon vaвЂ™dalar, izolyatsiya va miya yuvish kabi usullardan foydalanadi."}, {"question": "Diniy oqimlar nimani buzishi mumkin?", "options": ["AnвЂ™anaviy diniy qadriyatlar, ijtimoiy barqarorlik, milliy birlik", "Ilmiy bilimlarni", "Iqtisodiy tizimlarni", "Siyosiy partiyalarni"], "correct_index": 0, "explanation": "Diniy oqimlar anвЂ™anaviy diniy qadriyatlarni buzishi, ijtimoiy barqarorlikka putur yetkazishi, milliy birlikni zaiflashtirishi va nizolarni keltirib chiqarishi mumkin."}, {"question": "Sektalarga qarshi kurash nimadan boshlanadi?", "options": ["Aholining diniy savodxonligini oshirish va toвЂgвЂri maвЂ™rifat berishdan", "Ularni butunlay taqiqlashdan", "Ularni eвЂ™tiborsiz qoldirishdan", "Faqat jazolashdan"], "correct_index": 0, "explanation": "Sektalarga qarshi kurashning eng samarali yoвЂli aholining, ayniqsa yoshlarning diniy savodxonligini oshirish, ularga toв