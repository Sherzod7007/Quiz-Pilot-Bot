ta_6518a066d4X wtg_a38fde2e02q_6943d9b23fb5424d9a07494b8a263ce5Yueeyj‰„N    ion Sortning eng yaxshi holati (massiv allaqachon saralangan bo'lsa) O(n) chiziqli murakkablikka ega, chunki har bir element faqat bir marta tekshiriladi."}, {"question": "Grafni toвЂliq tekshirish uchun qaysi algoritmlardan foydalanamiz?", "options": ["BFS va DFS", "Binary Search", "Merge Sort", "Quick Sort"], "correct_index": 0, "explanation": "Grafni to'liq tekshirish (ya'ni, barcha tugunlarni va qirralarni ko'rib chiqish) uchun BFS (Kenglik bo'yicha qidiruv) va DFS (Chuqurlik bo'yicha qidiruv) algoritmlaridan foydalaniladi."}, {"question": "Qo'shnilik ro'yxati (adjacency list) sifatida berilgan V tugun va E qirrali grafda BFS ning vaqt murakkabligi qanday?", "options": ["O(E)", "O(V * E)", "O(V + E)", "O(V)"], "correct_index": 2, "explanation": "Qo'shnilik ro'yxati bilan berilgan grafda BFS ning vaqt murakkabligi O(V + E) ga teng, bu yerda V tugunlar soni, E esa qirralar soni."}, {"question": "Tugunni bo'lish paytida qaysi kalit yuqoriga (ota tugunga) ko'tariladi?", "options": ["Eng katta kalit", "Eng kichik kalit", "O'rtadagi kalit", "Tasodifiy kalit"], "correct_index": 2, "explanation": "Tugunni bo'lish (split) paytida, tugundagi kalitlarning o'rtadagi kaliti yuqoriga (ota tugunga) ko'tariladi."}, {"question": "MaКјlumotlar yaxlitligi (data integrity) ning necha xil turi bor?", "options": ["1", "3", "4", "2"], "correct_index": 2, "explanation": "Ma'lumotlar yaxlitligining asosiy turlari: Entity Integrity (obyekt yaxlitligi), Referential Integrity (havola yaxlitligi), Domain Integrity (domen yaxlitligi) va User-Defined Integrity (foydalanuvchi tomonidan belgilangan yaxlitlik)."}, {"question": "Heap-Sort algoritmining o'rtacha va eng yomon holatdagi vaqt murakkabligi qanday?", "options": ["O(n^2)", "O(n)", "O(n log n)", "O(log n)"], "correct_index": 2, "explanation": "Heap-Sort algoritmining o'rtacha va eng yomon holatdagi vaqt murakkabligi O(n log n) ga teng."}, {"question": "Qaysi javobda Logarifmik murakkablik keltirilgan?", "options": ["O(n!)", "O(n)", "O(log n)", "O(n^2)"], "correct_index": 2, "explanation": "O(log n) logarifmik murakkablikni ifodalaydi, bu juda samarali hisoblash murakkabligi hisoblanadi."}, {"question": "1 mln ta elementdan iborat int (4 bayt) toifali massiv berilgan. U xotiradan necha MB (mega bayt) joy oladi?", "options": ["2 MB", "4 MB", "1 MB", "8 MB"], "correct_index": 1, "explanation": "1 million element * 4 bayt/element = 4,000,000 bayt. 4,000,000 bayt / (1024 * 1024) bayt/MB в‰€ 3.81 MB. Eng yaqin javob 4 MB."}, {"question": "Hisoblash modeli nima?", "options": ["Ma'lumotlar bazasi", "Kompyuter arxitekturasi", "Dasturlash tili", "Algoritmlarning ishlashini tahlil qilish uchun abstrakt tizim"], "correct_index": 3, "explanation": "Hisoblash modeli - bu algoritmlarning ishlashini va resurs sarfini (vaqt, xotira) tahlil qilish uchun ishlatiladigan abstrakt tizim."}, {"question": "Algoritmlarning qanday holatlari mavjud", "options": ["Tez, sekin, normal", "Yaxshi, yomon, o'rtacha", "Oddiy, murakkab, optimal", "Eng yaxshi, eng yomon, o'rtacha"], "correct_index": 3, "explanation": "Algoritmlarning samaradorligi odatda uchta holatda baholanadi: eng yaxshi holat (Best Case), eng yomon holat (Worst Case) va o'rtacha holat (Average Case)."}, {"question": "Grafda oвЂtish nima?", "options": ["Grafdagi qirralarni qo'shish", "Grafdagi barcha tugunlarni bir marta ziyorat qilish", "Grafdagi eng qisqa yo'lni topish", "Grafdagi tugunlarni o'chirish"], "correct_index": 1, "explanation": "Grafda o'tish (Graph Traversal) - bu grafdagi barcha tugunlarni (yoki ma'lum bir shartga javob beradigan tugunlarni) bir marta ziyorat qilish jarayoni."}, {"question": "Hisoblash geometriyasi qayerda qoвЂllaniladi?", "options": ["Faqat veb-dasturlashda", "Faqat matn tahlilida", "Kompyuter grafikasi, robototexnika, geografik axborot tizimlari (GIS), CAD/CAM tizimlarida", "Faqat ma'lumotlar bazalarida"], "correct_index": 2, "explanation": "Hisoblash geometriyasi kompyuter grafikasi, robototexnika, geografik axborot tizimlari (GIS), CAD/CAM tizimlari, tasvirni qayta ishlash kabi ko'plab sohalarda qo'llaniladi."}]}j‰…–   љigini O(log n) da ushlab turish uchun", "Faqat xotira sarfini kamaytirish uchun", "Faqat ma'lumotlarni tezroq qo'shish uchun"], "correct_index": 1, "explanation": "Muvozanatlangan ikkilik qidiruv daraxti (masalan, AVL, Red-Black Tree) qidiruv, qo'shish va o'chirish operatsiyalarining eng yomon holatdagi vaqt murakkabligini O(log n) da ushlab turish uchun kerak, bu esa uning samaradorligini ta'minlaydi."}, {"question": "Daraxtda tanlangan tugunnning balandligi (height) nimaga teng?", "options": ["Ildizdan shu tugungacha bo'lgan yo'l uzunligi", "Shu tugunning farzandlari soni", "Shu tugundan eng uzoqdagi barg tugungacha bo'lgan eng uzun yo'l uzunligi", "Daraxtdagi tugunlar soni"], "correct_index": 2, "explanation": "Daraxtda tanlangan tugunning balandligi (height) - bu shu tugundan eng uzoqdagi barg tugungacha bo'lgan eng uzun yo'l uzunligi (qirralar soni)."}, {"question": "Nuqta (Point) tekislikda qanday ifodalanadi?", "options": ["Ikkita koordinata (x, y) bilan", "Uchta koordinata (x, y, z) bilan", "Faqat bitta koordinata bilan", "Vektor bilan"], "correct_index": 0, "explanation": "Nuqta (Point) tekislikda ikkita koordinata (x, y) bilan ifodalanadi."}, {"question": "Orientation (yoвЂnalish) nima aniqlaydi?", "options": ["Ikki chiziqning kesishish nuqtasini", "To'rt nuqtaning shaklini", "Uchta nuqtaning bir to'g'ri chiziqda joylashganligini yoki soat yo'nalishi bo'yicha/teskari yo'nalishda ekanligini", "Ikki nuqta orasidagi masofani"], "correct_index": 2, "explanation": "Orientation (yo'nalish) uchta nuqtaning bir to'g'ri chiziqda joylashganligini (kollinear), soat yo'nalishi bo'yicha (clockwise) yoki soat yo'nalishiga teskari (counter-clockwise) yo'nalishda ekanligini aniqlaydi."}, {"question": "Agar daraxt left-left (chap-chap) og'ish holatida bo'lsa bunday daraxtni muvozanatga keltirishda uni qaysi tomonga aylantiriladi?", "options": ["O'ngga, keyin chapga", "Faqat chapga", "Faqat o'ngga", "Chapga, keyin o'ngga"], "correct_index": 2, "explanation": "Left-Left (LL) og'ish holatida daraxtni muvozanatga keltirish uchun bitta o'ng aylantirish (Right Rotation) bajariladi."}, {"question": "Qismiy satr yana qanday nom bilan ataladi?", "options": ["Belgi", "Asosiy satr", "Naqsh (Pattern)", "Matn"], "correct_index": 2, "explanation": "Qismiy satr (Substring) ko'pincha 'Naqsh' (Pattern) deb ham ataladi, ayniqsa satr qidirish algoritmlarida."}, {"question": "Binar uyumdan ildiz (root) element o'chirilganda, uning o'rniga vaqtincha qaysi element qo'yiladi?", "options": ["Eng kichik element", "Massivning oxirgi elementi", "Tasodifiy element", "Eng katta element"], "correct_index": 1, "explanation": "Binar uyumdan ildiz element o'chirilganda, uyumning to'liq binar daraxt xossasini saqlash uchun massivning oxirgi elementi ildizga vaqtincha qo'yiladi, so'ngra 'Heapify-down' amali bajariladi."}, {"question": "AVL daraxtiga yangi tugun qo'shilganda muvozanat buzilsa, maksimal necha turdagi aylantirish (rotation) ishlatilishi mumkin?", "options": ["4", "1", "3", "2"], "correct_index": 0, "explanation": "AVL daraxtida muvozanatni tiklash uchun to'rt turdagi aylantirish (LL, RR, LR, RL) ishlatilishi mumkin. LR va RL ikki marta aylantirishni talab qiladi."}, {"question": "Agar tugunning chap farzandining balandligi 3 va o'ng farzandining balandligi 1 bo'lsa, Balans Faktori (Balance Factor) nechaga teng?", "options": ["0", "-2", "2", "1"], "correct_index": 2, "explanation": "Balance Factor = Chap farzand balandligi - O'ng farzand balandligi = 3 - 1 = 2. Bu tugun muvozanatlanmaganligini bildiradi."}, {"question": "Tez saralash (Quick Sort) algoritmi qaysi saralash algoritmiga oвЂxshaydi?", "options": ["Merge Sort", "Heap Sort", "Selection Sort", "Insertion Sort"], "correct_index": 2, "explanation": "Quick Sort va Selection Sort ikkalasi ham massivni bo'lish va elementlarni o'z joyiga qo'yish g'oyasiga ega, ammo Quick Sort pivot atrofida bo'lish orqali tezroq ishlaydi."}, {"question": "Insertion Sortning eng yaxshi holat murakkabligi qanday?", "options": ["O(n^2)", "O(n)", "O(n log n)", "O(1)"], "correct_index": 1, "explanation": "Insert   ›misol boвЂladi?", "options": ["Matnni formatlash", "Matnni saqlash", "Matnni chop etish", "\"Topish va almashtirish\" (Find and Replace) funksiyasi"], "correct_index": 3, "explanation": "Matn muharrirlaridagi \"Topish va almashtirish\" (Find and Replace) funksiyasi satrlardan qismiy satrlarni qidirishga (va keyin almashtirishga) yorqin misol bo'la oladi."}, {"question": "Daraxtda avlod (descendant) deb qaysi tugunlarga aytiladi?", "options": ["Tugunning ota-onasi", "Tugunning farzandlari va ularning farzandlari (ya'ni, undan pastdagi barcha tugunlar)", "Tugunning aka-ukalari", "Tugunning ildizi"], "correct_index": 1, "explanation": "Daraxtda avlod (descendant) - bu tanlangan tugunning farzandlari va ularning farzandlari, ya'ni undan pastdagi barcha tugunlar."}, {"question": "Stek qaysi tamoyil asosida ishlaydi?", "options": ["LIFO (Last-In, First-Out)", "Priority Based", "Random Access", "FIFO (First-In, First-Out)"], "correct_index": 0, "explanation": "Stek LIFO (Last-In, First-Out) tamoyili asosida ishlaydi, ya'ni oxirgi qo'shilgan element birinchi bo'lib olinadi."}, {"question": "Primitiv (sodda) qidiruv algoritmining eng yomon holatdagi vaqt murakkabligi qanday?", "options": ["O(m)", "O(n)", "O(m+n)", "O(m*n)"], "correct_index": 3, "explanation": "Primitiv (sodda) qidiruv algoritmining eng yomon holatdagi vaqt murakkabligi O(m*n) ga teng, bu yerda n - matn uzunligi, m - qidirilayotgan qismiy satr uzunligi."}, {"question": "Graf G = (V, E) da E nimani bildiradi?", "options": ["Qirralar (chekkalar) to'plami", "Tugunlar to'plami", "Grafning hajmi", "Grafning turi"], "correct_index": 0, "explanation": "Graf G = (V, E) da E qirralar (edges) to'plamini bildiradi."}, {"question": "Algoritm nima?", "options": ["Kompyuter dasturi", "Dasturlash tili", "Muammoni hal qilish uchun aniq ko'rsatmalar ketma-ketligi", "Ma'lumotlar tuzilmasi"], "correct_index": 2, "explanation": "Algoritm - bu ma'lum bir muammoni hal qilish uchun qadam-baqadam, aniq va chekli ko'rsatmalar ketma-ketligi."}, {"question": "QoвЂshnichilik roвЂyxati (adjacency list) nimani bildiradi?", "options": ["Grafdagi barcha tugunlar ro'yxati", "Grafdagi barcha qirralar ro'yxati", "Grafning og'irliklari ro'yxati", "Har bir tugun uchun unga qo'shni bo'lgan tugunlar ro'yxati"], "correct_index": 3, "explanation": "Qo'shnichilik ro'yxati (Adjacency List) - bu har bir tugun uchun unga bevosita qo'shni bo'lgan tugunlar ro'yxatini saqlovchi ma'lumotlar tuzilmasi."}, {"question": "ToвЂliq grafda 5 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["8", "12", "5", "10"], "correct_index": 3, "explanation": "To'liq grafdagi qirralar sonini topish formulasi n * (n - 1) / 2. Bu yerda n=5 bo'lsa, 5 * (5 - 1) / 2 = 5 * 4 / 2 = 10 ta qirra bo'ladi."}, {"question": "Agar daraxtda 8 ta tugun mavjud bo'lsa uning Pryufer kodi uzunligi nechchiga teng boвЂladi?", "options": ["8", "7", "6", "9"], "correct_index": 2, "explanation": "Pryufer kodi uzunligi n-2 formulasi bo'yicha, 8 ta tugun bo'lsa, 8-2 = 6 ga teng bo'ladi."}, {"question": "Active Set nima?", "options": ["Barcha elementlar to'plami", "Algoritm ishlashi davomida faol foydalaniladigan elementlar to'plami", "Faqat o'chirilgan elementlar to'plami", "Faqat qo'shilgan elementlar to'plami"], "correct_index": 1, "explanation": "Active Set (Faol to'plam) - bu algoritm ishlashi davomida ma'lum bir vaqtda faol foydalaniladigan yoki ko'rib chiqilayotgan elementlar to'plami."}, {"question": "Agar orientation = 0 boвЂlsa, bu nimani anglatadi?", "options": ["Nuqtalar bir-biriga juda yaqin", "Nuqtalar soat yo'nalishiga teskari joylashgan", "Nuqtalar soat yo'nalishi bo'yicha joylashgan", "Nuqtalar bir to'g'ri chiziqda (kollinear) joylashgan"], "correct_index": 3, "explanation": "Agar orientation = 0 bo'lsa, bu uchta nuqtaning bir to'g'ri chiziqda (kollinear) joylashganligini anglatadi."}, {"question": "Muvozanatlangan ikkilik qidiruv daraxti (Balanced Binary Search Tree) nima uchun kerak?", "options": ["Daraxtni chiroyli ko'rsatish uchun", "Qidiruv, qo'shish va o'chirish operatsiyalarining eng yomon holatdagi murakkabl   њ paradigmasi asosida ishlaydi."}, {"question": "Ichki saralash (Internal Sorting) nimani anglatadi?", "options": ["Saralash algoritmining ichki qismi", "Ma'lumotlar diskda saralanishi", "Saralanishi kerak bo'lgan barcha ma'lumotlar xotiraga sig'ishi", "Ma'lumotlar tarmoq orqali saralanishi"], "correct_index": 2, "explanation": "Ichki saralash (Internal Sorting) - bu saralanishi kerak bo'lgan barcha ma'lumotlar kompyuterning asosiy xotirasiga (RAM) sig'adigan holatda bajariladigan saralash."}, {"question": "BFS algoritmi qaysi maвЂ™lumot tuzilmasiga asoslanadi?", "options": ["Daraxt", "Massiv", "Stek", "Navbat"], "correct_index": 3, "explanation": "BFS (Breadth-First Search) algoritmi navbat (Queue) ma'lumotlar tuzilmasiga asoslanadi."}, {"question": "AVL daraxtida qidirish operatsiyasining vaqt murakkabligi (Time Complexity) qancha?", "options": ["O(n)", "O(1)", "O(n log n)", "O(log n)"], "correct_index": 3, "explanation": "AVL daraxti muvozanatlangan bo'lganligi sababli, qidirish operatsiyasining vaqt murakkabligi har doim O(log n) ga teng."}, {"question": "Binar uyumda eng katta (Max-Heap bo'lsa) yoki eng kichik (Min-Heap) element har doim qayerda bo'ladi?", "options": ["Daraxtning o'rtasida", "Eng chap bargda", "Eng o'ng bargda", "Ildiz tugunda"], "correct_index": 3, "explanation": "Binar uyumning xossasiga ko'ra, eng katta element (Max-Heapda) yoki eng kichik element (Min-Heapda) har doim ildiz tugunda joylashgan bo'ladi."}, {"question": "External Sorting (Tashqi saralash) uchun nega Birlashtirib saralash (Merge Sort) tanlanadi?", "options": ["U katta ma'lumotlar to'plamini diskdan o'qib, saralash va yozish uchun samarali bo'lgani uchun", "Uning xotira murakkabligi O(1) bo'lgani uchun", "Uning implementatsiyasi juda oddiy bo'lgani uchun", "Uning eng yomon holatdagi murakkabligi O(n^2) bo'lgani uchun"], "correct_index": 0, "explanation": "Merge Sort tashqi saralash uchun juda mos keladi, chunki u katta ma'lumotlar to'plamini kichik qismlarga bo'lib, ularni diskdan o'qib, saralash va qayta yozish jarayonini samarali boshqara oladi."}, {"question": "Stekga element qoвЂshish amali qanday ataladi?", "options": ["Push", "Enqueue", "Pop", "Dequeue"], "correct_index": 0, "explanation": "Stekga element qo'shish amali 'Push' deb ataladi."}, {"question": "Quyidagilardan qaysi biri ideal xesh funksiyaning muhim xususiyati hisoblanadi?", "options": ["Hisoblash uchun juda ko'p vaqt talab qilishi", "Kolliziyalarni minimallashtirishi va xesh qiymatlarini bir tekis taqsimlashi", "Faqat ma'lum turdagi ma'lumotlar uchun ishlashi", "Kolliziyalarni ko'p hosil qilishi"], "correct_index": 1, "explanation": "Ideal xesh funksiyaning muhim xususiyati kolliziyalarni minimallashtirishi va xesh qiymatlarini xesh jadval bo'ylab bir tekis taqsimlashi, bu esa operatsiyalarning o'rtacha O(1) murakkabligini ta'minlaydi."}, {"question": "MaвЂ™lumotlarning abstrakt turlarida maвЂ™lumotning xotirada qanday saqlanishi muhimmi?", "options": ["Yo'q, muhim emas", "Faqat ba'zi hollarda", "Ha, har doim muhim", "Faqat dasturlash tiliga bog'liq"], "correct_index": 0, "explanation": "Abstrakt ma'lumotlar turlarida (ADT) ma'lumotlarning xotirada qanday saqlanishi muhim emas, balki ularga qanday amallar bajarilishi va ularning xulq-atvori muhimdir. Implementatsiya tafsilotlari yashiriladi."}, {"question": "Quyidagilardan qaysi biri chiziqli maвЂ™lumotlar tuzilmasi emas?", "options": ["Bog'lamli ro'yxat", "Massiv", "Daraxt", "Stek"], "correct_index": 2, "explanation": "Daraxt chiziqli bo'lmagan ma'lumotlar tuzilmasi hisoblanadi, chunki uning elementlari ierarxik tarzda joylashgan."}, {"question": "Sath yoki chuqurlik (ing. level yoki depth) nima?", "options": ["Tugunning farzandlari soni", "Tugunning balandligi", "Tugunning ildizdan uzoqligi (qirralar soni)", "Daraxtdagi barg tugunlar soni"], "correct_index": 2, "explanation": "Tugunning sathi (level) yoki chuqurligi (depth) - bu ildizdan shu tugungacha bo'lgan yo'l uzunligi (qirralar soni). Ildizning sathi 0 ga teng."}, {"question": "Matn muharrirlaridagi qaysi funksiya satrlardan qismiy satrlarni qidirishga 
   џ џ                                                                                                                                                                                                                                                                                                                                                                                                                     „Ь& Q‰·Qq_6943d9b23fb5424d9a07494b8a263ce5A{"variant": "A", "quizzes": [{"question": "Undo (Bekor qilish) / Redo (Qayta bajarish) mexanizmlarini qaysi maвЂ™lumotlar tuzilmasi yordamida qilish mumkin?", "options": ["Stek", "Massiv", "Navbat", "Daraxt"], "correct_index": 0, "explanation": "Undo/Redo mexanizmlari stek yordamida samarali amalga oshiriladi, chunki oxirgi bajarilgan amal birinchi bo'lib bekor qilinadi (LIFO)."}, {"question": "Quyidagi nuqtalar toвЂplami uchun Convex Hull nechta nuqtadan iborat boвЂladi? Nuqtalar: (0,0), (2,0), (2,2), (0,2), (1,1)", "options": ["5", "4", "2", "3"], "correct_index": 1, "explanation": "Nuqtalar: (0,0), (2,0), (2,2), (0,2) kvadratning burchaklari, (1,1) esa kvadratning ichida joylashgan. Convex Hull faqat tashqi nuqtalardan iborat bo'ladi, ya'ni (0,0), (2,0), (2,2), (0,2). Shuning uchun 4 ta nuqta."}, {"question": "ToвЂliq grafda 4 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["3", "4", "8", "6"], "correct_index": 3, "explanation": "To'liq grafdagi qirralar sonini topish formulasi n * (n - 1) / 2. Bu yerda n=4 bo'lsa, 4 * (4 - 1) / 2 = 4 * 3 / 2 = 6 ta qirra bo'ladi."}, {"question": "Tez saralash (Quick Sort) algoritmining kamchiliklari nimalar?", "options": ["Eng yomon holatda O(n^2) murakkablikka ega bo'lishi", "Barqaror emasligi", "Rekursiv chaqiruvlar uchun stek xotirasi talab qilishi", "Yuqoridagi barcha javoblar"], "correct_index": 3, "explanation": "Quick Sortning kamchiliklari orasida eng yomon holatda O(n^2) murakkablik, barqaror emasligi va rekursiv chaqiruvlar uchun qo'shimcha stek xotirasi talab qilishi bor."}, {"question": "Ikki bogвЂlamli roвЂyxatda har bir tugun nechta koвЂrsatkichga ega?", "options": ["0", "3", "2", "1"], "correct_index": 2, "explanation": "Ikki bog'lamli ro'yxatda har bir tugun ikkita ko'rsatkichga ega: biri keyingi tugunga, ikkinchisi esa oldingi tugunga ishora qiladi."}, {"question": "Qanday daraxtni biz \"To'liq binar daraxt\" deb ataymiz?", "options": ["Barcha barg tugunlari bir xil sathda joylashgan daraxt", "Har bir tugunida kamida bitta farzand bo'lgan daraxt", "Har bir tugunida 0 yoki 2 ta farzand bo'lgan va barcha barg tugunlari bir xil sathda joylashgan daraxt", "Har bir tugunida maksimal 2 ta farzand bo'lgan daraxt"], "correct_index": 2, "explanation": "To'liq binar daraxt (Full Binary Tree) - bu har bir tugunida 0 yoki 2 ta farzand bo'lgan daraxt. Agar barcha barg tugunlari bir xil sathda bo'lsa, u 'Perfect Binary Tree' bo'ladi. Savol 'To'liq binar daraxt' haqida bo'lgani uchun, har bir tugunida 0 yoki 2 ta farzand bo'lishi asosiy shart."}, {"question": "C++ dagi unordered_map konteynerining asosi qaysi maвЂ™lumotlar tuzilmasiga tayanadi?", "options": ["AVL daraxti", "Ikkilik qidiruv daraxti", "Xesh jadval", "Bog'lamli ro'yxat"], "correct_index": 2, "explanation": "C++ dagi `std::unordered_map` konteyneri ichki ravishda xesh jadval (hash table) ma'lumotlar tuzilmasiga tayanadi."}, {"question": "Quyidagi javoblardan qaysi birida chiziqli boвЂlmagan maвЂ™lumotlar tuzilmalari keltirilgan?", "options": ["Xesh jadval, Vektor", "Daraxt, Graf", "Navbat, Bog'lamli ro'yxat", "Massiv, Stek"], "correct_index": 1, "explanation": "Daraxt va graf chiziqli bo'lmagan ma'lumotlar tuzilmalariga misoldir, chunki ularning elementlari ierarxik yoki tarmoqlangan tarzda bog'langan."}, {"question": "B-daraxt tartibi t=3 bo'lsa, tugunda maksimal nechta farzand bo'lishi mumkin?", "options": ["6", "5", "3", "4"], "correct_index": 0, "explanation": "B-daraxtda tugunda n ta kalit bo'lsa, n+1 ta farzand bo'ladi. Maksimal kalitlar soni 2t-1. t=3 bo'lsa, maksimal kalitlar soni 2*3-1 = 5. Demak, maksimal farzandlar soni 5+1 =    А   ќoyob oddiy yo'l mavjud."}, {"question": "Model nima?", "options": ["Ma'lumotlar bazasi", "Real dunyo ob'ektining soddalashtirilgan tasviri", "Kompyuter dasturi", "Dasturlash tili"], "correct_index": 1, "explanation": "Model - bu real dunyo ob'ektining, tizimining yoki jarayonining soddalashtirilgan, abstrakt tasviri bo'lib, uning asosiy xususiyatlarini aks ettiradi."}, {"question": "Pufakli saralash algoritmining asosiy gвЂoyasi nimadan iborat?", "options": ["Elementlarni xesh funksiya yordamida joylashtirish", "Qo'shni elementlarni solishtirib, noto'g'ri tartibda bo'lsa almashtirish", "Massivni teng ikkiga bo'lish", "Eng kichik elementni topib, boshiga qo'yish"], "correct_index": 1, "explanation": "Pufakli saralash (Bubble Sort) algoritmining asosiy g'oyasi qo'shni elementlarni qayta-qayta solishtirish va agar ular noto'g'ri tartibda bo'lsa, ularning o'rnini almashtirishdan iborat."}, {"question": "Hisoblash geometriyasida fazodagi nuqta qanday ifodalanadi?", "options": ["Faqat bitta koordinata bilan", "Ikkita koordinata (x, y) bilan", "Uchta koordinata (x, y, z) bilan", "Vektor bilan"], "correct_index": 2, "explanation": "Hisoblash geometriyasida fazodagi nuqta uchta koordinata (x, y, z) bilan ifodalanadi."}, {"question": "B-daraxtning tartibi (minimum degree) t bo'lsa, ildizdan tashqari har bir tugundagi minimal kalitlar soni qancha?", "options": ["2t", "t-1", "2t-1", "t"], "correct_index": 1, "explanation": "B-daraxtning tartibi (minimum degree) t bo'lsa, ildizdan tashqari har bir tugundagi minimal kalitlar soni t-1 ga teng."}, {"question": "Navbat qaysi tamoyil asosida ishlaydi?", "options": ["Random Access", "FIFO (First-In, First-Out)", "Priority Based", "LIFO (Last-In, First-Out)"], "correct_index": 1, "explanation": "Navbat FIFO (First-In, First-Out) tamoyili asosida ishlaydi, ya'ni birinchi qo'shilgan element birinchi bo'lib olinadi."}, {"question": "Kichik daraxt yoki qism daraxt (sub tree) tugunlari sifatida qaysi tugunlar olinadi?", "options": ["Faqat barg tugunlar", "Har qanday tugun va uning barcha avlodlari", "Faqat ildiz tugun", "Faqat ota-ona tugunlar"], "correct_index": 1, "explanation": "Kichik daraxt (subtree) - bu daraxtning har qanday tuguni va uning barcha avlodlaridan tashkil topgan qismidir."}, {"question": "OgвЂirlikli graf nima?", "options": ["Yo'naltirilmagan graf", "Hech qanday qirrasi bo'lmagan graf", "Qirralari og'irlik (qiymat) bilan bog'langan graf", "Faqat bitta tuguni bo'lgan graf"], "correct_index": 2, "explanation": "Og'irlikli graf (Weighted Graph) - bu har bir qirrasi ma'lum bir og'irlik (qiymat, masofa, narx va hokazo) bilan bog'langan graf."}, {"question": "Knut-Morris-Pratt (KMP) algoritmining murakkabligi qaysi javobda keltirilgan?", "options": ["O(log n)", "O(m*n)", "O(n^2)", "O(m+n)"], "correct_index": 3, "explanation": "Knut-Morris-Pratt (KMP) algoritmining vaqt murakkabligi O(m+n) ga teng, bu yerda n - matn uzunligi, m - qidirilayotgan qismiy satr uzunligi. Bu uni primitiv algoritmga nisbatan ancha samarali qiladi."}, {"question": "BFS va DFS ikkala algoritm uchun ham umumiy bo'lgan xususiyat qaysi?", "options": ["Grafdagi barcha tugunlarni ziyorat qilish", "Har doim eng qisqa yo'lni topish", "Faqat yo'naltirilgan graflarda ishlash", "Xotira murakkabligi O(1) bo'lishi"], "correct_index": 0, "explanation": "BFS va DFS ikkalasi ham grafdagi barcha tugunlarni (agar ular bog'langan bo'lsa) ziyorat qilish (traversal) uchun ishlatiladi."}, {"question": "Daraxt tuzilmasida o'lcham nima?", "options": ["Daraxtning balandligi", "Daraxtdagi tugunlar soni", "Daraxtning maksimal sathi", "Daraxtdagi qirralar soni"], "correct_index": 1, "explanation": "Daraxt tuzilmasida 'o'lcham' (size) odatda daraxtdagi tugunlar sonini anglatadi."}, {"question": "Tez saralash (Quick Sort) qaysi algoritmik paradigma asosida ishlaydi?", "options": ["Backtracking (Orqaga qaytish)", "Dynamic Programming (Dinamik dasturlash)", "Greedy (Ochko'z)", "Divide and Conquer (Bo'lish va Yengish)"], "correct_index": 3, "explanation": "Tez saralash (Quick Sort) 'Divide and Conquer' (Bo'lish va Yengish) algoritmik
