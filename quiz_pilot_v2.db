    {
      "question": "Tez saralash (Quick Sort) qaysi algoritmik paradigma asosida ishlaydi?",
      "options": [
        "Greedy (Ochko'z)",
        "Dynamic Programming (Dinamik dasturlash)",
        "Divide and Conquer (Bo'lish va Hukmronlik qilish)",
        "Backtracking (Orqaga qaytish)"
      ],
      "correct_index": 2,
      "explanation": "Quick Sort \"Divide and Conquer\" (Bo'lish va Hukmronlik qilish) paradigmasiga asoslanadi, u massivni pivot atrofida bo'ladi va keyin kichik massivlarni rekursiv ravishda saralaydi."
    },
    {
      "question": "Tez saralash (Quick Sort) algoritmida pivot nima?",
      "options": [
