   Ш Ш                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              Ѓєl Q‚уGq_2279c21fb0e74a40b9ec780d81cb4847A{"variant": "A", "quizzes": [{"question": "Primitiv (sodda) qidiruv algoritmining eng yomon holatdagi vaqt murakkabligi qanday?", "options": ["O(log n)", "O(n)", "O(m*n)", "O(m+n)"], "correct_index": 2, "explanation": "Primitiv qidiruv algoritmining eng yomon holatdagi vaqt murakkabligi O(m*n) dir, bu yerda n - matn uzunligi, m - naqsh uzunligi."}, {"question": "Quyidagi tuzilmalardan qaysi biri ichki ravishda xesh funksiyadan foydalanadi?", "options": ["std::vector", "std::unordered_map", "std::map", "std::list"], "correct_index": 1, "explanation": "`std::unordered_map` va `std::unordered_set` kabi xeshga asoslangan konteynerlar ichki ravishda xesh funksiyadan foydalanadi."}, {"question": "Orientation (yoвЂnalish) nima aniqlaydi?", "options": ["Doiraning radiusi", "Chiziqning uzunligi", "Uchta nuqtaning bir-biriga nisbatan joylashuvi", "Ikki nuqta orasidagi masofa"], "correct_index": 2, "explanation": "Orientation uchta nuqtaning bir-biriga nisbatan joylashuvini (soat strelkasi bo'yicha, soat strelkasiga qarshi yoki kollinear) aniqlaydi."}, {"question": "Double Hashing nima ishlatadi?", "options": ["Faqat bitta xesh funksiya", "Massivlar", "Ikki xesh funksiya", "Bog'langan ro'yxatlar"], "correct_index": 2, "explanation": "Double Hashing ochiq manzillashning bir turi bo'lib, ikkinchi xesh funksiyadan foydalanib, kolliziya yuz berganda keyingi bo'sh joyni topish uchun qadam hajmini aniqlaydi."}, {"question": "Muvozanatlangan ikkilik qidiruv daraxti (Balanced Binary Search Tree) nima uchun kerak?", "options": ["Qidirish operatsiyalarini tezlashtirish va eng yomon holatda O(log n) murakkablikni ta'minlash uchun", "Xotira hajmini kamaytirish uchun", "Faqatgina kichik ma'lumotlar to'plamlari uchun", "Faqatgina elementlarni tartiblash uchun"], "correct_index": 0, "explanation": "Muvozanatlangan BST daraxt balandligini logaritmik darajada saqlash orqali qidirish, qo'shish va o'chirish operatsiyalarining eng yomon holatdagi murakkabligini O(log n) ga tushirish uchun kerak."}, {"question": "Qaysi javobda satrdan qismiy satrni qidirishga toвЂgвЂri misol keltirilgan?", "options": ["\"123\" ichidan \"456\" ni qidirish", "\"Salom dunyo\" ichidan \"dunyo\" ni qidirish", "\"Kitob\" ichidan \"kitob\" ni qidirish", "\"A\" ichidan \"B\" ni qidirish"], "correct_index": 1, "explanation": "\"Salom dunyo\" satridan \"dunyo\" qismiy satrini qidirish - bu satrdan qismiy satrni qidirishning to'g'ri misoli."}, {"question": "Primitiv (sodda) qidiruv algoritmining kamchiligi nima?", "options": ["Juda murakkabligi", "Faqat kichik satrlar uchun ishlashi", "Juda samarasizligi (eng yomon holatda)", "Juda tez ishlashi"], "correct_index": 2, "explanation": "Primitiv qidiruv algoritmi (naive string matching) eng yomon holatda O(m*n) vaqt murakkabligiga ega bo'lib, juda samarasizdir."}, {"question": "Kriptografik xesh funksiyaning asosiy xususiyatlaridan biri qaysi?", "options": ["Ikki tomonlama bo'lishi", "Tez ishlashi", "Kichik xesh qiymatlarni hosil qilishi", "Bir tomonlama (one-way) bo'lishi"], "correct_index": 3, "explanation": "Kriptografik xesh funksiyalar bir tomonlama (one-way) bo'lishi kerak, ya'ni xesh qiymatidan asl ma'lumotni tiklash qiyin bo'lishi kerak."}, {"question": "Satr (ing. String) nima?", "options": ["Belgilar ketma-ketligi", "Faqat bitta belgi", "Faqat raqamlar to'p  Ќ  Dakunlanishini anglatadi."}, {"question": "External Sorting (Tashqi saralash) uchun nega Birlashtirib saralash (Merge Sort) tanlanadi?", "options": ["U kam xotira talab qilgani uchun", "Uning chiziqli ketma-ket kirishga mosligi va barqarorligi tufayli", "Uning amalga oshirilishi juda oson bo'lgani uchun", "U juda tez bo'lgani uchun"], "correct_index": 1, "explanation": "Merge Sort tashqi saralash uchun ideal, chunki u ma'lumotlarga asosan ketma-ket kirishni talab qiladi, bu esa disk operatsiyalari uchun samaralidir. Shuningdek, uning barqarorligi ham muhim afzallikdir."}, {"question": "Quyidagilardan qaysi biri eng yomon (eng tez oвЂsuvchi) murakkablik hisoblanadi?", "options": ["O(2^n)", "O(n^2)", "O(n log n)", "O(n!)"], "correct_index": 3, "explanation": "Faktorial murakkablik (O(n!)) eksponensial murakkablik (O(2^n)) dan ham tezroq o'sadi va odatda eng yomon murakkablik hisoblanadi."}, {"question": "MaКјlumotlar yaxlitligi (data integrity) nima?", "options": ["Ma'lumotlarning aniqligi, izchilligi va ishonchliligi", "Ma'lumotlarning xotirada saqlanish usuli", "Ma'lumotlarning tezkorligi", "Ma'lumotlarning himoyalanganligi"], "correct_index": 0, "explanation": "Ma'lumotlar yaxlitligi (Data Integrity) ma'lumotlarning butun umri davomida aniqligi, izchilligi va ishonchliligini anglatadi."}, {"question": "Stekga element qoвЂshish amali qanday ataladi?", "options": ["Enqueue", "Push", "Dequeue", "Pop"], "correct_index": 1, "explanation": "Stekga element qo'shish amali \"Push\" deb ataladi."}, {"question": "for(int i=0; i<n; i++) { cout << i; } Ushbu kodning vaqt murakkabligini toping.", "options": ["O(log n)", "O(n)", "O(n^2)", "O(1)"], "correct_index": 1, "explanation": "Tsikl 'n' marta takrorlanadi, har bir takrorlash doimiy vaqtni oladi. Shuning uchun umumiy vaqt murakkabligi O(n) (chiziqli) bo'ladi."}, {"question": "Stekdan elementni olib tashlash amali qanday ataladi?", "options": ["Dequeue", "Enqueue", "Push", "Pop"], "correct_index": 3, "explanation": "Stekdan elementni olib tashlash amali \"Pop\" deb ataladi."}, {"question": "C++ dasturlash tilida dinamik massiv qanday ataladi?", "options": ["std::list", "std::array", "std::map", "std::vector"], "correct_index": 3, "explanation": "C++ standart kutubxonasida dinamik massiv funksionalligini ta'minlovchi konteyner `std::vector` hisoblanadi."}, {"question": "Graf G = (V, E ) da V nimani bildiradi?", "options": ["Grafning og'irligi", "Tugunlar (Vertices) to'plami", "Qirralar (Edges) to'plami", "Grafning yo'nalishi"], "correct_index": 1, "explanation": "Graf G = (V, E) da V tugunlar (vertices) to'plamini, E esa qirralar (edges) to'plamini bildiradi."}, {"question": "Birlashtirib saralash (Merge Sort) algoritmining asosi bo'lgan \"Divide and Conquer\" strategiyasi necha bosqichdan iborat?", "options": ["1 bosqichdan", "2 bosqichdan", "3 bosqichdan", "4 bosqichdan"], "correct_index": 2, "explanation": "\"Divide and Conquer\" (Bo'lish va Hukmronlik qilish) strategiyasi uchta asosiy bosqichdan iborat: Divide (muammoni kichikroq sub-muammolarga bo'lish), Conquer (sub-muammolarni rekursiv ravishda hal qilish) va Combine (sub-muammolar yechimlarini birlashtirib, asl muammoning yechimini hosil qilish)."}, {"question": "Tez saralash (Quick Sort) algoritmining vaqt murakkabligida eng yomon holati qachon yuz beradi?", "options": ["Massiv allaqachon saralangan bo'lsa", "Massiv teskari tartibda saralangan bo'lsa", "Massivda faqat bir xil elementlar bo'lsa", "Pivot har doim eng kichik yoki eng katta element bo'lganda"], "correct_index": 3, "explanation": "Quick Sortning eng yomon holati O(n^2) ga teng bo'lib, bu pivot har doim massivdagi eng kichik yoki eng katta element bo'lib tanlanganda yuz beradi. Bu massivni har safar bitta elementga va qolgan n-1 elementga bo'lishga olib keladi."}, {"question": "Algoritm murakkabligi nimani baholaydi?", "options": ["Algoritmning ishlashi uchun talab qilinadigan resurslar (vaqt va xotira)", "Algoritmning to'g'riligini", "Dasturchining mahoratini", "Dasturning hajmini"], "correct_index": 0, "explanation": "Algoritm murakkabligi uning ishlashi   9ardan farqli o'laroq."}, {"question": "Pufakli saralash algoritmining asosiy gвЂoyasi nimadan iborat?", "options": ["Massivni ikkiga bo'lish va alohida saralash", "Elementni saralangan qismga to'g'ri joyga qo'yish", "Eng kichik elementni topib, uni boshiga qo'yish", "Qo'shni elementlarni taqqoslash va noto'g'ri tartibda bo'lsa, ularni almashtirish"], "correct_index": 3, "explanation": "Pufakli saralash (Bubble Sort) qo'shni elementlarni qayta-qayta taqqoslash va agar ular noto'g'ri tartibda bo'lsa, ularni almashtirish orqali ishlaydi, natijada eng katta (yoki eng kichik) elementlar \"pufak kabi\" yuqoriga ko'tariladi."}, {"question": "Tashqi saralash qachon qoвЂllaniladi?", "options": ["Faqat tez saralash kerak bo'lganda", "Faqat massivlar uchun", "Ma'lumotlar kichik bo'lganda", "Saralanadigan ma'lumotlar asosiy xotiraga sig'maganda"], "correct_index": 3, "explanation": "Tashqi saralash (External Sorting) saralanadigan ma'lumotlar to'plami asosiy xotiraga (RAM) sig'maydigan darajada katta bo'lganda qo'llaniladi va disk kabi tashqi xotira qurilmalaridan foydalanadi."}, {"question": "Printerning ishlashi qaysi maвЂ™lumotlar tuzilmasiga misol boвЂla oladi?", "options": ["Massiv", "Stek", "Navbat", "Daraxt"], "correct_index": 2, "explanation": "Printerga yuborilgan vazifalar odatda navbatda turadi va birinchi kelgan birinchi chop etiladi (FIFO tamoyili), bu navbat ma'lumotlar tuzilmasiga misoldir."}, {"question": "Kamayish tartibida saralash qanday nomlanadi?", "options": ["Tasodifiy tartib", "Kamayish tartibi (Descending order)", "O'sish tartibi (Ascending order)", "Alfavit tartibi"], "correct_index": 1, "explanation": "Elementlarni kattadan kichikka qarab joylashtirish \"kamayish tartibi\" (descending order) deb ataladi."}, {"question": "Quyidagilardan qaysi biri eng yaxshi (eng sekin oвЂsuvchi) murakkablik hisoblanadi?", "options": ["O(n log n)", "O(1)", "O(log n)", "O(n)"], "correct_index": 1, "explanation": "O(1) (doimiy murakkablik) kirish hajmidan qat'i nazar, bajarilish vaqti o'zgarmasligini bildiradi va eng sekin o'suvchi, ya'ni eng yaxshi murakkablikdir."}, {"question": "Tez saralash (Quick sort) algoritmi kim tomonidan yaratilgan?", "options": ["Alan Turing", "Donald Knuth", "C.A.R. Hoare", "Edsger Dijkstra"], "correct_index": 2, "explanation": "Quick Sort algoritmi 1960 yilda Tony Hoare (C.A.R. Hoare) tomonidan ixtiro qilingan."}, {"question": "Tez saralash (Quick Sort) algoritmida pivot nima?", "options": ["Saralash tugaganligini bildiruvchi element", "Massivdagi eng kichik element", "Massivdagi eng katta element", "Massivni ikki qismga ajratish uchun ishlatiladigan element"], "correct_index": 3, "explanation": "Quick Sortda pivot (tayanch element) massivni ikki qismga ajratish uchun ishlatiladigan elementdir: pivotdan kichik elementlar bir tomonga, pivotdan katta elementlar esa boshqa tomonga joylashtiriladi."}, {"question": "Stek qaysi tamoyil asosida ishlaydi?", "options": ["LIFO (Last In, First Out)", "Random Access", "FIFO (First In, First Out)", "Sorted Order"], "correct_index": 0, "explanation": "Stek (Stack) ma'lumotlar tuzilmasi LIFO (Last In, First Out - oxirgi kirgan birinchi chiqadi) tamoyili asosida ishlaydi."}, {"question": "Navbat qaysi tamoyil asosida ishlaydi?", "options": ["Sorted Order", "LIFO (Last In, First Out)", "Random Access", "FIFO (First In, First Out)"], "correct_index": 3, "explanation": "Navbat (Queue) ma'lumotlar tuzilmasi FIFO (First In, First Out - birinchi kirgan birinchi chiqadi) tamoyili asosida ishlaydi."}, {"question": "Ichki saralash (Internal Sorting) nimani anglatadi?", "options": ["Faqat kichik ma'lumotlar to'plamini saralash", "Ma'lumotlar diskda saqlanishi", "Saralash uchun barcha ma'lumotlar asosiy xotiraga sig'ishi", "Algoritmning ichki qismi"], "correct_index": 2, "explanation": "Ichki saralashda saralanadigan barcha ma'lumotlar kompyuterning asosiy xotirasiga (RAM) sig'adi va saralash shu xotira ichida amalga oshiriladi."}, {"question": "Quyidagilardan qaysi biri chiziqli maвЂ™lumotlar tuzilmasi emas?", "options": ["Daraxt (Tree)", "Massiv (Array)", "Bog'la  :mli ro'yxat (Linked List)", "Stek (Stack)"], "correct_index": 0, "explanation": "Daraxt (Tree) chiziqli bo'lmagan ma'lumotlar tuzilmasi bo'lib, elementlar ierarxik tarzda joylashadi. Massiv, bog'lamli ro'yxat va stek chiziqli tuzilmalardir."}, {"question": "Tez saralash (Quick Sort) algoritmining kamchiliklari nimalar?", "options": ["Har doim O(n log n) murakkablik", "Faqat kichik massivlar uchun samarali", "Eng yomon holatda O(n^2) murakkablik va barqaror emasligi", "Qo'shimcha xotira talab qilishi"], "correct_index": 2, "explanation": "Quick Sortning asosiy kamchiliklari uning eng yomon holatda O(n^2) vaqt murakkabligiga ega bo'lishi (yomon pivot tanlovi tufayli) va odatda barqaror algoritm emasligidir."}, {"question": "Insertion Sortning eng yaxshi holat murakkabligi qanday?", "options": ["O(n)", "O(n^2)", "O(1)", "O(n log n)"], "correct_index": 0, "explanation": "Insertion Sortning eng yaxshi holati ma'lumotlar allaqachon saralangan bo'lsa yuz beradi. Bu holda har bir element faqat bir marta taqqoslanadi va joyiga qo'yiladi, bu esa O(n) chiziqli murakkablikni beradi."}, {"question": "Oddiy saralash algoritmlari qaysilar?", "options": ["Faqat Pufakli saralash (Bubble Sort)", "Birlashtirib saralash (Merge Sort), Tez saralash (Quick Sort)", "Pufakli saralash (Bubble Sort), Tanlash saralash (Selection Sort), Qo'shish saralash (Insertion Sort)", "Pufakli saralash (Bubble Sort), Tez saralash (Quick Sort)"], "correct_index": 2, "explanation": "Pufakli saralash, tanlash saralash va qo'shish saralash algoritmlari odatda \"oddiy\" yoki \"elementar\" saralash algoritmlari hisoblanadi, chunki ularning amalga oshirilishi nisbatan sodda, ammo katta ma'lumotlar to'plamlari uchun samaradorligi past."}, {"question": "Algoritm ishlashi uchun talab qilinadigan qo'shimcha xotira (Space Complexity) qancha?", "options": ["O(log n)", "O(n)", "O(n^2)", "O(1)"], "correct_index": 1, "explanation": "Merge Sort qo'shimcha O(n) xotira talab qiladi, chunki u birlashtirish jarayonida vaqtinchalik massivlardan foydalanadi."}, {"question": "Stek yordamida qaysi masala samarali hal qilinadi?", "options": ["Ma'lumotlarni tez qidirish", "Qavslar muvozanatini tekshirish", "Eng qisqa yo'lni topish", "Navbatda turgan mijozlarga xizmat ko'rsatish"], "correct_index": 1, "explanation": "Stek qavslar muvozanatini tekshirish, rekursiv funksiyalarni boshqarish va ifodalarni baholash kabi masalalarni samarali hal qilishda keng qo'llaniladi."}, {"question": "Agar algoritm doimiy vaqt ichida bajarilsa, uning murakkabligi qanday boвЂladi?", "options": ["O(n)", "O(log n)", "O(n^2)", "O(1)"], "correct_index": 3, "explanation": "Doimiy vaqt murakkabligi kirish hajmidan qat'i nazar, algoritmning bajarilish vaqti o'zgarmasligini bildiradi va O(1) bilan ifodalanadi."}, {"question": "Model nima?", "options": ["Haqiqiy tizimning soddalashtirilgan tasviri", "Dasturlash tili", "Kompyuter dasturi", "Ma'lumotlar bazasi"], "correct_index": 0, "explanation": "Model - bu murakkab tizim yoki hodisaning asosiy xususiyatlarini aks ettiruvchi soddalashtirilgan tasviri yoki abstraksiyasi."}, {"question": "for(int i=0; i<n; i++) { for(int j=0; j<n; j++) { cout << i+j; } } Ushbu ichma-ich joylashgan takrorlash operatoridan iborat boвЂlgan kodning murakkabligini toping.", "options": ["O(n)", "O(n^2)", "O(log n)", "O(n log n)"], "correct_index": 1, "explanation": "Tashqi tsikl 'n' marta, ichki tsikl ham 'n' marta takrorlanadi. Shuning uchun umumiy vaqt murakkabligi O(n * n) = O(n^2) (kvadratik) bo'ladi."}, {"question": "Qaysi qatorda chiziqli murakkablik ifodasi keltirilgan?", "options": ["O(log n)", "O(n^2)", "O(1)", "O(n)"], "correct_index": 3, "explanation": "Chiziqli murakkablik kirish hajmi 'n' bilan to'g'ri proportsional ravishda o'sishini bildiradi va O(n) bilan ifodalanadi."}, {"question": "Tez saralash (Quick Sort) algoritmi qaysi saralash algoritmiga oвЂxshaydi?", "options": ["Tanlash saralash (Selection Sort)", "Birlashtirib saralash (Merge Sort)", "Qo'shish saralash (Insertion Sort)", "Pufakli saralash (Bubble Sort)"], "correct_index": 0, "explanation": "Quick Sortning   7asosiy g'oyasi (pivotni tanlash va massivni uning atrofida bo'lish) Selection Sortga o'xshaydi, chunki Selection Sort ham har bir iteratsiyada eng kichik (yoki eng katta) elementni topib, uni to'g'ri joyiga qo'yadi. Quick Sortda pivot o'zining yakuniy joyiga qo'yiladi."}, {"question": "Algoritmning ommaviylik xossasi nimani bildiradi?", "options": ["Algoritmning turli xil kirish ma'lumotlari uchun ishlay olishi", "Algoritmning tez ishlashi", "Algoritmning oson tushunilishi", "Algoritmning ko'p odamlar tomonidan ishlatilishi"], "correct_index": 0, "explanation": "Algoritmning ommaviylik (generality) xossasi uning ma'lum bir muammoning barcha holatlari uchun yoki keng doiradagi kirish ma'lumotlari uchun qo'llanilishi mumkinligini anglatadi."}, {"question": "Birlashtirib saralash (Merge Sort) algoritmi rekursiv ravishda qachongacha davom etadi?", "options": ["Belgilangan chuqurlikka yetguncha", "Massiv to'liq saralanguncha", "Massivning yarmi saralanguncha", "Har bir kichik massivda bitta element qolguncha"], "correct_index": 3, "explanation": "Merge Sortning rekursiv bo'lish bosqichi har bir kichik massivda faqat bitta element qolguncha davom etadi, chunki bitta elementli massiv allaqachon saralangan hisoblanadi."}, {"question": "KoвЂrsatkichli murakkablik qaysi javobda keltirilgan?", "options": ["O(n^2)", "O(2^n)", "O(n)", "O(log n)"], "correct_index": 1, "explanation": "Ko'rsatkichli (eksponensial) murakkablik kirish hajmi 'n' bilan 2 ning 'n'-chi darajasi kabi o'sishini bildiradi va O(2^n) bilan ifodalanadi."}, {"question": "Algoritmning вЂњDivideвЂќ (Bo'lish) bosqichida massiv qanday qismlarga ajratiladi?", "options": ["Ikkita teng (yoki deyarli teng) qismga", "Bitta elementgacha", "Uchta qismga", "Tasodifiy qismlarga"], "correct_index": 0, "explanation": "Merge Sortning \"Divide\" bosqichida massiv doimiy ravishda o'rtadan ikkita teng (yoki deyarli teng) qismga bo'linadi."}, {"question": "MaвЂ™lumotlar tuzilmalari tuzilishiga koвЂra qanday turlarga boвЂlinadi?", "options": ["Oddiy va murakkab", "Abstrakt va konkret", "Chiziqli va chiziqli bo'lmagan", "Statik va dinamik"], "correct_index": 2, "explanation": "Ma'lumotlar tuzilmalari asosan ikki turga bo'linadi: chiziqli (masalan, massiv, ro'yxat, stek, navbat) va chiziqli bo'lmagan (masalan, daraxt, graf)."}, {"question": "1 mln ta elementdan iborat int (4 bayt) toifali massiv berilgan. U xotiradan necha MB (mega bayt) joy oladi?", "options": ["1 MB", "8 MB", "2 MB", "4 MB"], "correct_index": 3, "explanation": "1 million (1,000,000) int elementi * 4 bayt/int = 4,000,000 bayt. 1 megabayt (MB) = 1,000,000 bayt deb hisoblasak, bu 4 MB ga teng bo'ladi."}, {"question": "2 mln ta elementdan iborat int (4 bayt) toifali massiv berilgan. U xotiradan necha MB (mega bayt) joy oladi?", "options": ["2 MB", "16 MB", "8 MB", "4 MB"], "correct_index": 2, "explanation": "2 million (2,000,000) int elementi * 4 bayt/int = 8,000,000 bayt. 1 megabayt (MB) = 1,000,000 bayt deb hisoblasak, bu 8 MB ga teng bo'ladi."}, {"question": "Chiziqli maвЂ™lumotlar tuzilmalari qaysi javobda keltirilgan?", "options": ["Faqat massiv va daraxt", "Faqat stek va navbat", "Massiv, bog'lamli ro'yxat, stek, navbat", "Daraxt, graf, hash jadvali"], "correct_index": 2, "explanation": "Chiziqli ma'lumotlar tuzilmalarida elementlar ketma-ket tartibda joylashadi. Massiv, bog'lamli ro'yxat, stek va navbat bunga misoldir."}, {"question": "Ikki saralangan kichik massivni bitta saralangan massivga birlashtirish bosqichi nima deyiladi?", "options": ["Almashtirish (Swap)", "Birlashtirish (Merge)", "Saralash (Sort)", "Bo'lish (Divide)"], "correct_index": 1, "explanation": "\"Combine\" bosqichida ikki saralangan kichik massivni bitta saralangan massivga birlashtirish amali \"Birlashtirish\" (Merge) deb ataladi."}, {"question": "Algoritmning qaysi xossasi u chekli qadamlardan iboratligini bildiradi?", "options": ["Kirish (Input)", "Cheklilik (Finiteness)", "Aniqlik (Definiteness)", "Samaradorlik (Effectiveness)"], "correct_index": 1, "explanation": "Algoritmning cheklilik xossasi uning chekli sondagi qadamlardan keyin y    degree) nimani bildiradi?", "options": ["Grafdagi qirralar sonini", "Grafdagi tugunlar sonini", "Tugunga bog'langan qirralar sonini", "Tugunning og'irligini"], "correct_index": 2, "explanation": "Grafda tugunning darajasi (degree) bu tugunga bog'langan qirralar sonini bildiradi. Yo'naltirilgan grafda kiruvchi va chiquvchi darajalar farqlanadi."}, {"question": "AVL daraxtida eng kichik element qayerda joylashgan bo'ladi?", "options": ["Har qanday joyda bo'lishi mumkin", "Eng o'ngdagi barg tugunda", "Ildiz tugunda", "Eng chapdagi barg tugunda"], "correct_index": 3, "explanation": "Ikkilik qidiruv daraxtining (shu jumladan AVL daraxtining) xususiyatiga ko'ra, eng kichik element har doim daraxtning eng chap tomonidagi barg tugunda joylashgan bo'ladi."}, {"question": "Agar daraxtda 12 ta tugun mavjud bo'lsa uning Pryufer kodi uzunligi nechchiga teng boвЂladi?", "options": ["11", "13", "10", "12"], "correct_index": 2, "explanation": "Pryufer kodi uzunligi n-2 formulasi bilan topiladi. Agar n=12 bo'lsa, 12-2 = 10."}, {"question": "MaКјlumotlar yaxlitligi (data integrity) ning necha xil turi bor?", "options": ["4 xil (Entity, Domain, Referential, User-defined)", "5 xil (Entity, Domain, Referential, Key, User-defined)", "2 xil (Faqat Entity va Domain)", "3 xil (Faqat Entity, Domain va Referential)"], "correct_index": 0, "explanation": "Ma'lumotlar yaxlitligining asosiy turlari: Entity Integrity (obyekt yaxlitligi), Domain Integrity (domen yaxlitligi), Referential Integrity (havola yaxlitligi) va User-defined Integrity (foydalanuvchi tomonidan belgilangan yaxlitlik)."}, {"question": "Daraxtda ajdod (ancestor) deb qaysi tugunlarga aytiladi?", "options": ["Berilgan tugunning aka-ukalari", "Berilgan tugunning o'zi", "Berilgan tugundan ildizgacha bo'lgan yo'ldagi barcha tugunlar", "Berilgan tugunning farzandlari"], "correct_index": 2, "explanation": "Daraxtda ajdod (ancestor) bu berilgan tugundan ildizgacha bo'lgan yo'ldagi barcha tugunlardir (shu jumladan ildiz, lekin berilgan tugunning o'zi emas)."}, {"question": "BogвЂlangan graf deb qanday graflarga aytiladi?", "options": ["Yo'naltirilgan graf", "Faqat bitta qirrasi bor graf", "Og'irlikli graf", "Har qanday ikki tugun orasida yo'l mavjud bo'lgan graf"], "correct_index": 3, "explanation": "Bog'langan graf (connected graph) shunday grafki, unda grafdagi har qanday ikki tugun orasida kamida bitta yo'l mavjud bo'ladi."}, {"question": "B-daraxtda qidiruv (search) amali qanday vaqt murakkabligiga ega?", "options": ["O(n log n)", "O(1)", "O(log n)", "O(n)"], "correct_index": 2, "explanation": "B-daraxtlar muvozanatlanganligi sababli, qidiruv amali logaritmik vaqt murakkabligiga ega, ya'ni O(log n). Bu disk I/O operatsiyalari sonini minimallashtirishga yordam beradi."}, {"question": "Qo'shnilik ro'yxati (adjacency list) sifatida berilgan V tugun va E qirrali grafda BFS ning vaqt murakkabligi qanday?", "options": ["O(E^2)", "O(V + E)", "O(V^2)", "O(V*E)"], "correct_index": 1, "explanation": "Qo'shnichilik ro'yxati yordamida tasvirlangan grafda BFS algoritmining vaqt murakkabligi O(V + E) ga teng, bu yerda V tugunlar soni, E esa qirralar soni. Har bir tugun va har bir qirra bir marta ko'rib chiqiladi."}, {"question": "QoвЂshnilik matritsasi bilan berilgan grafda BFS ning vaqt murakkabligi qanday?", "options": ["O(V + E)", "O(E)", "O(V log V)", "O(V^2)"], "correct_index": 3, "explanation": "Qo'shnichilik matritsasi yordamida tasvirlangan grafda BFS algoritmining vaqt murakkabligi O(V^2) ga teng, chunki har bir tugun uchun uning barcha V ta qo'shnisini tekshirish uchun matritsaning bir qatorini to'liq ko'rib chiqish kerak bo'ladi."}, {"question": "Daraxtda tanlangan tugunnning balandligi (height) nimaga teng?", "options": ["Tugundan eng uzoqdagi barg tugungacha bo'lgan eng uzun yo'l uzunligi", "Tugundan ildizgacha bo'lgan yo'l uzunligi", "Tugunning farzandlari soni", "Tugunning ota-onasi soni"], "correct_index": 0, "explanation": "Daraxtda tugunning balandligi (height) bu tugundan uning avlodlari orasidagi eng uzoqdagi barg tugungacha bo'lgan eng uzun yo'lning qirralar sonidir."}]}j™Ґ 
