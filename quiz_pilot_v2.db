      ],
      "correct_index": 2,
      "explanation": "Hisoblash modeli (masalan, Turing mashinasi) algoritmning ishlashini va resurs sarfini tahlil qilish uchun ishlatiladigan nazariy abstrakt mashinadir."
    },
    {
      "question": "Algoritm murakkabligi nimani baholaydi?",
      "options": [
        "Dasturning hajmini",
        "Algoritmning ishlashi uchun talab qilinadigan resurslar (vaqt va xotira)",
        "Dasturchining mahoratini",
        "Algoritmning to'g'riligini"
      ],
      "correct_index": 1,
      "explanation": "Algoritm murakkabligi uning ishlashi uchun talab qilinadigan va  Ѕ  Ћlami", "Tasodifiy belgilar to'plami"], "correct_index": 0, "explanation": "Satr - bu belgilar ketma-ketligi."}, {"question": "Quyidagi nuqtalar toвЂplami uchun Convex Hull nechta nuqtadan iborat boвЂladi? Nuqtalar: (0,0), (2,0), (2,2), (0,2), (1,1)", "options": ["2", "4", "5", "3"], "correct_index": 1, "explanation": "Nuqtalar (0,0), (2,0), (2,2), (0,2) kvadrat hosil qiladi. (1,1) nuqtasi esa bu kvadratning ichida joylashgan. Shuning uchun Convex Hullni tashkil etuvchi nuqtalar 4 ta bo'ladi: (0,0), (2,0), (2,2), (0,2)."}, {"question": "Hisoblash geometriyasi qayerda qoвЂllaniladi?", "options": ["Faqatgina moliyaviy tahlilda", "Kompyuter grafikasi, robototexnika, GIS kabi sohalarda", "Faqatgina matn tahlilida", "Faqatgina ma'lumotlar bazalarida"], "correct_index": 1, "explanation": "Hisoblash geometriyasi kompyuter grafikasi, robototexnika, geografik axborot tizimlari (GIS), CAD/CAM va boshqa ko'plab sohalarda qo'llaniladi."}, {"question": "Kolliziyani hal qilish usullaridan biri qaysi?", "options": ["Saralash", "Shifrlash", "Zanjirlash (Chaining)", "Qidirish"], "correct_index": 2, "explanation": "Zanjirlash (Chaining) va Ochiq manzillash (Open Addressing) kolliziyani hal qilishning asosiy usullaridir."}, {"question": "Quyidagi algoritmlardan qaysi biri kriptografik xesh algoritm hisoblanadi?", "options": ["Binary Search", "Bubble Sort", "Linear Search", "SHA-256"], "correct_index": 3, "explanation": "SHA-256 algoritmi kriptografik xesh algoritm hisoblanadi. MD5 va SHA-1 ham shunday, ammo SHA-256 hozirda xavfsizroq."}, {"question": "Antivirus dasturlarida qismiy satrlarni qidirish algoritmlarining asosiy vazifasi nima?", "options": ["Fayllarni siqish", "Virus signaturalarini aniqlash", "Tizim tezligini oshirish", "Fayllarni shifrlash"], "correct_index": 1, "explanation": "Antivirus dasturlarida qismiy satrlarni qidirish algoritmlari virus signaturalarini (ma'lum viruslarga xos kod qismlarini) fayllar ichidan topish uchun ishlatiladi."}, {"question": "Open Addressing usulining mohiyati nimada?", "options": ["Kolliziya yuz berganda yangi xesh jadval yaratish", "Kolliziya yuz berganda xesh jadvalda keyingi bo'sh joyni qidirish", "Har bir indeks uchun bog'langan ro'yxat ishlatish", "Ma'lumotlarni shifrlash"], "correct_index": 1, "explanation": "Open Addressing (Ochiq manzillash) usulida kolliziya yuz berganda, xesh jadvalda keyingi bo'sh joy topilguncha ketma-ket (yoki boshqa proba ketma-ketligi bo'yicha) qidiriladi."}, {"question": "Quyidagi holatlardan qaysi biri hash tableda kolliziya yuz berganini bildiradi?", "options": ["Xesh jadval bo'sh bo'lsa", "Xesh jadval to'la bo'lsa", "Ikki kalit bir xil xesh indeksiga xeshlansa", "Ikki kalit bir xil qiymatga ega bo'lsa"], "correct_index": 2, "explanation": "Kolliziya - bu ikki xil kalit xesh funksiya orqali bir xil indeksga (xesh qiymatiga) aylantirilganda yuzaga keladigan holat."}, {"question": "Binar uyumni massivda saqlashda i-indeksdagi tugunning chap bolasi qaysi formuladan topiladi?", "options": ["(i-1)/2", "i+1", "2*i + 1", "2*i + 2"], "correct_index": 2, "explanation": "Massivda saqlangan binar uyumda 0-indeksdan boshlansa, 'i' indeksdagi tugunning chap bolasi '2*i + 1' formulasi bilan topiladi."}, {"question": "Xesh jadvalda maвЂ™lumotlar nima orqali saqlanadi?", "options": ["Kalit-qiymat juftliklari", "Bog'langan ro'yxatlar", "Faqat qiymatlar", "Faqat indekslar"], "correct_index": 0, "explanation": "Xesh jadvalda ma'lumotlar kalit-qiymat juftliklari (key-value pairs) orqali saqlanadi, bu yerda kalit xesh funksiya yordamida indeksga aylantiriladi."}, {"question": "Parollarni xeshlashdan asosiy maqsad nima?", "options": ["Parollarni shifrlash", "Parollarni tiklash", "Parollarni xavfsiz saqlash va ularni ochiq matnda ko'rinmasligini ta'minlash", "Parollarni tezroq qidirish"], "correct_index": 2, "explanation": "Parollarni xeshlashdan asosiy maqsad - parollarni to'g'ridan-to'g'ri saqlash o'rniga ularning xesh qiymatlarini saqlash orqali xavfsizlikni oshirish. Agar ma'lumotlar bazasi buzilsa ham, parollar ochiq holda ko'rinmaydi."}, {"question": "Password Hashing nim  Џa uchun ishlatiladi?", "options": ["Parollarni xavfsiz saqlash uchun", "Parollarni shifrlash uchun", "Parollarni tezroq qidirish uchun", "Parollarni tiklash uchun"], "correct_index": 0, "explanation": "Parol xeshlash parollarni to'g'ridan-to'g'ri saqlash o'rniga ularning xesh qiymatlarini saqlash orqali xavfsizlikni oshirish uchun ishlatiladi."}, {"question": "Qismiy satr yana qanday nom bilan ataladi?", "options": ["Matn", "Belgilar to'plami", "Naqsh", "Asosiy satr"], "correct_index": 2, "explanation": "Qismiy satr ko'pincha 'naqsh' (pattern) deb ham ataladi, ayniqsa satrlarni qidirish algoritmlarida."}, {"question": "Hisoblash geometriyasidagi Orientatsiya (ing. Orientation) formulasi natijasi manfiy boвЂlsa nimani bildiradi?", "options": ["Nuqtalar bir-biriga ustma-ust tushadi", "Nuqtalar soat strelkasiga qarshi joylashgan", "Nuqtalar soat strelkasi bo'yicha joylashgan", "Nuqtalar kollinear"], "correct_index": 2, "explanation": "Agar orientatsiya formulasi natijasi manfiy bo'lsa, bu nuqtalar soat strelkasi bo'yicha (clockwise) joylashganligini bildiradi."}, {"question": "Quyidagilardan qaysi biri xesh funksiyaga misol boвЂladi?", "options": ["sum()", "len()", "sqrt()", "key % size"], "correct_index": 3, "explanation": "Modulus operatori (qoldiqni olish) xesh funksiyalarda kalitni jadval o'lchamiga mos indeksga aylantirish uchun keng qo'llaniladi."}, {"question": "Hisoblash geometriyasidagi qavariq qobiq (Convex Hull) nima?", "options": ["Barcha nuqtalarni o'z ichiga olgan eng kichik qavariq ko'pburchak", "Barcha nuqtalarni o'z ichiga olgan eng katta doira", "Faqat uchta nuqtadan iborat shakl", "Nuqtalarni birlashtiruvchi chiziq"], "correct_index": 0, "explanation": "Qavariq qobiq - bu berilgan nuqtalar to'plamini o'z ichiga olgan eng kichik qavariq ko'pburchak."}, {"question": "MD5 algoritmining asosiy kamchiligi nimada?", "options": ["Faqat kichik ma'lumotlar uchun ishlashi", "Katta xesh qiymatlarini hosil qilishi", "Kolliziya hujumlariga zaifligi", "Juda sekin ishlashi"], "correct_index": 2, "explanation": "MD5 algoritmining asosiy kamchiligi - kolliziya hujumlariga zaifligi, ya'ni bir xil xesh qiymatini beradigan ikkita turli xil ma'lumotni topish mumkinligi."}, {"question": "Matn muharrirlaridagi qaysi funksiya satrlardan qismiy satrlarni qidirishga misol boвЂladi?", "options": ["Qidirish va almashtirish", "Sahifani saqlash", "Imlo tekshiruvi", "Matnni formatlash"], "correct_index": 0, "explanation": "Matn muharrirlaridagi 'Qidirish va almashtirish' (Find and Replace) funksiyasi qismiy satrlarni qidirishga misol bo'ladi."}, {"question": "Binar uyumda i-indeksdagi tugunning ota tuguni (parent) qaysi formula bilan topiladi?", "options": ["2*i + 1", "i-1", "(i-1)/2", "2*i + 2"], "correct_index": 2, "explanation": "Massivda saqlangan binar uyumda 0-indeksdan boshlansa, 'i' indeksdagi tugunning ota tuguni '(i-1)/2' (butun qismi) formulasi bilan topiladi."}, {"question": "Virus signaturasi deganda nima tushuniladi?", "options": ["Operatsion tizim fayli", "Virusning nomi", "Har qanday dastur kodi", "Ma'lum bir virusga xos bo'lgan noyob baytlar ketma-ketligi"], "correct_index": 3, "explanation": "Virus signaturasi - bu ma'lum bir virusga xos bo'lgan noyob baytlar ketma-ketligi yoki kod qismi bo'lib, antivirus dasturlari uni aniqlash uchun foydalanadi."}, {"question": "Nuqta (Point) tekislikda qanday ifodalanadi?", "options": ["Faqat y koordinata", "Faqat x koordinata", "Radius va burchak", "(x, y) koordinatalar juftligi"], "correct_index": 3, "explanation": "Tekislikda nuqta ikki koordinata (x, y) bilan ifodalanadi."}, {"question": "Quyidagi algoritmlardan qaysi biri hozirgi kunda xavfsiz emas deb hisoblanadi?", "options": ["Blake2", "SHA-3", "MD5", "SHA-256"], "correct_index": 2, "explanation": "MD5 va SHA-1 algoritmlari kolliziya hujumlariga zaifligi sababli hozirgi kunda xavfsiz emas deb hisoblanadi."}, {"question": "Convex Hull nechta nuqtadan iborat? Nuqtalar: (0,0), (3,0), (3,3), (0,3), (1,1), (2,2)", "options": ["3", "5", "4", "6"], "correct_index": 2, "explanation": "Nuqtalar (0,0), (3,0), (3,3), (0,3) kvad  ‹rat hosil qiladi. (1,1) va (2,2) nuqtalari esa bu kvadratning ichida joylashgan. Shuning uchun Convex Hullni tashkil etuvchi nuqtalar 4 ta bo'ladi: (0,0), (3,0), (3,3), (0,3)."}, {"question": "Knut-Morris-Pratt (KMP) algoritmining murakkabligi qaysi javobda keltirilgan?", "options": ["O(n^2)", "O(m*n)", "O(m+n)", "O(log n)"], "correct_index": 2, "explanation": "KMP algoritmining vaqt murakkabligi O(m+n) dir, bu yerda n - matn uzunligi, m - naqsh uzunligi."}, {"question": "Quyidagi usullardan qaysi biri kolliziyani bartaraf etish uchun qoвЂllaniladi?", "options": ["Merge Sort", "Binary Search", "Bubble Sort", "Zanjirlash (Chaining)"], "correct_index": 3, "explanation": "Zanjirlash (Chaining) va Ochiq manzillash (Open Addressing) kolliziyani bartaraf etish uchun qo'llaniladigan asosiy usullardir."}, {"question": "SHA-256 algoritmi keng qoвЂllaniladigan soha qaysi?", "options": ["Matn tahlili", "Ma'lumotlar bazalari", "Kriptovalyutalar va raqamli imzo", "Kompyuter grafikasi"], "correct_index": 2, "explanation": "SHA-256 kriptovalyutalar (masalan, Bitcoin), raqamli imzo va ma'lumotlar yaxlitligini tekshirish kabi sohalarda keng qo'llaniladi."}, {"question": "B-daraxt tartibi t=3 bo'lsa, tugunda maksimal nechta farzand bo'lishi mumkin?", "options": ["5", "3", "6", "4"], "correct_index": 2, "explanation": "B-daraxtda tartib 't' bo'lsa, har bir tugunda maksimal 2t-1 ta kalit va maksimal 2t ta farzand bo'lishi mumkin. Agar t=3 bo'lsa, maksimal farzandlar soni 2*3 = 6 ga teng bo'ladi."}, {"question": "Hisoblash geometriyasida eng sodda obyekt nima?", "options": ["Chiziq", "Nuqta", "Doira", "Uchburchak"], "correct_index": 1, "explanation": "Hisoblash geometriyasida eng sodda obyekt nuqta (point) hisoblanadi."}, {"question": "unordered_set qanday qiymatlarni saqlaydi?", "options": ["Tartiblangan qiymatlar", "Kalit-qiymat juftliklari", "Takrorlanuvchi qiymatlar", "Noyob qiymatlar"], "correct_index": 3, "explanation": "`unordered_set` noyob qiymatlarni (kalitlarni) saqlaydi, xuddi `std::set` kabi, lekin xesh jadval asosida."}, {"question": "Kesma (Line Segment) nima?", "options": ["Faqat bitta nuqta", "Cheksiz uzunlikdagi chiziq", "Egri chiziq", "Ikki nuqta orasidagi to'g'ri chiziqning bir qismi"], "correct_index": 3, "explanation": "Kesma - bu ikki nuqta orasidagi to'g'ri chiziqning bir qismi."}, {"question": "Quyidagilardan qaysi biri ideal xesh funksiyaning muhim xususiyati hisoblanadi?", "options": ["Faqatgina katta kalitlar uchun ishlashi", "Juda sekin ishlashi", "Kolliziyalarni minimallashtirish va xesh qiymatlarini bir tekis taqsimlash", "Har doim bir xil xesh qiymatini berishi"], "correct_index": 2, "explanation": "Ideal xesh funksiya kolliziyalarni minimallashtirishi va xesh qiymatlarini jadval bo'ylab bir tekis taqsimlashi kerak."}, {"question": "Xesh funksiyalar axborot xavfsizligida nima uchun ishlatiladi?", "options": ["Ma'lumotlarni tartiblash uchun", "Ma'lumotlarni siqish uchun", "Ma'lumotlarni tezroq uzatish uchun", "Ma'lumotlarni shifrlash va yaxlitligini tekshirish uchun"], "correct_index": 3, "explanation": "Xesh funksiyalar axborot xavfsizligida parollarni saqlash, ma'lumotlar yaxlitligini tekshirish, raqamli imzo va boshqa kriptografik maqsadlarda ishlatiladi. Ular ma'lumotni shifrlamaydi, balki uning 'barmoq izini' yaratadi, bu esa yaxlitlikni tekshirishga yordam beradi."}, {"question": "Heap-Sort algoritmi ishlashi uchun qancha qo'shimcha xotira talab qilinadi (Space Complexity)?", "options": ["O(log n)", "O(1)", "O(n log n)", "O(n)"], "correct_index": 1, "explanation": "Heap-Sort joyida (in-place) saralash algoritmi bo'lib, O(1) qo'shimcha xotira talab qiladi."}, {"question": "Convex Hull nechta nuqtadan iborat? Nuqtalar: (0,0), (1,1), (2,2), (3,3)", "options": ["1", "3", "4", "2"], "correct_index": 3, "explanation": "Berilgan nuqtalar bitta to'g'ri chiziqda yotadi. Convex Hull faqat chekka nuqtalardan iborat bo'ladi, ya'ni (0,0) va (3,3)."}, {"question": "Heap-Sort algoritmining o'rtacha va eng yomon holatdagi vaqt murakkabligi qanday?", "options": ["O(n^2)", "O(n log n)", "O(n)", "O(log n)"], "correct_
