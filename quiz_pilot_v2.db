   џ џ                                                                                                                                                                                                                                                                                                                                                                                                                     „Ь( Q‰·Qq_6943d9b23fb5424d9a07494b8a263ce5C{"variant": "C", "quizzes": [{"question": "AVL daraxti qanday turdagi daraxt hisoblanadi?", "options": ["Oddiy ikkilik daraxt", "To'liq binar daraxt", "O'z-o'zidan muvozanatlashadigan ikkilik qidiruv daraxti", "Muvozanatlanmagan ikkilik qidiruv daraxti"], "correct_index": 2, "explanation": "AVL daraxti - bu o'z-o'zidan muvozanatlashadigan ikkilik qidiruv daraxti (Self-Balancing Binary Search Tree) bo'lib, u har bir tugun uchun chap va o'ng kichik daraxtlar balandliklari farqini ma'lum bir chegarada ushlab turadi."}, {"question": "Agar daraxtda n ta tugun boвЂlsa, unda nechta qirra boвЂladi?", "options": ["n-1", "2n", "n+1", "n"], "correct_index": 0, "explanation": "Daraxtda n ta tugun bo'lsa, unda har doim n-1 ta qirra bo'ladi."}, {"question": "YoвЂnaltirilmagan grafda qirra nimani bildiradi?", "options": ["Tugunning o'ziga bog'lanishini", "Grafning og'irligini", "Faqat bir tomonlama bog'lanishni", "Ikki tugun orasidagi ikki tomonlama bog'lanishni"], "correct_index": 3, "explanation": "Yo'naltirilmagan grafda qirra ikki tugun orasidagi ikki tomonlama bog'lanishni bildiradi, ya'ni A dan B ga yo'l bo'lsa, B dan A ga ham yo'l bor."}, {"question": "Double Hashing nima ishlatadi?", "options": ["Uchta xesh funksiyani", "Xesh funksiyani ishlatmaydi", "Ikkita xesh funksiyani", "Bitta xesh funksiyani"], "correct_index": 2, "explanation": "Double Hashing (Ikki marta xeshlash) - bu kolliziyani hal qilish usuli bo'lib, u ikkita xesh funksiyadan foydalanadi: birinchisi boshlang'ich indeksni, ikkinchisi esa kolliziya yuz berganda keyingi indeksni topish uchun qadam hajmini aniqlaydi."}, {"question": "unordered_set qanday qiymatlarni saqlaydi?", "options": ["Takrorlanuvchi qiymatlarni", "Kalit-qiymat juftliklarini", "Saralangan qiymatlarni", "Faqat noyob kalitlarni"], "correct_index": 3, "explanation": "`std::unordered_set` faqat noyob kalitlarni (qiymatlarni) saqlaydi va ularni xesh funksiya yordamida joylashtiradi."}, {"question": "DFS algoritmi rekursiv tarzda bajarilganda qaysi maвЂ™lumot tuzilmasi bilvosita ishlatiladi?", "options": ["Xesh jadval", "Massiv", "Stek", "Navbat"], "correct_index": 2, "explanation": "DFS (Depth-First Search) algoritmi rekursiv tarzda bajarilganda, funksiya chaqiruvlari steki (Call Stack) bilvosita stek ma'lumotlar tuzilmasi sifatida ishlatiladi."}, {"question": "YoвЂnaltirilgan graf nima?", "options": ["Og'irlikli graf", "Qirralari faqat bir tomonlama yo'nalishga ega bo'lgan graf", "Barcha tugunlari bir-biriga bog'langan graf", "Qirralari yo'nalishga ega bo'lmagan graf"], "correct_index": 1, "explanation": "Yo'naltirilgan graf (Directed Graph) - bu qirralari ma'lum bir yo'nalishga ega bo'lgan graf, ya'ni A dan B ga qirra bo'lsa, B dan A ga qirra bo'lishi shart emas."}, {"question": "Hisoblash geometriyasidagi Orientatsiya (ing. Orientation) formulasi natijasi manfiy boвЂlsa nimani bildiradi?", "options": ["Nuqtalar bir to'g'ri chiziqda joylashgan", "Nuqtalar bir-biriga juda uzoq", "Nuqtalar soat yo'nalishiga teskari (counter-clockwise) joylashgan", "Nuqtalar soat yo'nalishi bo'yicha (clockwise) joylashgan"], "correct_index": 3, "explanation": "Orientatsiya formulasi natijasi manfiy bo'lsa, bu nuqtalarning soat yo'nalishi bo'yicha (clockwise) joylashganligini bildiradi."}, {"question": "QoвЂshnichilik matritsasi (adjacency matrix) qanday tuziladi?", "options": ["Tugunlar soniga teng qator va ustunli matritsa", "Qirralar soniga teng qator va ustunli matritsa", "Faqat nol va birlardan iborat matritsa", "Faqat grafning og'irliklarini saqlovchi matritsa"], "correct_index": 0, "explanation": "Qo'shnichilik matritsasi (Adjacency Matrix) - bu tugu   Є
