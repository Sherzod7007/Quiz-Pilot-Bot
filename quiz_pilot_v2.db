    r  r                                                                                                        Ѓћv_ Q‚Ѕq_ba53919ce2674fcd93aa6293a5ef7f53D{"variant": "D", "quizzes": [{"question": "What are soft skills?", "options": ["Personal attributes and interpersonal skills", "Technical knowledge", "Data analysis", "Programming languages"], "correct_index": 0, "explanation": "Soft skills are personal attributes that enable effective interaction with others, such as communication and teamwork."}, {"question": "What do freelancers sell?", "options": ["Physical products", "Real estate", "Stocks", "Their skills and services"], "correct_index": 3, "explanation": "Freelancers work independently, offering their specialized skills and services to clients on a project basis."}, {"question": "What is telemedicine?", "options": ["A medical device", "A new type of medicine", "Healthcare services delivered remotely", "A hospital department"], "correct_index": 2, "explanation": "Telemedicine uses technology to provide healthcare services from a distance, such as virtual consultations."}, {"question": "Who designs app look?", "options": ["Testers", "Project managers", "Developers", "UI/UX designers"], "correct_index": 3, "explanation": "UI/UX designers focus on the visual appearance (UI) and user experience (UX) of an application."}, {"question": "Microsoft Azure is a cloud ___.", "options": ["device", "platform", "operating system", "application"], "correct_index": 1, "explanation": "Microsoft Azure is a comprehensive cloud computing platform offering various services."}, {"question": "Why use antivirus?", "options": ["To browse the internet safely", "To protect against viruses and malware", "To speed up your computer", "To store files"], "correct_index": 1, "explanation": "Antivirus software scans for, detects, and removes malicious software like viruses and other malware."}, {"question": "Students ___ bring a dictionary to the exam. It is not allowed.", "options": ["shouldn't", "couldn't", "don't have to", "mustn't"], "correct_index": 3, "explanation": "This indicates a strict prohibition."}, {"question": "You ___ visit the museum while you are in Paris. It's fantastic!", "options": ["must", "have to", "might", "should"], "correct_index": 3, "explanation": "This is a strong recommendation or suggestion."}, {"question": "What does K.I.S.S. mean?", "options": ["Keep It Simple, Stupid", "Kindly Inform Senior Staff", "Know Important System Secrets", "Keep It Safe and Secure"], "correct_index": 0, "explanation": "K.I.S.S. is a design principle that advocates for simplicity in design and avoiding unnecessary complexity."}, {"question": "What do startups focus on?", "options": ["Maintaining existing products", "Innovation and rapid growth", "Large market share", "Stable profits"], "correct_index": 1, "explanation": "Startups are typically new companies focused on developing unique products or services and scaling quickly."}, {"question": "What is Git used for?", "options": ["Version control", "Graphic design", "Project management", "Data storage"], "correct_index": 0, "explanation": "Git is a distributed version control system used for tracking changes in source code during software development."}, {"question": "What is VR?", "options": ["Virtual Reality", "Video Recording", "Visual Rendering", "Voice Recognition"], "correct_index": 0, "explanation": "VR stands for Virtual Reality, which creates simulated environments."}, {"question": "What is spyware?", "options": ["A type of operating system", "A tool for system optimization", "Software that secretly collects information", "A network monitoring device"], "correct_index": 2, "explanation": "Spyware is software that secretly monitors and collects information about a user's computer activity without their knowledge."}, {"question": "What is a virus?", "options": ["A computer program", "A network protocol", "A type of malware that replicates itself", "A hardware component"], "correct_index": 2, "explanation": "Computer viruses are self-replicating malicious programs that attac  C    ": "Estetik his-tuygК»ular nima?", "options": ["Estetik his-tuygК»ular вЂ“ bu insonning goК»zallik, ulugК»vorlik, fojialilik, kulgililik kabi estetik hodisalarni idrok etishida yuzaga keladigan hissiy kechinmalaridir.", "Estetik his-tuygК»ular вЂ“ bu faqat ilmiy kashfiyotlar qilishda yuzaga keladigan intellektual kechinmalardir.", "Estetik his-tuygК»ular вЂ“ bu faqat ochlik va chanqoqlik kabi biologik ehtiyojlar bilan bogК»liq hissiyotlardir.", "Estetik his-tuygК»ular вЂ“ bu ijtimoiy munosabatlarda yuzaga keladigan gК»azab va nafrat kabi salbiy hissiyotlardir."], "correct_index": 0, "explanation": "Estetik his-tuygК»ular вЂ“ bu insonning borliqni estetik jihatdan idrok etishi natijasida yuzaga keladigan, goК»zallik, uygК»unlik, ulugК»vorlik, fojialilik, kulgililik kabi estetik kategoriyalar bilan bogК»liq ijobiy yoki salbiy hissiy kechinmalardir."}, {"question": "Estetik ong va uning koК»rinishlari qanday?", "options": ["Estetik ong вЂ“ bu faqat san'at asarlarini yaratish jarayoni boК»lib, uning koК»rinishlari faqat rassomchilik va haykaltaroshlikda uchraydi.", "Estetik ong вЂ“ bu insonning kundalik hayotdagi oddiy fikrlari boК»lib, uning koК»rinishlari faqat moddiy boylikka intilishda aks etadi.", "Estetik ong вЂ“ bu ilmiy bilimlarni oК»zlashtirish jarayoni boК»lib, uning koК»rinishlari faqat matematik formulalarda ifodalanadi.", "Estetik ong вЂ“ bu insonning borliqni goК»zallik qonuniyatlari asosida idrok etishi va baholashi boК»lib, uning koК»rinishlari estetik his-tuygК»ular, did, ideal va nazariyalarda namoyon boК»ladi."], "correct_index": 3, "explanation": "Estetik ong insonning borliqni goК»zallik, uygК»unlik va mukammallik nuqtai nazaridan idrok etishi, baholashi va oК»zgartirishga intilishi. Uning asosiy koК»rinishlari estetik his-tuygК»ular, did, ideal, ehtiyoj, baho va nazariyalardir."}, {"question": "Estetik did va uning namoyon boК»lish shakllari qanday?", "options": ["Estetik did вЂ“ bu insonning estetik qadriyatlarni farqlash, baholash va ularga nisbatan shaxsiy munosabatini ifodalash qobiliyatidir. Uning namoyon boК»lish shakllari san'at asarlarini tanlash, kiyim-kechak uslubi, interyer dizayni va xulq-atvorda koК»rinadi.", "Estetik did вЂ“ bu insonning boshqalarga taqlid qilish qobiliyatidir va uning shaxsiy namoyon boК»lish shakllari yoК»q.", "Estetik did вЂ“ bu faqat ilmiy nazariyalarni tushunish qobiliyatidir.", "Estetik did вЂ“ bu faqat ovqatlanishdagi afzalliklar va ta'mlarni anglatadi."], "correct_index": 0, "explanation": "Estetik did вЂ“ bu insonning goК»zallikni xunuklikdan, nafislikni dagК»allikdan ajrata olish, estetik qadriyatlarni toК»gК»ri baholash va ularga nisbatan shaxsiy munosabatini ifodalash qobiliyatidir. Uning namoyon boК»lish shakllari turli sohalarda, jumladan, san'at, moda, dizayn, tabiatni idrok etish va kundalik hayotdagi tanlovlarda aks etadi."}, {"question": "Estetikada вЂњUlugвЂvorlikвЂќ va вЂњFojialilikвЂќ kategoriyalarining asosiy farqi nimada?", "options": ["UlugК»vorlik va Fojialilik bir xil ma'noga ega boК»lgan tushunchalardir.", "UlugК»vorlik вЂ“ bu faqat kichik va ahamiyatsiz narsalarni anglatadi, Fojialilik esa faqat quvonchli voqealarni tasvirlaydi.", "UlugК»vorlik вЂ“ bu insonning imkoniyatlaridan ustun boК»lgan, hayratga soluvchi va ilhomlantiruvchi hodisalarni ifodalasa, Fojialilik вЂ“ bu insonning azob-uqubatlari, halokati va qaygК»usini aks ettiruvchi, chuqur hissiy kechinmalarni uygК»otuvchi hodisadir.", "UlugК»vorlik вЂ“ bu faqat san'at asarlarida uchraydigan tushuncha, Fojialilik esa faqat kundalik hayotdagi muammolarni anglatadi."], "correct_index": 2, "explanation": "UlugК»vorlik (Sublime) вЂ“ bu insonning aql-idrokidan yuqori boК»lgan, cheksizlik, qudrat va buyuklikni ifodalovchi, hayrat va hurmat uygК»otuvchi estetik kategoriya. Fojialilik (Tragic) вЂ“ bu insonning hayotdagi ziddiyatlar, azob-uqubatlar, halokat va qaygК»ularini aks ettiruvchi, chuqur hissiy kechinmalar va hamdardlik uygК»otuvchi estetik kategoriya. Ularning asosiy farqi shundaki, ulugК»vorlik insonni ilhomlantirsa, fojialilik insonni oК»ylantiradi va chuqur qaygК»uga soladi."}]}j›{о
