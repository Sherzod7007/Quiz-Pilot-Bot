explanation": "Musbat f(x,y) funksiyaning ikki karrali integrali mos silindrik jism hajmini ifodalaydi."}, {"question": "в€‚^2 z / в€‚x^2 koвЂrinishidagi hosila nima deyiladi?", "options": ["x bo'yicha ikkinchi tartibli xususiy hosila", "y bo'yicha birinchi tartibli hosila", "Aralash hosila", "To'liq differensial"], "correct_index": 0, "explanation": "Ushbu belgilash x o'zgaruvchisi bo'yicha olingan ikkinchi tartibli xususiy hosiladir."}, {"question": "Chiziqli dasturlash masalasining matematik modelida x1, x2 в‰Ґ 0 sharti nima deyiladi?", "options": ["Cheklov sharti", "Chiziqlilik sharti", "O'zgaruvchilarning nomanfiylik sharti", "Maqsad sharti"], "correct_index": 2, "explanation": "O'zgaruvchilarning noldan kichik bo'lmaslik talabi nomanfiylik sharti deyiladi."}, {"question": "Bir jinsli plastinkaning massasini topish uchun nima maвЂ™lum boвЂlishi kerak?", "options": ["Faqat uning balandligi", "Plastinkaning sirtiy zichligi va eg   Ыallagan sohasi", "Faqat uning perimetri", "Havo bosimi"], "correct_index": 1, "explanation": "Massa m = в€¬_D ПЃ(x,y) dx dy formulasi orqali topilishi uchun sirtiy zichlik va D soha ma'lum bo'lishi lozim."}, {"question": "Nomanfiylik sharti (x в‰Ґ 0) nimani bildiradi?", "options": ["Resurslar cheksizligini", "Ishlab chiqariladigan mahsulot yoki resurs miqdori manfiy bo'lishi mumkin emasligini", "Faqat manfiy qiymatlarni hisobga olishni", "Nolga bo'lish mumkinligini"], "correct_index": 1, "explanation": "Amaliy masalalarda mahsulot va resurs miqdori manfiy bo'la olmaydi."}, {"question": "Talabaning vaqti: 5 soat boвЂsh vaqt bor. Kitob oвЂqish (x1) va video koвЂ™rish (x2) uchun jami vaqt cheklovi qanday yoziladi?", "options": ["x1 + x2 в‰Ґ 5", "x1 * x2 = 5", "x1 + x2 в‰¤ 5", "x1 - x2 в‰¤ 5"], "correct_index": 2, "explanation": "Sarflangan vaqt yig'indisi mavjud 5 soatdan oshib ketmasligi kerak: x1 + x2 в‰¤ 5."}, {"question": "OвЂyin industriyasida 3D modellarning yoritilishini hisoblashda nima qoвЂllaniladi?", "options": ["Faqat chiziqli integrallar", "Noma'lum ko'paytuvchilar", "Sirt integrallari va ikki karrali integrallar", "Algebraik tenglamalar"], "correct_index": 2, "explanation": "3D modellarda nur va soyaning tarqalishini hisoblashda sirt va ikki karrali integrallar ishlatiladi."}, {"question": "Maqsad funksiyasi вЂњmaxвЂќ boвЂlsa, nima izlanadi?", "options": ["Minimal (eng kichik) qiymat", "Maksimal (eng katta) qiymat", "Nol qiymat", "O'rtacha qiymat"], "correct_index": 1, "explanation": "'max' belgisi maksimum (eng katta foyda yoki natija) izlanayotganini bildiradi."}, {"question": "Chiziqli dasturlash masalasining asosiy maqsadi nima?", "options": ["Nomalumlarni yo'qotish", "Tenglamalar sonini ko'paytirish", "Cheklangan resurslar sharoitida optimal yechimni topish", "Grafiklarni chizish"], "correct_index": 2, "explanation": "Asosiy maqsad вЂ” berilgan cheklovlar doirasida eng maqbul (optimal) yechimga erishish."}, {"question": "Modellashtirishning birinchi bosqichi nima?", "options": ["Matematik tenglamani yechish", "Natijalarni tahlil qilish", "Dastur kodini yozish", "Masalaning qo'yilishi va maqsadni aniqlash"], "correct_index": 3, "explanation": "Modellashtirish masalaning qo'yilishi va maqsadlarni belgilashdan boshlanadi."}, {"question": "Ekstremumga tekshirishda в€† = AC - B^2 < 0 boвЂlsa, xulosa qanday boвЂladi?", "options": ["Maksimum mavjud", "Minimum mavjud", "Ekstremum mavjud emas", "Ekstremum mavjud"], "correct_index": 2, "explanation": "Ikki o'zgaruvchili funksiyada в€† = AC - B^2 < 0 bo'lganda ushbu nuqtada ekstremum mavjud emas."}, {"question": "Bitta mahsulotdan 5000 soвЂm foyda qolsa, x ta mahsulotdan qancha foyda qoladi?", "options": ["5000 / x", "x - 5000", "5000 + x", "5000x"], "correct_index": 3, "explanation": "x ta mahsulotdan olinadigan umumiy foyda 5000 * x so'm bo'ladi."}, {"question": "z = y^2 + 7 funksiya uchun z_x' ni toping:", "options": ["0", "2y", "2y + 7", "7"], "correct_index": 0, "explanation": "Funksiyada x o'zgaruvchisi qatnashmagani uchun x bo'yicha xususiy hosilasi 0 ga teng."}, {"question": "Model tuzishda вЂњSoddalikвЂќ tamoyili nima uchun kerak?", "options": ["Maqsad funksiyasini yo'qotish uchun", "Xatoliklarni ko'paytirish uchun", "Modelni tushunish va hisoblashni osonlashtirish uchun", "Aniqlikni butunlay yo'qotish uchun"], "correct_index": 2, "explanation": "Soddalik tamoyili modelni keraksiz murakkabliklardan xoli qilib, asosiy jarayonlarni aks ettirishga yordam beradi."}, {"question": "Plastinkaning ogвЂirlik markazi koordinatalari nima orqali aniqlanadi?", "options": ["Faqat soha yuzi orqali", "Perimetrlar nisbati orqali", "Statik momentlarning massaga nisbati va ikki karrali integrallar orqali", "Koordinata boshidan masofa orqali"], "correct_index": 2, "explanation": "Og'irlik markazi x_c = My/m va y_c = Mx/m ko'rinishida statik momentlar va massaning ikki karrali integrallari orqali topiladi."}, {"question": "Hayotda вЂњOptimallashtirishвЂќ nima uchun kerak?", "options": ["Matematik modellarni yo'qotish uchun", "Mavjud resurslardan eng samarali va foy   Ьdali tarzda foydalanish uchun", "Faqat xarajatlarni oshirish uchun", "Hisoblashlarni murakkablashtirish uchun"], "correct_index": 1, "explanation": "Optimallashtirish cheklangan resurslardan maksimal foyda yoki minimal xarajat olish uchun xizmat qiladi."}, {"question": "F(x, y) = 0 koвЂrinishida berilgan funksiya nima deyiladi?", "options": ["Oshkor funksiya", "Murakkab funksiya", "Oshkormas funksiya", "Chiziqli funksiya"], "correct_index": 2, "explanation": "O'zgaruvchilari tenglamaning bir tomonida yig'ilgan F(x, y) = 0 ko'rinishidagi funksiya oshkormas funksiya deyiladi."}, {"question": "z = x^2 + y^2 funksiyaning statsionar nuqtasini toping:", "options": ["(0, 1)", "(1, 1)", "(0, 0)", "(1, 0)"], "correct_index": 2, "explanation": "z_x' = 2x = 0 va z_y' = 2y = 0 tenglamalardan x=0, y=0 kelib chiqadi. Statsionar nuqta (0,0)."}, {"question": "Funksiyada faqat x oвЂzgarganda olingan в€†_x z = f(x + в€†x, y) - f(x, y) ayirma nima deyiladi?", "options": ["Xususiy orttirma", "Xususiy hosila", "To'liq differensial", "To'liq orttirma"], "correct_index": 0, "explanation": "Faqat bitta o'zgaruvchi x o'zgargandagi orttirma x bo'yicha xususiy orttirma deyiladi."}, {"question": "f(x,y) funksiya ikki karrali integrallanuvchi boвЂlishining yetarli sharti:", "options": ["D yopiq va cheklangan sohada uzluksiz bo'lishi", "Faqat noldan katta hosilaga ega bo'lishi", "Chiziqli bo'lishi", "D sohada faqat musbat bo'lishi"], "correct_index": 0, "explanation": "Yopiq va cheklangan D sohada uzluksiz bo'lgan funksiya shu sohada integrallanuvchi bo'ladi."}, {"question": "z = 10x funksiyaning x boвЂyicha xususiy hosilasi z_x' nimaga teng?", "options": ["10", "0", "10x", "1"], "correct_index": 0, "explanation": "x bo'yicha hosila olinganda (10x)' = 10 bo'ladi."}, {"question": "Agar ikki karrali integralda integral ostidagi funksiya 1 ga teng boвЂlsa, u nimani hisoblaydi?", "options": ["Og'irlik markazini", "Perimetrni", "Sohaning hajmini", "Integrallash sohasi D ning yuzasini"], "correct_index": 3, "explanation": "в€¬_D 1 dx dy integral D sohaning yuzasiga teng bo'ladi."}, {"question": "Funksiyaning maksimum va minimum nuqtalari umumiy qanday nomlanadi?", "options": ["Kritik nuqtalar", "Statsionar nuqtalar", "Nol nuqtalari", "Ekstremum nuqtalari"], "correct_index": 3, "explanation": "Maksimum va minimum nuqtalari birgalikda ekstremum nuqtalari deb ataladi."}, {"question": "Shartli ekstremumni topishda qaysi funksiya yordamida hisoblashlar olib boriladi?", "options": ["Nyuton funksiyasi", "Lagranj funksiyasi", "Gauss funksiyasi", "Eyler funksiyasi"], "correct_index": 1, "explanation": "Shartli ekstremumni topishda Lagranj ko'paytuvchilar usuli va Lagranj funksiyasi qo'llaniladi."}, {"question": "Chiziqli dasturlash masalasida cheklangan resurslar (masalan: un, vaqt, pul) qanday ifodalanadi?", "options": ["Faqat maqsad funksiyasi bilan", "Nomanfiylik sharti bilan", "O'zgarmas koordinatalar bilan", "Tengsizliklar yoki tenglamalar ko'rinishidagi cheklovlar bilan"], "correct_index": 3, "explanation": "Resurslar miqdori modelda matematik tengsizliklar yoki tenglamalar ko'rinishida beriladi."}, {"question": "Agar masalada xarajatlarni kamaytirish soвЂralsa, maqsad funksiyasi nimaga intiladi?", "options": ["O'zgarmasga", "Birga", "Minimumga (min)", "Maksimumga (max)"], "correct_index": 2, "explanation": "Xarajatlarni minimallashtirish uchun maqsad funksiyasi min ga intiladi."}, {"question": "Р¤(x, y, О») = x + y + О»(x^2 + y^2 - 1) Lagranj funksiyasidan x boвЂyicha hosila oling:", "options": ["1 + О»", "2О»x", "1 + 2О»x", "1 + 2О»y"], "correct_index": 2, "explanation": "x bo'yicha xususiy hosila: (x)' + (y)' + О»(x^2)' + О»(y^2)' - О»(1)' = 1 + 2О»x."}, {"question": "Ikki karrali integral qanday soha ustida hisoblanadi?", "options": ["Cheksiz to'g'ri chiziq ustida", "Faqat fazodagi shar ustida", "Faqat bir o'lchovli kesma ustida", "Tekislikdagi cheklangan D soha ustida"], "correct_index": 3, "explanation": "Ikki karrali integral 2D tekislikdagi cheklangan va yopiq D sohada hisoblanadi."}, {"question": "Ikki oвЂzgaruvchili z = f(x, y) funksiyan    ing M0(x0, y0) nuqtadagi qiymati uning atrofidagi boshqa nuqtalardagi qiymatlaridan katta boвЂlsa, bu nuqta nima deyiladi?", "options": ["Minimum nuqtasi", "Nol nuqtasi", "Maksimum nuqtasi", "Egar nuqtasi"], "correct_index": 2, "explanation": "Atrofidagi barcha nuqtalardagi qiymatlardan katta qiymat qabul qiluvchi nuqta maksimum nuqtasi hisoblanadi."}, {"question": "Agar masalada foydani koвЂpaytirish soвЂralsa, maqsad funksiyasi nimaga intiladi?", "options": ["Cheksizlikka", "Minimumga (min)", "Maksimumga (max)", "Nolga"], "correct_index": 2, "explanation": "Foyda maksimal darajaga yetkazilishi kerak, shuning uchun maqsad funksiyasi max ga intiladi."}, {"question": "Axborot xavfsizligida barmoq izi matematik modelini nima orqali qurish mumkin?", "options": ["Ikki karrali integrallar va sirt tenglamalari orqali", "Chiziqli tenglamalar sistemasi bilan", "Tasodifiy sonlar generatori orqali", "Faqat oddiy qo'shish usuli bilan"], "correct_index": 0, "explanation": "Barmoq izi tasviridagi zichlik va sirt relyefini ikki karrali integrallar va sirt tenglamalari yordamida modellashtirish mumkin."}, {"question": "ToвЂliq differensialni hisoblash formulasini koвЂrsating:", "options": ["dz = z_x' dx + z_y' dy", "dz = z_x' dx - z_y' dy", "dz = z_x' + z_y'", "dz = dx + dy"], "correct_index": 0, "explanation": "Ikki o'zgaruvchili funksiyaning to'liq differensiali dz = z_x' dx + z_y' dy formula bilan hisoblanadi."}, {"question": "Ikki karrali integralda D sohaning diametr tushunchasi qanday aniqlanadi?", "options": ["Soha markazidan masofa", "Soha chegarasining uzunligi", "Sohadagi ixtiyoriy ikki nuqta orasidagi eng katta masofa", "Soha yuzining kvadrati"], "correct_index": 2, "explanation": "Sohaning diametri shu sohada yotuvchi barcha juft nuqtalar orasidagi masofalarning eng kattasiga teng."}, {"question": "Chiziqli dasturlash nima?", "options": ["Faqat chiziqli tenglamalar sistemasi", "Chiziqli bog'lanishli optimallashtirish masalalarini yechish usullari bo'limi", "Kompyuterda dastur yozish tili", "Geometrik shakllarni chizish usuli"], "correct_index": 1, "explanation": "Chiziqli dasturlash вЂ” chiziqli maqsad funksiyasi va chiziqli cheklovlarga ega masalalarni yechuvchi matematika bo'limi."}, {"question": "Agar A = 2, B = 0, C = 2 boвЂlsa, в€† = AC - B^2 qiymatini hisoblang:", "options": ["-4", "4", "2", "0"], "correct_index": 1, "explanation": "в€† = 2 * 2 - 0^2 = 4."}, {"question": "Muzqaymoq 20 soвЂm, pulingiz 100 soвЂm. Muzqaymoq soni x bo'lsa, toвЂgвЂri tengsizlikni toping:", "options": ["20x в‰¤ 100", "x в‰¤ 20", "20x = 100", "20x в‰Ґ 100"], "correct_index": 0, "explanation": "Xarajat (20x) mavjud puldan (100) oshib ketmasligi kerak, ya'ni 20x в‰¤ 100."}, {"question": "Ikki karrali integralda oвЂzgarmas sonni integral belgisidan tashqariga chiqarish mumkinmi?", "options": ["Faqat musbat bo'lsa mumkin", "Yo'q, mumkin emas", "Ha, mumkin", "Faqat nolga teng bo'lganda mumkin"], "correct_index": 2, "explanation": "Integral xossasiga ko'ra, o'zgarmas ko'paytuvchini integral belgisidan tashqariga chiqarish mumkin."}, {"question": "Funksiyaning yopiq sohadagi eng katta va eng kichik qiymatlari qayerda qidiriladi?", "options": ["Faqat soha chegarasida", "Faqat koordinata boshida", "Soha ichidagi kritik nuqtalarda va soha chegarasida", "Faqat soha markazida"], "correct_index": 2, "explanation": "Yopiq sohada eng katta va eng kichik qiymatlar soha ichki kritik nuqtalarida hamda soha chegarasida qidiriladi."}, {"question": "Grafik usul odatda nechta oвЂzgaruvchi boвЂlganda qoвЂllaniladi?", "options": ["Faqat 1 ta o'zgaruvchi", "10 ta o'zgaruvchi", "2 ta o'zgaruvchi", "Istalgancha o'zgaruvchi"], "correct_index": 2, "explanation": "Grafik usul tekislikda tasvirlash oson bo'lganligi sababli ko'pincha 2 ta o'zgaruvchili masalalarda qo'llaniladi."}]}j†џ                                                                                                                                                                                                                                                                                       Юkita elektron joylashishi mumkin."}, {"question": "Yarim oвЂtkazgichlarda harorat koвЂtarilishi bilan ularning elektr oвЂtkazuvchanligi qanday oвЂzgaradi?", "options": ["O'zgarmaydi", "Ortadi", "Avval kamayib, keyin ortadi", "Kamayadi"], "correct_index": 1, "explanation": "Harorat ortishi bilan yarimo'tkazgichlarda ko'proq elektronlar valentlik sohasidan o'tkazuvchanlik sohasiga o'tadi, bu esa zaryad tashuvchilar konsentratsiyasini oshirib, elektr o'tkazuvchanligini oshiradi."}, {"question": "Mikrozarrachalarning energetik sathlar boвЂ™ylab taqsimlanish ehtimolligi qaysi statistika bilan aniqlanadi?", "options": ["Maksvell statistikasi", "Bolsman statistikasi", "Fermi-Dirak statistikasi", "Bose-Eynshteyn statistikasi"], "correct_index": 2, "explanation": "Elektronlar kabi fermionlar Pauli prinsipiga amal qilganligi sababli Fermi-Dirak statistikasiga bo'ysunadi."}, {"question": "Yarim oвЂtkazgichga elektron beradigan (beruvchi) kirishma atomlari nima deb ataladi?", "options": ["Akseptor", "Izolyator", "Metall", "Donor"], "correct_index": 3, "explanation": "Donor kirishmalar yarimo'tkazgichga qo'shimcha elektronlar beradi, bu esa n-tipli o'tkazuvchanlikni hosil qiladi."}, {"question": "ToвЂliq elektronlar bilan toвЂlgan eng yuqori energetik soha qanday ataladi?", "options": ["Valentlik sohasi", "Taqiqlangan soha", "O'tkazuvchanlik sohasi", "Fermi sohasi"], "correct_index": 0, "explanation": "Valentlik sohasi - bu elektronlar bilan to'liq to'lgan va atomlarning valent elektronlarini o'z ichiga olgan eng yuqori energetik soha."}, {"question": "n-tipli yarim oвЂtkazgichda 'ozchilik' zaryad tashuvchilar qaysilar?", "options": ["Kovaklar", "Neytronlar", "Ikkala ham teng", "Elektronlar"], "correct_index": 0, "explanation": "n-tipli yarimo'tkazgichlarda elektronlar asosiy zaryad tashuvchilar bo'lsa, kovaklar ozchilik zaryad tashuvchilar hisoblanadi."}, {"question": "Yadro kuchlarining asosiy xususiyati nima?", "options": ["Qisqa masofali va zaryadga bog'liq emasligi", "Uzoq masofali va zaryadga bog'liq", "Faqat neytronlar orasida ta'sir qiladi", "Faqat protonlar orasida ta'sir qiladi"], "correct_index": 0, "explanation": "Yadro kuchlari juda qisqa masofalarda ta'sir qiladi va protonlar, neytronlar yoki proton-neytron orasidagi ta'sir kuchlari deyarli bir xil, ya'ni zaryadga bog'liq emas."}, {"question": "p-n oвЂtishda muvozanat holatida nima sodir boвЂladi?", "options": ["Faqat kovaklar harakatlanadi", "Faqat elektronlar harakatlanadi", "Hech qanday zaryad tashuvchi harakatlanmaydi", "Diffuziya va dreyf toklari tenglashadi"], "correct_index": 3, "explanation": "Muvozanat holatida diffuziya (konsentratsiya farqi tufayli) va dreyf (ichki elektr maydoni tufayli) toklari bir-birini kompensatsiya qiladi, natijada sof tok nolga teng bo'ladi."}, {"question": "Harorat juda yuqori boвЂlganda kirishmali yarim oвЂtkazgich oвЂzini qanday tutadi?", "options": ["Supero'tkazgich kabi", "Xususiy yarimo'tkazgich kabi", "Izolyator kabi", "Metall kabi"], "correct_index": 1, "explanation": "Yuqori haroratlarda termal generatsiya kuchayadi va kirishma atomlaridan keladigan zaryad tashuvchilar soni xususiy zaryad tashuvchilar soniga nisbatan ahamiyatsiz bo'lib qoladi, shuning uchun u xususiy yarimo'tkazgich kabi harakat qiladi."}, {"question": "Kremniyga (IV-gruppa) Beshinchi gruppa elementi (masalan, Fosfor) qoвЂshilganda qanday turdagi yarim oвЂtkazgich hosil boвЂladi?", "options": ["p-tipli", "Xususiy", "n-tipli", "Izolyator"], "correct_index": 2, "explanation": "Beshinchi gruppa elementi (masalan, Fosfor) kremniyga qo'shilganda, u bitta ortiqcha elektron beradi, bu esa n-tipli yarimo'tkazgich hosil bo'lishiga olib keladi."}, {"question": "Alfa (О±) yemirilishda yadroning massa soni (A) va zaryadi (Z) qanday oвЂzgaradi?", "options": ["A 4 ga, Z 2 ga ortadi", "A o'zgarmaydi, Z 1 ga kamayadi", "A o'zgarmaydi, Z 1 ga ortadi", "A 4 ga, Z 2 ga kamayadi"], "correct_index": 3, "explanation": "Alfa yemirilishda geliy yadrosi (ikki proton va ikki neytron) uchib chiqadi, shuning uchun massa soni 4 ga, zaryad soni esa 2 ga kamayadi."}, {"   Яquestion": "Qattiq jismlarda elektronlarning energetik sohalarga boвЂlinishiga sabab boвЂladigan asosiy prinsip qaysi?", "options": ["Plank kvant prinsipi", "Geyzenbergning noaniqlik prinsipi", "Dirak prinsipi", "Pauli prinsipi"], "correct_index": 3, "explanation": "Pauli prinsipi shuni aytadiki, bitta kvant holatida ikkita bir xil fermion (elektron) bo'lishi mumkin emas. Bu atomlar bir-biriga yaqinlashganda energetik sathlarning sohalarga bo'linishiga olib keladi."}, {"question": "Taqiqlangan sohasi mavjud boвЂlmagan yoki valentlik sohasi bilan oвЂtkazuvchanlik sohasi ustma-ust tushgan moddalar qaysi?", "options": ["Yarimo'tkazgichlar", "Supero'tkazgichlar", "Dielektriklar", "Metallar"], "correct_index": 3, "explanation": "Metallarda valentlik sohasi va o'tkazuvchanlik sohasi ustma-ust tushadi, bu esa elektronlarning erkin harakatlanishini va yuqori elektr o'tkazuvchanligini ta'minlaydi."}, {"question": "Elektronni metalldan vakuumga chiqarish uchun sarflanadigan minimal energiya nima deyiladi?", "options": ["Kinetik energiya", "Bog'lanish energiyasi", "Chiqish ishi", "Ionizatsiya energiyasi"], "correct_index": 2, "explanation": "Chiqish ishi - bu elektronni metalldan chiqarib, uni vakuumga olib chiqish uchun zarur bo'lgan minimal energiya."}, {"question": "Taqiqlangan soha kengligi (Eg) ortishi bilan zaryad tashuvchilar konsentratsiyasi qanday oвЂ™zgaradi?", "options": ["O'zgarmaydi", "Ortadi", "Avval ortib, keyin kamayadi", "Kamayadi"], "correct_index": 3, "explanation": "Taqiqlangan soha kengligi ortishi bilan elektronlarning valentlik sohasidan o'tkazuvchanlik sohasiga o'tishi uchun ko'proq energiya talab qilinadi, bu esa zaryad tashuvchilar konsentratsiyasini kamaytiradi."}, {"question": "Yarim oвЂtkazgich panjarasidan bitta elektronni oвЂziga olib, musbat zaryadlangan kovak hosil qiladigan kirishmalar nima deyiladi?", "options": ["Akseptor", "Neytral", "Donor", "Katalizator"], "correct_index": 0, "explanation": "Akseptor kirishmalar yarimo'tkazgichdan elektron qabul qilib, kovaklar hosil qiladi, bu esa p-tipli o'tkazuvchanlikni ta'minlaydi."}, {"question": "OвЂzaro taвЂ™sir turlari ichida eng kichik taвЂ™sir doimiysiga (~10вЃ»ВівЃ№) egasi qaysi?", "options": ["Gravitatsion o'zaro ta'sir", "Elektromagnit o'zaro ta'sir", "Zaif o'zaro ta'sir", "Kuchli o'zaro ta'sir"], "correct_index": 0, "explanation": "To'rtta fundamental o'zaro ta'sir orasida gravitatsion o'zaro ta'sir eng zaifidir."}, {"question": "Elektronlar boвЂlmagan yoki qisman toвЂlgan, elektr oвЂtkazuvchanlikni taвЂ™minlovchi soha qaysi?", "options": ["Valentlik sohasi", "Asosiy soha", "O'tkazuvchanlik sohasi", "Taqiqlangan soha"], "correct_index": 2, "explanation": "O'tkazuvchanlik sohasi - bu elektronlar bo'lmagan yoki qisman to'lgan energetik soha bo'lib, undagi elektronlar elektr tokini o'tkazishga qodir."}, {"question": "Betta (ОІ) yemirilishda yadrodan qanday zarracha uchib chiqadi?", "options": ["Neytron", "Elektron yoki pozitron", "Proton", "Alfa zarracha"], "correct_index": 1, "explanation": "Beta yemirilishda yadro ichidagi neytron protonga aylanib elektron (beta-minus) chiqarishi yoki proton neytronga aylanib pozitron (beta-plyus) chiqarishi mumkin."}, {"question": "Xususiy yarim oвЂ™tkazgichlarda Fermi sathi (Вµ) qayerda joylashgan boвЂ™ladi?", "options": ["Taqiqlangan sohaning o'rtasida", "Taqiqlangan sohadan tashqarida", "O'tkazuvchanlik sohasida", "Valentlik sohasida"], "correct_index": 0, "explanation": "Xususiy yarimo'tkazgichlarda Fermi sathi taqiqlangan sohaning aniq o'rtasida joylashgan bo'ladi, bu elektronlar va kovaklarning teng ehtimollik bilan paydo bo'lishini ko'rsatadi."}, {"question": "Taqiqlangan sohasining kengligi (О”E) juda katta (bir necha eV) boвЂlgan moddalar nima deb ataladi?", "options": ["Metallar", "Yarimo'tkazgichlar", "Dielektriklar (izolyatorlar)", "Supero'tkazgichlar"], "correct_index": 2, "explanation": "Dielektriklar (izolyatorlar) juda katta taqiqlangan sohaga ega bo'lib, bu ularning elektr tokini o'tkazmasligini anglatadi."}, {"question": "Xususiy yarim oвЂ™tkazgichlarda elektronlar (n) va kovakla   аr (p) konsentratsiyasi oвЂ™rtasidagi munosabat qanday?", "options": ["n < p", "n > p", "n = p", "n в‰  p"], "correct_index": 2, "explanation": "Xususiy yarimo'tkazgichlarda har bir valentlik sohasidan o'tkazuvchanlik sohasiga o'tgan elektron uchun valentlik sohasida bitta kovak hosil bo'ladi, shuning uchun ularning konsentratsiyasi teng bo'ladi."}, {"question": "Aralashmalarsiz, sof holdagi yarim oвЂ™tkazgichlar nima deb ataladi?", "options": ["P-tipli yarimo'tkazgichlar", "N-tipli yarimo'tkazgichlar", "Kirishmali yarimo'tkazgichlar", "Xususiy yarimo'tkazgichlar"], "correct_index": 3, "explanation": "Xususiy yarimo'tkazgichlar - bu hech qanday kirishma atomlari bo'lmagan, sof yarimo'tkazgichlar."}, {"question": "Qattiq jism hosil boвЂlishida zarrachalar orasidagi qaysi kuchlar ularning bir-biriga qoвЂshilishiga qarshilik qiladi?", "options": ["Yadro kuchlari", "Itarish kuchlari", "Tortishish kuchlari", "Magnit kuchlar"], "correct_index": 1, "explanation": "Atomlar bir-biriga juda yaqinlashganda, ularning elektron qobiqlari o'zaro itarishni boshlaydi, bu esa ularning ma'lum bir masofada muvozanatda bo'lishini ta'minlaydi."}, {"question": "p-tipli yarim oвЂtkazgichda asosiy zaryad tashuvchilar qaysilar?", "options": ["Neytronlar", "Ikkala ham teng", "Kovaklar", "Elektronlar"], "correct_index": 2, "explanation": "p-tipli yarimo'tkazgichlarda akseptor kirishmalar tufayli kovaklar konsentratsiyasi elektronlar konsentratsiyasidan ancha yuqori bo'ladi."}, {"question": "Kontakt potensiallar farqi tashqi zanjirdagi tokka qanday taвЂ™sir qiladi?", "options": ["Tok o'tishiga qarshilik ko'rsatadi", "Tok o'tishiga yordam beradi", "Tokni kuchaytiradi", "Tokka ta'sir qilmaydi"], "correct_index": 0, "explanation": "Kontakt potensiallar farqi (yoki ichki elektr maydoni) zaryad tashuvchilarning o'tishiga to'sqinlik qiladi, ya'ni tok o'tishiga qarshilik ko'rsatadi."}, {"question": "Chiqish ishi turlicha boвЂlgan ikki metall tekkizilganda, elektronlar qaysi metalldan qaysinisiga oвЂtadi?", "options": ["Chiqish ishi katta bo'lgan metalldan chiqish ishi kichik bo'lgan metallga", "Har ikki yo'nalishda ham teng o'tadi", "Elektronlar o'tmaydi", "Chiqish ishi kichik bo'lgan metalldan chiqish ishi katta bo'lgan metallga"], "correct_index": 3, "explanation": "Elektronlar energiya jihatdan qulayroq holatga o'tishga intiladi, ya'ni chiqish ishi kichik bo'lgan metalldan (elektronlar erkinroq) chiqish ishi katta bo'lgan metallga o'tadi."}, {"question": "n-tipli yarim oвЂtkazgichlarda Fermi sathi (Вµ) taqiqlangan sohaning qaysi qismida joylashgan boвЂladi?", "options": ["Taqiqlangan sohadan tashqarida", "O'tkazuvchanlik sohasiga yaqin", "Taqiqlangan sohaning o'rtasida", "Valentlik sohasiga yaqin"], "correct_index": 1, "explanation": "n-tipli yarimo'tkazgichlarda donor kirishmalar qo'shimcha elektronlar beradi, bu esa Fermi sathini o'tkazuvchanlik sohasiga yaqinroq siljitadi."}, {"question": "Kristall panjaraning ichki maydoni taвЂ™sirini hisobga olgan holda kiritilgan massa nima deyiladi?", "options": ["Effektiv massa", "Dam olish massasi", "Nisbiy massa", "Haqiqiy massa"], "correct_index": 0, "explanation": "Effektiv massa - bu elektronning kristall panjara ichidagi harakatini tavsiflash uchun ishlatiladigan tushuncha bo'lib, panjara potentsialining elektron harakatiga ta'sirini hisobga oladi."}, {"question": "Kristallarda elektronlarning alohida atomlarga tegishli boвЂlmay, butun kristall boвЂylab harakatlanishi nima deyiladi?", "options": ["Ionizatsiya", "Delokalizatsiya", "Rekombinatsiya", "Lokalizatsiya"], "correct_index": 1, "explanation": "Metallar va ba'zi yarimo'tkazgichlarda elektronlar alohida atomlarga bog'lanmagan holda butun kristall bo'ylab erkin harakatlana oladi."}, {"question": "Kirishmali yarim oвЂtkazgichlarda juda past temperaturalarda qaysi turdagi oвЂtkazuvchanlik ustunlik qiladi?", "options": ["Supero'tkazuvchanlik", "Xususiy o'tkazuvchanlik", "Metall o'tkazuvchanlik", "Kirishmali o'tkazuvchanlik"], "correct_index": 3, "explanation": "Past haroratlarda kirishma atomlaridan elektronlar (yoki kovaklar) ajralib chiqis    hi ustunlik qiladi, chunki bu jarayon uchun kamroq energiya talab qilinadi."}, {"question": "Zaryadlar soni (Z) bir xil, neytronlar soni (N) har xil boвЂlgan yadrolar nima deyiladi?", "options": ["Izomerlar", "Izotoplar", "Izobaralar", "Izotonlar"], "correct_index": 1, "explanation": "Izotoplar - bu bir xil protonlar soniga (bir xil element), ammo har xil neytronlar soniga ega bo'lgan atom yadrolari."}, {"question": "Neytron erkin holatda parchalanganda qanday zarrachalar hosil boвЂladi?", "options": ["Proton, elektron va antineytrino", "Faqat proton", "Faqat elektron", "Proton va elektron"], "correct_index": 0, "explanation": "Erkin neytron beta-minus yemirilish orqali parchalanadi, bunda proton, elektron va elektron antineytrino hosil bo'ladi."}, {"question": "Massa defekti deb nimaga aytiladi?", "options": ["Elektronning massasi proton massasidan kichik bo'lishi", "Atomning massasi yadro massasidan kichik bo'lishi", "Yadroning massasi uni tashkil etuvchi nuklonlar massalari yig'indisidan kichik bo'lishi", "Neytronning massasi proton massasidan katta bo'lishi"], "correct_index": 2, "explanation": "Massa defekti - bu yadroning haqiqiy massasi uni tashkil etuvchi alohida nuklonlarning massalari yig'indisidan kichik bo'lishi. Bu massa farqi yadro bog'lanish energiyasiga aylanadi."}, {"question": "Donor sathlar taqiqlangan sohaning qaysi qismida joylashadi?", "options": ["Taqiqlangan sohadan tashqarida", "Valentlik sohasiga yaqin", "O'tkazuvchanlik sohasiga yaqin", "Taqiqlangan sohaning o'rtasida"], "correct_index": 2, "explanation": "Donor sathlar o'tkazuvchanlik sohasining pastki chetiga juda yaqin joylashgan bo'lib, elektronlarning o'tkazuvchanlik sohasiga o'tishini osonlashtiradi."}, {"question": "Metall va yarim oвЂtkazgich kontaktida tokni bir yoвЂnalishda oвЂtkazuvchi qatlam nima deyiladi?", "options": ["Shottki to'sig'i", "Dielektrik qatlam", "Omik kontakt", "p-n o'tish"], "correct_index": 0, "explanation": "Metall va yarimo'tkazgich kontaktida Shottki to'sig'i hosil bo'lishi mumkin, bu tokni bir yo'nalishda o'tkazish xususiyatiga ega."}, {"question": "p va n turdagi yarim oвЂtkazgichlar kontaktida hosil boвЂlgan oвЂtish sohasi nima deb ataladi?", "options": ["Omik kontakt", "Izolyator qatlami", "Metall-yarimo'tkazgich o'tish", "p-n o'tish"], "correct_index": 3, "explanation": "p-n o'tish - bu p-tipli va n-tipli yarimo'tkazgichlar bir-biriga tegib turgan joyda hosil bo'ladigan soha bo'lib, diodlarning asosini tashkil qiladi."}, {"question": "p-n oвЂtishga 'toвЂgвЂri kuchlanish' berilganda toвЂsuvchi qatlam qalinligi qanday oвЂzgaradi?", "options": ["Avval ortib, keyin kamayadi", "Kamayadi", "O'zgarmaydi", "Ortadi"], "correct_index": 1, "explanation": "To'g'ri kuchlanish berilganda, tashqi elektr maydoni ichki maydonni zaiflashtiradi, bu esa to'suvchi qatlamning qalinligini kamaytiradi va tok o'tishini osonlashtiradi."}, {"question": "Valent sohadagi elektron oвЂ™tkazuvchanlik sohasiga oвЂ™tganda, u yerda qolgan boвЂ™sh oвЂ™rin nima deyiladi?", "options": ["Proton", "Neytron", "Kovak", "Elektron"], "correct_index": 2, "explanation": "Elektron valentlik sohasidan o'tkazuvchanlik sohasiga o'tganda, u o'zidan keyin musbat zaryadlangan 'kovak' qoldiradi, bu ham zaryad tashuvchi vazifasini bajaradi."}, {"question": "Ikki xil metall kontaktga keltirilganda, ular orasida potensiallar farqi hosil boвЂlishi qanday nomlanadi?", "options": ["Kontakt potensiallar farqi", "Xoll effekti", "Fotoelektr effekt", "Termoelektr effekt"], "correct_index": 0, "explanation": "Ikki xil metall kontaktga keltirilganda, ularning chiqish ishlari farqi tufayli elektronlar bir metalldan ikkinchisiga o'tadi va natijada potensiallar farqi hosil bo'ladi."}, {"question": "Yarim oвЂtkazgichli diodning asosiy xossasi nima?", "options": ["Tokni umuman o'tkazmaslik", "Tokni bir yo'nalishda o'tkazish", "Kuchlanishni kuchaytirish", "Tokni ikki yo'nalishda o'tkazish"], "correct_index": 1, "explanation": "Yarimo'tkazgichli diodning asosiy xossasi uning bir tomonlama o'tkazuvchanligidir, ya'ni tokni faqat bir yo'nalishda o'tkazadi."}]}j† ь
   2 2                                                                                                                                                                                                                                                                                                        Ѓќ6 Q‚єq_80c6ca04bd1648dfbb7002ea7001bfcfB{"variant": "B", "quizzes": [{"question": "Massalar soni (A) bir xil boвЂlib, zaryadi (Z) har xil boвЂlgan yadrolar nima deyiladi?", "options": ["Izotonlar", "Izobaralar", "Izomerlar", "Izotoplar"], "correct_index": 1, "explanation": "Izobaralar - bu bir xil massa soniga (A), ammo har xil zaryad soniga (Z) ega bo'lgan yadrolar."}, {"question": "Kristall panjarada zarrachalarning muvozanat holati atrofida tartibli joylashishi nima deb ataladi?", "options": ["Molekulyar bog'lanish", "Kristall panjara", "Atom bog'lanishi", "Amorf tuzilish"], "correct_index": 1, "explanation": "Bu kristallarning asosiy xususiyati bo'lib, atomlar, ionlar yoki molekulalar fazoda tartibli, davriy takrorlanuvchi tuzilish hosil qiladi."}, {"question": "Absolyut nol haroratda (T=0K) xususiy yarim oвЂ™tkazgich oвЂ™zini qanday tutadi?", "options": ["Izolyator kabi", "Yarimo'tkazgich kabi (normal)", "Metall kabi", "Supero'tkazgich kabi"], "correct_index": 0, "explanation": "Absolyut nol haroratda xususiy yarimo'tkazgichlarda valentlik sohasi to'liq to'lgan, o'tkazuvchanlik sohasi esa bo'sh bo'ladi, shuning uchun ular elektr tokini o'tkazmaydi va izolyator kabi harakat qiladi."}, {"question": "p-tipli yarim oвЂtkazgichda Fermi sathi (Вµ) qayerda joylashgan boвЂladi?", "options": ["O'tkazuvchanlik sohasiga yaqin", "Taqiqlangan sohaning o'rtasida", "Valentlik sohasiga yaqin", "Taqiqlangan sohadan tashqarida"], "correct_index": 2, "explanation": "p-tipli yarimo'tkazgichlarda akseptor kirishmalar kovaklar hosil qiladi, bu esa Fermi sathini valentlik sohasiga yaqinroq siljitadi."}, {"question": "n-sohadan p-sohaga elektronlar diffuziyasi natijasida n-soha qanday zaryadlanadi?", "options": ["Neytral", "Avval manfiy, keyin musbat", "Musbat", "Manfiy"], "correct_index": 2, "explanation": "n-sohadan p-sohaga elektronlar o'tganda, n-sohada elektronlar yetishmovchiligi yuzaga keladi va u musbat zaryadlanadi (donor ionlari qoladi)."}, {"question": "Yadrodagi protonlar va neytronlar umumiy nom bilan nima deyiladi?", "options": ["Leptonlar", "Elektronlar", "Nuklonlar", "Kvarklar"], "correct_index": 2, "explanation": "Protonlar va neytronlar yadroda joylashganligi sababli umumiy nom bilan nuklonlar deb ataladi."}, {"question": "Atom yadrosi qanday zarrachalardan tashkil topgan?", "options": ["Elektronlar va neytronlar", "Elektronlar va protonlar", "Protonlar va neytronlar", "Faqat protonlar"], "correct_index": 2, "explanation": "Atom yadrosi musbat zaryadlangan protonlar va zaryadsiz neytronlardan tashkil topgan."}, {"question": "Yarim oвЂ™tkazgichlarda harorat (T) ortishi bilan zaryad tashuvchilar konsentratsiyasi qanday oвЂ™zgaradi?", "options": ["O'zgarmaydi", "Ortadi", "Kamayadi", "Avval kamayib, keyin ortadi"], "correct_index": 1, "explanation": "Harorat ortishi bilan ko'proq elektronlar termal energiya olib, valentlik sohasidan o'tkazuvchanlik sohasiga o'tadi, bu esa elektronlar va kovaklar konsentratsiyasini oshiradi."}, {"question": "Valentlik sohasi bilan oвЂtkazuvchanlik sohasi orasidagi elektronlar boвЂlishi mumkin boвЂlmagan oraliq nima deyiladi?", "options": ["O'tkazuvchanlik sohasi", "Fermi sathi", "Valentlik sohasi", "Taqiqlangan soha"], "correct_index": 3, "explanation": "Taqiqlangan soha - bu valentlik sohasi va o'tkazuvchanlik sohasi orasidagi energetik bo'shliq bo'lib, unda elektronlar doimiy ravishda joylasha olmaydi."}, {"question": "Pauli prinsipiga koвЂ™ra, bitta energetik sathda koвЂ™pi bilan nechta elektron boвЂ™lishi mumkin?", "options": ["Bitta", "Ikkita", "Uchta", "To'rtta"], "correct_index": 1, "explanation": "Pauli prinsipi shuni aytadiki, bitta kvant holatida ikkita bir xil fermion (elektron) bo'lishi mumkin emas. Biroq, bitta energetik sathda (orbitalda) qarama-qarshi spinli ik   Э   гi sanaladi."}, {"question": "RoвЂza qaysi oyda tutiladi?", "options": ["Rujab oyida", "Sha'bon oyida", "Ramazon oyida", "Muharram oyida"], "correct_index": 2, "explanation": "Farz bo'lgan ro'za Islom taqvimining Ramazon oyida tutiladi."}, {"question": "Dinshunoslikning jamiyatdagi roli nimada?", "options": ["Texnik innovatsiyalarni yaratish", "Ijtimoiy nizolarni keltirib chiqarish", "Insonlarni faqat bitta e'tiqodga majburlash", "Jamiyatda diniy ma'rifat va bag'rikenglikni oshirish"], "correct_index": 3, "explanation": "Dinshunoslik jamiyatda to'g'ri diniy ma'rifatni tarqatish va dinlararo totuvlikni ta'minlashda muhim rol o'ynaydi."}, {"question": "Xristianlik qaysi hududda paydo boвЂlgan?", "options": ["G'arbiy Yevropada", "Hindistonda", "Yaqin Sharqda (Falasthin)", "Markaziy Osiyoda"], "correct_index": 2, "explanation": "Xristianlik Yaqin Sharqda, ya'ni Falastin hududida vujudga kelgan."}, {"question": "Islomda taqiqlangan ichimlik?", "options": ["Choy", "Sharbatlar", "Sut", "Meyoriy spirtli ichimliklar hamda mast qiluvchi barcha ichimliklar (Xamr)"], "correct_index": 3, "explanation": "Islomda mast qiluvchi har qanday ichimlik (xamr) harom va taqiqlangan."}, {"question": "Dinshunoslik qaysi soha bilan chambarchas bogвЂliq?", "options": ["Matematika va kibernetika", "Fizika va kimyo", "Astronomiya va geografiya", "Tarix, falsafa va sotsiologiya"], "correct_index": 3, "explanation": "Dinshunoslik gumanitar va ijtimoiy fanlar, jumladan tarix, falsafa va sotsiologiya bilan yaqin bog'liq."}, {"question": "Dinshunoslikning predmeti nima?", "options": ["Iqtisodiy jarayonlar", "Dinning mohiyati, rivojlanishi va ijtimoiy funksiyalari", "O'simliklar dunyosi", "Faqat ibodathonalarning me'morchiligi"], "correct_index": 1, "explanation": "Dinshunoslikning predmeti din va uning jamiyatdagi namoyon bo'lish qonuniyatlaridir."}, {"question": "Shinto dini qaysi davlatning milliy dini?", "options": ["Misr", "Yaponiya", "Hindiston", "Xitoy"], "correct_index": 1, "explanation": "Shintoizm Yaponiya xalqining an'anaviy va milliy dini hisoblanadi."}, {"question": "QurвЂ™onda nechta sura bor?", "options": ["66 ta", "100 ta", "150 ta", "114 ta"], "correct_index": 3, "explanation": "Qur'oni Karim 114 ta suradan tashkil topgan."}, {"question": "Zardushtiylikda yaxshilik kuchlari qiroli kim?", "options": ["Anaxita", "Mihr", "Ahuramazda", "Ahriman"], "correct_index": 2, "explanation": "Ahuramazda zardushtiylikda ezgulik va yorug'lik tangrisi hisoblanadi."}, {"question": "Islom dinining asosiy manbasi qaysi?", "options": ["Hadislar", "Qur'oni Karim", "Qiyos", "Ijmo'"], "correct_index": 1, "explanation": "Islom dinining birinchi va eng asosiy manbasi Qur'oni Karimdir."}, {"question": "Qaysi biri qadimgi milliy din hisoblanadi?", "options": ["Protestantizm", "Islom", "Shintoizm", "Xristianlik"], "correct_index": 2, "explanation": "Shintoizm Yaponiyaning qadimgi va an'anaviy milliy dini hisoblanadi."}, {"question": "Hijrat voqeasi qayerdan qayerga boвЂlgan?", "options": ["Makkadan Quddusga", "Madinadan Makkaga", "Makkadan Madinaga", "Madinadan Shomga"], "correct_index": 2, "explanation": "Hijrat 622-yilda musulmonlarning Makkadan Madinaga ko'chib o'tish voqeasidir."}, {"question": "Milliy dinlarning paydo boвЂlishiga nima sabab boвЂladi?", "options": ["Xalqning etnik va madaniy rivojlanish ehtiyojlari", "Xalqaro shartnomalar", "Zamonaviy texnologiyalar", "Siyosiy partiyalar tuzilishi"], "correct_index": 0, "explanation": "Milliy dinlar muayyan jamiyat va etnosning shakllanish, urf-odat va madaniy ehtiyojlari natijasida paydo bo'ladi."}, {"question": "Islomda kuniga necha mahal namoz oвЂqiladi?", "options": ["7 mahal", "3 mahal", "1 mahal", "5 mahal"], "correct_index": 3, "explanation": "Islomda har bir balog'atga etgan musulmonga kuniga 5 mahal namoz farz qilingan."}, {"question": "Islomda sadaqa nima?", "options": ["Ibodat turi", "Farz bo'lgan majburiy soliq", "Ko'ngilli ravishda beriladigan ehson", "Diniy bayram"], "correct_index": 2, "explanation": "Sadaqa вЂ“ insonning o'z xohishi bilan savob umidida qiladigan moddiy yoki ma'naviy ehso   дnidir."}, {"question": "Muhammad (s.a.v.) qayerda tugвЂilganlar?", "options": ["Quddus shahrida", "Makka shahrida", "Madina shahrida", "Toif shahrida"], "correct_index": 1, "explanation": "Muhammad (s.a.v.) milodiy 570-yilda Makka shahrida tug'ilganlar."}, {"question": "Dinshunoslikning yana bir vazifasi nima?", "options": ["Tadbirkorlikni rivojlantirish", "Bag'rikenglik va diniy bag'rikenglik madaniyatini rivojlantirish", "Siyosiy qarorlarni qabul qilish", "Sog'liqni saqlash tizimini nazorat qilish"], "correct_index": 1, "explanation": "Dinlararo bag'rikenglik va tinch-totuvlikni ta'minlashga ko'maklashish uning muhim vazifasidir."}, {"question": "Qaysi milliy din qadimgi Eron xalqi bilan bogвЂliq?", "options": ["Dovosizm", "Sikhizm", "Zardushtiylik", "Konfutsichilik"], "correct_index": 2, "explanation": "Zardushtiylik qadimgi Eron va O'rta Osiyo xalqlari madaniyati va e'tiqodi bilan bog'liq."}, {"question": "Hadislarni toвЂplagan mashhur kitoblardan biri?", "options": ["Tavrot", "Katta Fiqh", "Al-Jome' as-Sahih (Imom Buxoriy)", "Avesto"], "correct_index": 2, "explanation": "Imom al-Buxoriyning \"Al-Jome' as-Sahih\" kitobi eng ishonchli hadislar to'plamidir."}, {"question": "Islom fiqhida manbalar nechta asosiy toifaga boвЂlinadi?", "options": ["Asosiy va qo'shimcha (manbalar)", "O'nta", "Faqat bitta", "Yuzta"], "correct_index": 0, "explanation": "Islom fiqhi manbalari asosiy (Qur'on, Sunnat, Ijmo', Qiyos) va qo'shimcha manbalarga bo'linadi."}, {"question": "Buddizmda \"ToвЂrt olijanob haqiqat\" nimani bildiradi?", "options": ["Azob-uqubat va undan qutulish yo'li haqidagi ta'limot", "To'rt xil ibodat usuli", "Ijtimoiy tabaqalar haqidagi qonun", "Dunyoning yaratilishi haqidagi afsona"], "correct_index": 0, "explanation": "To'rt olijanob haqiqat hayotning azob ekani va undan halos bo'lish yo'lini ko'rsatuvchi tayanch ta'limotdir."}, {"question": "Dinshunoslikda ilmiy yondashuv qanday boвЂladi?", "options": ["Mintaqaviy chegaralangan", "Faqat his-tuyg'ularga asoslangan", "Xolis, ob'ektiv va neytral", "Biryoqlama va tarafkash"], "correct_index": 2, "explanation": "Ilmiy yondashuv xolislik va betaraflik tamoyillariga tayangan holda olib boriladi."}, {"question": "Sunnat nimani anglatadi?", "options": ["Muhammad (s.a.v.)ning yo'li, fe'l-atvori va ko'rsatmalari", "Tarixiy voqealar to'plami", "Olimlarning shaxsiy fikri", "Faqat Qur'on suralari"], "correct_index": 0, "explanation": "Sunnat вЂ“ Payg'ambarimiz (s.a.v.)ning aytgan gip gaplari, qilgan amallari va maqullashlaridir."}, {"question": "Islomning birinchi farz amali?", "options": ["Zakot berish", "Iymon keltirish (Shahodat)", "Namoz o'qish", "Ro'za tutish"], "correct_index": 1, "explanation": "Islomdagi birinchi va eng muhim farz amal Allohga va Unining elchisiga iymon keltirishdir."}, {"question": "Hadislar nima?", "options": ["Qadimiy shaqar qonunlari", "Faqat duolar to'plami", "Sahobalarning o'z fikrlari", "Muhammad (s.a.v.)ning so'zlari va amallari haqidagi rivoyatlar"], "correct_index": 3, "explanation": "Hadis вЂ“ Payg'ambarimiz (s.a.v.) so'zlari, amallari va sifatlari haqida yetib kelgan xabardir."}, {"question": "QurвЂ™on kimga nozil qilingan?", "options": ["Muhammad (s.a.v.)ga", "Muso (a.s.)ga", "Ibrohim (a.s.)ga", "Iso (a.s.)ga"], "correct_index": 0, "explanation": "Qur'oni Karim So'nggi payg'ambar Muhammad (s.a.v.)ga nozil qilingan."}, {"question": "Islomdagi вЂњhalolвЂќ soвЂzi nimani anglatadi?", "options": ["Majburiy", "Taqiqlangan, harom", "Ruxsat berilgan, shariatga uyg'un", "Shubhali"], "correct_index": 2, "explanation": "Halol вЂ“ Islom shariatida ruxsat berilgan va pok bo'lgan narsa hamda amallardir."}, {"question": "Buddizmning asosiy yoвЂnalishlaridan biri qaysi?", "options": ["Iudaizm", "Katolik va Pravoslav", "Xinayana va Maxayana", "Sunniylik va Shia"], "correct_index": 2, "explanation": "Xinayana (Xeravada) va Maxayana Buddizmning eng yirik yo'nalishlaridir."}, {"question": "Tafsirning asosiy vazifasi nima?", "options": ["Namaz vaqtlarini belgilash", "Qur'on oyatlarining ma'nolarini izohlash va tushuntirish", "Hadislarni yodlash", "Kito   еblarni chop etish"], "correct_index": 1, "explanation": "Tafsir вЂ“ Qur'oni Karim oyatlarining ma'nosi, mazmuni va nozil bo'lish sabablarini sharhlaydigan fandir."}, {"question": "Milliy dinlarning asosiy xususiyati?", "options": ["Butun dunyo bo'ylab keng yoyilishi", "Kitoblari yo'qligi", "Faqat ma'lum bir etnik guruh yoki xalq orasida tarqalganligi", "Ibodat tili yo'qligi"], "correct_index": 2, "explanation": "Milliy dinlar asosan bitta etnos yoki xalq doirasida saqlanib qoladi."}, {"question": "Milliy dinlarda marosim va urf-odatlar qanday ahamiyatga ega?", "options": ["Juda yuqori, etnik madaniyat bilan uzviy bog'liq", "Faqat sayyohlar uchun mo'ljallangan", "Ikkinchi darajali", "Hech qanday ahamiyatga ega emas"], "correct_index": 0, "explanation": "Milliy dinlarda marosimlar va urf-odatlar milliylik hamda urf-odatlarni saqlashda muhim o'rin tutadi."}, {"question": "Buddizmning asosiy amaliyotlaridan biri?", "options": ["Meditatsiya", "Olovga sig'inish", "Ro'za tutish", "Qurbonlik qilish"], "correct_index": 0, "explanation": "Meditatsiya ongni tozalash va ruhiy yuksalish uchun buddizmda asosiy amaliyotdir."}, {"question": "Milliy dinlar qanday dinlar turiga kiradi?", "options": ["Muayyan bir xalq yoki elatga mansub dinlar", "Ateistik ta'limotlar", "Jahon dinlari", "Zamonaviy oqimlar"], "correct_index": 0, "explanation": "Milliy dinlar muayyan bir xalq yoki millat madaniyati va tarixi bilan chegaralangan dinlardir."}, {"question": "Islomning muqaddas kitobi qaysi?", "options": ["Qur'oni Karim", "Tavrot", "Injil", "Zabur"], "correct_index": 0, "explanation": "Islom dinining muqaddas kitobi Allohning kalomi bo'lmish Qur'oni Karimdir."}, {"question": "Buddizmning asoschisi kim?", "options": ["Siddxartxa Gautama (Budda)", "Lao-Tzi", "Zardusht", "Konfutsiy"], "correct_index": 0, "explanation": "Buddizm ta'limotiga miloddan avvalgi VI-V asrlarda Siddxartxa Gautama asos solgan."}, {"question": "Hinduizmda qayta tugвЂilish eвЂ™tiqodi qanday ataladi?", "options": ["Samsara (Reinkarnatsiya)", "Nirvana", "Kamma", "Karma"], "correct_index": 0, "explanation": "Ruhlarning qayta tug'ilish va aylanish zanjiri Samsara deb ataladi."}, {"question": "Yahudiylikning asosiy muqaddas kitobi?", "options": ["Tripitaka", "Tavrot (Tora)", "Qur'on", "Zend-Avesto"], "correct_index": 1, "explanation": "Tavrot (Tora) yahudiylikning eng asosiy va muqaddas manbasi hisoblanadi."}, {"question": "Xristianlikning markaziy gвЂoyasi?", "options": ["Iso Masih orqali insoniyatni qutqarish va ilohiy sevgiga tayanish", "Olovga sig'inish", "Etnik ustunlik", "Dunyo azob-uqubatdan iboratligi"], "correct_index": 0, "explanation": "Xristianlik Iso Masihning qurbonligi orqali insoniyatning najot topishi g'oyasiga asoslanadi."}, {"question": "Buddizmning muqaddas kitoblari qaysi nom bilan yuritiladi?", "options": ["Tripitaka (Uch savat)", "Veda", "Bibliya", "Avesto"], "correct_index": 0, "explanation": "Buddizmning muqaddas matnlari to'plami Tripitaka deb ataladi."}, {"question": "Islom nechta asosiy ruknga ega?", "options": ["5 ta", "3 ta", "10 ta", "7 ta"], "correct_index": 0, "explanation": "Islom dini 5 ta asosiy rukndan iborat: Iymon, Namoz, Ro'za, Zakot, Haj."}, {"question": "Dinshunoslikning vazifalaridan biri qaysi?", "options": ["Diniy hodisalarni ilmiy va tahliliy o'rganish", "Moddiy ishlab chiqarishni oshirish", "Aholini muayyan dinga o'tkazish", "Faqat diniy bayramlarni tashkillashtirish"], "correct_index": 0, "explanation": "Diniy hodisalarni ob'ektiv hamda xolis yondashuv asosida tahlil qilish dinshunoslikning asosiy vazifalaridan biridir."}, {"question": "Xristianlikda \"Muqaddas uchlik\" nimani anglatadi?", "options": ["Uchta farishta", "Muso, Iso, Muhammad", "Tavrot, Injil, Zabur", "Ota-Xudo, O'g'il-Xudo va Muqaddas Ruh"], "correct_index": 3, "explanation": "Muqaddas uchlik (Troitza) Ota, O'g'il va Muqaddas Ruh birligini anglatadi."}, {"question": "Dinshunoslik nimani oвЂrganadi?", "options": ["Faqatgina tabiat qonunlarini", "Dillarning paydo bo'lishi, tarixi va ta'limotlarini", "Geografik joylashuvlarni", "Siyosiy tuzumlarni"], "correct_index"   ж: 1, "explanation": "Dinshunoslik dinlarning kelib chiqishi, tarixi, e'tiqodiy va axloqiy tizimlarini ilmiy jihatdan o'rganadi."}, {"question": "Dinshunoslikning yana bir predmeti qaysi?", "options": ["Astronomik hodisalar", "Diniy e'tiqod va marosimlar tizimi", "Iqtisodiy krizislar", "Faqat davlat chegaralari"], "correct_index": 1, "explanation": "Diniy e'tiqodlar, marosimlar hamda diniy tashkilotlar faoliyati uning predmetiga kiradi."}, {"question": "Qiyos nimaga asoslanadi?", "options": ["Boshqa dinlar tajribasiga", "Insonning shaxsiy xohishiga", "Qur'on va Sunnatdagi oxshash hukmlarni yangi masalaga solishtirish va tatbiq etishga", "Tush ko'rishga"], "correct_index": 2, "explanation": "Qiyos вЂ“ manbalarda hukmi bo'lmagan masalani sababi bir xil bo'lgan hukmli masalaga solishtirishdir."}, {"question": "Zardushtiylikning asoschisi kim?", "options": ["Muso (a.s.)", "Konfutsiy", "Zardusht (Zoroastr)", "Budda"], "correct_index": 2, "explanation": "Zardushtiylik ta'limotining asoschisi va targ'ibotchisi Zardushtdir."}, {"question": "Hinduizmning muqaddas matnlari qaysi?", "options": ["Tavrot", "Injil", "Avesto", "Vedalar va Upanishadlar"], "correct_index": 3, "explanation": "Vedalar, Upanishadlar hamda Mahabharata kabi matnlar Hinduizmning muqaddas kitoblaridir."}, {"question": "Milliy dinlar qaysi din turidan farq qiladi?", "options": ["Qabila dinlaridan", "Iptidoiy e'tiqodlardan", "Jahon dinlaridan", "An'anaviy e'tiqodlardan"], "correct_index": 2, "explanation": "Milliy dinlar baynalminal bo'lmagani bilan barcha xalqlarni qamrab oladigan Jahon dinlaridan farq qiladi."}, {"question": "Milliy dinlar asosan qayerda tarqalgan boвЂladi?", "options": ["Barcha qitalarda teng", "Faqat Yevropada", "Faqat shahar markazlarida", "Muayyan xalq yashaydigan mintaqada"], "correct_index": 3, "explanation": "Milliy dinlar tegishli etnik guruh va xalq yashaydigan hudud doirasida tarqaladi."}, {"question": "Hinduizm qaysi mamlakatda shakllangan?", "options": ["Hindiston", "Yaponiya", "Eron", "Xitoy"], "correct_index": 0, "explanation": "Hinduizm dini Hindiston yarimorolida shakllangan va rivojlangan."}, {"question": "Buddistlarning ibodat joyi qanday ataladi?", "options": ["Masjid", "Sinagoga", "Cherkov", "Pagoda (Ibodathona/Shtupa)"], "correct_index": 3, "explanation": "Buddistlarning diniy majmualari ibodathona, pagoda yoki shtupa deb ataladi."}, {"question": "Iso Masihning tirilish bayrami qanday ataladi?", "options": ["Rojdestvo", "Kresteniye", "Pasha", "Troitza"], "correct_index": 2, "explanation": "Iso Masihning qayta tirilishi sharafiga nishonlanadigan bayram Pasha deb ataladi."}, {"question": "Shahodat kalimasining mazmuni nima?", "options": ["Tinchlikka da'vat qilish", "Barcha dinlar teng ekanligini ta'kidlash", "Ibodat vaqtlari haqida xabar berish", "Allohdan o'zga iloh yo'qligi va Muhammad (s.a.v.) Unining elchisi ekanligiga guvohlik berish"], "correct_index": 3, "explanation": "Shahodat kalimasi Islom e'tiqodining kaliti va tavhid va payg'ambarlikni e'tirof etishdir."}, {"question": "Zardushtiylikning muqaddas kitobi qaysi?", "options": ["Veda", "Avesto", "Tavrot", "Injil"], "correct_index": 1, "explanation": "Avesto zardushtiylik dinining asosiy va muqaddas manbasidir."}, {"question": "Dinshunoslikning asosiy metodlaridan biri?", "options": ["Fizik tajriba", "Tarixiy-qiyosiy metod", "Matematik modellashtirish", "Kimyoviy analiz"], "correct_index": 1, "explanation": "Tarixiy-qiyosiy metod dinlar rivojlanishi va o'xshashliklarini tahlil qilishda keng qo'llaniladi."}, {"question": "Buddizmning asosiy maqsadi nima?", "options": ["Azob-uqubatlardan xalos bo'lish va Nirvanaga erishish", "Dunyo hukmronligiga erishish", "Urushlarda g'alaba qozonish", "Boylik orttirish"], "correct_index": 0, "explanation": "Buddizm insonni azob-uqubatlardan va qayta tug'ilish zanjiridan qutqarib Nirvanaga olib borishni maqsad qiladi."}, {"question": "QurвЂ™on qaysi tilda nozil qilingan?", "options": ["Arab tilda", "Fors tilda", "Oromiy tilda", "Ibroniy tilda"], "correct_index": 0, "explanation": "Qur'oni Karim arab tilida nozil qilingan."}, {"ques    tion": "Dinshunoslikning asosiy maqsadi nimadan iborat?", "options": ["Faqat qadimgi afsonalarni to'plash", "Diniy e'tiqodlarni yo'q qilish", "Dinlar haqida ob'ektiv ilmiy bilim berish va bag'rikenglikni shakllantirish", "Muayyan bir dinni targ'ib qilish"], "correct_index": 2, "explanation": "Asosiy maqsad dinlar to'g'risida ob'ektiv, ilmiy asoslangan bilimlarni shakllantirish va konfessiyalararo bag'rikenglikni ta'minlashdir."}, {"question": "Xristianlikning eng koвЂp tarqalgan yoвЂnalishi qaysi?", "options": ["Protestantizm", "Monofizitlik", "Pravoslavie", "Katolik"], "correct_index": 3, "explanation": "Katolitsizm xristianlikning eng ko'p ketma-ket ergashuvchilariga ega bo'lgan yo'nalishidir."}, {"question": "Musulmonlarning haftalik jamoat namozi kuni qaysi?", "options": ["Juma", "Yakshanba", "Shanba", "Dushanba"], "correct_index": 0, "explanation": "Juma kuni musulmonlar uchun haftalik jamoat namozi va bayram kuni hisoblanadi."}, {"question": "Buddizmda qayta tugвЂilish eвЂ™tiqodi qanday ataladi?", "options": ["Dxarma", "Sutrabitaka", "Nirvana", "Samsara"], "correct_index": 3, "explanation": "Qayta tug'ilish zanjiri buddizmda ham Samsara deyiladi."}, {"question": "IjmoвЂ™ nima?", "options": ["Bir kishining shaxsiy qarori", "Qur'on o'qish qoidasi", "Davlat rahbari buyrug'i", "Islom olimlarining biror diniy masala bo'yicha bir ovozdan kelishuvi"], "correct_index": 3, "explanation": "Ijmo' вЂ“ bir davrdagi Islom mujtahid olimlarining diniy hukm borasidagi ittifoqidir."}, {"question": "Islom dinida eng muqaddas joy?", "options": ["Ka'ba (Makkai Mukarrama)", "Al-Aqsa masjidi", "Masjid an-Nabaviy", "Umaviy masjidi"], "correct_index": 0, "explanation": "Ka'batulloh Makkadagi eng muqaddas va musulmonlar qiblasi bo'lgan joydir."}, {"question": "Xristianlikning asoschisi kim?", "options": ["Muso (a.s.)", "Siddxartxa Gautama", "Muhammad (s.a.v.)", "Iso Masih (Iisus Xristos)"], "correct_index": 3, "explanation": "Xristianlik ta'limotining asoschisi va markaziy shaxsiyat Iso Masihdir."}, {"question": "Xristianlikning muqaddas kitobi qaysi?", "options": ["Qur'on", "Avesto", "Tavrot", "Injil (Bibliya)"], "correct_index": 3, "explanation": "Xristianlikning muqaddas kitobi Injil (Bibliya) hisoblanadi."}, {"question": "Xristianlik qaysi asrda vujudga kelgan?", "options": ["Milodiy XV asrda", "Milodiy VII asrda", "Milodiy I asrda", "Miloddan avvalgi V asrda"], "correct_index": 2, "explanation": "Xristianlik milodiy I asrda Rim imperiyasining sharqiy qismida paydo bo'lgan."}, {"question": "Islom dini asoschisi kim?", "options": ["Muhammad (s.a.v.)", "Iso (a.s.)", "Ibrohim (a.s.)", "Muso (a.s.)"], "correct_index": 0, "explanation": "Islom dini Payg'ambari va uni yetkazuvchi asosiy shaxs Muhammad (s.a.v.) hisoblanadilar."}, {"question": "Musulmonlarning ibodat joyi?", "options": ["Masjid", "Sinagoga", "Pagoda", "Cherkov"], "correct_index": 0, "explanation": "Musulmonlar jamoat bo'lib ibodat qiladigan muqaddas joy Masjid deyiladi."}, {"question": "Yahudiylarning asosiy ibodat joyi?", "options": ["Shtupa", "Ibodathona (Xram)", "Sinagoga", "Masiqit"], "correct_index": 2, "explanation": "Yahudiylarning jamoat ibodatini bajaradigan joyi Sinagoga deyiladi."}, {"question": "Xristianlarning ibodat joyi nima deb ataladi?", "options": ["Masiqit", "Cherkov (Xram)", "Pagoda", "Sinagoga"], "correct_index": 1, "explanation": "Xristianlarning ibodat va diniy marosimlarni o'tkazish joyi Cherkov deb ataladi."}, {"question": "Zardushtiylikning markaziy gвЂoyalaridan biri qaysi?", "options": ["Taqdirga batamom bo'ysunish", "Ezgulik va yovuzlik o'rtasidagi kashfiyot va kurash", "Ruhlarga sig'inish", "Ko'phudolilikni inkor qilmaslik"], "correct_index": 1, "explanation": "Zardushtiylikda Ezgulik (Ahuramazda) va Yovuzlik (Ahriman) o'rtasidagi doimiy kurash markaziy g'oyadir."}, {"question": "Zakot kimlarga beriladi?", "options": ["Faqat davlat arboblariga", "Barcha qarindoshlarga", "Ehtiyojmand va kambag'allarga", "Boy insonlarga"], "correct_index": 2, "explanation": "Zakot jamiyatdagi muhtoj, kambag'al va belgilangan toifa insonlarga beriladi."}]}j†Ў6
