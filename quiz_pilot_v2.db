                                                                                                          $(Qq_a33498bf4d9945d19e2e3cb521574e85A   t "\"At the moment\" indicates an action happening now, requiring the Present Continuous tense (subject + am/is/are + verb-ing)."}, {"question": "While they ___ studying, the lights went out.", "options": ["was", "are", "had been", "were"], "correct_index": 3, "explanation": "\"While\" introduces a longer action in the Past Continuous tense. For \"they,\" the auxiliary verb is \"were.\""}, {"question": "If it rains tomorrow, we ___ go to the park.", "options": ["wouldn't", "didn't", "don't", "won't"], "correct_index": 3, "explanation": "The First Conditional describes a real possibility in the future. The \"if\" clause uses the Present Simple, and the main clause uses \"will\" + base verb (or \"won't\" for negative)."}, {"question": "I ___ swim when I was five years old.", "options": ["may", "will be able to", "can", "could"], "correct_index": 3, "explanation": "\"When I was five years old\" indicates a past ability, so \"could\" is the correct modal verb."}, {"question": "After a lot of practice, she ___ pass her driving test last week.", "options": ["could", "might", "was able to", "can"], "correct_index": 2, "explanation": "\"Last week\" indicates a specific past achievement or success in doing something, for which \"was able to\" (or \"managed to\") is used, not \"could.\""}, {"question": "Look! The birds ___.", "options": ["are singing", "sing", "have sung", "sang"], "correct_index": 0, "explanation": "\"Look!\" is an imperative that signals an action happening at the moment of speaking, requiring the Present Continuous tense."}, {"question": "This test was not ___ difficult as the last one. It was easier.", "options": ["more", "too", "less", "as"], "correct_index": 3, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way. \"It was easier\" confirms the inequality."}, {"question": "I was watching TV ___ the telephone rang.", "options": ["as", "when", "while", "during"], "correct_index": 1, "explanation": "\"When\" is used to introduce a shorter, interrupting action (Past Simple) that happens during a longer action (Past Continuous)."}, {"question": "He ___ like milk.", "options": ["doesn't", "don't", "isn't", "wasn't"], "correct_index": 0, "explanation": "This expresses a general preference, requiring the Present Simple tense. For negative statements with \"he,\" the auxiliary verb is \"doesn't.\""}, {"question": "___ you speak English when you started school?", "options": ["Were", "Could", "Can", "Did"], "correct_index": 1, "explanation": "\"When you started school\" indicates a past ability, so \"Could\" is the correct modal verb for the question."}, {"question": "She was sleeping ___ the door bell rang.", "options": ["during", "as", "when", "while"], "correct_index": 2, "explanation": "\"When\" is used to introduce a shorter, interrupting action (Past Simple) that happens during a longer action (Past Continuous)."}, {"question": "___ you were sleeping, your brother washed the car.", "options": ["While", "During", "As soon as", "When"], "correct_index": 0, "explanation": "\"While\" is used to connect two simultaneous actions, one of which is often longer. Here, \"you were sleeping\" is a longer action."}, {"question": "Listen! Someone ___ the piano.", "options": ["is playing", "plays", "has played", "played"], "correct_index": 0, "explanation": "\"Listen!\" is an imperative that signals an action happening at the moment of speaking, requiring the Present Continuous tense. \"Someone\" takes a singular verb."}, {"question": "They ___ walk after the accident last month.", "options": ["might not", "won't be able to", "couldn't", "can't"], "correct_index": 2, "explanation": "\"Last month\" indicates a past inability, so \"couldn't\" is the correct modal verb."}, {"question": "He doesn't run ___ fast as his brother.", "options": ["too", "less", "more", "as"], "correct_index": 3, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "He lost his wallet while he ___ shopping.", "options": ["had been", "was", "were", "is"], "correct
