   џ џ                                                                                                                                                                                                                                                                                                                                                                                                                     „Ь' Q‰·Qq_6943d9b23fb5424d9a07494b8a263ce5B{"variant": "B", "quizzes": [{"question": "Stekga element qoвЂshish amali qanday ataladi?", "options": ["Push", "Enqueue", "Pop", "Dequeue"], "correct_index": 0, "explanation": "Stekga element qo'shish amali 'Push' deb ataladi."}, {"question": "Qanday daraxtni biz \"To'liq binar daraxt\" deb ataymiz?", "options": ["Har bir tugunida maksimal 2 ta farzand bo'lgan daraxt", "Har bir tugunida kamida bitta farzand bo'lgan daraxt", "Har bir tugunida 0 yoki 2 ta farzand bo'lgan va barcha barg tugunlari bir xil sathda joylashgan daraxt", "Barcha barg tugunlari bir xil sathda joylashgan daraxt"], "correct_index": 2, "explanation": "To'liq binar daraxt (Full Binary Tree) - bu har bir tugunida 0 yoki 2 ta farzand bo'lgan daraxt. Agar barcha barg tugunlari bir xil sathda bo'lsa, u 'Perfect Binary Tree' bo'ladi. Savol 'To'liq binar daraxt' haqida bo'lgani uchun, har bir tugunida 0 yoki 2 ta farzand bo'lishi asosiy shart."}, {"question": "Quyidagi nuqtalar toвЂplami uchun Convex Hull nechta nuqtadan iborat boвЂladi? Nuqtalar: (0,0), (2,0), (2,2), (0,2), (1,1)", "options": ["2", "4", "5", "3"], "correct_index": 1, "explanation": "Nuqtalar: (0,0), (2,0), (2,2), (0,2) kvadratning burchaklari, (1,1) esa kvadratning ichida joylashgan. Convex Hull faqat tashqi nuqtalardan iborat bo'ladi, ya'ni (0,0), (2,0), (2,2), (0,2). Shuning uchun 4 ta nuqta."}, {"question": "Tugunni bo'lish paytida qaysi kalit yuqoriga (ota tugunga) ko'tariladi?", "options": ["Tasodifiy kalit", "Eng kichik kalit", "Eng katta kalit", "O'rtadagi kalit"], "correct_index": 3, "explanation": "Tugunni bo'lish (split) paytida, tugundagi kalitlarning o'rtadagi kaliti yuqoriga (ota tugunga) ko'tariladi."}, {"question": "Max-Heap (Maksimal uyum) sharti nima?", "options": ["Har bir ota tugun o'z farzandlaridan kichik bo'lishi kerak", "Daraxt muvozanatlangan bo'lishi kerak", "Barcha barg tugunlari bir xil sathda bo'lishi kerak", "Har bir ota tugun o'z farzandlaridan katta yoki teng bo'lishi kerak"], "correct_index": 3, "explanation": "Max-Heap sharti shundan iboratki, har bir ota tugun o'z farzandlaridan katta yoki teng bo'lishi kerak. Natijada, eng katta element har doim ildizda joylashadi."}, {"question": "Binar uyumni massivda saqlashda i-indeksdagi tugunning chap bolasi qaysi formuladan topiladi?", "options": ["2 * i + 2", "2 * i + 1", "i / 2", "(i - 1) / 2"], "correct_index": 1, "explanation": "Binar uyumni massivda saqlashda (0-indeksdan boshlab), i-indeksdagi tugunning chap bolasi 2 * i + 1 formulasi bilan topiladi."}, {"question": "AVL daraxtida qidirish operatsiyasining vaqt murakkabligi (Time Complexity) qancha?", "options": ["O(1)", "O(n log n)", "O(n)", "O(log n)"], "correct_index": 3, "explanation": "AVL daraxti muvozanatlangan bo'lganligi sababli, qidirish operatsiyasining vaqt murakkabligi har doim O(log n) ga teng."}, {"question": "Active Set nima?", "options": ["Faqat qo'shilgan elementlar to'plami", "Algoritm ishlashi davomida faol foydalaniladigan elementlar to'plami", "Faqat o'chirilgan elementlar to'plami", "Barcha elementlar to'plami"], "correct_index": 1, "explanation": "Active Set (Faol to'plam) - bu algoritm ishlashi davomida ma'lum bir vaqtda faol foydalaniladigan yoki ko'rib chiqilayotgan elementlar to'plami."}, {"question": "Tez saralash (Quick Sort) qaysi algoritmik paradigma asosida ishlaydi?", "options": ["Divide and Conquer (Bo'lish va Yengish)", "Greedy (Ochko'z)", "Backtracking (Orqaga qaytish)", "Dynamic Programming (Dinamik dasturlash)"], "correct_index": 0, "explanation": "Tez saralash (Quick Sort) 'Divide and Conquer' (Bo'lish va Yengish) algoritmik paradigmasi asosida ishlaydi."}, {"   D   ©(print queue) navbat ma'lumotlar tuzilmasiga misol bo'la oladi, chunki birinchi yuborilgan hujjat birinchi bo'lib chop etiladi (FIFO)."}, {"question": "Algoritm murakkabligini baholashda n nimani anglatadi?", "options": ["Dasturchilar soni", "Kompyuterning tezligi", "Dastur qatorlari soni", "Kirish ma'lumotlari hajmi"], "correct_index": 3, "explanation": "Algoritm murakkabligini baholashda 'n' odatda kirish ma'lumotlari hajmini yoki elementlar sonini anglatadi."}, {"question": "Algoritm murakkabligi nimani baholaydi?", "options": ["Dasturning hajmini", "Kodning o'qiluvchanligini", "Algoritmning ishlash tezligi va xotira sarfini", "Dasturchining mahoratini"], "correct_index": 2, "explanation": "Algoritm murakkabligi (Time and Space Complexity) uning ishlash tezligi (vaqt) va talab qilinadigan xotira miqdorini baholaydi."}, {"question": "Open Addressing usulining mohiyati nimada?", "options": ["Kolliziya yuz berganda boshqa bo'sh joyni topish uchun jadvalning o'zida izlash", "Kolliziya yuz berganda yangi xesh jadval yaratish", "Kolliziya yuz berganda bog'lamli ro'yxatdan foydalanish", "Kolliziya yuz berganda elementni o'chirish"], "correct_index": 0, "explanation": "Open Addressing (Ochiq adreslash) usulining mohiyati shundaki, kolliziya yuz berganda, elementni saqlash uchun boshqa bo'sh joyni topish maqsadida xesh jadvalning o'zida (turli tekshirish strategiyalari yordamida) izlash amalga oshiriladi."}, {"question": "B-daraxtning tartibi t bo'lsa, tugundagi maksimal kalitlar soni qanday formula bilan aniqlanadi?", "options": ["t-1", "2t", "t", "2t-1"], "correct_index": 3, "explanation": "B-daraxtning tartibi t bo'lsa, tugundagi maksimal kalitlar soni 2t-1 ga teng."}, {"question": "B daraxtda tugun kalit(qiymat) lar bilan to'lib qolganda (2t-1 ta kalit) qanday amal bajariladi?", "options": ["Yangi tugun qo'shiladi", "Tugun bo'linadi (split)", "Tugun o'chiriladi", "Daraxt qayta quriladi"], "correct_index": 1, "explanation": "B-daraxtda tugun maksimal kalitlar soniga (2t-1) yetganda, u bo'linadi (split) va o'rtadagi kalit ota tugunga ko'tariladi."}, {"question": "Agar daraxtda ikki tugun qirra orqali bogвЂlangan boвЂlsa, pastdagi tugun qanday nomlanadi?", "options": ["Ota-ona", "Barg", "Ildiz", "Farzand"], "correct_index": 3, "explanation": "Agar ikki tugun qirra orqali bog'langan bo'lsa, pastdagi tugun 'Farzand' (Child) deb ataladi."}, {"question": "Convex Hull nechta nuqtadan iborat? Nuqtalar: (0,0), (3,0), (3,3), (0,3), (1,1), (2,2)", "options": ["4", "3", "5", "6"], "correct_index": 0, "explanation": "Nuqtalar: (0,0), (3,0), (3,3), (0,3) kvadratning burchaklari. (1,1) va (2,2) esa kvadratning ichida joylashgan. Convex Hull faqat tashqi nuqtalardan iborat bo'ladi, ya'ni (0,0), (3,0), (3,3), (0,3). Shuning uchun 4 ta nuqta."}, {"question": "Agar algoritm doimiy vaqt ichida bajarilsa, uning murakkabligi qanday boвЂladi?", "options": ["O(n)", "O(log n)", "O(1)", "O(n^2)"], "correct_index": 2, "explanation": "Agar algoritm doimiy vaqt ichida bajarilsa, uning murakkabligi O(1) (doimiy murakkablik) deb belgilanadi, ya'ni kirish ma'lumotlari hajmiga bog'liq emas."}, {"question": "Agar daraxtda n ta tugun boвЂlsa Pryufer kodi uzunligi nechchiga teng bo'ladi?", "options": ["n", "n+1", "n-2", "n-1"], "correct_index": 2, "explanation": "n ta tugundan iborat daraxtning Pryufer kodi uzunligi n-2 ga teng bo'ladi."}, {"question": "Tashqi saralash qachon qoвЂllaniladi?", "options": ["Ma'lumotlar xotiraga sig'ganda", "Faqat kichik massivlar uchun", "Ma'lumotlar juda kam bo'lganda", "Ma'lumotlar asosiy xotiraga sig'may, diskda saqlanganda"], "correct_index": 3, "explanation": "Tashqi saralash (External Sorting) - bu saralanishi kerak bo'lgan ma'lumotlar hajmi asosiy xotiraga sig'may, disk yoki boshqa tashqi xotira qurilmalarida saqlanganda qo'llaniladi."}, {"question": "Binar uyum (Binary Heap) qanday maвЂ™lumotlar tuzilmasi hisoblanadi?", "options": ["Chiziqli ma'lumotlar tuzilmasi", "Bog'lamli ro'yxat", "To'liq binar daraxt shartini qanoatlantiruvchi daraxt", "Muvozanatlanmagan ikkilik qidiruv daraxti"], "correct_index": 2, "exp    t balandligi - O'ng kichik daraxt balandligi", "Daraxtning umumiy balandligi"], "correct_index": 2, "explanation": "AVL daraxtida tugunning muvozanat faktori (Balance Factor) uning chap kichik daraxtining balandligi va o'ng kichik daraxtining balandligi o'rtasidagi farq sifatida aniqlanadi."}, {"question": "ToвЂliq grafda 5 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["10", "8", "5", "12"], "correct_index": 0, "explanation": "To'liq grafdagi qirralar sonini topish formulasi n * (n - 1) / 2. Bu yerda n=5 bo'lsa, 5 * (5 - 1) / 2 = 5 * 4 / 2 = 10 ta qirra bo'ladi."}, {"question": "MD5 algoritmining asosiy kamchiligi nimada?", "options": ["Juda katta xesh qiymat qaytarishi", "Kolliziyalarga moyilligi (xavfsizlik zaifliklari)", "Juda sekin ishlashi", "Faqat kichik ma'lumotlar uchun ishlashi"], "correct_index": 1, "explanation": "MD5 algoritmining asosiy kamchiligi uning kolliziyalarga moyilligi (collision vulnerability) topilganligi sababli, xavfsizlik maqsadlarida ishonchsiz hisoblanadi."}, {"question": "Agar grafdagi A tugun B, C va D tugunlar bilan qirralar orqali tutashgan boвЂlsa A tugunning darajasi nechchiga teng?", "options": ["1", "2", "3", "4"], "correct_index": 2, "explanation": "A tugun B, C va D tugunlar bilan tutashgan bo'lsa, unga 3 ta qirra tutashgan, shuning uchun A tugunning darajasi 3 ga teng."}, {"question": "Ustuvor navbatni (Priority Queue) eng samarali amalga oshirish uchun qaysi tuzilmadan foydalaniladi?", "options": ["Bog'lamli ro'yxat", "Massiv", "Binar uyum (Binary Heap)", "Ikkilik qidiruv daraxti"], "correct_index": 2, "explanation": "Ustuvor navbatni (Priority Queue) eng samarali amalga oshirish uchun binar uyum (Binary Heap) ma'lumotlar tuzilmasidan foydalaniladi, chunki u eng yuqori ustuvorlikka ega elementni O(1) da olish va elementlarni qo'shish/o'chirishni O(log n) da bajarish imkonini beradi."}, {"question": "Quyidagilardan qaysi biri ideal xesh funksiyaning muhim xususiyati hisoblanadi?", "options": ["Kolliziyalarni minimallashtirishi va xesh qiymatlarini bir tekis taqsimlashi", "Hisoblash uchun juda ko'p vaqt talab qilishi", "Faqat ma'lum turdagi ma'lumotlar uchun ishlashi", "Kolliziyalarni ko'p hosil qilishi"], "correct_index": 0, "explanation": "Ideal xesh funksiyaning muhim xususiyati kolliziyalarni minimallashtirishi va xesh qiymatlarini xesh jadval bo'ylab bir tekis taqsimlashi, bu esa operatsiyalarning o'rtacha O(1) murakkabligini ta'minlaydi."}, {"question": "Stekga element qoвЂshish amali qanday ataladi?", "options": ["Dequeue", "Pop", "Push", "Enqueue"], "correct_index": 2, "explanation": "Stekga element qo'shish amali 'Push' deb ataladi."}, {"question": "QoвЂshnichilik matritsasi (adjacency matrix) qanday tuziladi?", "options": ["Faqat grafning og'irliklarini saqlovchi matritsa", "Qirralar soniga teng qator va ustunli matritsa", "Tugunlar soniga teng qator va ustunli matritsa", "Faqat nol va birlardan iborat matritsa"], "correct_index": 2, "explanation": "Qo'shnichilik matritsasi (Adjacency Matrix) - bu tugunlar soniga teng (V x V) o'lchamli kvadrat matritsa bo'lib, A[i][j] qiymati i-tugundan j-tugunga qirra bor-yo'qligini (yoki og'irligini) ko'rsatadi."}, {"question": "Hisoblash geometriyasidagi Orientatsiya (ing. Orientation) formulasi natijasi manfiy boвЂlsa nimani bildiradi?", "options": ["Nuqtalar bir to'g'ri chiziqda joylashgan", "Nuqtalar soat yo'nalishiga teskari (counter-clockwise) joylashgan", "Nuqtalar bir-biriga juda uzoq", "Nuqtalar soat yo'nalishi bo'yicha (clockwise) joylashgan"], "correct_index": 3, "explanation": "Orientatsiya formulasi natijasi manfiy bo'lsa, bu nuqtalarning soat yo'nalishi bo'yicha (clockwise) joylashganligini bildiradi."}, {"question": "Chiziqli maвЂ™lumotlar tuzilmalari qaysi javobda keltirilgan?", "options": ["Daraxt, Graf", "Uyum (Heap), Qizil-qora daraxt", "Massiv, Stek, Navbat, Bog'lamli ro'yxat", "Xesh jadval, B-daraxt"], "correct_index": 2, "explanation": "Massiv, stek, navbat va bog'lamli ro'yxat chiziqli ma'lumotlar tuzilmalariga misoldir, chunki ularning elementlari ketma-ket tartibda joylashgan."}]}j‰…–   °lan, ma'lumotlar bazalari va fayl tizimlarida) samarali qidiruv, qo'shish va o'chirish operatsiyalarini ta'minlashdir."}, {"question": "ToвЂliq grafda 6 ta tugun boвЂlsa nechta qirralar mavjud boвЂladi?", "options": ["12", "15", "18", "10"], "correct_index": 1, "explanation": "To'liq grafdagi qirralar sonini topish formulasi n * (n - 1) / 2. Bu yerda n=6 bo'lsa, 6 * (6 - 1) / 2 = 6 * 5 / 2 = 15 ta qirra bo'ladi."}, {"question": "AVL daraxtidan tugunni o'chirish (Deletion) murakkabligi qancha?", "options": ["O(log n)", "O(1)", "O(n log n)", "O(n)"], "correct_index": 0, "explanation": "AVL daraxtidan tugunni o'chirish operatsiyasining vaqt murakkabligi ham O(log n) ga teng, chunki o'chirishdan keyin muvozanatni tiklash uchun aylantirishlar logarifmik vaqtda bajariladi."}, {"question": "Algoritm murakkabligi nimani baholaydi?", "options": ["Dasturchining mahoratini", "Algoritmning ishlash tezligi va xotira sarfini", "Dasturning hajmini", "Kodning o'qiluvchanligini"], "correct_index": 1, "explanation": "Algoritm murakkabligi (Time and Space Complexity) uning ishlash tezligi (vaqt) va talab qilinadigan xotira miqdorini baholaydi."}, {"question": "Kriptografik xesh funksiyaning asosiy xususiyatlaridan biri qaysi?", "options": ["Tez hisoblash", "Kichik o'zgarishlar katta xesh o'zgarishiga olib kelmasligi", "Bir tomonlama (one-way) funksiya bo'lishi", "Kolliziyalarni umuman yo'qotishi"], "correct_index": 2, "explanation": "Kriptografik xesh funksiyaning asosiy xususiyatlaridan biri uning bir tomonlama (one-way) funksiya bo'lishidir, ya'ni xesh qiymatidan asl ma'lumotni qayta tiklash deyarli imkonsiz."}, {"question": "Tez saralash (Quick Sort) algoritmi qaysi saralash algoritmiga oвЂxshaydi?", "options": ["Merge Sort", "Selection Sort", "Insertion Sort", "Heap Sort"], "correct_index": 1, "explanation": "Quick Sort va Selection Sort ikkalasi ham massivni bo'lish va elementlarni o'z joyiga qo'yish g'oyasiga ega, ammo Quick Sort pivot atrofida bo'lish orqali tezroq ishlaydi."}, {"question": "Hisoblash geometriyasi qayerda qoвЂllaniladi?", "options": ["Kompyuter grafikasi, robototexnika, geografik axborot tizimlari (GIS), CAD/CAM tizimlarida", "Faqat matn tahlilida", "Faqat ma'lumotlar bazalarida", "Faqat veb-dasturlashda"], "correct_index": 0, "explanation": "Hisoblash geometriyasi kompyuter grafikasi, robototexnika, geografik axborot tizimlari (GIS), CAD/CAM tizimlari, tasvirni qayta ishlash kabi ko'plab sohalarda qo'llaniladi."}, {"question": "Saralash algoritmlarining samaradorligini baholashda asosiy mezon nima?", "options": ["Kodning qisqaligi", "Dasturlash tilining turi", "Dasturchining tajribasi", "Vaqt va xotira murakkabligi"], "correct_index": 3, "explanation": "Saralash algoritmlarining samaradorligini baholashda asosiy mezonlar uning vaqt murakkabligi (Time Complexity) va xotira murakkabligi (Space Complexity) hisoblanadi."}, {"question": "Agar daraxtda 12 ta tugun mavjud bo'lsa uning Pryufer kodi uzunligi nechchiga teng boвЂladi?", "options": ["10", "13", "12", "11"], "correct_index": 0, "explanation": "Pryufer kodi uzunligi n-2 formulasi bo'yicha, 12 ta tugun bo'lsa, 12-2 = 10 ga teng bo'ladi."}, {"question": "Quyidagi tuzilmalardan qaysi biri ichki ravishda xesh funksiyadan foydalanadi?", "options": ["std::vector", "std::unordered_map", "std::list", "std::map"], "correct_index": 1, "explanation": "`std::unordered_map` C++ STL konteyneri ichki ravishda xesh funksiyadan foydalanib, kalitlarni massiv indekslariga xeshlash orqali ma'lumotlarni saqlaydi va ularga tezkor kirishni ta'minlaydi."}, {"question": "Kolliziya (Collision) nima?", "options": ["Xesh jadvalning buzilishi", "Ikki xil kalit uchun xesh funksiya bir xil indeksni qaytarishi", "Xesh jadvalning to'lib ketishi", "Ma'lumotlarning yo'qolishi"], "correct_index": 1, "explanation": "Kolliziya (Collision) - bu ikki xil kalit uchun xesh funksiya bir xil indeksni qaytarishi holati."}, {"question": "AVL daraxtining muvozanatlashganlik sharti (Balance Factor) qanday aniqlanadi?", "options": ["Tugunning farzandlari soni", "Tugunning qiymati", "Chap kichik darax   ±ct_index": 1, "explanation": "Ichki saralash (Internal Sorting) - bu saralanishi kerak bo'lgan barcha ma'lumotlar kompyuterning asosiy xotirasiga (RAM) sig'adigan holatda bajariladigan saralash."}, {"question": "Tez saralash (Quick Sort) algoritmining vaqt murakkabligida eng yomon holati qachon yuz beradi?", "options": ["Pivot har doim eng kichik yoki eng katta element bo'lib tanlansa", "Yuqoridagi barcha holatlarda", "Massiv teskari tartibda saralangan bo'lsa", "Massiv allaqachon saralangan bo'lsa"], "correct_index": 1, "explanation": "Quick Sortning eng yomon holati O(n^2) ga teng bo'lib, u massiv allaqachon saralangan, teskari saralangan yoki pivot har doim eng kichik/eng katta element sifatida tanlanganda yuz beradi."}, {"question": "Quyidagilardan qaysi biri chiziqli maвЂ™lumotlar tuzilmasi emas?", "options": ["Massiv", "Stek", "Daraxt", "Bog'lamli ro'yxat"], "correct_index": 2, "explanation": "Daraxt chiziqli bo'lmagan ma'lumotlar tuzilmasi hisoblanadi, chunki uning elementlari ierarxik tarzda joylashgan."}, {"question": "Primitiv (sodda) qidiruv algoritmining kamchiligi nima?", "options": ["Eng yomon holatda O(m*n) vaqt murakkabligiga ega bo'lishi", "Xotira sarfi juda yuqori bo'lishi", "Juda murakkab implementatsiya", "Faqat kichik satrlar uchun ishlashi"], "correct_index": 0, "explanation": "Primitiv (sodda) qismiy satr qidiruv algoritmining asosiy kamchiligi shundaki, uning eng yomon holatdagi vaqt murakkabligi O(m*n) ga teng bo'lishi mumkin, bu yerda n - matn uzunligi, m - qidirilayotgan qismiy satr uzunligi."}, {"question": "for(int i=0; i<n; i++){ cout << i; } Ushbu kodning vaqt murakkabligini toping.", "options": ["O(log n)", "O(n^2)", "O(n)", "O(1)"], "correct_index": 2, "explanation": "Tsikl 'n' marta takrorlanadi, shuning uchun vaqt murakkabligi O(n) (chiziqli) bo'ladi."}, {"question": "KoвЂrsatkichli murakkablik qaysi javobda keltirilgan?", "options": ["O(n)", "O(n^2)", "O(2^n)", "O(log n)"], "correct_index": 2, "explanation": "O(2^n) ko'rsatkichli (eksponensial) murakkablikni ifodalaydi, bu juda tez o'suvchi murakkablik turidir."}, {"question": "Algoritmning ommaviylik xossasi nimani bildiradi?", "options": ["Algoritmning tez ishlashini", "Algoritmning bir turdagi barcha masalalarni hal qilishini", "Algoritmning faqat bitta turdagi muammoni hal qilishini", "Algoritmning mashhurligini"], "correct_index": 1, "explanation": "Algoritmning ommaviylik (generality) xossasi uning bir turdagi barcha masalalarni hal qilish qobiliyatini bildiradi, ya'ni u faqat bitta aniq holat uchun emas, balki umumiy muammolar sinfi uchun ishlaydi."}, {"question": "BogвЂlangan graf deb qanday graflarga aytiladi?", "options": ["Yo'naltirilgan graf", "Barcha tugunlari bir-biriga bog'langan graf", "Faqat bitta qirrasi bo'lgan graf", "Har qanday ikki tugun orasida yo'l mavjud bo'lgan graf"], "correct_index": 3, "explanation": "Bog'langan graf (Connected Graph) - bu grafdagi har qanday ikki tugun orasida kamida bitta yo'l mavjud bo'lgan graf."}, {"question": "Qaysi qatorda chiziqli murakkablik ifodasi keltirilgan?", "options": ["O(n^2)", "O(n)", "O(1)", "O(log n)"], "correct_index": 1, "explanation": "O(n) chiziqli murakkablikni ifodalaydi, bu yerda algoritmning ishlash vaqti kirish ma'lumotlari hajmiga to'g'ri proportsionaldir."}, {"question": "AVL daraxtida eng kichik element qayerda joylashgan bo'ladi?", "options": ["Ildiz tugunda", "Daraxtning o'rtasida", "Eng chapdagi barg tugunda", "Eng o'ngdagi barg tugunda"], "correct_index": 2, "explanation": "AVL daraxti ikkilik qidiruv daraxti bo'lganligi sababli, eng kichik element har doim eng chapdagi barg tugunda (yoki eng chapdagi tugun yo'lida) joylashgan bo'ladi."}, {"question": "B-daraxtning asosiy maqsadi nima?", "options": ["Faqat xotirada tezkor qidiruvni ta'minlash", "Faqat kichik ma'lumotlar to'plamini saqlash", "Diskda saqlanadigan katta ma'lumotlar to'plamlarida samarali qidiruv va boshqa operatsiyalarni ta'minlash", "Grafik ma'lumotlarni saqlash"], "correct_index": 2, "explanation": "B-daraxtning asosiy maqsadi diskda saqlanadigan katta ma'lumotlar to'plamlarida (masa   Іotlarning aniqligi, izchilligi va ishonchliligi, ya'ni ular o'zgartirilmagan va buzilmaganligini ta'minlash."}, {"question": "Agar orientation = 0 boвЂlsa, bu nimani anglatadi?", "options": ["Nuqtalar bir to'g'ri chiziqda (kollinear) joylashgan", "Nuqtalar soat yo'nalishiga teskari joylashgan", "Nuqtalar soat yo'nalishi bo'yicha joylashgan", "Nuqtalar bir-biriga juda yaqin"], "correct_index": 0, "explanation": "Agar orientation = 0 bo'lsa, bu uchta nuqtaning bir to'g'ri chiziqda (kollinear) joylashganligini anglatadi."}, {"question": "Uyumga yangi element qo'shilganda (Insert), uning o'rnini to'g'rilash jarayoni nima deyiladi?", "options": ["Heapify-down", "Heapify-up", "Delete-max", "Build-heap"], "correct_index": 1, "explanation": "Uyumga yangi element qo'shilganda, uning o'rnini to'g'rilash jarayoni 'Heapify-up' (yoki 'sift-up') deb ataladi, bunda element ota tugunlari bilan solishtirilib, yuqoriga ko'tariladi."}, {"question": "Algoritm murakkabligini baholashda n nimani anglatadi?", "options": ["Kompyuterning tezligi", "Kirish ma'lumotlari hajmi", "Dasturchilar soni", "Dastur qatorlari soni"], "correct_index": 1, "explanation": "Algoritm murakkabligini baholashda 'n' odatda kirish ma'lumotlari hajmini yoki elementlar sonini anglatadi."}, {"question": "Muvozanatlangan ikkilik qidiruv daraxti (Balanced Binary Search Tree) nima uchun kerak?", "options": ["Daraxtni chiroyli ko'rsatish uchun", "Faqat ma'lumotlarni tezroq qo'shish uchun", "Faqat xotira sarfini kamaytirish uchun", "Qidiruv, qo'shish va o'chirish operatsiyalarining eng yomon holatdagi murakkabligini O(log n) da ushlab turish uchun"], "correct_index": 3, "explanation": "Muvozanatlangan ikkilik qidiruv daraxti (masalan, AVL, Red-Black Tree) qidiruv, qo'shish va o'chirish operatsiyalarining eng yomon holatdagi vaqt murakkabligini O(log n) da ushlab turish uchun kerak, bu esa uning samaradorligini ta'minlaydi."}, {"question": "Binar uyum (Binary Heap) qanday maвЂ™lumotlar tuzilmasi hisoblanadi?", "options": ["To'liq binar daraxt shartini qanoatlantiruvchi daraxt", "Chiziqli ma'lumotlar tuzilmasi", "Bog'lamli ro'yxat", "Muvozanatlanmagan ikkilik qidiruv daraxti"], "correct_index": 0, "explanation": "Binar uyum (Binary Heap) - bu to'liq binar daraxt (Complete Binary Tree) shartini qanoatlantiruvchi va uyum xossasiga (Max-Heap yoki Min-Heap) ega bo'lgan daraxtga asoslangan ma'lumotlar tuzilmasi."}, {"question": "Grafda oвЂtish nima?", "options": ["Grafdagi eng qisqa yo'lni topish", "Grafdagi tugunlarni o'chirish", "Grafdagi qirralarni qo'shish", "Grafdagi barcha tugunlarni bir marta ziyorat qilish"], "correct_index": 3, "explanation": "Grafda o'tish (Graph Traversal) - bu grafdagi barcha tugunlarni (yoki ma'lum bir shartga javob beradigan tugunlarni) bir marta ziyorat qilish jarayoni."}, {"question": "Qaysi saralash algoritmlari \"Divide and Conquer\" tamoyili asosida ishlaydi?", "options": ["Merge Sort, Quick Sort", "Selection Sort, Counting Sort", "Bubble Sort, Insertion Sort", "Radix Sort, Bucket Sort"], "correct_index": 0, "explanation": "Merge Sort va Quick Sort algoritmlari 'Divide and Conquer' (Bo'lish va Yengish) tamoyili asosida ishlaydi."}, {"question": "Kesma (Line Segment) nima?", "options": ["Faqat bitta nuqta", "Ikki nuqta orasidagi to'g'ri chiziqning cheklangan qismi", "Egri chiziq", "Cheksiz uzunlikdagi chiziq"], "correct_index": 1, "explanation": "Kesma (Line Segment) - bu ikki nuqta orasidagi to'g'ri chiziqning cheklangan qismi."}, {"question": "Virus signaturasi deganda nima tushuniladi?", "options": ["Virusning yaratilgan sanasi", "Virusning nomi", "Virusning hajmi", "Virus kodidagi noyob belgilar ketma-ketligi"], "correct_index": 3, "explanation": "Virus signaturasi - bu virus kodidagi noyob belgilar ketma-ketligi bo'lib, antivirus dasturlari uni aniqlash uchun foydalanadi."}, {"question": "Ichki saralash (Internal Sorting) nimani anglatadi?", "options": ["Ma'lumotlar diskda saralanishi", "Saralanishi kerak bo'lgan barcha ma'lumotlar xotiraga sig'ishi", "Saralash algoritmining ichki qismi", "Ma'lumotlar tarmoq orqali saralanishi"], "corre   і qilingan."}, {"question": "Agar tugunning chap farzandining balandligi 3 va o'ng farzandining balandligi 1 bo'lsa, Balans Faktori (Balance Factor) nechaga teng?", "options": ["2", "1", "-2", "0"], "correct_index": 0, "explanation": "Balance Factor = Chap farzand balandligi - O'ng farzand balandligi = 3 - 1 = 2. Bu tugun muvozanatlanmaganligini bildiradi."}, {"question": "Active Set nima?", "options": ["Barcha elementlar to'plami", "Algoritm ishlashi davomida faol foydalaniladigan elementlar to'plami", "Faqat qo'shilgan elementlar to'plami", "Faqat o'chirilgan elementlar to'plami"], "correct_index": 1, "explanation": "Active Set (Faol to'plam) - bu algoritm ishlashi davomida ma'lum bir vaqtda faol foydalaniladigan yoki ko'rib chiqilayotgan elementlar to'plami."}, {"question": "MaКјlumotlar yaxlitligi (data integrity) ning necha xil turi bor?", "options": ["2", "1", "3", "4"], "correct_index": 3, "explanation": "Ma'lumotlar yaxlitligining asosiy turlari: Entity Integrity (obyekt yaxlitligi), Referential Integrity (havola yaxlitligi), Domain Integrity (domen yaxlitligi) va User-Defined Integrity (foydalanuvchi tomonidan belgilangan yaxlitlik)."}, {"question": "AVL daraxti va oddiy BST (Binary Search Tree) o'rtasidagi asosiy farq nima?", "options": ["AVL daraxti o'z-o'zidan muvozanatlashadi, BST esa muvozanatlanmasligi mumkin", "AVL daraxti faqat ildiz tuguniga ega", "BST tezroq qidiradi", "AVL daraxti faqat butun sonlarni saqlaydi"], "correct_index": 0, "explanation": "Asosiy farq shundaki, AVL daraxti o'z-o'zidan muvozanatlashadi, bu esa qidirish, qo'shish va o'chirish operatsiyalarining eng yomon holatdagi murakkabligini O(log n) da ushlab turadi. Oddiy BST esa muvozanatlanmagan holatda O(n) murakkablikka ega bo'lishi mumkin."}, {"question": "Labirintdan chiqish yoвЂlini topish uchun qaysi algoritmdan foydalaniladi?", "options": ["Saralash algoritmlari", "Dinamik dasturlash", "Xesh funksiyalar", "Qidiruv algoritmlari (BFS/DFS)"], "correct_index": 3, "explanation": "Labirintdan chiqish yo'lini topish uchun graf qidiruv algoritmlari, xususan BFS (eng qisqa yo'l uchun) yoki DFS (har qanday yo'l uchun) samarali qo'llaniladi."}, {"question": "Daraxtda qaysi tugun \"Ildiz\" (root) deb ataladi?", "options": ["Hech qanday ota-onasi bo'lmagan tugun", "Eng ko'p farzandga ega tugun", "Eng chapdagi tugun", "Eng pastdagi tugun"], "correct_index": 0, "explanation": "Daraxtda 'Ildiz' (Root) - bu hech qanday ota-onasi bo'lmagan, daraxtning eng yuqorisidagi tugun."}, {"question": "B-daraxtning tartibi (minimum degree) t bo'lsa, ildizdan tashqari har bir tugundagi minimal kalitlar soni qancha?", "options": ["t", "2t", "2t-1", "t-1"], "correct_index": 3, "explanation": "B-daraxtning tartibi (minimum degree) t bo'lsa, ildizdan tashqari har bir tugundagi minimal kalitlar soni t-1 ga teng."}, {"question": "Agar daraxtda n ta tugun boвЂlsa Pryufer kodi uzunligi nechchiga teng bo'ladi?", "options": ["n", "n-2", "n-1", "n+1"], "correct_index": 1, "explanation": "n ta tugundan iborat daraxtning Pryufer kodi uzunligi n-2 ga teng bo'ladi."}, {"question": "Algoritmning samaradorligini baholashda log n qayerdan kelib chiqadi?", "options": ["Ichma-ich tsikllardan", "Har bir elementni birma-bir tekshirishdan", "Qo'shni elementlarni solishtirishdan", "Massivni teng ikkiga bo'lishdan"], "correct_index": 3, "explanation": "Log n ko'pincha 'Divide and Conquer' (Bo'lish va Yengish) strategiyasini qo'llaydigan algoritmlarda (masalan, Binary Search, Merge Sort) massivni yoki muammoni har safar teng ikkiga bo'lishdan kelib chiqadi."}, {"question": "Hisoblash geometriyasida eng sodda obyekt nima?", "options": ["Chiziq", "Doira", "Nuqta", "Ko'pburchak"], "correct_index": 2, "explanation": "Hisoblash geometriyasida eng sodda va asosiy obyekt nuqta (Point) hisoblanadi."}, {"question": "MaКјlumotlar yaxlitligi (data integrity) nima?", "options": ["Ma'lumotlarning xavfsizligi", "Ma'lumotlarning tezkorligi", "Ma'lumotlarning hajmi", "Ma'lumotlarning aniqligi va izchilligi"], "correct_index": 3, "explanation": "Ma'lumotlar yaxlitligi (Data Integrity) - bu ma'lum   ґa bo'lish", "Qo'shni elementlarni solishtirib, noto'g'ri tartibda bo'lsa almashtirish"], "correct_index": 3, "explanation": "Pufakli saralash (Bubble Sort) algoritmining asosiy g'oyasi qo'shni elementlarni qayta-qayta solishtirish va agar ular noto'g'ri tartibda bo'lsa, ularning o'rnini almashtirishdan iborat."}, {"question": "Xesh funksiya (Hash Function) ning asosiy vazifasi nima?", "options": ["Ma'lumotlarni siqish", "Katta hajmdagi ma'lumotni kichik, o'zgarmas uzunlikdagi qiymatga (xesh) aylantirish", "Ma'lumotlarni shifrlash", "Ma'lumotlarni saralash"], "correct_index": 1, "explanation": "Xesh funksiyaning asosiy vazifasi katta hajmdagi (ixtiyoriy uzunlikdagi) ma'lumotni kichik, o'zgarmas uzunlikdagi qiymatga (xesh qiymat yoki xesh kod) aylantirishdir."}, {"question": "Hisoblash geometriyasidagi qavariq qobiq (Convex Hull) nima?", "options": ["Nuqtalar to'plamini o'z ichiga olgan eng kichik to'g'ri to'rtburchak", "Nuqtalar to'plamini o'z ichiga olgan eng katta doira", "Nuqtalar to'plamini o'z ichiga olgan eng kichik qavariq ko'pburchak", "Nuqtalar to'plamini o'z ichiga olgan har qanday ko'pburchak"], "correct_index": 2, "explanation": "Qavariq qobiq (Convex Hull) - bu berilgan nuqtalar to'plamini o'z ichiga olgan eng kichik qavariq ko'pburchak."}, {"question": "B-daraxt va Ikkilik qidiruv daraxti (BST) o'rtasidagi asosiy farq nimada?", "options": ["B-daraxt faqat ikkita farzandga ega bo'ladi", "B-daraxt muvozanatlanmagan bo'ladi", "B-daraxt har bir tugunda bir nechta kalit va farzandga ega bo'lishi mumkin, BST esa har bir tugunda bitta kalit va maksimal ikkita farzandga ega", "BST diskda saqlanadigan ma'lumotlar uchun optimallashtirilgan"], "correct_index": 2, "explanation": "Asosiy farq shundaki, B-daraxt har bir tugunda bir nechta kalit va farzandga ega bo'lishi mumkin, bu esa disk I/O operatsiyalarini kamaytirishga yordam beradi. BST esa har bir tugunda bitta kalit va maksimal ikkita farzandga ega."}, {"question": "Xesh funksiyalar axborot xavfsizligida nima uchun ishlatiladi?", "options": ["Ma'lumotlarni siqish uchun", "Ma'lumotlarni shifrlash uchun", "Ma'lumotlarni saralash uchun", "Ma'lumotlar yaxlitligini tekshirish va parollarni saqlash uchun"], "correct_index": 3, "explanation": "Xesh funksiyalar axborot xavfsizligida ma'lumotlar yaxlitligini tekshirish (masalan, faylning buzilmaganligini aniqlash) va parollarni xavfsiz saqlash uchun keng qo'llaniladi."}, {"question": "Bir bogвЂlamli roвЂyxatda har bir tugun nechta koвЂrsatkichga ega?", "options": ["3", "0", "2", "1"], "correct_index": 3, "explanation": "Bir bog'lamli ro'yxatda har bir tugun bitta ko'rsatkichga ega bo'lib, u keyingi tugunga ishora qiladi."}, {"question": "Stek qaysi tamoyil asosida ishlaydi?", "options": ["Random Access", "LIFO (Last-In, First-Out)", "FIFO (First-In, First-Out)", "Priority Based"], "correct_index": 1, "explanation": "Stek LIFO (Last-In, First-Out) tamoyili asosida ishlaydi, ya'ni oxirgi qo'shilgan element birinchi bo'lib olinadi."}, {"question": "Convex Hull nechta nuqtadan iborat? Nuqtalar: (0,0), (1,1), (2,2), (3,3)", "options": ["4", "3", "2", "1"], "correct_index": 2, "explanation": "Berilgan nuqtalar bir to'g'ri chiziqda joylashgan. Convex Hull bu nuqtalarni o'z ichiga olgan eng kichik qavariq ko'pburchakdir. Bu holda, (0,0) va (3,3) nuqtalari Convex Hullni tashkil qiladi, chunki ular chiziqning chekka nuqtalari. Shuning uchun 2 ta nuqta."}, {"question": "AVL daraxtiga yangi tugun qo'shilganda muvozanat buzilsa, maksimal necha turdagi aylantirish (rotation) ishlatilishi mumkin?", "options": ["4", "3", "1", "2"], "correct_index": 0, "explanation": "AVL daraxtida muvozanatni tiklash uchun to'rt turdagi aylantirish (LL, RR, LR, RL) ishlatilishi mumkin. LR va RL ikki marta aylantirishni talab qiladi."}, {"question": "AVL daraxtini kimlar ixtiro qilgan?", "options": ["Sergey Brin va Larry Page", "Adelson-Velsky va Landis", "Edsger Dijkstra va Tony Hoare", "Donald Knuth va Robert Tarjan"], "correct_index": 1, "explanation": "AVL daraxti 1962 yilda sovet matematiklari G.M. Adelson-Velsky va E.M. Landis tomonidan ixtiro   µir."}, {"question": "1 mln ta elementdan iborat int (4 bayt) toifali massiv berilgan. U xotiradan necha MB (mega bayt) joy oladi?", "options": ["4 MB", "8 MB", "2 MB", "1 MB"], "correct_index": 0, "explanation": "1 million element * 4 bayt/element = 4,000,000 bayt. 4,000,000 bayt / (1024 * 1024) bayt/MB в‰€ 3.81 MB. Eng yaqin javob 4 MB."}, {"question": "Ikki saralangan kichik massivni bitta saralangan massivga birlashtirish bosqichi nima deyiladi?", "options": ["Divide", "Conquer", "Merge", "Split"], "correct_index": 2, "explanation": "Ikki saralangan kichik massivni bitta saralangan massivga birlashtirish bosqichi 'Merge' (Birlashtirish) deb ataladi."}, {"question": "Convex Hull nechta nuqtadan iborat? Nuqtalar: (0,0), (3,0), (3,3), (0,3), (1,1), (2,2)", "options": ["6", "3", "5", "4"], "correct_index": 3, "explanation": "Nuqtalar: (0,0), (3,0), (3,3), (0,3) kvadratning burchaklari. (1,1) va (2,2) esa kvadratning ichida joylashgan. Convex Hull faqat tashqi nuqtalardan iborat bo'ladi, ya'ni (0,0), (3,0), (3,3), (0,3). Shuning uchun 4 ta nuqta."}, {"question": "Massiv elementlari xotirada qanday joylashadi?", "options": ["Ierarxik tarzda", "Ketma-ket (yonma-yon)", "Bog'lamli tarzda", "Tasodifiy tartibda"], "correct_index": 1, "explanation": "Massiv elementlari xotirada ketma-ket (contiguous) joylashadi, bu ularga indeks orqali tez kirish imkonini beradi."}, {"question": "Double Hashing nima ishlatadi?", "options": ["Xesh funksiyani ishlatmaydi", "Uchta xesh funksiyani", "Bitta xesh funksiyani", "Ikkita xesh funksiyani"], "correct_index": 3, "explanation": "Double Hashing (Ikki marta xeshlash) - bu kolliziyani hal qilish usuli bo'lib, u ikkita xesh funksiyadan foydalanadi: birinchisi boshlang'ich indeksni, ikkinchisi esa kolliziya yuz berganda keyingi indeksni topish uchun qadam hajmini aniqlaydi."}, {"question": "Oddiy saralash algoritmlari qaysilar?", "options": ["Bubble Sort, Selection Sort, Insertion Sort", "Merge Sort, Quick Sort", "Heap Sort, Radix Sort", "Counting Sort, Bucket Sort"], "correct_index": 0, "explanation": "Pufakli saralash (Bubble Sort), Tanlash orqali saralash (Selection Sort) va Kiritish orqali saralash (Insertion Sort) oddiy (kvadratik murakkablikka ega) saralash algoritmlaridir."}, {"question": "Kichik daraxt yoki qism daraxt (sub tree) tugunlari sifatida qaysi tugunlar olinadi?", "options": ["Faqat barg tugunlar", "Faqat ota-ona tugunlar", "Har qanday tugun va uning barcha avlodlari", "Faqat ildiz tugun"], "correct_index": 2, "explanation": "Kichik daraxt (subtree) - bu daraxtning har qanday tuguni va uning barcha avlodlaridan tashkil topgan qismidir."}, {"question": "Algoritmlarning qanday holatlari mavjud", "options": ["Eng yaxshi, eng yomon, o'rtacha", "Tez, sekin, normal", "Yaxshi, yomon, o'rtacha", "Oddiy, murakkab, optimal"], "correct_index": 0, "explanation": "Algoritmlarning samaradorligi odatda uchta holatda baholanadi: eng yaxshi holat (Best Case), eng yomon holat (Worst Case) va o'rtacha holat (Average Case)."}, {"question": "Tez saralash (Quick Sort) algoritmi barqarormi (stabilmi)?", "options": ["Yo'q", "Ha", "Faqat ba'zi hollarda", "Ma'lumot turiga bog'liq"], "correct_index": 0, "explanation": "Yo'q, Quick Sort odatda barqaror (unstable) saralash algoritmi hisoblanadi, chunki u bir xil qiymatga ega elementlarning nisbiy tartibini saqlamasligi mumkin."}, {"question": "Agar daraxtda 10 ta tugun mavjud bo'lsa uning Pryufer kodi uzunligi nechchiga teng boвЂladi?", "options": ["8", "11", "10", "9"], "correct_index": 0, "explanation": "Pryufer kodi uzunligi n-2 formulasi bo'yicha, 10 ta tugun bo'lsa, 10-2 = 8 ga teng bo'ladi."}, {"question": "Daraxtda har qanday ikki tugun orasida nechta yoвЂl mavjud?", "options": ["2", "Cheksiz", "0", "1"], "correct_index": 3, "explanation": "Daraxtning ta'rifiga ko'ra, har qanday ikki tugun orasida faqat bitta noyob oddiy yo'l mavjud."}, {"question": "Pufakli saralash algoritmining asosiy gвЂoyasi nimadan iborat?", "options": ["Elementlarni xesh funksiya yordamida joylashtirish", "Eng kichik elementni topib, boshiga qo'yish", "Massivni teng ikkig   ¶aydi va ularni xesh funksiya yordamida joylashtiradi."}, {"question": "Daraxtda farzandga ega boвЂlmagan tugunlar qanday nomlanadi?", "options": ["Ildiz tugunlar", "Barg tugunlar", "Ichki tugunlar", "Ota-ona tugunlar"], "correct_index": 1, "explanation": "Daraxtda farzandga ega bo'lmagan tugunlar 'Barg tugunlar' (Leaf Nodes) deb nomlanadi."}, {"question": "Algoritm nima?", "options": ["Dasturlash tili", "Muammoni hal qilish uchun aniq ko'rsatmalar ketma-ketligi", "Ma'lumotlar tuzilmasi", "Kompyuter dasturi"], "correct_index": 1, "explanation": "Algoritm - bu ma'lum bir muammoni hal qilish uchun qadam-baqadam, aniq va chekli ko'rsatmalar ketma-ketligi."}, {"question": "Quyida berilgan grafda BFS yordamida A dan F gacha eng qisqa yo'l uzunligi (qirralar soni) qancha? AвЂ“B, AвЂ“C, BвЂ“D, CвЂ“E, DвЂ“F, EвЂ“F", "options": ["4", "2", "3", "1"], "correct_index": 2, "explanation": "A dan F gacha eng qisqa yo'l: A -> B -> D -> F (3 qirra) yoki A -> C -> E -> F (3 qirra). Shuning uchun eng qisqa yo'l uzunligi 3 ga teng."}, {"question": "Kolliziyani hal qilish usullaridan biri qaysi?", "options": ["Rekursiya", "Zanjirlash (Chaining)", "Saralash", "Dinamik dasturlash"], "correct_index": 1, "explanation": "Kolliziyani hal qilish usullaridan biri 'Zanjirlash' (Chaining) bo'lib, bunda har bir indeksda bog'lamli ro'yxat yoki massiv yordamida bir nechta element saqlanadi."}, {"question": "Qo'shnilik ro'yxati (adjacency list) sifatida berilgan V tugun va E qirrali grafda BFS ning vaqt murakkabligi qanday?", "options": ["O(V + E)", "O(E)", "O(V * E)", "O(V)"], "correct_index": 0, "explanation": "Qo'shnilik ro'yxati bilan berilgan grafda BFS ning vaqt murakkabligi O(V + E) ga teng, bu yerda V tugunlar soni, E esa qirralar soni."}, {"question": "Agar daraxtda ikki tugun qirra orqali bogвЂlangan boвЂlsa, yuqoridagi tugun qanday nomlanadi?", "options": ["Farzand", "Ota-ona", "Barg", "Aka-uka"], "correct_index": 1, "explanation": "Agar ikki tugun qirra orqali bog'langan bo'lsa, yuqoridagi tugun 'Ota-ona' (Parent) deb ataladi."}, {"question": "Convex Hull nechta nuqtadan iborat? Nuqtalar: (1,1), (2,2), (3,1), (2,0)", "options": ["4", "3", "5", "2"], "correct_index": 0, "explanation": "Nuqtalar: (1,1), (2,2), (3,1), (2,0). Bu nuqtalar kvadrat shaklini hosil qiladi. Convex Hull bu nuqtalarning barchasini o'z ichiga oladi, chunki ular qavariq ko'pburchakning burchaklari hisoblanadi. Shuning uchun 4 ta nuqta."}, {"question": "Antivirus dasturlarida qismiy satrlarni qidirish algoritmlarining asosiy vazifasi nima?", "options": ["Fayllarni saralash", "Fayllarni siqish", "Virus signaturalarini fayllar ichidan topish", "Fayllarni shifrlash"], "correct_index": 2, "explanation": "Antivirus dasturlarida qismiy satrlarni qidirish algoritmlarining asosiy vazifasi - ma'lum viruslarga xos bo'lgan 'signaturalarni' (belgilar ketma-ketliklarini) fayllar ichidan topishdir."}, {"question": "Daraxtda tanlangan tugunnning balandligi (height) nimaga teng?", "options": ["Shu tugunning farzandlari soni", "Ildizdan shu tugungacha bo'lgan yo'l uzunligi", "Daraxtdagi tugunlar soni", "Shu tugundan eng uzoqdagi barg tugungacha bo'lgan eng uzun yo'l uzunligi"], "correct_index": 3, "explanation": "Daraxtda tanlangan tugunning balandligi (height) - bu shu tugundan eng uzoqdagi barg tugungacha bo'lgan eng uzun yo'l uzunligi (qirralar soni)."}, {"question": "Graf G = (V, E) da V nimani bildiradi?", "options": ["Tugunlar (uchlar) to'plami", "Grafning og'irligi", "Grafning yo'nalishi", "Qirralar to'plami"], "correct_index": 0, "explanation": "Graf G = (V, E) da V tugunlar (vertices) to'plamini bildiradi."}, {"question": "Parollarni xeshlashdan asosiy maqsad nima?", "options": ["Parollarni ochiq matn shaklida saqlash", "Parollarni shifrlash kalitini yaratish", "Parollarni xavfsiz saqlash va ularni to'g'ridan-to'g'ri o'qish imkoniyatini yo'qotish", "Parollarni tezroq tiklash"], "correct_index": 2, "explanation": "Parollarni xeshlashdan asosiy maqsad - ularni xavfsiz saqlash va ma'lumotlar bazasi buzilgan taqdirda ham parollarni to'g'ridan-to'g'ri o'qish imkoniyatini yo'qotishd   ·'llaniladi."}, {"question": "Agar daraxt chiziqli (muvozanatlanmagan) bo'lsa qidirish murakkabligi qanday boвЂladi?", "options": ["O(1)", "O(n)", "O(log n)", "O(n log n)"], "correct_index": 1, "explanation": "Agar daraxt chiziqli (muvozanatlanmagan) bo'lsa, u bog'lamli ro'yxatga o'xshab qoladi va qidirish murakkabligi O(n) ga teng bo'ladi."}, {"question": "Grafning darajasi (degree) nimani bildiradi?", "options": ["Grafdagi tugunlar sonini", "Grafning eng uzun yo'lini", "Tugunga tutashgan qirralar sonini", "Grafdagi qirralar sonini"], "correct_index": 2, "explanation": "Grafning darajasi (Degree) - bu ma'lum bir tugunga tutashgan qirralar sonini bildiradi."}, {"question": "Vektor (vector) dan elementni oвЂqish murakkabligi qanday?", "options": ["O(n)", "O(n^2)", "O(1)", "O(log n)"], "correct_index": 2, "explanation": "Vektor (dinamik massiv) elementlariga indeks orqali to'g'ridan-to'g'ri kirish mumkin, shuning uchun elementni o'qish murakkabligi O(1) (doimiy) hisoblanadi."}, {"question": "Printerning ishlashi qaysi maвЂ™lumotlar tuzilmasiga misol boвЂla oladi.", "options": ["Massiv", "Navbat", "Bog'lamli ro'yxat", "Stek"], "correct_index": 1, "explanation": "Printer navbati (print queue) navbat ma'lumotlar tuzilmasiga misol bo'la oladi, chunki birinchi yuborilgan hujjat birinchi bo'lib chop etiladi (FIFO)."}, {"question": "Grafni toвЂliq tekshirish uchun qaysi algoritmlardan foydalanamiz?", "options": ["BFS va DFS", "Merge Sort", "Binary Search", "Quick Sort"], "correct_index": 0, "explanation": "Grafni to'liq tekshirish (ya'ni, barcha tugunlarni va qirralarni ko'rib chiqish) uchun BFS (Kenglik bo'yicha qidiruv) va DFS (Chuqurlik bo'yicha qidiruv) algoritmlaridan foydalaniladi."}, {"question": "Xesh jadvalning oвЂrtacha qidiruv tezligi qanday?", "options": ["O(n^2)", "O(n)", "O(log n)", "O(1)"], "correct_index": 3, "explanation": "Yaxshi xesh funksiya va kolliziyani samarali hal qilish usullari bilan xesh jadvalning o'rtacha qidiruv, qo'shish va o'chirish tezligi O(1) (doimiy) ga teng."}, {"question": "B-daraxtda barcha barg tugunlar (leaf nodes) qayerda joylashgan bo'lishi kerak?", "options": ["Faqat eng yuqori sathda", "Har xil sathlarda", "Bir xil sathda", "Faqat ildiz sathida"], "correct_index": 2, "explanation": "B-daraxtning muhim xususiyatlaridan biri shundaki, barcha barg tugunlar bir xil sathda joylashgan bo'lishi kerak."}, {"question": "Tez saralash (Quick Sort) algoritmining vaqt murakkabligi oвЂrtacha holatda nimaga teng?", "options": ["O(log n)", "O(n^2)", "O(n)", "O(n log n)"], "correct_index": 3, "explanation": "Quick Sort algoritmining o'rtacha holatdagi vaqt murakkabligi O(n log n) ga teng, bu uni juda samarali qiladi."}, {"question": "Birlashtirib saralash (Merge Sort) algoritmi \"Stable\" (Barqaror) algoritmlar sirasiga kiradimi?", "options": ["Yo'q", "Ma'lumot turiga bog'liq", "Faqat ba'zi hollarda", "Ha"], "correct_index": 3, "explanation": "Ha, Merge Sort barqaror (stable) saralash algoritmi hisoblanadi, ya'ni bir xil qiymatga ega elementlarning nisbiy tartibini saqlaydi."}, {"question": "C++ dasturlash tilida dinamik massiv qanday ataladi?", "options": ["array", "vector", "map", "list"], "correct_index": 1, "explanation": "C++ standart kutubxonasida dinamik massiv `std::vector` deb ataladi."}, {"question": "Quyidagilardan qaysi biri xesh jadvalning asosiy afzalligi hisoblanadi?", "options": ["Eng yomon holatda ham O(1) murakkablikni ta'minlashi", "O'rtacha holatda O(1) vaqtda qidirish, qo'shish va o'chirish imkoniyatini berishi", "Kolliziyalarning umuman yuz bermasligi", "Ma'lumotlarni saralangan holda saqlashi"], "correct_index": 1, "explanation": "Xesh jadvalning asosiy afzalligi shundaki, u o'rtacha holatda O(1) (doimiy) vaqtda qidirish, qo'shish va o'chirish operatsiyalarini bajarish imkoniyatini beradi."}, {"question": "unordered_set qanday qiymatlarni saqlaydi?", "options": ["Kalit-qiymat juftliklarini", "Faqat noyob kalitlarni", "Saralangan qiymatlarni", "Takrorlanuvchi qiymatlarni"], "correct_index": 1, "explanation": "`std::unordered_set` faqat noyob kalitlarni (qiymatlarni) saql   ёsiv"], "correct_index": 2, "explanation": "BFS (Breadth-First Search) algoritmi navbat (Queue) ma'lumotlar tuzilmasiga asoslanadi."}, {"question": "Agar daraxt right-right (o'ng-o'ng) og'ish holatida bo'lsa bunday daraxtni muvozanatga keltirishda uni qaysi tomonga aylantiriladi?", "options": ["Faqat o'ngga", "Chapga, keyin o'ngga", "O'ngga, keyin chapga", "Faqat chapga"], "correct_index": 3, "explanation": "Right-Right (RR) og'ish holatida daraxtni muvozanatga keltirish uchun bitta chap aylantirish (Left Rotation) bajariladi."}, {"question": "Tez saralash (Quick Sort) algoritmida pivot nima?", "options": ["Massivning eng kichik elementi", "Massivning o'rtasidagi element", "Saralash jarayonida massivni bo'lish uchun ishlatiladigan element", "Massivning eng katta elementi"], "correct_index": 2, "explanation": "Quick Sort algoritmida 'pivot' - bu massivni ikkita kichik qismga (pivotdan kichik va pivotdan katta elementlar) bo'lish uchun ishlatiladigan tanlangan element."}, {"question": "Tez saralash (Quick Sort) qaysi algoritmik paradigma asosida ishlaydi?", "options": ["Dynamic Programming (Dinamik dasturlash)", "Divide and Conquer (Bo'lish va Yengish)", "Greedy (Ochko'z)", "Backtracking (Orqaga qaytish)"], "correct_index": 1, "explanation": "Tez saralash (Quick Sort) 'Divide and Conquer' (Bo'lish va Yengish) algoritmik paradigmasi asosida ishlaydi."}, {"question": "Xesh jadvalda maвЂ™lumotlar nima orqali saqlanadi?", "options": ["Indeks", "Massiv", "Kalit-qiymat juftligi", "Bog'lamli ro'yxat"], "correct_index": 2, "explanation": "Xesh jadvalda ma'lumotlar kalit-qiymat (key-value) juftligi orqali saqlanadi, bu yerda kalit xesh funksiya yordamida indeksga aylantiriladi."}, {"question": "Password Hashing nima uchun ishlatiladi?", "options": ["Parollarni tezroq topish uchun", "Parollarni ochiq matn shaklida saqlash uchun", "Parollarni shifrlash uchun", "Parollarni xavfsiz saqlash va tekshirish uchun"], "correct_index": 3, "explanation": "Password Hashing parollarni xavfsiz saqlash va tekshirish uchun ishlatiladi. Parol ochiq matn shaklida saqlanmaydi, balki uning xesh qiymati saqlanadi. Tekshirishda kiritilgan paroldan xesh olinib, saqlangan xesh bilan solishtiriladi."}, {"question": "Hisoblash modeli nima?", "options": ["Dasturlash tili", "Algoritmlarning ishlashini tahlil qilish uchun abstrakt tizim", "Kompyuter arxitekturasi", "Ma'lumotlar bazasi"], "correct_index": 1, "explanation": "Hisoblash modeli - bu algoritmlarning ishlashini va resurs sarfini (vaqt, xotira) tahlil qilish uchun ishlatiladigan abstrakt tizim."}, {"question": "Birlashtirib saralash (Merge Sort) algoritmining asosi bo'lgan \"Divide and Conquer\" strategiyasi necha bosqichdan iborat?", "options": ["2", "3", "4", "1"], "correct_index": 1, "explanation": "Divide and Conquer strategiyasi uchta asosiy bosqichdan iborat: Divide (Bo'lish), Conquer (Yengish/Hal qilish) va Combine (Birlashtirish)."}, {"question": "Birlashtirib saralash (Merge Sort) algoritmi rekursiv ravishda qachongacha davom etadi?", "options": ["Massiv to'liq saralanguncha", "Massivning o'lchami juft bo'lguncha", "Har bir kichik massivda bitta element qolguncha", "Massivning o'lchami 10 dan kichik bo'lguncha"], "correct_index": 2, "explanation": "Merge Sort rekursiv ravishda har bir kichik massivda bitta element qolguncha davom etadi, chunki bitta elementli massiv allaqachon saralangan hisoblanadi."}, {"question": "Qismiy satr yana qanday nom bilan ataladi?", "options": ["Matn", "Belgi", "Asosiy satr", "Naqsh (Pattern)"], "correct_index": 3, "explanation": "Qismiy satr (Substring) ko'pincha 'Naqsh' (Pattern) deb ham ataladi, ayniqsa satr qidirish algoritmlarida."}, {"question": "Tashqi saralash qachon qoвЂllaniladi?", "options": ["Ma'lumotlar xotiraga sig'ganda", "Faqat kichik massivlar uchun", "Ma'lumotlar juda kam bo'lganda", "Ma'lumotlar asosiy xotiraga sig'may, diskda saqlanganda"], "correct_index": 3, "explanation": "Tashqi saralash (External Sorting) - bu saralanishi kerak bo'lgan ma'lumotlar hajmi asosiy xotiraga sig'may, disk yoki boshqa tashqi xotira qurilmalarida saqlanganda qo   №"Algoritmning вЂњDivideвЂќ (Bo'lish) bosqichida massiv qanday qismlarga ajratiladi?", "options": ["Har xil o'lchamdagi qismlarga", "Tasodifiy qismlarga", "Teng ikkita qismga", "Saralangan qismlarga"], "correct_index": 2, "explanation": "Merge Sortning 'Divide' bosqichida massiv rekursiv ravishda teng ikkita kichik massivga bo'linadi."}, {"question": "Xesh funksiyaning vazifasi nima?", "options": ["Kalitni massiv indeksiga aylantirish", "Ma'lumotlarni saralash", "Ma'lumotlarni shifrlash", "Ma'lumotlarni siqish"], "correct_index": 0, "explanation": "Xesh funksiyaning asosiy vazifasi berilgan kalitni massivdagi (xesh jadvaldagi) indeksga aylantirishdir."}, {"question": "Knut-Morris-Pratt (KMP) algoritmining murakkabligi qaysi javobda keltirilgan?", "options": ["O(m*n)", "O(m+n)", "O(log n)", "O(n^2)"], "correct_index": 1, "explanation": "Knut-Morris-Pratt (KMP) algoritmining vaqt murakkabligi O(m+n) ga teng, bu yerda n - matn uzunligi, m - qidirilayotgan qismiy satr uzunligi. Bu uni primitiv algoritmga nisbatan ancha samarali qiladi."}, {"question": "QoвЂshnilik matritsasi bilan berilgan grafda BFS ning vaqt murakkabligi qanday?", "options": ["O(E)", "O(log V)", "O(V^2)", "O(V + E)"], "correct_index": 2, "explanation": "Qo'shnilik matritsasi bilan berilgan grafda BFS ning vaqt murakkabligi O(V^2) ga teng, chunki har bir tugun uchun matritsaning barcha V ustunlari tekshiriladi."}, {"question": "Hisoblash geometriyasi nima?", "options": ["Kompyuter grafikasi bilan bog'liq bo'lmagan soha", "Faqat 2D shakllarni o'rganadigan soha", "Geometrik muammolarni hal qilish uchun algoritmlarni o'rganadigan soha", "Faqat chiziqlar va doiralarni o'rganadigan soha"], "correct_index": 2, "explanation": "Hisoblash geometriyasi - bu geometrik muammolarni hal qilish uchun algoritmlarni ishlab chiqish va tahlil qilish bilan shug'ullanadigan informatika sohasi."}, {"question": "Matn muharrirlaridagi qaysi funksiya satrlardan qismiy satrlarni qidirishga misol boвЂladi?", "options": ["Matnni saqlash", "Matnni chop etish", "\"Topish va almashtirish\" (Find and Replace) funksiyasi", "Matnni formatlash"], "correct_index": 2, "explanation": "Matn muharrirlaridagi \"Topish va almashtirish\" (Find and Replace) funksiyasi satrlardan qismiy satrlarni qidirishga (va keyin almashtirishga) yorqin misol bo'la oladi."}, {"question": "Binar uyumdan ildiz (root) element o'chirilganda, uning o'rniga vaqtincha qaysi element qo'yiladi?", "options": ["Massivning oxirgi elementi", "Eng katta element", "Tasodifiy element", "Eng kichik element"], "correct_index": 0, "explanation": "Binar uyumdan ildiz element o'chirilganda, uyumning to'liq binar daraxt xossasini saqlash uchun massivning oxirgi elementi ildizga vaqtincha qo'yiladi, so'ngra 'Heapify-down' amali bajariladi."}, {"question": "OgвЂirlikli graf nimalarni ifodalashi mumkin?", "options": ["Masofa, vaqt, narx yoki boshqa qiymatlarni", "Faqat masofani", "Faqat yo'nalishni", "Faqat narxni"], "correct_index": 0, "explanation": "Og'irlikli grafdagi qirralarning og'irliklari masofa, vaqt, narx, o'tkazish qobiliyati kabi turli xil qiymatlarni ifodalashi mumkin."}, {"question": "Max-Heap (Maksimal uyum) sharti nima?", "options": ["Har bir ota tugun o'z farzandlaridan kichik bo'lishi kerak", "Barcha barg tugunlari bir xil sathda bo'lishi kerak", "Daraxt muvozanatlangan bo'lishi kerak", "Har bir ota tugun o'z farzandlaridan katta yoki teng bo'lishi kerak"], "correct_index": 3, "explanation": "Max-Heap sharti shundan iboratki, har bir ota tugun o'z farzandlaridan katta yoki teng bo'lishi kerak. Natijada, eng katta element har doim ildizda joylashadi."}, {"question": "Quyidagilardan qaysi biri xesh funksiyaga misol boвЂladi?", "options": ["f(x) = x * x", "f(x) = x % M (M - jadval hajmi)", "f(x) = log(x)", "f(x) = x + 1"], "correct_index": 1, "explanation": "f(x) = x % M (M - jadval hajmi) - bu oddiy xesh funksiyaga misol bo'lib, kalitni jadval hajmi bo'yicha qoldiq olish orqali indeksga aylantiradi."}, {"question": "BFS algoritmi qaysi maвЂ™lumot tuzilmasiga asoslanadi?", "options": ["Stek", "Daraxt", "Navbat", "Mas   єmentdan iborat int (4 bayt) toifali massiv berilgan. U xotiradan necha MB (mega bayt) joy oladi?", "options": ["16 MB", "2 MB", "8 MB", "4 MB"], "correct_index": 2, "explanation": "2 million element * 4 bayt/element = 8,000,000 bayt. 8,000,000 bayt / (1024 * 1024) bayt/MB в‰€ 7.63 MB. Eng yaqin javob 8 MB."}, {"question": "OgвЂirlikli graf nima?", "options": ["Qirralari og'irlik (qiymat) bilan bog'langan graf", "Faqat bitta tuguni bo'lgan graf", "Hech qanday qirrasi bo'lmagan graf", "Yo'naltirilmagan graf"], "correct_index": 0, "explanation": "Og'irlikli graf (Weighted Graph) - bu har bir qirrasi ma'lum bir og'irlik (qiymat, masofa, narx va hokazo) bilan bog'langan graf."}, {"question": "Tez saralash (Quick Sort) algoritmining vaqt murakkabligi eng yaxshi holatda nimaga teng?", "options": ["O(n log n)", "O(n)", "O(n^2)", "O(log n)"], "correct_index": 0, "explanation": "Quick Sort algoritmining eng yaxshi holatdagi vaqt murakkabligi ham O(n log n) ga teng, bu pivotning har safar massivni teng ikkiga bo'lishi bilan yuzaga keladi."}, {"question": "ToвЂliq grafda tugunlar soniga koвЂra qirralar sonini topish formulasi keltirilgan javobni belgilang.", "options": ["n - 1", "n * (n - 1) / 2", "n^2", "n * (n + 1) / 2"], "correct_index": 1, "explanation": "To'liq grafda n ta tugun bo'lsa, qirralar sonini topish formulasi n * (n - 1) / 2."}, {"question": "Quyidagi algoritmlardan qaysi biri hozirgi kunda xavfsiz emas deb hisoblanadi?", "options": ["SHA-3", "bcrypt", "SHA-256", "MD5"], "correct_index": 3, "explanation": "MD5 algoritmi kolliziya hujumlariga zaif bo'lganligi sababli, hozirgi kunda xavfsizlik maqsadlarida (ayniqsa, parollarni xeshlashda) xavfsiz emas deb hisoblanadi."}, {"question": "YoвЂnaltirilmagan grafda qirra nimani bildiradi?", "options": ["Ikki tugun orasidagi ikki tomonlama bog'lanishni", "Tugunning o'ziga bog'lanishini", "Faqat bir tomonlama bog'lanishni", "Grafning og'irligini"], "correct_index": 0, "explanation": "Yo'naltirilmagan grafda qirra ikki tugun orasidagi ikki tomonlama bog'lanishni bildiradi, ya'ni A dan B ga yo'l bo'lsa, B dan A ga ham yo'l bor."}, {"question": "Stek yordamida qaysi masala samarali hal qilinadi?", "options": ["Tarmoq marshrutizatsiyasi", "Ma'lumotlar bazasini boshqarish", "Brauzerning orqaga qaytish funksiyasi", "Fayl tizimini boshqarish"], "correct_index": 2, "explanation": "Stek brauzerning orqaga qaytish (Back) funksiyasi, ifodalarni baholash va rekursiv funksiyalarni boshqarish kabi masalalarni samarali hal qilishda ishlatiladi."}, {"question": "AVL daraxtda Balance Factor (BF) qiymati qanday hisoblab topiladi?", "options": ["Chap farzand balandligi - O'ng farzand balandligi", "O'ng farzand balandligi - Chap farzand balandligi", "Tugunning farzandlari soni", "Tugunning o'z balandligi"], "correct_index": 0, "explanation": "AVL daraxtida Balance Factor (BF) odatda Chap farzand balandligi - O'ng farzand balandligi formulasi bilan hisoblanadi."}, {"question": "Agar grafdagi F tugun A, B, C va D tugunlar bilan qirralar orqali tutashgan boвЂlsa F tugunning darajasi nechchiga teng?", "options": ["3", "5", "2", "4"], "correct_index": 3, "explanation": "F tugun A, B, C va D tugunlar bilan tutashgan bo'lsa, unga 4 ta qirra tutashgan, shuning uchun F tugunning darajasi 4 ga teng."}, {"question": "YoвЂnaltirilgan graf nima?", "options": ["Og'irlikli graf", "Qirralari yo'nalishga ega bo'lmagan graf", "Barcha tugunlari bir-biriga bog'langan graf", "Qirralari faqat bir tomonlama yo'nalishga ega bo'lgan graf"], "correct_index": 3, "explanation": "Yo'naltirilgan graf (Directed Graph) - bu qirralari ma'lum bir yo'nalishga ega bo'lgan graf, ya'ni A dan B ga qirra bo'lsa, B dan A ga qirra bo'lishi shart emas."}, {"question": "Qanday tugunlarni biz aka-uka tugunlar (ing. siblings) deb ataymiz?", "options": ["Bir xil balandlikdagi tugunlar", "Bir xil ota-onaga ega bo'lgan tugunlar", "Bir xil farzandga ega bo'lgan tugunlar", "Bir xil qiymatga ega bo'lgan tugunlar"], "correct_index": 1, "explanation": "Aka-uka tugunlar (siblings) - bu bir xil ota-onaga ega bo'lgan tugunlar."}, {"question":    » E nimani bildiradi?", "options": ["Grafning turi", "Grafning hajmi", "Qirralar (chekkalar) to'plami", "Tugunlar to'plami"], "correct_index": 2, "explanation": "Graf G = (V, E) da E qirralar (edges) to'plamini bildiradi."}, {"question": "Grafda BFS va DFS algoritmlarining xotira murakkabligi nimaga bogвЂliq?", "options": ["Grafning tuzilishiga va tugunlar soniga", "Dasturlash tiliga", "Faqat qirralar soniga", "Faqat tugunlar soniga"], "correct_index": 0, "explanation": "BFS va DFS algoritmlarining xotira murakkabligi grafning tuzilishiga (masalan, daraxtning balandligi DFS uchun, eng keng sath BFS uchun) va tugunlar soniga bog'liq. Umumiy holda, O(V) yoki O(V+E) bo'lishi mumkin."}, {"question": "Ikkilik qidiruv daraxtida (Binary Search Tree) qidirish murakkabligi o'rtacha holatda qanday?", "options": ["O(n log n)", "O(log n)", "O(1)", "O(n)"], "correct_index": 1, "explanation": "Ikkilik qidiruv daraxtida (BST) o'rtacha holatda qidirish murakkabligi O(log n) ga teng, bu daraxtning muvozanatlanganligini bildiradi."}, {"question": "OвЂlchami oвЂzgaradigan massiv qanday nomlanadi?", "options": ["Sabit massiv", "Bir o'lchamli massiv", "Statik massiv", "Dinamik massiv"], "correct_index": 3, "explanation": "O'lchami dastur ishlashi davomida o'zgarishi mumkin bo'lgan massiv dinamik massiv deb ataladi (masalan, C++ dagi `std::vector`)."}, {"question": "Agar daraxtda ikki tugun qirra orqali bogвЂlangan boвЂlsa, pastdagi tugun qanday nomlanadi?", "options": ["Farzand", "Ota-ona", "Ildiz", "Barg"], "correct_index": 0, "explanation": "Agar ikki tugun qirra orqali bog'langan bo'lsa, pastdagi tugun 'Farzand' (Child) deb ataladi."}, {"question": "AVL daraxti qanday turdagi daraxt hisoblanadi?", "options": ["Muvozanatlanmagan ikkilik qidiruv daraxti", "O'z-o'zidan muvozanatlashadigan ikkilik qidiruv daraxti", "Oddiy ikkilik daraxt", "To'liq binar daraxt"], "correct_index": 1, "explanation": "AVL daraxti - bu o'z-o'zidan muvozanatlashadigan ikkilik qidiruv daraxti (Self-Balancing Binary Search Tree) bo'lib, u har bir tugun uchun chap va o'ng kichik daraxtlar balandliklari farqini ma'lum bir chegarada ushlab turadi."}, {"question": "Binar uyumda eng katta (Max-Heap bo'lsa) yoki eng kichik (Min-Heap) element har doim qayerda bo'ladi?", "options": ["Ildiz tugunda", "Eng o'ng bargda", "Eng chap bargda", "Daraxtning o'rtasida"], "correct_index": 0, "explanation": "Binar uyumning xossasiga ko'ra, eng katta element (Max-Heapda) yoki eng kichik element (Min-Heapda) har doim ildiz tugunda joylashgan bo'ladi."}, {"question": "Daraxtda avlod (descendant) deb qaysi tugunlarga aytiladi?", "options": ["Tugunning aka-ukalari", "Tugunning farzandlari va ularning farzandlari (ya'ni, undan pastdagi barcha tugunlar)", "Tugunning ota-onasi", "Tugunning ildizi"], "correct_index": 1, "explanation": "Daraxtda avlod (descendant) - bu tanlangan tugunning farzandlari va ularning farzandlari, ya'ni undan pastdagi barcha tugunlar."}, {"question": "Sath yoki chuqurlik (ing. level yoki depth) nima?", "options": ["Tugunning ildizdan uzoqligi (qirralar soni)", "Tugunning farzandlari soni", "Daraxtdagi barg tugunlar soni", "Tugunning balandligi"], "correct_index": 0, "explanation": "Tugunning sathi (level) yoki chuqurligi (depth) - bu ildizdan shu tugungacha bo'lgan yo'l uzunligi (qirralar soni). Ildizning sathi 0 ga teng."}, {"question": "Qanday daraxtni biz Binar daraxt deb ataymiz?", "options": ["Har bir tugunida maksimal 2 ta farzand bo'lgan daraxt", "Faqat bitta farzandi bo'lgan daraxt", "Barg tugunlari bo'lmagan daraxt", "Har bir tugunida 3 tadan ortiq farzand bo'lmagan daraxt"], "correct_index": 0, "explanation": "Binar daraxt - bu har bir tugunida maksimal 2 ta farzand (chap va o'ng) bo'lgan daraxt."}, {"question": "Hisoblash geometriyasida fazodagi nuqta qanday ifodalanadi?", "options": ["Faqat bitta koordinata bilan", "Vektor bilan", "Ikkita koordinata (x, y) bilan", "Uchta koordinata (x, y, z) bilan"], "correct_index": 3, "explanation": "Hisoblash geometriyasida fazodagi nuqta uchta koordinata (x, y, z) bilan ifodalanadi."}, {"question": "2 mln ta ele
   
