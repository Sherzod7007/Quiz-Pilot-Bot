stion": "Aniq integral tushunchasi nimaga asoslanib kiritiladi?", "options": ["Riemann yig'indisi limiti", "Differensial tushunchasi", "Boshlang'ich funksiya", "Hosila tushunchasi"], "correct_index": 0, "explanation": "Aniq integral funksiya grafigi ostidagi yuzani topish uchun Riemann yig'indilarining limiti sifatida kiritiladi."}, {"question": "Funksional qatorning umumiy koвЂrinishi toвЂgвЂri berilgan javobni toping", "options": ["a1 + a2 + ... + an", "в€« f(x)dx", "f1(x) + f2(x) + ... + fn(x) + ...", "f(x) = ОЈ an * x^n"], "correct_index": 2, "explanation": "Funksional qatorning umumiy ko'rinishi f1(x) + f2(x) + ... + fn(x) + ... yoki ОЈ fn(x) dir."}, {"question": "e^x funksiyaning Makloren qatori qaysi?", "options": ["ОЈ x^n", "ОЈ (x^n / n!)", "ОЈ ((-1)^n * x^(2n) / (2n)!)", "ОЈ ((-1)^n * x^(2n+1) / (2n+1)!)"], "correct_index": 1, "explanation": "e^x funksiyaning Makloren qatori 1 + x + x^2/2! + x^3/3! + ... = ОЈ (x^n / n!) dir."}, {"question": "Nyuton вЂ“Leybnits formulasi amaliy jihatdan nimani yengillashtiradi?", "options": ["Differensial tenglamalarni yechishni", "Aniq integralni Riemann yig'indisi limiti orqali hisoblashni", "Aniq integralni boshlang'ich funksiya orqali hisoblashni", "Funksiyaning uzluksizligini tekshirishni"], "correct_index": 2, "explanation": "Nyuton-Leybnits formulasi aniq integralni Riemann yig'indisi limitini hisoblamasdan, boshlang'ich funksiya yordamida tez va oson hisoblash imkonini beradi."}, {"question": "e^x qatori nima sababdan qulay?", "options": ["U faqat juft darajalarni o'z ichiga oladi", "Uning yaqinlashish radiusi chekli", "U faqat toq darajalarni o'z ichiga oladi", "Uning hosilasi va integrali o'ziga teng"], "correct_index": 3, "explanation": "e^x funksiyasining hosilasi ham, integrali ham o'ziga teng bo'lganligi sababli, uning qatori bilan ishlash juda qulay."}, {"question": "Agar z = x + y^3 boвЂlsa, z'y nimaga teng?", "options": ["x", "3y^2", "1", "x + 3y^2"], "correct_index": 1, "explanation": "z = x + y^3 funksiyasining y bo'yicha xususiy hosilasi (x ni o'zgarmas deb hisoblab) z'y = 3y^2 ga teng."}, {"question": "Agar funksiya [a, b] da ishorasini oвЂzgartirsa, yuzani topish uchun qaysi integral ishlatiladi?", "options": ["в€«a^b |f(x)|dx", "в€«a^b f(x)dx", "в€«a^b -f(x)dx", "в€«a^b f'(x)dx"    ], "correct_index": 0, "explanation": "Agar funksiya ishorasini o'zgartirsa, yuzani topish uchun funksiyaning modulidan integral olinadi: в€«a^b |f(x)|dx."}, {"question": "Qismiy yigвЂindi Sn qanday aniqlanadi?", "options": ["Qatorning barcha hadlari yig'indisi", "Qatorning limiti", "Qatorning dastlabki n ta hadining yig'indisi", "Qatorning umumiy hadi"], "correct_index": 2, "explanation": "Qismiy yig'indi Sn deb qatorning dastlabki n ta hadining yig'indisiga aytiladi: Sn = a1 + a2 + ... + an."}, {"question": "Ikki oвЂzgaruvchili funksiyaning nechta birinchi tartibli xususiy hosilasi bor?", "options": ["Ikkita", "Uchta", "Bitta", "To'rtta"], "correct_index": 0, "explanation": "Ikki o'zgaruvchili f(x, y) funksiyasining ikkita birinchi tartibli xususiy hosilasi bor: в€‚f/в€‚x va в€‚f/в€‚y."}, {"question": "в€«1^3 2x dx integralni toping.", "options": ["6", "8", "10", "4"], "correct_index": 1, "explanation": "в€«1^3 2x dx = [x^2]1^3 = 3^2 - 1^2 = 9 - 1 = 8."}, {"question": "Uch oвЂzgaruvchili funksiya qanday yoziladi?", "options": ["y = f(x)", "w = f(x, y, z)", "f(x, y)", "z = f(x, y)"], "correct_index": 1, "explanation": "Uch o'zgaruvchili funksiya w = f(x, y, z) ko'rinishida yoziladi."}, {"question": "OвЂrta qiymat haqidagi teorema qaysi shart bajarilganda qoвЂllaniladi?", "options": ["Funksiya juft bo'lganda", "Funksiya uzluksiz bo'lganda", "Funksiya differensiallanuvchi bo'lganda", "Funksiya monoton bo'lganda"], "correct_index": 1, "explanation": "O'rta qiymat haqidagi teorema funksiya integrallash oralig'ida uzluksiz bo'lganda qo'llaniladi."}, {"question": "Ikki egri chiziq orasidagi yuzani topish formulasi qaysi?", "options": ["S = в€«a^b f(x)g(x)dx", "S = в€«a^b (f(x) + g(x))dx", "S = в€«a^b (f(x) - g(x))^2 dx", "S = в€«a^b (f(x) - g(x))dx, agar f(x) в‰Ґ g(x) bo'lsa"], "correct_index": 3, "explanation": "Ikki egri chiziq y = f(x) va y = g(x) orasidagi yuza, agar f(x) в‰Ґ g(x) bo'lsa, S = в€«a^b (f(x) - g(x))dx formula bilan topiladi."}, {"question": "Uch oвЂzgaruvchili funksiya qaysi fazoda aniqlanadi?", "options": ["Uch o'lchovli fazoda", "To'rt o'lchovli fazoda", "Bir o'lchovli fazoda (sonlar o'qida)", "Ikki o'lchovli fazoda (tekislikda)"], "correct_index": 0, "explanation": "Uch o'zgaruvchili funksiya (x, y, z) nuqtalari uchun aniqlanganligi sababli, uch o'lchovli fazoda aniqlanadi."}, {"question": "Aniq integral uchun toвЂgвЂri tenglikni koвЂrsating", "options": ["в€«a^b f(x)dx = в€«a^b f(t)dt", "в€«a^b f(x)dx = f(b) - f(a)", "в€«a^b f(x)dx = -в€«b^a f(x)dx", "в€«a^b f(x)dx = 0, agar a=b bo'lsa"], "correct_index": 0, "explanation": "Aniq integralning qiymati integrallash o'zgaruvchisining nomiga bog'liq emas, ya'ni в€«a^b f(x)dx = в€«a^b f(t)dt."}, {"question": "Funksiyaning toвЂla differensiali qaysi harf bilan belgilanadi?", "options": ["dx", "О”z", "dz", "dy"], "correct_index": 2, "explanation": "Funksiyaning to'la differensiali dz bilan belgilanadi."}, {"question": "Umumiy hadi an = (2n-1)/n boвЂlgan qatorni qaysi alomat yordamida yaqinlashuvchilikka tekshirish qulay?", "options": ["Dalamber alomati", "Koshining ildiz alomati", "Integral alomat", "Zaruriy shart"], "correct_index": 3, "explanation": "Qatorning umumiy hadi an = (2n-1)/n ning limiti lim(nв†’в€ћ) (2n-1)/n = 2 ga teng. Bu nolga teng emas, shuning uchun qator uzoqlashuvchi. Zaruriy shartni tekshirish eng qulay."}, {"question": "Yaqinlashuvchi qator uchun zaruriy shart qanday?", "options": ["lim(nв†’в€ћ) an mavjud emas", "lim(nв†’в€ћ) an = 0", "lim(nв†’в€ћ) an = 1", "lim(nв†’в€ћ) an = в€ћ"], "correct_index": 1, "explanation": "Agar qator yaqinlashuvchi bo'lsa, uning umumiy hadi nolga intilishi shart: lim(nв†’в€ћ) an = 0. Bu zaruriy shart, ammo yetarli emas."}, {"question": "Taqqoslash alomati qaysi shartda qoвЂllaniladi?", "options": ["Faqat musbat hadli qatorlar uchun", "Barcha turdagi qatorlar uchun", "Faqat manfiy hadli qatorlar uchun", "Faqat ishora almashinuvchi qatorlar uchun"], "correct_index": 0, "explanation": "Taqqoslash alomatlari asosan musbat hadli qatorlarning yaqinlashuvchanligini tekshirish uchun qo'llaniladi."}]}j›™©
