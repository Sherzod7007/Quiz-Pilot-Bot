ion": "Umumlashgan taqqoslash alomati (limitli taqqoslash alomati) lim(nв†’в€ћ) (an / bn) = L ni hisoblashga asoslangan. Agar L chekli va noldan farqli bo'lsa, ikkala qator bir xil yaqinlashuvchanlikka ega bo'ladi."}, {"question": "Agar ОЈ an va ОЈ bn yaqinlashuvchi boвЂlsa, ОЈ (an + bn) qanday?", "options": ["Shartli yaqinlashuvchi", "Uzoqlashuvchi", "Absolyut yaqinlashuvchi", "Yaqinlashuvchi"], "correct_index": 3, "explanation": "Agar ikkita qator yaqinlashuvchi bo'lsa, ularning yig'indisi ham yaqinlashuvchi bo'ladi."}, {"question": "Agar f(x, y) = x^2 + y^2 boвЂlsa, f(1,2) ni toping.", "options": ["3", "5", "9", "6"], "correct_index": 1, "explanation": "f(1,2) = 1^2 + 2^2 = 1 + 4 = 5."}, {"question": "в€«a^в€ћ f(x)dx xosmas integral absolyut yaqinlashuvchi deyiladi, agar:", "options": ["в€«a^в€ћ f(x)dx uzoqlashuvchi bo'lsa", "в€«a^в€ћ f(x)dx yaqinlashuvchi bo'lsa", "в€«a^в€ћ |f(x)|dx uzoqlashuvchi bo'lsa", "в€«a^в€ћ |f(x)|dx yaqinlashuvchi bo'lsa"], "correct_index": 3, "explanation": "Xosmas integral в€«a^в€ћ f(x)dx absolyut yaqinlashuvchi deyiladi, agar в€«a^в€ћ |f(x)|dx integral yaqinlashuvchi bo'lsa."}, {"question": "ОЈ (x^n / n!) qatorni yaqinlashishga tekshiring.", "options": ["Hech qachon yaqinlashmaydi", "Barcha x lar uchun yaqinlashadi", "Faqat x=0 da yaqinlashadi", "Faqat x=1 da yaqinlashadi"], "correct_index": 1, "explanation": "Bu qator e^x ning Teylor qatori bo'lib, Dalamber alomati yordamida tekshirilganda, u barcha x haqiqiy sonlar uchun yaqinlashuvchi ekanligi aniqlanadi."}, {"question": "Shartli yaqinlashuvchi xosmas integral qaysi holatda yuzaga keladi?", "options": ["Agar integral yaqinlashuvchi bo'lsa va uning moduli ham yaqinlashuvchi bo'lsa", "Agar integral uzoqlashuvchi bo'lsa", "Agar integral yaqinlashuvchi bo'lsa, lekin uning moduli uzoqlashuvchi bo'lsa", "Agar integralning qiymati nolga teng bo'lsa"], "correct_index": 2, "explanation": "Shartli yaqinlashuvchi xosmas integral, agar integralning o'zi yaqinlashuvchi bo'lsa, lekin uning moduli uzoqlashuvchi bo'lsa, yuzaga keladi."}, {"question": "Quyidagi qaysi holatda xosmas integral yaqinlashuvchi deyiladi?", "options": ["Agar uning qiymati chekli songa teng bo'lsa", "Agar integral ostidagi funksiya uzluksiz bo'lsa", "Agar uni hisoblash mumkin bo'lmasa", "Agar uning qiy  Umati cheksizlikka intilsa"], "correct_index": 0, "explanation": "Xosmas integral, agar uning limiti chekli songa teng bo'lsa, yaqinlashuvchi deyiladi."}, {"question": "в€«0^2 x^2 dx integralning qiymati nimaga teng?", "options": ["8/3", "4/3", "6", "2"], "correct_index": 0, "explanation": "в€«0^2 x^2 dx = [x^3/3]0^2 = 2^3/3 - 0^3/3 = 8/3."}, {"question": "Funksiyaning toвЂla differensiali qaysi harf bilan belgilanadi?", "options": ["О”z", "dx", "dz", "dy"], "correct_index": 2, "explanation": "Funksiyaning to'la differensiali dz bilan belgilanadi."}, {"question": "Absolyut yaqinlashuvchi xosmas integral nimani anglatadi?", "options": ["U har doim uzoqlashuvchi bo'ladi", "U faqat musbat qiymatlarni qabul qiladi", "Uning moduli uzoqlashuvchi bo'ladi", "Uning moduli ham yaqinlashuvchi bo'ladi"], "correct_index": 3, "explanation": "Absolyut yaqinlashuvchi xosmas integral, uning o'zi ham, uning moduli ham yaqinlashuvchi bo'lishini anglatadi."}, {"question": "y = f(x) в‰Ґ 0 boвЂlsa, [a, b] kesmadagi yuzani hisoblash formulasi qaysi?", "options": ["S = в€«a^b f'(x)dx", "S = в€«a^b f(x)dx", "S = в€«a^b |f(x)|dx", "S = в€«a^b -f(x)dx"], "correct_index": 1, "explanation": "Agar funksiya manfiy bo'lmasa (f(x) в‰Ґ 0), egri chiziq ostidagi yuza S = в€«a^b f(x)dx formula bilan hisoblanadi."}, {"question": "Agar funksiya nuqtada aniqlanmagan boвЂlsa, bu nuqta qanday ataladi?", "options": ["Uzilish nuqtasi", "Uzluksizlik nuqtasi", "Kritik nuqta", "Ekstremum nuqtasi"], "correct_index": 0, "explanation": "Agar funksiya biror nuqtada aniqlanmagan bo'lsa yoki uning limiti funksiya qiymatiga teng bo'lmasa, bu nuqta uzilish nuqtasi deyiladi."}, {"question": "Nyuton -Leybnits formulasi qaysi ifoda bil