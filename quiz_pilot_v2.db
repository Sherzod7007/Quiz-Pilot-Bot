   F F                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ‚™t Q„±Sq_74f905e4fcff4ff4842d2a6d60ec3e35A{"variant": "A", "quizzes": [{"question": "Funksiyaning [a, b] kesmadagi oвЂrtacha qiymati qaysi formula bilan aniqlanadi?", "options": ["f_o'rtacha = в€«a^b f(x)dx", "f_o'rtacha = (f(a) + f(b))/2", "f_o'rtacha = (1/(b-a)) в€«a^b f(x)dx", "f_o'rtacha = f'(c)"], "correct_index": 2, "explanation": "Funksiyaning [a, b] kesmadagi o'rtacha qiymati (1/(b-a)) в€«a^b f(x)dx formulasi bilan aniqlanadi."}, {"question": "в€«0^2 cos(x) dx integralni toping.", "options": ["cos(2)", "sin(2)", "sin(2) - sin(0)", "1 - cos(2)"], "correct_index": 1, "explanation": "в€«0^2 cos(x) dx = [sin(x)]0^2 = sin(2) - sin(0) = sin(2) - 0 = sin(2)."}, {"question": "Xosmas integral tushunchasi nimani umumlashtiradi?", "options": ["Hosila tushunchasini", "Differensial tushunchasini", "Limit tushunchasini", "Aniq integral tushunchasini"], "correct_index": 3, "explanation": "Xosmas integral tushunchasi integrallash chegaralari cheksiz bo'lgan yoki integral ostidagi funksiya uzilishga ega bo'lgan holatlar uchun aniq integral tushunchasini umumlashtiradi."}, {"question": "ОЈ an * (x - x0)^n qator xususiy holda x0 = 0 boвЂlsa qanday koвЂrinishda boвЂladi?", "options": ["ОЈ (x - x0)", "ОЈ an * x^n", "ОЈ an", "ОЈ an * x0^n"], "correct_index": 1, "explanation": "Agar x0 = 0 bo'lsa, ОЈ an * (x - x0)^n qator ОЈ an * x^n ko'rinishini oladi, bu Makloren qatori deb ham ataladi."}, {"question": "ToвЂla differensial formulasini koвЂrsating.", "options": ["dz = (в€‚z/в€‚x)dx", "dz = dx + dy", "dz = (в€‚z/в€‚x)dx + (в€‚z/в€‚y)dy", "dz = (в€‚z/в€‚y)dy"], "correct_index": 2, "explanation": "Ikki o'zgaruvchili funksiyaning to'la differensiali dz = (в€‚z/в€‚x)dx + (в€‚z/в€‚y)dy formula bilan beriladi."}, {"question": "II -tur xosmas integralning asosiy belgisi nimada?", "options": ["Integrallash oralig'i cheksiz", "Integralning qiymati cheksiz", "Integral ostidagi funksiya integrallash oralig'ida uzilishga ega", "Integralning qiymati nolga teng"], "correct_index": 2, "explanation": "II-tur xosmas integralning asosiy belgisi integral ostidagi funksiyaning integrallash oralig'ida uzilishga ega bo'lishidir."}, {"question": "Agar z = x + y^3 boвЂlsa, z'y nimaga teng?", "options": ["1", "x", "x + 3y^2", "3y^2"], "correct_index": 3, "explanation": "z = x + y^3 funksiyasining y bo'yicha xususiy hosilasi (x ni o'zgarmas deb hisoblab) z'y = 3y^2 ga teng."}, {"question": "Uzluksiz funksiyalarning [a, b] kesmada kuchaytirilgan funksional qatorining yigвЂindisi ham bu kesmada ____________ boвЂladi.", "options": ["Chegaralanmagan", "Differensiallanuvchi", "Monoton", "Uzluksiz"], "correct_index": 3, "explanation": "Agar funksional qatorning hadlari uzluksiz bo'lsa va qator bir tekis yaqinlashsa, uning yig'indisi ham uzluksiz bo'ladi."}, {"question": "Taqqoslash alomati qaysi shartda qoвЂllaniladi?", "options": ["Faqat ishora almashinuvchi qatorlar uchun", "Barcha turdagi qatorlar uchun", "Faqat manfiy hadli qatorlar uchun", "Faqat musbat hadli qatorlar uchun"], "correct_index": 3, "explanation": "Taqqoslash alomatlari asosan musbat hadli qatorlarning yaqinlashuvchanligini tekshirish uchun qo'llaniladi."}, {"question": "Agar Teylor qatorida x0 = 0 deb olinsa, funksiyaning x ning darajalari boвЂyicha qaysi        doira", "Barcha nuqtalarni o'z ichiga olgan eng kichik qavariq ko'pburchak", "Faqat uchta nuqtadan iborat shakl", "Nuqtalarni birlashtiruvchi chiziq"], "correct_index": 1, "explanation": "Qavariq qobiq - bu berilgan nuqtalar to'plamini o'z ichiga olgan eng kichik qavariq ko'pburchak."}, {"question": "Knut-Morris-Pratt (KMP) algoritmining murakkabligi qaysi javobda keltirilgan?", "options": ["O(m*n)", "O(m+n)", "O(log n)", "O(n^2)"], "correct_index": 1, "explanation": "KMP algoritmining vaqt murakkabligi O(m+n) dir, bu yerda n - matn uzunligi, m - naqsh uzunligi."}, {"question": "Binar uyumdan ildiz (root) element o'chirilganda, uning o'rniga vaqtincha qaysi element qo'yiladi?", "options": ["Oxirgi element", "Eng kichik element", "Eng katta element", "Birinchi element"], "correct_index": 0, "explanation": "Ildiz element o'chirilganda, uyumning oxirgi elementi ildizga ko'chiriladi va keyin uyum xususiyatini tiklash uchun pastga 'tushiriladi' (heapify-down)."}, {"question": "Virus signaturasi deganda nima tushuniladi?", "options": ["Ma'lum bir virusga xos bo'lgan noyob baytlar ketma-ketligi", "Operatsion tizim fayli", "Har qanday dastur kodi", "Virusning nomi"], "correct_index": 0, "explanation": "Virus signaturasi - bu ma'lum bir virusga xos bo'lgan noyob baytlar ketma-ketligi yoki kod qismi bo'lib, antivirus dasturlari uni aniqlash uchun foydalanadi."}, {"question": "Binar uyumda i-indeksdagi tugunning ota tuguni (parent) qaysi formula bilan topiladi?", "options": ["i-1", "2*i + 1", "2*i + 2", "(i-1)/2"], "correct_index": 3, "explanation": "Massivda saqlangan binar uyumda 0-indeksdan boshlansa, 'i' indeksdagi tugunning ota tuguni '(i-1)/2' (butun qismi) formulasi bilan topiladi."}, {"question": "Qismiy satr nima?", "options": ["Butun bir satr", "Boshqa bir katta satrning bir qismi bo'lgan satr", "Faqat raqamlardan iborat satr", "Bitta belgi"], "correct_index": 1, "explanation": "Qismiy satr - bu boshqa bir katta satrning bir qismi bo'lgan satr."}, {"question": "Qismiy satr yana qanday nom bilan ataladi?", "options": ["Belgilar to'plami", "Naqsh", "Matn", "Asosiy satr"], "correct_index": 1, "explanation": "Qismiy satr ko'pincha 'naqsh' (pattern) deb ham ataladi, ayniqsa satrlarni qidirish algoritmlarida."}, {"question": "MD5 algoritmining asosiy kamchiligi nimada?", "options": ["Faqat kichik ma'lumotlar uchun ishlashi", "Kolliziya hujumlariga zaifligi", "Katta xesh qiymatlarini hosil qilishi", "Juda sekin ishlashi"], "correct_index": 1, "explanation": "MD5 algoritmining asosiy kamchiligi - kolliziya hujumlariga zaifligi, ya'ni bir xil xesh qiymatini beradigan ikkita turli xil ma'lumotni topish mumkinligi."}, {"question": "Heap-Sort algoritmining o'rtacha va eng yomon holatdagi vaqt murakkabligi qanday?", "options": ["O(n^2)", "O(n)", "O(n log n)", "O(log n)"], "correct_index": 2, "explanation": "Heap-Sort algoritmining o'rtacha va eng yomon holatdagi vaqt murakkabligi O(n log n) dir."}, {"question": "Quyidagi tuzilmalardan qaysi biri ichki ravishda xesh funksiyadan foydalanadi?", "options": ["std::vector", "std::map", "std::list", "std::unordered_map"], "correct_index": 3, "explanation": "`std::unordered_map` va `std::unordered_set` kabi xeshga asoslangan konteynerlar ichki ravishda xesh funksiyadan foydalanadi."}, {"question": "Double Hashing nima ishlatadi?", "options": ["Bog'langan ro'yxatlar", "Ikki xesh funksiya", "Faqat bitta xesh funksiya", "Massivlar"], "correct_index": 1, "explanation": "Double Hashing ochiq manzillashning bir turi bo'lib, ikkinchi xesh funksiyadan foydalanib, kolliziya yuz berganda keyingi bo'sh joyni topish uchun qadam hajmini aniqlaydi."}, {"question": "Quyidagilardan qaysi biri ideal xesh funksiyaning muhim xususiyati hisoblanadi?", "options": ["Har doim bir xil xesh qiymatini berishi", "Kolliziyalarni minimallashtirish va xesh qiymatlarini bir tekis taqsimlash", "Faqatgina katta kalitlar uchun ishlashi", "Juda sekin ishlashi"], "correct_index": 1, "explanation": "Ideal xesh funksiya kolliziyalarni minimallashtirishi va xesh qiymatlarini jadval bo'ylab bir tekis taqsimlashi kerak."}]}j›Ђy    a?",
