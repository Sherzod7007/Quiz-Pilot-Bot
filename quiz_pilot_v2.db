Q'‚Єaq_160edda1ca7a4175aecacceb91425eb7nхП)Xorijiy Til 1>{
  "quizzes": [
    {
      "question": "I ___ my homework at the moment.",
      "options": ["am doing", "do", "done", "will do"],
      "correct_index": 0,
      "explanation": "\"at the moment\" is a key phrase indicating an action happening right now, which requires the Present Continuous tense (am doing)."
    },
    {
      "question": "She usually ___ tennis on Saturdays.",
      "options": ["plays", "is playing", "played", "will play"],
      "correct_index": 0,
      "explanation": "\"Usually\" and \"on Saturdays\" indicate a habitual or routine action, which is expressed using the Present Simple tense (plays)."
    },
    {
      "question": "Look! The birds ___.",
      "options": ["are singing", "sing", "sang", "will sing"],
      "correct_index": 0,
      "explanation": "\"Look!\" is an imperative used to draw attention to an action happening at the moment of speaking, requiring the Present Continuous tense (are singing)."
    },
    {
      "question": "They ___ coffee every morning.",
      "options": ["drink", "are drinking", "drank", "will drink"],
      "correct_index": 0,
      "explanation": "\"Every morning\" signifies a regular, habitual action, which is expressed using the Present Simple tense (drink)."
    },
    {
      "question": "He ___ a book right now.",
      "options": ["is reading", "reads", "read", "will read"],
      "correct_index": 0,
      "explanation": "\"Right now\" is a clear indicator for the Present Continuous tense, showing an action in progress (is reading)."
    },
    {
      "question": "We ___ to school by bus every day.",
      "options": ["go", "are going", "went", "will go"],
      "correct_index": 0,
      "explanation": "\"Every day\" denotes a regular, repeated action, thus requiring the Present Simple tense (go)."
    },
    {
      "question": "Why ___ you crying now?",
      "options": ["are", "do", "did", "will"],
      "correct_index": 0,
      "explanation": "\"Now\" indicates an action in progress, so the Present Continuous (are + -ing form) is needed for the question."
    },
    {
      "question": "My mother ___ dinner at the moment.",
      "options": ["is cooking", "cooks", "cooked", "will cook"],
      "correct_index": 0,
      "explanation": "\"At the moment\" is a time expression used with the Present Continuous to describe an action happening right now (is cooking)."
    },
    {
      "question": "___ you listen to music every night?",
      "options": ["Do", "Are", "Did", "Will"],
      "correct_index": 0,
      "explanation": "\"Every night\" indicates a regular habit, which requires the auxiliary verb \"Do\" for questions in the Present Simple tense."
    },
    {
      "question": "He ___ like milk.",
      "options": ["doesn'  
    re", "too"], "correct_index": 1, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "I am ___ tall as my father now.", "options": ["more", "too", "less", "as"], "correct_index": 3, "explanation": "\"As...as\" is used to show that two things are equal in some way."}, {"question": "This film is ___ interesting as the book. Both are great.", "options": ["as", "too", "less", "more"], "correct_index": 0, "explanation": "\"As...as\" is used to show that two things are equal in some way. \"Both are great\" confirms equality."}, {"question": "My sister is not ___ old as me. She is younger.", "options": ["as", "too", "more", "less"], "correct_index": 0, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way. \"She is younger\" confirms the inequality."}, {"question": "This phone is ___ expensive as that one. They cost the same.", "options": ["less", "as", "too", "more"], "correct_index": 1, "explanation": "\"As...as\" is used to show that two things are equal in some way. \"They cost the same\" confirms equality."}, {"question": "If you heat ice, it ___ into water.", "options": ["will melt", "melted", "melts", "would melt"], "correct_index": 2, "explanation": "The Zero Conditional describes general truths or scientific facts. Both clauses use the Present Simple tense."}, {"question": "Your cat is ___ beautiful as mine.", "options": ["as", "less", "too", "more"], "correct_index": 0, "explanation": "\"As...as\" is used to show that two things are equal in some way."}, {"question": "Penguins ___ fly, but they are great swimmers.", "options": ["couldn't", "can't", "don't", "won't be able to"], "correct_index": 1, "explanation": "This states a general fact about penguins' present inability, so \"can't\" is the correct modal verb."}, {"question": "He ___ speak three languages now.", "options": ["could", "can", "might", "will be able to"], "correct_index": 1, "explanation": "\"Now\" indicates a present ability, so \"can\" is the correct modal verb."}, {"question": "One day, humans ___ live on Mars.", "options": ["will be able to", "might", "could", "can"], "correct_index": 0, "explanation": "\"One day\" indicates a future ability or possibility, so \"will be able to\" is the most appropriate expression."}, {"question": "My mother ___ dinner at the moment.", "options": ["has cooked", "is cooking", "cooked", "cooks"], "correct_index": 1, "explanation": "\"At the moment\" indicates an action happening now, requiring the Present Continuous tense. For \"my mother\" (she), the auxiliary verb is \"is.\""}, {"question": "The bus is not ___ fast as the train.", "options": ["more", "as", "too", "less"], "correct_index": 1, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "I ___ swim when I was five years old.", "options": ["may", "can", "will be able to", "could"], "correct_index": 3, "explanation": "\"When I was five years old\" indicates a past ability, so \"could\" is the correct modal verb."}, {"question": "They were playing football when it ___ to rain.", "options": ["started", "had started", "was starting", "starts"], "correct_index": 0, "explanation": "\"When\" introduces a shorter, interrupting action in the Past Simple tense that occurs during a longer action in the Past Continuous."}, {"question": "Listen! Someone ___ the piano.", "options": ["played", "is playing", "plays", "has played"], "correct_index": 1, "explanation": "\"Listen!\" is an imperative that signals an action happening at the moment of speaking, requiring the Present Continuous tense. \"Someone\" takes a singular verb."}]}j‹/f                                                                                                                                                                                                                                                                                                                                                                                                                    +ess formal."}, {"question": "Where ___ they live?", "options": ["have", "are", "did", "do"], "correct_index": 3, "explanation": "This asks about a general fact (where they reside), requiring the Present Simple tense. For questions with \"they,\" the auxiliary verb is \"do.\""}, {"question": "While we ___ walking in the park, we saw a beautiful bird.", "options": ["are", "was", "were", "have been"], "correct_index": 2, "explanation": "\"While\" introduces a longer action in the Past Continuous tense. For \"we,\" the auxiliary verb is \"were.\""}, {"question": "He lost his wallet while he ___ shopping.", "options": ["is", "were", "had been", "was"], "correct_index": 3, "explanation": "\"While\" introduces a longer action in the Past Continuous tense. For \"he,\" the auxiliary verb is \"was.\""}, {"question": "My bedroom is ___ big as your bedroom. They are exactly the same size.", "options": ["less", "too", "as", "more"], "correct_index": 2, "explanation": "\"As...as\" is used to show that two things are equal in some way. \"They are exactly the same size\" confirms equality."}, {"question": "Learning English is not ___ hard as learning Chinese.", "options": ["as", "less", "too", "more"], "correct_index": 0, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "I ___ my homework at the moment.", "options": ["done", "am doing", "do", "doing"], "correct_index": 1, "explanation": "\"At the moment\" indicates an action happening now, requiring the Present Continuous tense (subject + am/is/are + verb-ing)."}, {"question": "I'm sorry, I ___ hear you right now.", "options": ["couldn't", "might not", "won't be able to", "can't"], "correct_index": 3, "explanation": "\"Right now\" indicates a present inability, so \"can't\" is the correct modal verb."}, {"question": "We were having dinner ___ the electricity stopped.", "options": ["as", "during", "while", "when"], "correct_index": 3, "explanation": "\"When\" is used to introduce a shorter, interrupting action (Past Simple) that happens during a longer action (Past Continuous)."}, {"question": "She ___ open the door yesterday because she lost the key.", "options": ["won't be able to", "might not", "couldn't", "can't"], "correct_index": 2, "explanation": "\"Yesterday\" indicates a past inability, so \"couldn't\" is the correct modal verb."}, {"question": "My phone rang when I ___ driving.", "options": ["was", "am", "had been", "were"], "correct_index": 0, "explanation": "\"When my phone rang\" (Past Simple) interrupted the longer action of \"I was driving\" (Past Continuous)."}, {"question": "I ___ a shower when you knocked on the door.", "options": ["took", "am taking", "had taken", "was taking"], "correct_index": 3, "explanation": "\"When you knocked\" (Past Simple) interrupted the longer action of \"I was taking a shower\" (Past Continuous)."}, {"question": "Look! The birds ___.", "options": ["sang", "sing", "have sung", "are singing"], "correct_index": 3, "explanation": "\"Look!\" is an imperative that signals an action happening at the moment of speaking, requiring the Present Continuous tense."}, {"question": "She usually ___ tennis on Saturdays.", "options": ["is playing", "play", "plays", "played"], "correct_index": 2, "explanation": "\"Usually\" and \"on Saturdays\" indicate a regular habit, requiring the Present Simple tense. For \"she,\" the verb takes an \"-s.\""}, {"question": "We ___ to school by bus every day.", "options": ["goes", "go", "went", "are going"], "correct_index": 1, "explanation": "\"Every day\" indicates a regular routine, requiring the Present Simple tense. For \"we,\" the base form of the verb is used."}, {"question": "I have never ___ understand his accent.", "options": ["been able to", "might", "can", "could"], "correct_index": 0, "explanation": "In perfect tenses (like Present Perfect \"have never\"), \"be able to\" is used instead of \"can/could\" to express ability. The past participle of \"be\" is \"been.\""}, {"question": "Today is not ___ sunny as yesterday.", "options": ["less", "as", "mo   ,""}, {"question": "This test was not ___ difficult as the last one. It was easier.", "options": ["more", "too", "less", "as"], "correct_index": 3, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way. \"It was easier\" confirms the inequality."}, {"question": "When the teacher entered the classroom, the students ___ talking.", "options": ["are", "were", "had been", "was"], "correct_index": 1, "explanation": "The students' talking was an ongoing action (Past Continuous) when the teacher entered (Past Simple). For \"the students\" (they), the auxiliary verb is \"were.\""}, {"question": "___ you speak English when you started school?", "options": ["Were", "Can", "Could", "Did"], "correct_index": 2, "explanation": "\"When you started school\" indicates a past ability, so \"Could\" is the correct modal verb for the question."}, {"question": "They ___ coffee every morning.", "options": ["are drinking", "drank", "drink", "drinks"], "correct_index": 2, "explanation": "\"Every morning\" indicates a regular routine, requiring the Present Simple tense. For \"they,\" the base form of the verb is used."}, {"question": "We ___ find the hotel yesterday without a map.", "options": ["might", "could", "were able to", "can"], "correct_index": 2, "explanation": "\"Yesterday\" indicates a specific past achievement or success in doing something, for which \"were able to\" is used, not \"could.\""}, {"question": "They ___ walk after the accident last month.", "options": ["won't be able to", "couldn't", "might not", "can't"], "correct_index": 1, "explanation": "\"Last month\" indicates a past inability, so \"couldn't\" is the correct modal verb."}, {"question": "If it rains tomorrow, we ___ go to the park.", "options": ["wouldn't", "didn't", "won't", "don't"], "correct_index": 2, "explanation": "The First Conditional describes a real possibility in the future. The \"if\" clause uses the Present Simple, and the main clause uses \"will\" + base verb (or \"won't\" for negative)."}, {"question": "The supermarket is ___ close as the bakery.", "options": ["less", "as", "too", "more"], "correct_index": 1, "explanation": "\"As...as\" is used to show that two things are equal in some way."}, {"question": "He ___ like milk.", "options": ["don't", "wasn't", "isn't", "doesn't"], "correct_index": 3, "explanation": "This expresses a general preference, requiring the Present Simple tense. For negative statements with \"he,\" the auxiliary verb is \"doesn't.\""}, {"question": "He ___ a book right now.", "options": ["is reading", "read", "reads", "has read"], "correct_index": 0, "explanation": "\"Right now\" indicates an action happening at the moment of speaking, requiring the Present Continuous tense (subject + am/is/are + verb-ing)."}, {"question": "I ___ working today because it's a holiday.", "options": ["didn't", "am not", "don't", "wasn't"], "correct_index": 1, "explanation": "This describes a temporary situation for \"today,\" requiring the Present Continuous tense. The negative form for \"I\" is \"am not.\""}, {"question": "When he was young, he ___ run very fast.", "options": ["may", "can", "could", "will be able to"], "correct_index": 2, "explanation": "\"When he was young\" indicates a past ability, so \"could\" is the correct modal verb."}, {"question": "___ you were sleeping, your brother washed the car.", "options": ["When", "While", "As soon as", "During"], "correct_index": 1, "explanation": "\"While\" is used to connect two simultaneous actions, one of which is often longer. Here, \"you were sleeping\" is a longer action."}, {"question": "She was sleeping ___ the door bell rang.", "options": ["when", "during", "while", "as"], "correct_index": 0, "explanation": "\"When\" is used to introduce a shorter, interrupting action (Past Simple) that happens during a longer action (Past Continuous)."}, {"question": "___ you help me with this heavy bag, please?", "options": ["Will", "Could", "Can", "May"], "correct_index": 1, "explanation": "\"Could\" is often used for polite requests. \"Can\" is also possible but l   -"explanation": "\"While\" introduces a longer action in the Past Continuous tense. For \"they,\" the auxiliary verb is \"were.\""}, {"question": "She fell down when she ___ running.", "options": ["is", "had been", "were", "was"], "correct_index": 3, "explanation": "\"When she fell down\" (Past Simple) interrupted the longer action of \"she was running\" (Past Continuous)."}, {"question": "I was watching TV ___ the telephone rang.", "options": ["while", "as", "during", "when"], "correct_index": 3, "explanation": "\"When\" is used to introduce a shorter, interrupting action (Past Simple) that happens during a longer action (Past Continuous)."}, {"question": "He doesn't run ___ fast as his brother.", "options": ["more", "too", "less", "as"], "correct_index": 3, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "I ___ come to your party next week.", "options": ["can", "might", "could", "will be able to"], "correct_index": 0, "explanation": "\"Next week\" indicates a future possibility or arrangement. \"Can\" can be used for future ability or permission/arrangement."}, {"question": "What ___ you doing right now?", "options": ["did", "do", "are", "were"], "correct_index": 2, "explanation": "\"Right now\" indicates an action happening at the moment of speaking, requiring the Present Continuous tense. The auxiliary verb for \"you\" in Present Continuous is \"are.\""}, {"question": "Water ___ at 100 degrees Celsius.", "options": ["boiled", "boils", "is boiling", "will boil"], "correct_index": 1, "explanation": "This is a scientific fact, requiring the Present Simple tense. For \"water\" (it), the verb takes an \"-s.\""}, {"question": "Silver is not ___ expensive as gold.", "options": ["less", "too", "as", "more"], "correct_index": 2, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "___ my mother was cooking, I was doing my homework.", "options": ["When", "As soon as", "While", "During"], "correct_index": 2, "explanation": "\"While\" is used to connect two simultaneous longer actions in the Past Continuous tense."}, {"question": "Winter in Spain is not ___ cold as in Canada.", "options": ["too", "as", "more", "less"], "correct_index": 1, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "Tomorrow, I ___ finish this project.", "options": ["can", "could", "will be able to", "might"], "correct_index": 2, "explanation": "\"Tomorrow\" indicates a future ability, so \"will be able to\" is the correct expression. \"Can\" is generally for present ability, and \"could\" for past or possibility."}, {"question": "After a lot of practice, she ___ pass her driving test last week.", "options": ["could", "might", "was able to", "can"], "correct_index": 2, "explanation": "\"Last week\" indicates a specific past achievement or success in doing something, for which \"was able to\" (or \"managed to\") is used, not \"could.\""}, {"question": "While he was reading a book, his sister ___ to music.", "options": ["listens", "had listened", "listened", "was listening"], "correct_index": 3, "explanation": "\"While\" connects two simultaneous longer actions in the Past Continuous tense."}, {"question": "This tea is ___ hot as coffee.", "options": ["less", "too", "more", "as"], "correct_index": 3, "explanation": "\"As...as\" is used to show that two things are equal in some way."}, {"question": "What ___ you doing when I called you yesterday?", "options": ["were", "did", "was", "are"], "correct_index": 0, "explanation": "This asks about an action in progress in the past, interrupted by another past action. The Past Continuous tense is formed with \"was/were\" + verb-ing. For \"you,\" \"were\" is used."}, {"question": "Why ___ you crying now?", "options": ["did", "do", "are", "were"], "correct_index": 2, "explanation": "\"Now\" indicates an action happening at the moment of speaking, requiring the Present Continuous tense. The auxiliary verb for \"you\" in Present Continuous is \"are.\    rect_index": 2, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "What ___ you doing right now?", "options": ["were", "are", "did", "do"], "correct_index": 1, "explanation": "\"Right now\" indicates an action happening at the moment of speaking, requiring the Present Continuous tense. The auxiliary verb for \"you\" in Present Continuous is \"are.\""}, {"question": "I ___ working today because it's a holiday.", "options": ["didn't", "am not", "wasn't", "don't"], "correct_index": 1, "explanation": "This describes a temporary situation for \"today,\" requiring the Present Continuous tense. The negative form for \"I\" is \"am not.\""}, {"question": "While they ___ studying, the lights went out.", "options": ["are", "were", "had been", "was"], "correct_index": 1, "explanation": "\"While\" introduces a longer action in the Past Continuous tense. For \"they,\" the auxiliary verb is \"were.\""}, {"question": "After a lot of practice, she ___ pass her driving test last week.", "options": ["could", "was able to", "can", "might"], "correct_index": 1, "explanation": "\"Last week\" indicates a specific past achievement or success in doing something, for which \"was able to\" (or \"managed to\") is used, not \"could.\""}, {"question": "___ you help me with this heavy bag, please?", "options": ["May", "Could", "Can", "Will"], "correct_index": 1, "explanation": "\"Could\" is often used for polite requests. \"Can\" is also possible but less formal."}, {"question": "This tea is ___ hot as coffee.", "options": ["less", "more", "as", "too"], "correct_index": 2, "explanation": "\"As...as\" is used to show that two things are equal in some way."}, {"question": "When he was young, he ___ run very fast.", "options": ["may", "can", "could", "will be able to"], "correct_index": 2, "explanation": "\"When he was young\" indicates a past ability, so \"could\" is the correct modal verb."}, {"question": "Where ___ they live?", "options": ["did", "are", "have", "do"], "correct_index": 3, "explanation": "This asks about a general fact (where they reside), requiring the Present Simple tense. For questions with \"they,\" the auxiliary verb is \"do.\""}, {"question": "___ my mother was cooking, I was doing my homework.", "options": ["During", "While", "When", "As soon as"], "correct_index": 1, "explanation": "\"While\" is used to connect two simultaneous longer actions in the Past Continuous tense."}, {"question": "Water ___ at 100 degrees Celsius.", "options": ["will boil", "is boiling", "boiled", "boils"], "correct_index": 3, "explanation": "This is a scientific fact, requiring the Present Simple tense. For \"water\" (it), the verb takes an \"-s.\""}, {"question": "They ___ coffee every morning.", "options": ["drink", "drinks", "drank", "are drinking"], "correct_index": 0, "explanation": "\"Every morning\" indicates a regular routine, requiring the Present Simple tense. For \"they,\" the base form of the verb is used."}, {"question": "___ you speak English when you started school?", "options": ["Did", "Were", "Could", "Can"], "correct_index": 2, "explanation": "\"When you started school\" indicates a past ability, so \"Could\" is the correct modal verb for the question."}, {"question": "The bus is not ___ fast as the train.", "options": ["too", "as", "less", "more"], "correct_index": 1, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "He ___ speak three languages now.", "options": ["might", "will be able to", "can", "could"], "correct_index": 2, "explanation": "\"Now\" indicates a present ability, so \"can\" is the correct modal verb."}]}j‹/f                                                                                                                                                                                                                                                                                                                                                                                                                    /ons": ["will be able to", "might", "can", "could"], "correct_index": 0, "explanation": "\"One day\" indicates a future ability or possibility, so \"will be able to\" is the most appropriate expression."}, {"question": "He ___ like milk.", "options": ["wasn't", "doesn't", "isn't", "don't"], "correct_index": 1, "explanation": "This expresses a general preference, requiring the Present Simple tense. For negative statements with \"he,\" the auxiliary verb is \"doesn't.\""}, {"question": "What ___ you doing when I called you yesterday?", "options": ["did", "was", "were", "are"], "correct_index": 2, "explanation": "This asks about an action in progress in the past, interrupted by another past action. The Past Continuous tense is formed with \"was/were\" + verb-ing. For \"you,\" \"were\" is used."}, {"question": "She ___ open the door yesterday because she lost the key.", "options": ["can't", "might not", "couldn't", "won't be able to"], "correct_index": 2, "explanation": "\"Yesterday\" indicates a past inability, so \"couldn't\" is the correct modal verb."}, {"question": "We ___ to school by bus every day.", "options": ["are going", "go", "goes", "went"], "correct_index": 1, "explanation": "\"Every day\" indicates a regular routine, requiring the Present Simple tense. For \"we,\" the base form of the verb is used."}, {"question": "Penguins ___ fly, but they are great swimmers.", "options": ["won't be able to", "couldn't", "can't", "don't"], "correct_index": 2, "explanation": "This states a general fact about penguins' present inability, so \"can't\" is the correct modal verb."}, {"question": "My mother ___ dinner at the moment.", "options": ["has cooked", "cooked", "is cooking", "cooks"], "correct_index": 2, "explanation": "\"At the moment\" indicates an action happening now, requiring the Present Continuous tense. For \"my mother\" (she), the auxiliary verb is \"is.\""}, {"question": "I ___ swim when I was five years old.", "options": ["can", "may", "could", "will be able to"], "correct_index": 2, "explanation": "\"When I was five years old\" indicates a past ability, so \"could\" is the correct modal verb."}, {"question": "Today is not ___ sunny as yesterday.", "options": ["as", "too", "more", "less"], "correct_index": 0, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "My phone rang when I ___ driving.", "options": ["am", "had been", "was", "were"], "correct_index": 2, "explanation": "\"When my phone rang\" (Past Simple) interrupted the longer action of \"I was driving\" (Past Continuous)."}, {"question": "She usually ___ tennis on Saturdays.", "options": ["play", "played", "is playing", "plays"], "correct_index": 3, "explanation": "\"Usually\" and \"on Saturdays\" indicate a regular habit, requiring the Present Simple tense. For \"she,\" the verb takes an \"-s.\""}, {"question": "I ___ a shower when you knocked on the door.", "options": ["was taking", "am taking", "took", "had taken"], "correct_index": 0, "explanation": "\"When you knocked\" (Past Simple) interrupted the longer action of \"I was taking a shower\" (Past Continuous)."}, {"question": "They were playing football when it ___ to rain.", "options": ["had started", "was starting", "started", "starts"], "correct_index": 2, "explanation": "\"When\" introduces a shorter, interrupting action in the Past Simple tense that occurs during a longer action in the Past Continuous."}, {"question": "He doesn't run ___ fast as his brother.", "options": ["as", "too", "less", "more"], "correct_index": 0, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "Tomorrow, I ___ finish this project.", "options": ["might", "will be able to", "can", "could"], "correct_index": 1, "explanation": "\"Tomorrow\" indicates a future ability, so \"will be able to\" is the correct expression. \"Can\" is generally for present ability, and \"could\" for past or possibility."}, {"question": "Winter in Spain is not ___ cold as in Canada.", "options": ["more", "too", "as", "less"], "cor   0 show that two things are equal in some way."}, {"question": "I have never ___ understand his accent.", "options": ["can", "been able to", "might", "could"], "correct_index": 1, "explanation": "In perfect tenses (like Present Perfect \"have never\"), \"be able to\" is used instead of \"can/could\" to express ability. The past participle of \"be\" is \"been.\""}, {"question": "They ___ walk after the accident last month.", "options": ["can't", "might not", "couldn't", "won't be able to"], "correct_index": 2, "explanation": "\"Last month\" indicates a past inability, so \"couldn't\" is the correct modal verb."}, {"question": "We were having dinner ___ the electricity stopped.", "options": ["when", "during", "as", "while"], "correct_index": 0, "explanation": "\"When\" is used to introduce a shorter, interrupting action (Past Simple) that happens during a longer action (Past Continuous)."}, {"question": "I'm sorry, I ___ hear you right now.", "options": ["won't be able to", "might not", "can't", "couldn't"], "correct_index": 2, "explanation": "\"Right now\" indicates a present inability, so \"can't\" is the correct modal verb."}, {"question": "We ___ find the hotel yesterday without a map.", "options": ["could", "were able to", "can", "might"], "correct_index": 1, "explanation": "\"Yesterday\" indicates a specific past achievement or success in doing something, for which \"were able to\" is used, not \"could.\""}, {"question": "She fell down when she ___ running.", "options": ["was", "were", "had been", "is"], "correct_index": 0, "explanation": "\"When she fell down\" (Past Simple) interrupted the longer action of \"she was running\" (Past Continuous)."}, {"question": "This test was not ___ difficult as the last one. It was easier.", "options": ["as", "too", "more", "less"], "correct_index": 0, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way. \"It was easier\" confirms the inequality."}, {"question": "Look! The birds ___.", "options": ["sang", "have sung", "are singing", "sing"], "correct_index": 2, "explanation": "\"Look!\" is an imperative that signals an action happening at the moment of speaking, requiring the Present Continuous tense."}, {"question": "While he was reading a book, his sister ___ to music.", "options": ["listens", "was listening", "listened", "had listened"], "correct_index": 1, "explanation": "\"While\" connects two simultaneous longer actions in the Past Continuous tense."}, {"question": "He lost his wallet while he ___ shopping.", "options": ["were", "is", "had been", "was"], "correct_index": 3, "explanation": "\"While\" introduces a longer action in the Past Continuous tense. For \"he,\" the auxiliary verb is \"was.\""}, {"question": "I was watching TV ___ the telephone rang.", "options": ["during", "while", "when", "as"], "correct_index": 2, "explanation": "\"When\" is used to introduce a shorter, interrupting action (Past Simple) that happens during a longer action (Past Continuous)."}, {"question": "___ you were sleeping, your brother washed the car.", "options": ["During", "As soon as", "When", "While"], "correct_index": 3, "explanation": "\"While\" is used to connect two simultaneous actions, one of which is often longer. Here, \"you were sleeping\" is a longer action."}, {"question": "If you heat ice, it ___ into water.", "options": ["melts", "would melt", "melted", "will melt"], "correct_index": 0, "explanation": "The Zero Conditional describes general truths or scientific facts. Both clauses use the Present Simple tense."}, {"question": "Your cat is ___ beautiful as mine.", "options": ["as", "too", "more", "less"], "correct_index": 0, "explanation": "\"As...as\" is used to show that two things are equal in some way."}, {"question": "He ___ a book right now.", "options": ["has read", "is reading", "read", "reads"], "correct_index": 1, "explanation": "\"Right now\" indicates an action happening at the moment of speaking, requiring the Present Continuous tense (subject + am/is/are + verb-ing)."}, {"question": "One day, humans ___ live on Mars.", "opti   1 the moment of speaking, requiring the Present Continuous tense. The auxiliary verb for \"you\" in Present Continuous is \"are.\""}, {"question": "She was sleeping ___ the door bell rang.", "options": ["while", "as", "when", "during"], "correct_index": 2, "explanation": "\"When\" is used to introduce a shorter, interrupting action (Past Simple) that happens during a longer action (Past Continuous)."}, {"question": "I am ___ tall as my father now.", "options": ["as", "more", "less", "too"], "correct_index": 0, "explanation": "\"As...as\" is used to show that two things are equal in some way."}, {"question": "When the teacher entered the classroom, the students ___ talking.", "options": ["were", "had been", "was", "are"], "correct_index": 0, "explanation": "The students' talking was an ongoing action (Past Continuous) when the teacher entered (Past Simple). For \"the students\" (they), the auxiliary verb is \"were.\""}, {"question": "My sister is not ___ old as me. She is younger.", "options": ["less", "too", "more", "as"], "correct_index": 3, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way. \"She is younger\" confirms the inequality."}, {"question": "Learning English is not ___ hard as learning Chinese.", "options": ["less", "too", "as", "more"], "correct_index": 2, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "If it rains tomorrow, we ___ go to the park.", "options": ["wouldn't", "won't", "don't", "didn't"], "correct_index": 1, "explanation": "The First Conditional describes a real possibility in the future. The \"if\" clause uses the Present Simple, and the main clause uses \"will\" + base verb (or \"won't\" for negative)."}, {"question": "While we ___ walking in the park, we saw a beautiful bird.", "options": ["was", "were", "have been", "are"], "correct_index": 1, "explanation": "\"While\" introduces a longer action in the Past Continuous tense. For \"we,\" the auxiliary verb is \"were.\""}, {"question": "Silver is not ___ expensive as gold.", "options": ["less", "as", "too", "more"], "correct_index": 1, "explanation": "\"Not as...as\" is used to show that two things are not equal in some way."}, {"question": "Listen! Someone ___ the piano.", "options": ["has played", "played", "is playing", "plays"], "correct_index": 2, "explanation": "\"Listen!\" is an imperative that signals an action happening at the moment of speaking, requiring the Present Continuous tense. \"Someone\" takes a singular verb."}, {"question": "My bedroom is ___ big as your bedroom. They are exactly the same size.", "options": ["too", "less", "as", "more"], "correct_index": 2, "explanation": "\"As...as\" is used to show that two things are equal in some way. \"They are exactly the same size\" confirms equality."}, {"question": "This phone is ___ expensive as that one. They cost the same.", "options": ["less", "too", "more", "as"], "correct_index": 3, "explanation": "\"As...as\" is used to show that two things are equal in some way. \"They cost the same\" confirms equality."}, {"question": "I ___ come to your party next week.", "options": ["might", "will be able to", "could", "can"], "correct_index": 3, "explanation": "\"Next week\" indicates a future possibility or arrangement. \"Can\" can be used for future ability or permission/arrangement."}, {"question": "I ___ my homework at the moment.", "options": ["am doing", "doing", "done", "do"], "correct_index": 0, "explanation": "\"At the moment\" indicates an action happening now, requiring the Present Continuous tense (subject + am/is/are + verb-ing)."}, {"question": "___ you listen to music every night?", "options": ["Did", "Are", "Do", "Have"], "correct_index": 2, "explanation": "\"Every night\" indicates a regular habit, requiring the Present Simple tense. For questions in Present Simple with \"you,\" the auxiliary verb is \"Do.\""}, {"question": "The supermarket is ___ close as the bakery.", "options": ["more", "as", "less", "too"], "correct_index": 1, "explanation": "\"As...as\" is used to   6yasi ' -' satrini 'web' satrining 1-indeksiga (0-indeksli 'w') kiritadi. Natija 'w -eb' bo'ladi."}, {"question": "Kod natijasi qanday? int x=100; string s=to_string(x)+\" ta\"; cout<<s;", "options": ["100", "x ta", "100 ta", "ta 100"], "correct_index": 2, "explanation": "to_string funksiyasi 100 butun sonini '100' satriga aylantiradi. Keyin unga ' ta' satri qo'shiladi. Natija '100 ta' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"data\"; s.append(\"base\"); cout<<s;", "options": ["data base", "data", "basedata", "database"], "correct_index": 3, "explanation": "append funksiyasi 'base' satrini 'data' satrining oxiriga qo'shadi. Natija 'database' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"kitob\"; reverse(s.begin(), s.end()); cout<<s;", "options": ["kibot", "kitob", "botik", "tobik"], "correct_index": 2, "explanation": "reverse funksiyasi 'kitob' satrini teskari tartibda joylashtiradi. Natija 'botik' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"ABCDE\"; reverse(s.begin(), s.end()); cout<<s;", "options": ["ABCDE", "DBCAE", "AECBD", "EDCBA"], "correct_index": 3, "explanation": "reverse funksiyasi 'ABCDE' satrini teskari tartibda joylashtiradi. Natija 'EDCBA' bo'ladi."}, {"question": "Kod natijasini toping: char s[] = \"Kitob\"; cout << (char )tolower(s[0]);", "options": ["I", "i", "K", "k"], "correct_index": 3, "explanation": "tolower funksiyasi 'K' (s[0]) belgisini kichik harfga ('k') aylantiradi."}, {"question": "strcmp(\"abc\",\"abd\")==0 ifodasi ekranga qanday qiymat chiqaradi?", "options": ["abc", "abd", "1", "0"], "correct_index": 3, "explanation": "strcmp funksiyasi 'abc' va 'abd' satrlarini solishtiradi. 'c' 'd' dan oldin kelgani uchun manfiy qiymat qaytaradi. Manfiy qiymat 0 ga teng emas, shuning uchun ifoda false (0) qiymatini beradi."}, {"question": "Kod natijasini toping: char s[]=\"1234\"; int x=atoi(s); cout<<x+6;", "options": ["1230", "1240", "6", "1234"], "correct_index": 1, "explanation": "atoi funksiyasi '1234' satrini butun songa (1234) aylantiradi. Keyin 1234 ga 6 qo'shiladi, natija 1240."}, {"question": "Kod natijasini toping: char s[] = \"ABC\"; cout << (char)tolower(s[0]);", "options": ["A", "b", "a", "B"], "correct_index": 2, "explanation": "tolower funksiyasi 'A' (s[0]) belgisini kichik harfga ('a') aylantiradi."}, {"question": "Kod natijasini toping: char s[] = \"Salom\"; cout << (char)tolower(s[0]);", "options": ["S", "a", "A", "s"], "correct_index": 3, "explanation": "tolower funksiyasi 'S' (s[0]) belgisini kichik harfga ('s') aylantiradi."}, {"question": "Kod natijasini toping: string s = \" sarbon\"; cout << s.substr(0,3);", "options": ["sar", " sa", "sarb", "bon"], "correct_index": 1, "explanation": "substr funksiyasi 0-indeksdan boshlab (bo'sh joy) 3 ta belgini oladi. Bu ' sa' satrini beradi."}, {"question": "Kod natijasini toping: string s=\"algoritm\"; cout<<s.find(\"rit\");", "options": ["4", "7", "1", "0"], "correct_index": 0, "explanation": "find funksiyasi 'rit' kichik satrining 'algoritm' satridagi birinchi uchragan indeksini qaytaradi. 'rit' 4-indeksdan boshlanadi."}, {"question": "Kod natijasini toping: string s=\"abracadabra\"; cout<<s.find(\"cad\");", "options": ["7", "3", "0", "4"], "correct_index": 3, "explanation": "find funksiyasi 'cad' kichik satrining 'abracadabra' satridagi birinchi uchragan indeksini qaytaradi. 'cad' 4-indeksdan boshlanadi."}, {"question": "Kod natijasini toping: string s=\"123\"; int x=stoi(s); cout<<x+1;", "options": ["124", "1", "122", "123"], "correct_index": 0, "explanation": "stoi funksiyasi '123' satrini butun songa (123) aylantiradi. Keyin 123 ga 1 qo'shiladi, natija 124."}, {"question": "Kod natijasini toping: string s = \"dasturlash\"; s.erase(0,3); cout << s;", "options": ["dasturlash", "turlash", "urlash", "dash"], "correct_index": 1, "explanation": "erase funksiyasi 'dasturlash' satridan 0-indeksdan boshlab 3 ta belgini ('das') o'chiradi. Natija 'turlash' bo'ladi."}, {"question": "Kod natijasini toping: char s[]=\"qismiy_satr\"; cout<<(strstr(s,\"satr\")!=nullptr);", "options": ["1", "0", "satr",   3 "gra"], "correct_index": 0, "explanation": "substr funksiyasi 2-indeksdan boshlab (0-indeksli 'p') 3 ta belgini oladi. Bu 'ogr' satrini beradi."}, {"question": "Kod natijasini toping: string s=\"informatika\"; cout<<s.substr(5,4);", "options": ["tika", "info", "form", "mati"], "correct_index": 3, "explanation": "substr funksiyasi 5-indeksdan boshlab (0-indeksli 'i') 4 ta belgini oladi. Bu 'mati' satrini beradi."}, {"question": "Kod natijasini toping: string s = \"file.cpp\"; cout << s.substr(5,3);", "options": ["cpp", "file", "e.c", ".cpp"], "correct_index": 0, "explanation": "substr funksiyasi 5-indeksdan boshlab (0-indeksli 'f') 3 ta belgini oladi. Bu 'cpp' satrini beradi."}, {"question": "Kod natijasi qanday? int x=12; string s=to_string(x)+\" ta\"; cout<<s;", "options": ["ta 12", "12", "12 ta", "x ta"], "correct_index": 2, "explanation": "to_string funksiyasi 12 butun sonini '12' satriga aylantiradi. Keyin unga ' ta' satri qo'shiladi. Natija '12 ta' bo'ladi."}, {"question": "Kod natijasini toping: char s[]=\"dasturlash\"; cout<<(strstr(s,\"tur\")!=nullptr);", "options": ["tur", "1", "0", "dasturlash"], "correct_index": 1, "explanation": "strstr funksiyasi 'tur' kichik satrini 'dasturlash' satrida topadi va nullptr bo'lmagan ko'rsatkich qaytaradi. Shuning uchun ifoda true (1) qiymatini beradi."}, {"question": "Kod natijasini toping: string s=\"matematika\"; cout<<s.substr(4,4);", "options": ["tika", "mati", "tema", "mate"], "correct_index": 1, "explanation": "substr funksiyasi 4-indeksdan boshlab (0-indeksli 'm') 4 ta belgini oladi. Bu 'mati' satrini beradi."}, {"question": "Kod natijasini toping: char s[]=\"90\"; int x=atoi(s); cout<<x+6;", "options": ["96", "90", "84", "6"], "correct_index": 0, "explanation": "atoi funksiyasi '90' satrini butun songa (90) aylantiradi. Keyin 90 ga 6 qo'shiladi, natija 96."}, {"question": "Quyidagi kodda strcmp natijasi qanday baholanadi: cout << (strcmp(\"kitob\",\"kitob\") == 0);", "options": ["true", "0", "kitob", "1"], "correct_index": 3, "explanation": "strcmp funksiyasi 'kitob' va 'kitob' satrlarini solishtiradi. Ular bir xil bo'lgani uchun 0 qaytaradi. 0 == 0 ifodasi true (1) qiymatini beradi."}, {"question": "Kod natijasini toping: string s=\"banana\"; cout<<s.find(\"ana\");", "options": ["2", "1", "0", "3"], "correct_index": 1, "explanation": "find funksiyasi 'ana' kichik satrining 'banana' satridagi birinchi uchragan indeksini qaytaradi. 'ana' 1-indeksdan boshlanadi."}, {"question": "Kod natijasini toping: char s[]=\"a babc\"; cout<<(strstr(s,\"abc\")!=nullptr);", "options": ["abc", "a babc", "0", "1"], "correct_index": 3, "explanation": "strstr funksiyasi 'abc' kichik satrini 'a babc' satrida topadi va nullptr bo'lmagan ko'rsatkich qaytaradi. Shuning uchun ifoda true (1) qiymatini beradi."}, {"question": "Quyidagi kodda qaysi satr hosil boвЂladi? string s=\"matematika\"; s.replace(0,4,\"info\"); cout<<s;", "options": ["matematika", "infotematika", "infomatika", "informatika"], "correct_index": 2, "explanation": "replace funksiyasi 'matematika' satrining 0-indeksdan boshlab 4 ta belgisini ('mate') 'info' satri bilan almashtiradi. Natija 'infomatika' bo'ladi."}, {"question": "Kod natijasini toping: char s[] = \"DATA\"; cout << (char)tolower(s[0]);", "options": ["d", "a", "D", "A"], "correct_index": 0, "explanation": "tolower funksiyasi 'D' (s[0]) belgisini kichik harfga ('d') aylantiradi."}, {"question": "Kod natijasini toping: string s=\"2025\"; int x=stoi(s); cout<<x+1;", "options": ["2025", "1", "2024", "2026"], "correct_index": 3, "explanation": "stoi funksiyasi '2025' satrini butun songa (2025) aylantiradi. Keyin 2025 ga 1 qo'shiladi, natija 2026."}, {"question": "Kod natijasini toping: char s[] = \"Web\"; cout << (char)tolower(s[0]);", "options": ["w", "e", "E", "W"], "correct_index": 0, "explanation": "tolower funksiyasi 'W' (s[0]) belgisini kichik harfga ('w') aylantiradi."}, {"question": "Kod ekranga nima chiqaradi? string s=\"web\"; s.insert(1,\" -\"); cout<<s;", "options": ["we -b", "- web", "w -eb", "web -"], "correct_index": 2, "explanation": "insert funksi
