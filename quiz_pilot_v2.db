an 4-indeksdan boshlab (0-indeksli 'f') 4 ta belgini ('.txt') o'chiradi. Natija 'file' bo'ladi."}, {"question": "Kod natijasi qanday? int x=45; string s=to_string(x)+\" ta\"; cout<<s;", "options": ["ta 45", "x ta", "45 ta", "45"], "correct_index": 2, "explanation": "to_string funksiyasi 45 butun sonini '45' satriga aylantiradi. Keyin unga ' ta' satri qo'shiladi. Natija '45 ta' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"fan\"; s.append(\"lar\"); cout<<s;", "options": ["fan lar", "fan", "fanlar", "larfan"], "correct_index": 2, "explanation": "append funksiyasi 'lar' satrini 'fan' satrining oxiriga qo'shadi. Natija 'fanlar' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"abcde\"; s.erase(1,1); cout<<s;", "options": ["bcde", "abcde", "acde", "abde"], "correct_index": 2, "explanation": "erase funksiyasi 'abcde' satridan 1-indeksdan boshlab (0-indeksli 'a') 1 ta belgini ('b') o'chiradi. Natija 'acde' bo'ladi."}, {"question": "Kod natijasini toping: char s[]=\"1005\"; int x=atoi(s); cout<<x+6;", "options": ["999", "6", "1011", "1005"], "correct_index": 2, "explanation": "atoi funksiyasi '1005' satrini butun songa (1005) aylantiradi. Keyin 1005 ga 6 qo'shiladi, natija 1011."}, {"question": "Kod natijasini toping: char s[]=\"informatika\"; cout<<(strstr(s,\"mat\")!=nullptr);", "options": ["0", "informatika", "1", "mat"], "correct_index": 2, "explanation": "strstr funksiyasi 'mat' kichik satrini 'informatika' satrida topadi va nullptr bo'lmagan ko'rsatkich qaytaradi. Shuning uchun ifoda true (1) qiymatini beradi."}, {"question": "Kod natijasi qanday? int x=2026; string s=to_string(x)+\" ta\"; cout<<s;", "options": ["ta 2026", "2026 ta", "x ta", "2026"], "correct_index": 1, "explanation": "to_string funksiyasi 2026 butun sonini '2026' satriga aylantiradi. Keyin unga ' ta' satri qo'shiladi. Natija '2026 ta' bo'ladi."}, {"question": "Quyidagi kodda ekranga nima chiqadi: string s = \"fan\"; s.insert(3,\"lar\"); cout << s;", "options": ["fanlar", "larfan", "fan", "fa nlar"], "correct_index": 0, "explanation": "insert funksiyasi 'lar' satrini 'fan' satrining 3-indeksiga (oxiriga) kiritadi. Natija 'fanlar' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"a,b,c\"; cout<<s.find(\",\");", "options": ["0", "2", "3", "1"], "correct_index": 3, "explanation": "find funksiyasi ',' belgisining 'a,b,c' satridagi birinchi uchragan indeksini qaytaradi. ',' 1-indeksdan boshlanadi."}, {"question": "Kod natijasini toping: string s=\"Dasturlash \"; cout<<s.substr(3,4);", "options": ["url", "turl", "lash", "Dast"], "correct_index": 1, "explanation": "substr funksiyasi 3-indeksdan boshlab (0-indeksli 'D') 4 ta belgini oladi. Bu 'turl' satrini beradi."}, {"question": "Kod satrni kichik harflarga aylantiradi. Natijani toping: string s=\"AbCd\"; for (char &c:s) c=tolower(c); cout<<s;", "options": ["ABCD", "AbCd", "abcd", "aBcD"], "correct_index": 2, "explanation": "Tsikl har bir belgini tolower funksiyasi yordamida kichik harfga aylantiradi. Natija 'abcd' bo'ladi."}, {"question": "Kod natijasini toping: string s=\"1005\"; int x=stoi(s); cout<<x+1;", "options": ["1006", "1", "1005", "1004"], "correct_index": 0, "explanation": "stoi funksiyasi '1005' satrini butun songa (1005) aylantiradi. Keyin 1005 ga 1 qo'shiladi, natija 1006."}]}jЏґZ                                                                                                                                                                                                                                                                                                        <tsiz reflekslarni",
