stion":"Islom fiqhida manbalar nechta asosiy toifaga boвЂlinadi?","options":["To'rt","Ikki","Uch","Besh"],"correct_index":0,"explanation":"Islom fiqhida asosiy manbalar Qur'on, Sunnat, Ijmo' va Qiyosdan iborat bo'lib, to'rt toifaga bo'linadi."},{"question":"Tafsirning asosiy vazifasi nima?","options":["Qur'on oyatlarini sharhlash va tushuntirish","Hadislarni to'plash","Diniy hukmlarni chiqarish","Falsafiy munozaralar olib borish"],"correct_index":0,"explanation":"Tafsir Qur'on oyatlarining ma'nolarini, sabablarini va hukmlarini tushuntiruvchi ilmdir."},{"question":  Б"Hadislarni toвЂplagan mashhur kitoblardan biri?","options":["Sahihi Buxoriy","Qur'on","Avesto","Injil"],"correct_index":0,"explanation":"Sahihi Buxoriy Islom olamidagi eng ishonchli va mashhur hadis to'plamlaridan biridir."},{"question":"Islom huquqi (fiqh) nimaga asoslanadi?","options":["Qur'on va Sunnatga","Faqat urf-odatlarga","Faqat davlat qonunlariga","Faqat shaxsiy fikrlarga"],"correct_index":0,"explanation":"Islom huquqi (fiqh) Qur'on va Sunnatga asoslanib, musulmonlarning hayotini tartibga soluvchi qoidalarni o'rganadi."},{"question":"Islom aqidasining markaziy gвЂoyasi nima?","options":["Tavhid (yagona Allohga e'tiqod)","Ko'p xudolarga sig'inish","Qayta tug'ilish","Faqat dunyoviy hayotga e'tibor"],"correct_index":0,"explanation":"Tavhid Islom aqidasining markaziy g'oyasi bo'lib, yagona Allohga hech qanday sherik keltirmasdan iymon keltirishni anglatadi."},{"question":"Islomdagi asosiy eвЂ™tiqodlar qanday ataladi?","options":["Iymon shartlari","Islom ruknlari","Sunnat amallari","Farz ibodatlar"],"correct_index":0,"explanation":"Islomdagi asosiy e'tiqodlar iymon shartlari deb ataladi: Allohga, farishtalarga, kitoblarga, payg'ambarlarga, oxirat kuniga va qadar-qazoga iymon."},{"question":"Iymon shartlaridan biri qaysi?","options":["Allohga iymon","Namoz o'qish","Ro'za tutish","Zakot berish"],"correct_index":0,"explanation":"Allohga iymon keltirish iymon shartlarining birinchisi va eng muhimi hisoblanadi."},{"question":"Islomdagi amaliy ibodatlar nima deb ataladi?","options":["Islom ruknlari","Iymon shartlari","Sunnat amallari","Mustahab amallar"],"correct_index":0,"explanation":"Islomdagi amaliy ibodatlar Islom ruknlari deb ataladi: shahodat, namoz, ro'za, zakot va haj."},{"question":"Sunniylik nechta asosiy fiqhiy mazhabga boвЂlinadi?","options":["To'rt","Ikki","Uch","Besh"],"correct_index":0,"explanation":"Sunniylikda to'rtta asosiy fiqhiy mazhab mavjud: Hanafiy, Molikiy, Shofe'iy va Hanbaliy."},{"question":"Sunniy fiqh mazhablaridan biri qaysi?","options":["Hanafiy","Ja'fariy","Zaydiy","Ismoiliy"],"correct_index":0,"explanation":"Hanafiy mazhabi sunniy Islomdagi eng yirik fiqhiy mazhablardan biridir."},{"question":"Shialikning asosiy aqidaviy gвЂoyasi qaysi?","options":["Ali ibn Abu Tolib va uning avlodlarining imomligiga e'tiqod","Faqat Qur'onga asoslanish","Faqat hadislarga asoslanish","Barcha xalifalarni tan olish"],"correct_index":0,"explanation":"Shialikda Muhammad (s.a.v.)dan keyin imomlik Ali ibn Abu Tolib va uning avlodlariga tegishli ekanligiga ishoniladi."},{"question":"Imonning shartlaridan biri nima?","options":["Qadar va qazoga iymon","Hajga borish","Zakot berish","Ro'za tutish"],"correct_index":0,"explanation":"Qadar va qazoga (taqdirga) iymon keltirish Islomdagi iymon shartlaridan biridir."},{"question":"Islomning amaliy ruknlaridan biri qaysi?","options":["Namoz","Farishtalarga iymon","Muqaddas kitoblarga iymon","Payg'ambarlarga iymon"],"correct_index":0,"explanation":"Namoz Islomning besh ruknidan biri bo'lib, kuniga besh mahal bajariladigan ibodatdir."},{"question":"Musulmonlar orasida eng keng tarqalgan mazhablardan biri?","options":["Hanafiy mazhabi","Ja'fariy mazhabi","Zaydiy mazhabi","Ismoiliy mazhabi"],"correct_index":0,"explanation":"Hanafiy mazhabi dunyo musulmonlari orasida, jumladan Markaziy Osiyoda eng keng tarqalgan fiqhiy mazhabdir."},{"question":"Islom dini Markaziy Osiyoga asosan qaysi asrlarda kirib kelgan?","option